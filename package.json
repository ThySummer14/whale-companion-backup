{
  "name": "dsh-companion-bot",
  "version": "0.128.0",
  "private": true,
  "description": "A single-character companion workbench for DeepSeek Harness",
  "license": "UNLICENSED",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": { "dsh-litematica": "lib/dsh-litematica.js" },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "scripts/bench-voice.mjs",
    "scripts/run-mlx-asr.py",
    "scripts/run-voxweft-tts.py",
    "scripts/run-seed-vc-svc.py",
    "scripts/run-soulx-score.py",
    "scripts/run-mlx-demucs.py",
    "scripts/prepare-indextts2.py",
    "scripts/run-indextts2-tts.py"
  ],
  "scripts": {
    "app:preview": "node scripts/preview-app.mjs",
    "build": "tsdown && cp src/host/tts-worker.py lib/tts-worker.py && cp -R src/avatar lib/avatar && cp apps/minecraft-worker/msa.mjs lib/msa.mjs && cp apps/minecraft-worker/console.sh lib/minecraft-console.sh && cp apps/minecraft-worker/NOTICE.txt lib/minecraft-worker-NOTICE.txt && cp apps/minecraft-worker/UPSTREAM-LICENSE.txt lib/minecraft-worker-UPSTREAM-LICENSE.txt",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm build && pnpm --filter @companion/mobile typecheck",
    "prepack": "pnpm check"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": "0.2.1-rc.5"
  },
  "packageManager": "pnpm@10.33.2",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "external": [
        "react",
        "react-dom",
        "react/jsx-runtime"
      ]
    }
  },
  "dependencies": {
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-agent-default-model": "0.2.1-rc.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.1-rc.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-agent-default-model": "0.2.1-rc.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.1-rc.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "22.20.0",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@types/ws": "8.18.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.14",
    "typescript": "6.0.3"
  }
}
