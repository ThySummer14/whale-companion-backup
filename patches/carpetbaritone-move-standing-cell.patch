+    private static String unavailableStandingCell(ServerPlayer player, BlockPos target) {
+        var world = player.serverLevel();
+        var settings = Baritone.settings();
+        if (settings.allowBreak.value || settings.allowPlace.value || !world.hasChunkAt(target)) {
+            return null;
+        }
+        for (BlockPos position : List.of(target, target.above())) {
+            var state = world.getBlockState(position);
+            if (state.isCollisionShapeFullBlock(world, position)
+                    && !settings.allowBreakAnyway.value.contains(state.getBlock())) {
+                return "move-target-blocked";
+            }
+        }
+        if (world.getBlockState(target).isAir() && world.getBlockState(target.below()).isAir()) {
+            return "move-target-unsupported";
+        }
+        return null;
