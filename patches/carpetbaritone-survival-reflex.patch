+    private void steerAway(ServerPlayer player, Vec3 away, boolean canJump) {
+        Vec3 origin = player.position();
+        ServerLevel level = player.serverLevel();
+        double angle = Math.atan2(away.z, away.x);
+        for (int degrees : ESCAPE_ANGLES) {
+            double heading = angle + Math.toRadians(degrees);
+            double dx = Math.cos(heading);
+            double dz = Math.sin(heading);
+            BlockPos first = BlockPos.containing(origin.x + 0.85D * dx, origin.y, origin.z + 0.85D * dz);
+            BlockPos second = BlockPos.containing(origin.x + 1.7D * dx, origin.y, origin.z + 1.7D * dz);
+            if (!safeColumn(level, first) || !safeColumn(level, second)) continue;
+            float yaw = (float) Math.toDegrees(Math.atan2(-dx, dz));
+            input.setEmergencyMovement(new Rotation(yaw, 0.0F), true,
+                    Baritone.settings().emergencyAvoidanceJump.value && canJump);
+            return;
+        }
+        input.setPriorityMovement(null, false, false, player.isInWater());
+    }
+
+    private boolean recoverAir(ServerPlayer player) {
+        // A swim jump can momentarily lift the whole player out of the fluid.
+        // Keep control until landing or until the breath has actually recovered.
+        if (!player.isInWater() && (activeThreat != Threat.WATER || player.onGround())) {
+            shore = null;
+            nextShoreScan = 0;
+            return false;
         }
+        int air = player.getAirSupply();
+        if (air >= 160 && activeThreat != Threat.WATER) return false;
+        boolean submerged = player.isEyeInFluid(FluidTags.WATER);
+        if (!submerged && player.tickCount >= nextShoreScan) {
+            shore = nearbyShore(player.serverLevel(), player.position());
+            nextShoreScan = player.tickCount + 5;
+        }
+        if (!submerged && shore == null && air >= 280) return false;
+        cancelManualShield(null, "shield-emergency");
+        stopShielding(player);
+        Rotation rotation = new Rotation(player.getYRot(), -45.0F);
+        boolean forward = false;
+        if (!submerged && shore != null) {
+            Vec3 direction = shore.subtract(player.position());
+            rotation = new Rotation((float) Math.toDegrees(Math.atan2(-direction.x, direction.z)), 0.0F);
+            forward = true;
+        }
+        input.setPriorityMovement(rotation, forward, forward, true);
+        activeThreat = Threat.WATER;
+        return true;
     }
 
+    private static Vec3 nearbyShore(ServerLevel level, Vec3 origin) {
+        for (int distance = 1; distance <= 5; distance++) {
+            for (int[] direction : SHORE_DIRECTIONS) {
+                BlockPos end = BlockPos.containing(origin.x + distance * direction[0], origin.y,
+                        origin.z + distance * direction[1]);
+                if (!safeColumn(level, end)) continue;
+                boolean clear = true;
+                for (int step = 1; step < distance && clear; step++) {
+                    BlockPos feet = BlockPos.containing(origin.x + step * direction[0], origin.y,
+                            origin.z + step * direction[1]);
+                    clear = level.hasChunkAt(feet) && level.getBlockState(feet).getCollisionShape(level, feet).isEmpty()
+                            && level.getBlockState(feet.above()).getCollisionShape(level, feet.above()).isEmpty();
+                }
+                if (clear) return Vec3.atCenterOf(end);
+            }
+        }
+        return null;
+    }
+
+    private static boolean safeColumn(ServerLevel level, BlockPos column) {
+        if (!level.hasChunkAt(column)) return false;
+        for (int height : FOOTING_LEVELS) {
+            BlockPos feet = column.above(height);
+            BlockPos head = feet.above();
+            BlockPos floor = feet.below();
+            var support = level.getBlockState(floor);
+            if (support.is(Blocks.MAGMA_BLOCK) || !support.getFluidState().isEmpty()
+                    || !support.isFaceSturdy(level, floor, Direction.UP)) continue;
+            if (clearDryCell(level, feet) && clearDryCell(level, head)) return true;
+        }
+        return false;
+    }
+
+    private static boolean clearDryCell(ServerLevel level, BlockPos pos) {
+        var state = level.getBlockState(pos);
+        return state.getFluidState().isEmpty() && state.getCollisionShape(level, pos).isEmpty()
+                && !state.is(Blocks.FIRE) && !state.is(Blocks.SOUL_FIRE)
+                && !state.is(Blocks.POWDER_SNOW) && !state.is(Blocks.SWEET_BERRY_BUSH);
+    }
