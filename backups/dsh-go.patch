+class _WhaleHomePageState extends State<WhaleHomePage> {
+  static const _freshness = Duration(seconds: 30);
+
+  Timer? _expiry;
+  Timer? _journalExpiry;
+  Timer? _liveExpiry;
+  final _roomKey = GlobalKey();
+  bool _fresh = false;
+  bool _revisionFresh = false;
+  bool _liveFresh = false;
+  WhaleHomeAnchor? _inspected;
+
+  @override
+  void initState() {
+    super.initState();
+    _trackExpiry();
+    widget.live?.addListener(_liveChanged);
+    _trackLiveExpiry();
+  }
+
+  @override
+  void didUpdateWidget(covariant WhaleHomePage oldWidget) {
+    super.didUpdateWidget(oldWidget);
+    if (oldWidget.snapshot != widget.snapshot || oldWidget.connection != widget.connection) {
+      _trackExpiry();
+    }
+    if (oldWidget.live != widget.live) {
+      oldWidget.live?.removeListener(_liveChanged);
+      widget.live?.addListener(_liveChanged);
+      _trackLiveExpiry();
+    }
+  }
+
+  void _liveChanged() => setState(_trackLiveExpiry);
+
+  void _trackLiveExpiry() {
+    _liveExpiry?.cancel();
+    _liveFresh = false;
+    final signal = widget.live?.value;
+    if (signal == null) return;
+    final age = DateTime.now().difference(signal.receivedAt);
+    if (age.isNegative || age >= WhaleHomeSignal.freshness) return;
+    _liveFresh = true;
+    _liveExpiry = Timer(WhaleHomeSignal.freshness - age, () => setState(() => _liveFresh = false));
+  }
+
+  void _trackExpiry() {
+    _expiry?.cancel();
+    _journalExpiry?.cancel();
+    _fresh = false;
+    _revisionFresh = false;
+    final snapshot = widget.snapshot;
+    if (snapshot == null || widget.connection != WhaleStatusConnection.reachable) return;
+    final age = DateTime.now().difference(snapshot.syncedAt);
+    if (age.abs() >= _freshness) return;
+    _fresh = true;
+    final remaining = _freshness - age;
+    _expiry = Timer(remaining, () => setState(() => _fresh = false));
+    final home = snapshot.home;
+    final journal = home?.journal;
+    if (home != null && journal != null && journal.state == WhaleHomeJournalState.revised) {
+      // Compare the note to the host's clock, then age it locally since receipt.
+      final revisionRemaining =
+          WhaleHomeSnapshot.journalRevisionWindow -
+          home.observedAt.difference(journal.at) -
+          (age.isNegative ? Duration.zero : age);
+      if (revisionRemaining > Duration.zero) {
+        _revisionFresh = true;
+        if (revisionRemaining < remaining) {
+          _journalExpiry = Timer(revisionRemaining, () => setState(() => _revisionFresh = false));
+        }
+      }
+    }
+  }
+
+  @override
+  void dispose() {
+    _expiry?.cancel();
+    _journalExpiry?.cancel();
+    _liveExpiry?.cancel();
+    widget.live?.removeListener(_liveChanged);
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final l = context.l10n;
+    final theme = Theme.of(context);
+    final connection = widget.connection;
