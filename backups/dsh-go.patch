+    expect(items.map((item) => item.id), [11, 3, 2, 1]);
+    expect(items.map((item) => item.kind), [
+      WhaleActivityKind.speech,
+      WhaleActivityKind.point,
+      WhaleActivityKind.gather,
+      WhaleActivityKind.reply,
