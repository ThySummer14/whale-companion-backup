index 0000000000000000000000000000000000000000..c499ac7442d845e5acf176dc4228214790cc385b
--- /dev/null
+++ b/app/android/app/src/main/kotlin/io/github/ccch1mneyyy/dsh_app/companion/PcmStreamPlayer.kt
@@ -0,0 +1,229 @@
+package io.github.ccch1mneyyy.dsh_app.companion
+
+import android.content.Context
+import android.media.AudioAttributes
+import android.media.AudioFocusRequest
+import android.media.AudioFormat
+import android.media.AudioManager
+import android.media.AudioTrack
+import android.os.Build
+import android.os.Handler
+import android.os.SystemClock
+import java.nio.ByteBuffer
+
+/** One mono PCM stream, owned by the plugin's main looper. Writes never block that looper. */
+internal class PcmStreamPlayer private constructor(
+    context: Context,
+    private val main: Handler,
+    val id: String,
+    private val track: AudioTrack,
+    private val event: (String) -> Unit,
+) {
+    private class Write(val bytes: ByteBuffer, val complete: (Boolean) -> Unit)
+
+    private val audio = context.getSystemService(AudioManager::class.java)
+    private var focus: AudioFocusRequest? = null
+    private var pending: Write? = null
+    private var writtenFrames = 0L
+    private var playedFrames = 0L
+    private var lastProgress = 0L
+    private var running = false
+    private var started = false
+    private var paused = false
+    private var ended = false
+    private var closed = false
+    private var tailPadding: ByteBuffer? = null
+    private val poll = Runnable { pump() }
+
+    fun write(bytes: ByteArray, complete: (Boolean) -> Unit) {
+        if (closed || ended || pending != null || bytes.isEmpty() || bytes.size % 2 != 0 || bytes.size > MAX_WRITE_BYTES) {
+            complete(false)
+            return
+        }
+        pending = Write(ByteBuffer.wrap(bytes), complete)
+        lastProgress = SystemClock.elapsedRealtime()
+        pump()
+    }
+
+    fun end(): Boolean {
+        if (closed || ended || pending != null || writtenFrames == 0L) return false
+        ended = true
+        lastProgress = SystemClock.elapsedRealtime()
+        try {
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+                // A final short block must drain even when it never fills the start threshold.
+                track.setStartThresholdInFrames(1)
+            } else {
+                val queued = (writtenFrames - playbackHead()).coerceAtLeast(0)
+                val missing = track.bufferSizeInFrames.toLong() - queued
+                if (queued > 0 && missing > 0) tailPadding = ByteBuffer.allocate(missing.toInt() * 2)
+            }
+        } catch (_: RuntimeException) {
+            finish("error")
+            return false
+        }
+        pump()
+        return true
+    }
+
+    fun pause(): Boolean {
+        if (closed) return false
+        if (paused) return true
+        try {
+            if (running) track.pause()
+        } catch (_: RuntimeException) {
+            finish("error")
+            return false
+        }
+        paused = true
+        running = false
+        main.removeCallbacks(poll)
+        abandonFocus()
+        return true
+    }
+
+    fun resume(): Boolean {
+        if (closed) return false
+        paused = false
+        lastProgress = SystemClock.elapsedRealtime()
+        pump()
+        return !closed
+    }
+
+    fun release() {
+        if (closed) return
+        closed = true
+        main.removeCallbacks(poll)
+        val write = pending
+        pending = null
+        tailPadding = null
+        runCatching { track.pause() }
+        runCatching { track.flush() }
+        runCatching { track.release() }
+        abandonFocus()
+        write?.complete?.invoke(false)
+    }
+
+    private fun pump() {
+        main.removeCallbacks(poll)
+        if (closed || paused) return
+        try {
+            val position = playbackHead()
+            if (position > playedFrames) {
+                playedFrames = position
+                lastProgress = SystemClock.elapsedRealtime()
+            }
+            if (!started && position > 0) {
+                started = true
+                event("start")
+            }
+            if (ended && position >= writtenFrames) {
+                finish("done")
+                return
+            }
+
+            val write = pending
+            if (write != null) {
+                val bytes = writeAvailable(write.bytes)
+                writtenFrames += bytes / 2
+                if (!write.bytes.hasRemaining()) {
+                    pending = null
+                    write.complete(true)
+                }
+            }
+            tailPadding?.let { if (it.hasRemaining()) writeAvailable(it) }
+            if (!running && writtenFrames > playedFrames) {
+                if (!requestFocus()) {
+                    finish("stopped")
+                    return
+                }
+                track.play()
+                running = true
+                lastProgress = SystemClock.elapsedRealtime()
+            }
+        } catch (_: RuntimeException) {
+            finish("error")
+            return
+        }
+
+        // One pending platform call plus the AudioTrack buffer is the entire native queue.
+        if (pending != null || ended || !started && writtenFrames > 0) {
+            if (SystemClock.elapsedRealtime() - lastProgress >= STALL_MS) finish("error")
+            else main.postDelayed(poll, POLL_MS)
+        }
+    }
+
+    private fun playbackHead(): Long = track.playbackHeadPosition.toLong() and 0xffffffffL
+
+    private fun writeAvailable(bytes: ByteBuffer): Int {
+        val count = track.write(bytes, bytes.remaining(), AudioTrack.WRITE_NON_BLOCKING)
+        check(count >= 0 && count % 2 == 0)
+        if (count > 0) lastProgress = SystemClock.elapsedRealtime()
+        return count
+    }
+
+    private fun requestFocus(): Boolean {
+        val manager = audio ?: return true
+        lateinit var request: AudioFocusRequest
+        request = AudioFocusRequest.Builder(AudioManager.AUDIOFOCUS_GAIN_TRANSIENT_MAY_DUCK)
+            .setAudioAttributes(ATTRIBUTES)
+            .setWillPauseWhenDucked(true)
+            .setOnAudioFocusChangeListener({ change ->
+                if (focus === request && change < 0) finish("stopped")
+            }, main)
+            .build()
+        if (manager.requestAudioFocus(request) != AudioManager.AUDIOFOCUS_REQUEST_GRANTED) return false
+        focus = request
+        return true
+    }
+
+    private fun abandonFocus() {
+        val request = focus ?: return
+        focus = null
+        runCatching { audio?.abandonAudioFocusRequest(request) }
+    }
+
+    private fun finish(type: String) {
+        if (closed) return
+        release()
+        event(type)
+    }
+
+    companion object {
+        private const val MAX_WRITE_BYTES = 16_384
+        private const val POLL_MS = 10L
+        private const val STALL_MS = 5000L
+        private val ATTRIBUTES = AudioAttributes.Builder()
+            .setUsage(AudioAttributes.USAGE_MEDIA)
+            .setContentType(AudioAttributes.CONTENT_TYPE_SPEECH)
+            .build()
+
+        fun open(context: Context, main: Handler, id: String, sampleRate: Int, event: (String) -> Unit): PcmStreamPlayer? {
+            if (sampleRate !in 8000..48000) return null
+            val format = AudioFormat.Builder()
+                .setEncoding(AudioFormat.ENCODING_PCM_16BIT)
+                .setChannelMask(AudioFormat.CHANNEL_OUT_MONO)
+                .setSampleRate(sampleRate)
+                .build()
+            val minimum = AudioTrack.getMinBufferSize(sampleRate, AudioFormat.CHANNEL_OUT_MONO, AudioFormat.ENCODING_PCM_16BIT)
+            if (minimum <= 0) return null
+            var track: AudioTrack? = null
+            return try {
+                val bufferBytes = maxOf(minimum, 2 * (sampleRate * 80 / 1000))
+                val opened = AudioTrack.Builder()
+                    .setAudioFormat(format)
+                    .setAudioAttributes(ATTRIBUTES)
+                    .setBufferSizeInBytes(bufferBytes)
+                    .setTransferMode(AudioTrack.MODE_STREAM)
+                    .build()
+                track = opened
+                check(opened.state == AudioTrack.STATE_INITIALIZED)
+                if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) opened.setStartThresholdInFrames(sampleRate * 30 / 1000)
+                PcmStreamPlayer(context, main, id, opened, event)
+            } catch (_: RuntimeException) {
+                runCatching { track?.release() }
+                null
+            }
+        }
+    }
+}
