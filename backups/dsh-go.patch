+      server.listen((request) async {
+        expect(request.headers.value('authorization'), 'Device isolated-feed');
+        expect(request.uri.path, '/companion-device/api/feed/publish');
+        expect(request.method, 'POST');
+        received.add(jsonDecode(await utf8.decoder.bind(request).join()) as Json);
+        request.response.statusCode = received.length == 1 ? 201 : 200;
+        request.response.headers.contentType = ContentType.json;
+        request.response.write(
+          jsonEncode({
+            'id': 'test-post',
+            'author': 'user',
+            'body': 'Photo caption',
+            'parentId': parentId,
+            if (received.length < 3) 'mediaId': imageId,
+          }),
