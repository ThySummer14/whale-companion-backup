+            ? l.whaleChatAttachmentBadName
+            : used + file.size > byteLimit
+            ? l.whaleChatAttachmentBudget
+            : invalidSource
+            ? (singingSource == SingingSource.midi ? l.whaleSingingMidiRequired : l.whaleSingingWavRequired)
+            : attachmentProblem(file);
+        if (issue != null) {
