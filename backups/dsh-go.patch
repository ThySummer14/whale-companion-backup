+  final WhaleHomeActivity activity;
+  final DateTime observedAt;
+  final List<WhaleHomeReceipt> recent;
+  final WhaleHomeJournal? journal;
+
+  static WhaleHomeSnapshot? fromState(Object? value) {
+    if (value is! Map || value['version'] != 1) return null;
+    final activity = WhaleHomeActivity.values.asNameMap()[value['activity']];
+    final observedAt = _homeInstant(value['observedAt']);
+    if (activity == null || activity.anchor.name != value['anchor'] || observedAt == null) return null;
+
+    final receipts = <WhaleHomeReceipt>[];
+    final recent = value['recent'];
+    if (recent is List) {
+      for (final row in recent.whereType<Map>()) {
+        final kind = WhaleHomeEvent.byWireName[row['kind']];
+        final at = _homeInstant(row['at']);
+        if (kind != null && at != null) {
+          receipts.add((
+            kind: kind,
+            at: at,
+            video: kind == WhaleHomeEvent.video ? WhaleBilibiliReceipt.fromWire(row['video']) : null,
+          ));
+        }
+        if (receipts.length == 4) break;
+      }
+    }
+    return WhaleHomeSnapshot._(
+      activity,
+      observedAt,
+      List.unmodifiable(receipts),
+      _homeJournal(value['journal'], activity, observedAt),
+    );
+  }
+}
