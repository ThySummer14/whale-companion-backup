+                                const SizedBox(height: 12),
+                                if (widget.pending > 0) ...[
+                                  ListTile(
+                                    contentPadding: EdgeInsets.zero,
+                                    minVerticalPadding: 10,
+                                    leading: Container(
+                                      width: 58,
+                                      height: 46,
+                                      decoration: BoxDecoration(
+                                        color: whaleHomeAccent,
+                                        borderRadius: BorderRadius.circular(5),
+                                        border: Border.all(color: const Color(0xff7297d2)),
+                                      ),
+                                      child: const Icon(Icons.architecture_outlined, color: Colors.white, size: 29),
+                                    ),
+                                    title: Text(
+                                      l.whaleHomePendingBlueprints(widget.pending),
+                                      style: theme.textTheme.titleSmall?.copyWith(fontWeight: FontWeight.w600),
+                                    ),
+                                    trailing: const Icon(Icons.chevron_right, color: Color(0xff81858b)),
+                                    onTap: widget.onOpenApprovals,
+                                  ),
