+      addTearDown(() => directory.delete(recursive: true));
+      final file = File('${directory.path}/song.wav');
+
+      const rate = 48000;
+      const seconds = 180;
+      const pcmBytes = seconds * rate * 2;
+      const id = '5adeffbd-0ad4-4919-82c6-1a0b791db949';
+      const row = {
+        'id': id,
+        'title': 'Long score',
+        'createdAt': '2026-11-09T07:15:00Z',
+        'bytes': pcmBytes + 44,
+        'mimeType': 'audio/wav',
+        'durationSeconds': seconds,
+      };
+      final wav = Uint8List(44)
+        ..setAll(0, ascii.encode('RIFF'))
+        ..setAll(8, ascii.encode('WAVEfmt '))
+        ..setAll(36, ascii.encode('data'));
+      ByteData.sublistView(wav)
+        ..setUint32(4, pcmBytes + 36, Endian.little)
+        ..setUint32(16, 16, Endian.little)
+        ..setUint16(20, 1, Endian.little)
+        ..setUint16(22, 1, Endian.little)
+        ..setUint32(24, rate, Endian.little)
+        ..setUint32(28, rate * 2, Endian.little)
+        ..setUint16(32, 2, Endian.little)
+        ..setUint16(34, 16, Endian.little)
+        ..setUint32(40, pcmBytes, Endian.little);
+
+      final firstChunk = Completer<void>();
+      final sendTail = Completer<void>();
+      final chunk = Uint8List(64 * 1024)..setAll(0, [0, 4]);
+      server.listen((request) async {
+        expect(request.headers.value('authorization'), 'Device long-song-fixture');
+        expect(request.method, 'GET');
+        expect(request.uri.hasQuery, isFalse);
+        final response = request.response;
+        if (request.uri.path == '/companion-device/api/singing') {
+          response.headers.contentType = ContentType.json;
+          response.write(
+            jsonEncode({
+              'version': 1,
+              'items': [
+                row,
+                {...row, 'id': '5adeffbd-0ad4-4919-82c6-1a0b791db950', 'durationSeconds': 180.1},
+                {...row, 'id': '5adeffbd-0ad4-4919-82c6-1a0b791db951', 'bytes': 24 * 1024 * 1024 + 1},
+              ],
+            }),
+          );
+        } else {
+          expect(request.uri.path, '/companion-device/api/singing/$id/audio');
+          response.headers.contentType = ContentType('audio', 'wav');
+          response.bufferOutput = false;
+          response.add(wav);
+          response.add(chunk);
+          await response.flush();
+          firstChunk.complete();
+          await sendTail.future;
+          final fullChunks = pcmBytes ~/ chunk.length;
+          await response.addStream(Stream.fromIterable(Iterable.generate(fullChunks - 1, (_) => chunk)));
+          response.add(Uint8List.sublistView(chunk, 0, pcmBytes % chunk.length));
+        }
+        await response.close();
+      });
+
+      final abort = Completer<void>();
+      final items = (await host.songArchive(abort.future))!;
+      expect(items.map((item) => item.durationSeconds), [180.0, null]);
+      final item = items.first;
+      final download = host.saveSong(item, file, abort.future);
+      try {
+        await firstChunk.future.timeout(const Duration(seconds: 5));
+        final wait = Stopwatch()..start();
+        while (!await file.exists() || await file.length() < wav.length + chunk.length) {
+          if (wait.elapsed.inSeconds >= 5) fail('No partial WAV written before the response tail');
+          await Future<void>.delayed(const Duration(milliseconds: 10));
+        }
+        expect(await file.length(), wav.length + chunk.length);
+      } finally {
+        sendTail.complete();
+        await download.timeout(const Duration(seconds: 10));
+      }
+      expect(await file.length(), pcmBytes + wav.length);
+      final handle = await file.open();
+      try {
+        expect(await handle.read(wav.length), wav);
+        expect(await handle.read(2), [0, 4]);
+      } finally {
+        await handle.close();
+      }
+    }, _RealHttp()),
+  );
