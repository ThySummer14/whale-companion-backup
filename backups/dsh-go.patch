+
+class WhaleCampPage extends StatefulWidget {
+  const WhaleCampPage({required this.host, required this.revoked, required this.onRevoked, super.key});
+
+  final CompanionHost host;
+  final ValueListenable<bool> revoked;
+  final VoidCallback onRevoked;
+
+  @override
+  State<WhaleCampPage> createState() => _WhaleCampPageState();
+}
+
+enum _PauseFailure { declined, unknown }
+
+class _WhaleCampPageState extends State<WhaleCampPage> with WidgetsBindingObserver {
+  WhaleCampSnapshot? _snapshot;
+  Completer<void>? _request;
+  Timer? _poll;
+  Timer? _expiry;
+  bool _fresh = false;
+  bool _foreground = true;
+  bool _failed = false;
+  bool _unsupported = false;
+  _PauseFailure? _pauseFailure;
+  bool _pausing = false;
+
+  bool get _canPause {
+    final snapshot = _snapshot;
+    return _foreground &&
+        _fresh &&
+        !widget.revoked.value &&
+        snapshot != null &&
+        snapshot.pairedPauseEnabled &&
+        (snapshot.pausedAt == null || snapshot.stopStatus == WhaleCampStopStatus.unconfirmed);
+  }
+
+  @override
+  void initState() {
+    super.initState();
+    widget.revoked.addListener(_revocationChanged);
+    WidgetsBinding.instance.addObserver(this);
+    unawaited(_refresh());
+    _poll = Timer.periodic(const Duration(seconds: 8), (_) {
+      if (ModalRoute.of(context)?.isCurrent == true) unawaited(_refresh());
+    });
+  }
+
+  void _cancelRequest() {
+    final active = _request;
+    if (active != null && !active.isCompleted) active.complete();
+    _request = null;
+    _pausing = false;
+    _expiry?.cancel();
+  }
+
+  void _revocationChanged() {
+    if (!widget.revoked.value) return;
+    setState(() {
+      _cancelRequest();
+      _snapshot = null;
+      _fresh = false;
+    });
+  }
+
+  Future<void> _refresh() => _load(pause: false);
+
+  Future<void> _load({required bool pause}) async {
+    if (!_foreground || widget.revoked.value || _request != null || _unsupported || pause && !_canPause) return;
+    final request = Completer<void>();
+    setState(() {
+      _request = request;
+      _failed = false;
+      _pausing = pause;
+      if (pause) _pauseFailure = null;
+    });
+    try {
+      final snapshot = pause
+          ? await widget.host.pauseMinecraft(request.future)
+          : await widget.host.minecraftCamp(request.future);
+      if (!mounted || !identical(_request, request)) return;
+      setState(() {
+        _snapshot = snapshot;
+        _fresh = true;
+        _pauseFailure = null;
+      });
+      _expiry?.cancel();
+      _expiry = Timer(const Duration(seconds: 15), () => setState(() => _fresh = false));
+    } catch (error) {
+      if (!mounted || !identical(_request, request)) return;
+      if (error is HostError && error.status == 401) {
+        widget.onRevoked();
+        return;
+      }
+      setState(() {
+        _fresh = false;
+        _unsupported = !pause && error is HostError && error.status == 404;
+        _failed = !_unsupported;
+        if (pause) {
+          _pauseFailure = error is HostError && error.status == 403 ? _PauseFailure.declined : _PauseFailure.unknown;
+        }
+      });
+    } finally {
+      if (!request.isCompleted) request.complete();
+      if (mounted && identical(_request, request)) {
+        setState(() {
+          _request = null;
+          _pausing = false;
+        });
+      }
+    }
+  }
+
+  Future<void> _confirmPause() async {
+    if (!_canPause || _request != null) return;
+    final l = context.l10n;
+    final confirmed = await showDialog<bool>(
+      context: context,
+      builder: (context) => AlertDialog(
+        title: Text(l.whaleCampPause),
+        content: Text(l.whaleCampPauseConfirm),
+        actions: [
+          TextButton(onPressed: () => Navigator.pop(context), child: Text(l.whaleCancel)),
+          FilledButton(onPressed: () => Navigator.pop(context, true), child: Text(l.whaleCampPause)),
+        ],
+      ),
+    );
+    if (confirmed == true && mounted) await _load(pause: true);
+  }
+
+  @override
+  void didChangeAppLifecycleState(AppLifecycleState state) {
+    switch (state) {
+      case AppLifecycleState.resumed:
+        _foreground = true;
+        unawaited(_refresh());
+      case AppLifecycleState.hidden || AppLifecycleState.paused || AppLifecycleState.detached:
+        setState(() {
+          _foreground = false;
+          _fresh = false;
+          if (_pausing) _pauseFailure = _PauseFailure.unknown;
+          _cancelRequest();
+        });
+      case AppLifecycleState.inactive:
+        break;
+    }
+  }
+
+  @override
+  void dispose() {
+    _poll?.cancel();
+    _cancelRequest();
+    WidgetsBinding.instance.removeObserver(this);
+    widget.revoked.removeListener(_revocationChanged);
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final l = context.l10n;
+    final revoked = widget.revoked.value;
+    final snapshot = revoked ? null : _snapshot;
+    final action = snapshot?.action;
+    final connection = switch (snapshot?.connection) {
+      WhaleCampConnection.online => l.whaleCampOnline,
+      WhaleCampConnection.offline => l.whaleCampOffline,
+      WhaleCampConnection.unavailable => l.whaleCampWorkerUnavailable,
+      null => l.whaleStatusSyncing,
+    };
+    final result = switch (snapshot?.stopStatus) {
+      WhaleCampStopStatus.pending => l.whaleCampStopPending,
+      WhaleCampStopStatus.confirmed => l.whaleCampStopConfirmed,
+      WhaleCampStopStatus.offline => l.whaleCampStopOffline,
+      WhaleCampStopStatus.unconfirmed => l.whaleCampStopUnconfirmed,
+      null => null,
+    };
+    return Scaffold(
+      appBar: AppBar(
+        title: Text(l.whaleCommunityCamp),
+        actions: [
+          IconButton(
+            tooltip: l.whaleRefresh,
+            onPressed: revoked || _unsupported || _request != null ? null : () => unawaited(_refresh()),
+            icon: const Icon(Icons.refresh),
+          ),
+        ],
+      ),
+      body: RefreshIndicator(
+        onRefresh: _refresh,
+        child: ListView(
+          physics: const AlwaysScrollableScrollPhysics(),
+          padding: const EdgeInsets.all(16),
+          children: [
+            if (revoked)
+              Text(l.whaleRevoked)
+            else if (_unsupported)
+              Text(l.whaleCampUnavailable)
+            else ...[
+              Semantics(
+                liveRegion: true,
+                child: Text(switch ((snapshot, _fresh, _failed)) {
+                  (null, _, true) => l.whaleStatusUnreachable,
+                  (null, _, _) => l.whaleStatusSyncing,
+                  (_, false, _) => l.whaleCampLastKnown(connection),
+                  _ => connection,
+                }, style: Theme.of(context).textTheme.titleMedium),
+              ),
+              if (snapshot != null) ...[
+                if (_fresh && snapshot.connection == WhaleCampConnection.online)
+                  Text(l.whaleCampCurrentAction(action == null ? l.whaleCampNoAction : _actionLabel(l, action))),
+                Text(l.whaleStatusLastSync(formatCampTime(context, snapshot.observedAt))),
+                const SizedBox(height: 16),
+                if (snapshot.pausedAt case final pausedAt?) ...[
+                  Text(l.whaleCampHeld, style: Theme.of(context).textTheme.titleMedium),
+                  Text(l.whaleCampHeldSince(formatCampTime(context, pausedAt))),
+                  Text(l.whaleCampResumeOnHost),
+                  if (result != null) Text(result),
+                  if (snapshot.stopAt case final stopAt?)
+                    Text(l.whaleCampStopCheckedAt(formatCampTime(context, stopAt))),
+                ] else
+                  Text(snapshot.pairedPauseEnabled ? l.whaleCampPauseAvailable : l.whaleCampReadOnly),
+                const SizedBox(height: 12),
+                if (snapshot.pairedPauseEnabled &&
+                    (snapshot.pausedAt == null || snapshot.stopStatus == WhaleCampStopStatus.unconfirmed))
+                  FilledButton.icon(
+                    onPressed: _canPause && _request == null ? () => unawaited(_confirmPause()) : null,
+                    icon: const Icon(Icons.pause_circle_outline),
+                    label: Text(snapshot.pausedAt == null ? l.whaleCampPause : l.whaleCampRetryStop),
+                  ),
+              ],
+              if (_pausing) ...[const LinearProgressIndicator(), Text(l.whaleCampStopPending)],
+              if (_pauseFailure case final failure?)
+                Text(failure == _PauseFailure.declined ? l.whaleCampPauseDenied : l.whaleCampPauseUnknown),
+              if (snapshot?.patrol case final patrol?) ...[
+                const SizedBox(height: 16),
+                _CampVisitCard.patrol(l, patrol, fresh: _fresh),
+              ],
+              if (snapshot?.gather case final gather?) ...[
+                const SizedBox(height: 16),
+                _CampVisitCard.gather(l, gather, fresh: _fresh),
+              ],
+              if (snapshot?.campProject case final project?) ...[
+                const SizedBox(height: 16),
+                WhaleCampProjectCard(project: project, fresh: _fresh),
+              ],
+            ],
+          ],
+        ),
+      ),
+    );
+  }
+}
+
