+  locale: const Locale('en'),
+  localizationsDelegates: L10n.localizationsDelegates,
+  supportedLocales: AppLocale.supported,
+  home: home,
+);
+
+void main() {
+  test('only allows confirmed role actions and skips deleted, private and repeated records', () {
+    final items = WhaleActivity.fromRecords([
+      _replyEvent,
+      _gameEvent,
+      _stageEvent,
+      _gameEvent,
+      _event(4, 'core.feed', 'post.created', data: {'postId': _removed, 'author': 'companion'}),
+      _event(5, 'core.feed', 'post.deleted', data: {'postId': _removed, 'author': 'companion'}),
+      _event(6, 'core.feed', 'post.created', data: {'postId': _post, 'author': 'user'}),
