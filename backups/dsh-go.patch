+class _ApprovalHost extends CompanionHost {
+  _ApprovalHost() : super(Uri.parse('https://example.invalid'), 'fixture');
+
+  final calls = <({String id, String zone, int revision, String? preview})>[];
+  String? previewFailure;
+
+  @override
+  Future<Json> houseApproval(String id, String zoneId, int revision, {String? previewId}) async {
+    calls.add((id: id, zone: zoneId, revision: revision, preview: previewId));
+    if (previewFailure case final String reason when previewId == null) {
+      return {'ready': false, 'checked': 0, 'reason': reason};
+    }
+    return previewId == null ? {'ready': true, 'previewId': 'reviewed'} : {'id': id, 'status': 'built'};
+  }
+}
