diff --git a/app/test/whale/dictation_test.dart b/app/test/whale/dictation_test.dart
new file mode 100644
index 0000000000000000000000000000000000000000..a5aa860e5049c99510c27673dbf3a90fe33982b6
--- /dev/null
+++ b/app/test/whale/dictation_test.dart
@@ -0,0 +1,211 @@
+import 'dart:async';
+import 'dart:typed_data';
+
+import 'package:dsh_app/ui/chat/voice/voice_bridge.dart';
+import 'package:dsh_app/whale/dictation.dart';
+import 'package:dsh_app/whale/host.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+class _Recorder implements VoiceBridge {
+  final eventQueue = StreamController<VoiceEvent>.broadcast();
+  Future<VoicePermission>? permission;
+  var permissionRequests = 0;
+  var starts = <int>[];
+  var stops = 0;
+  var automaticStops = 0;
+  bool silent = false;
+  var cancels = 0;
+  var settings = 0;
+
+  @override
+  Stream<VoiceEvent> get events => eventQueue.stream;
+
+  @override
+  Future<VoiceCapabilities> capabilities() async => const VoiceCapabilities(recognizer: false, recorder: true);
+
+  @override
+  Future<VoicePermission> requestPermission() async {
+    permissionRequests++;
+    return permission ?? Future.value(VoicePermission.granted);
+  }
+
+  @override
+  Future<void> openSettings() async => settings++;
+
+  @override
+  Future<void> startRecognizer({String? language}) async => fail('Whale dictation only records for its paired host');
+
+  @override
+  Future<void> startRecorder({required int maxSeconds}) async => starts.add(maxSeconds);
+
+  @override
+  Future<Uint8List?> stop({bool automatic = false}) async {
+    stops++;
+    if (automatic) automaticStops++;
+    if (automatic && silent) return null;
+    return Uint8List(46);
+  }
+
+  @override
+  Future<void> cancel() async => cancels++;
+}
+
+class _Host extends CompanionHost {
+  _Host() : super(Uri.parse('https://example.test'), '');
+
+  bool available = true;
+  final entered = Completer<void>();
+  final transcript = Completer<String>();
+  Future<void>? abort;
+  var calls = 0;
+
+  @override
+  Future<TranscriptionCapabilities> transcriptionCapabilities() async => (available: available, voiceReplyReady: false);
+
+  @override
+  Future<String> transcribeVoice(Uint8List wav, Future<void> abort) {
+    calls++;
+    expect(wav.length, 46);
+    this.abort = abort;
+    entered.complete();
+    return transcript.future;
+  }
+}
+
+void main() {
+  late WhaleDictation dictation;
+  late _Recorder recorder;
+  late _Host host;
+  late List<String> draft;
+  late List<HostError> revoked;
+
+  setUp(() {
+    recorder = _Recorder();
+    host = _Host();
+    draft = [];
+    revoked = [];
+    dictation = WhaleDictation(
+      host,
+      bridge: recorder,
+      onDraft: (text) {
+        draft.add(text);
+        return true;
+      },
+      onRevoked: revoked.add,
+    );
+  });
+
+  tearDown(() async {
+    dictation.dispose();
+    host.close();
+    await recorder.eventQueue.close();
+  });
+
+  test('an unsupported host does not prompt for microphone access', () async {
+    host.available = false;
+    await dictation.refreshAccess();
+    await dictation.start();
+    expect(dictation.access, DictationAccess.unavailable);
+    expect(dictation.active, isFalse);
+    expect(recorder.permissionRequests, 0);
+    expect(host.calls, 0);
+  });
+
+  test('denied and blocked permission are distinct and never open a recorder', () async {
+    await dictation.refreshAccess();
+    recorder.permission = Future.value(VoicePermission.denied);
+    await dictation.start();
+    expect(dictation.notice, DictationNotice.denied);
+    recorder.permission = Future.value(VoicePermission.blocked);
+    await dictation.start();
+    expect(dictation.notice, DictationNotice.blocked);
+    await dictation.openSettings();
+    expect(recorder.settings, 1);
+    expect(recorder.starts, isEmpty);
+  });
+
+  test('the 15-second recorder submits one WAV and yields an editable draft on completion', () async {
+    await dictation.refreshAccess();
+    await dictation.start();
+    expect(recorder.starts, [15]);
+    expect(dictation.phase, DictationPhase.recording);
+    expect(host.calls, 0);
+    recorder.eventQueue.add(const VoiceLimit());
+    await host.entered.future;
+    expect(dictation.phase, DictationPhase.transcribing);
+    expect(host.lastVoiceTranscriptionMs, isNull);
+    await dictation.stop();
+    expect(draft, isEmpty);
+    host.transcript.complete('晚上好。');
+    await Future<void>.delayed(Duration.zero);
+    expect(recorder.stops, 1);
+    expect(recorder.automaticStops, 1);
+    expect(host.calls, 1);
+    expect(draft, ['晚上好。']);
+    expect(host.lastVoiceTranscriptionMs, greaterThanOrEqualTo(0));
+    expect(dictation.notice, DictationNotice.ready);
+  });
+
+  test('cancelled permission and recording cannot submit audio', () async {
+    await dictation.refreshAccess();
+    final permission = Completer<VoicePermission>();
+    recorder.permission = permission.future;
+    final starting = dictation.start();
+    expect(dictation.phase, DictationPhase.permission);
+    await dictation.cancel();
+    permission.complete(VoicePermission.granted);
+    await starting;
+    expect(recorder.starts, isEmpty);
+    await dictation.start();
+    await dictation.cancel();
+    await dictation.stop();
+    expect(recorder.cancels, 1);
+    expect(recorder.stops, 0);
+    expect(host.calls, 0);
+  });
+
+  test('cancelling a pending upload aborts HTTP and rejects its late transcript', () async {
+    await dictation.refreshAccess();
+    await dictation.start();
+    final stopping = dictation.stop();
+    await host.entered.future;
+    await dictation.cancel();
+    await host.abort;
+    host.transcript.complete('不该写入草稿');
+    await stopping;
+    expect(dictation.phase, DictationPhase.idle);
+    expect(draft, isEmpty);
+    expect(host.lastVoiceTranscriptionMs, isNull);
+  });
+
+  test('a platform end retires the recorder without uploading', () async {
+    await dictation.refreshAccess();
+    await dictation.start();
+    recorder.eventQueue.add(const VoiceEnd());
+    await Future<void>.delayed(Duration.zero);
+    expect(dictation.phase, DictationPhase.idle);
+    expect(host.calls, 0);
+  });
+
+  test('the native no-speech result from an automatic stop skips the upload', () async {
+    await dictation.refreshAccess();
+    await dictation.start();
+    recorder.silent = true;
+    recorder.eventQueue.add(const VoiceLimit());
+    await Future<void>.delayed(Duration.zero);
+    expect(recorder.automaticStops, 1);
+    expect(host.calls, 0);
+    expect(dictation.notice, DictationNotice.noSpeech);
+  });
+
+  test('an ASR 401 revokes the device without filling a draft', () async {
+    await dictation.refreshAccess();
+    await dictation.start();
+    final stopping = dictation.stop();
+    await host.entered.future;
+    host.transcript.completeError(const HostError(401, 'device-revoked'));
+    await stopping;
+    expect(revoked.single.status, 401);
+    expect(draft, isEmpty);
+  });
+}
