+class _WhaleFeedThreadState extends State<WhaleFeedThread> {
+  late Future<Json> _thread = _load();
+
+  Future<Json> _load() async {
+    final result = await widget.host.thread(widget.threadId);
+    if (result['id'] != widget.threadId || result['replies'] is! List) {
+      throw const FormatException('Invalid feed thread');
+    }
+    return result;
+  }
