+  Future<ChatAttachmentLimits?> chatAttachmentLimits() async => attachmentLimits;
+  @override
+  Future<Json> sendAttachments(
+    String text,
+    List<ChatAttachmentUpload> files, {
+    required String requestId,
+    String? expectedSessionId,
+    bool voiceReply = false,
+  }) async {
+    attachmentSends.add((text, files, requestId));
+    if (failAttachmentSend) throw const HostError(0, 'offline');
+    return {
+      'accepted': true,
+      'messageId': 'files',
+      'sessionId': 'session',
+      'attachments': [
+        for (final file in files)
+          {'id': file.name, 'name': file.name, 'bytes': file.bytes.length, 'mimeType': 'application/octet-stream'},
+      ],
+    };
+  }
+
+  @override
+  Future<Uint8List> chatAttachment(String messageId, ChatAttachment attachment, Future<void> abort) {
+    expect(messageId, 'files');
+    expect(attachment.name, 'note.txt');
+    downloadAbort = abort;
+    return download!.future;
+  }
+
+  @override
+  Future<String> transcribeVoice(Uint8List wav, Future<void> abort) async {
+    uploadAbort = abort;
+    if (transcription case final pending?) return pending.future;
+    return '去樱花林看看';
+  }
+
+  @override
+  Future<Json> send(String text, {bool voiceReply = false}) async {
+    sends.add((text, voiceReply));
+    return {'accepted': true, 'messageId': 'user', 'sessionId': 'session'};
+  }
+
+  @override
+  Future<Json> sendDraft(
+    String text,
+    List<ChatAttachmentUpload> files, {
+    required String requestId,
+    required String expectedSessionId,
+    bool voiceReply = false,
+  }) async {
+    draftSends.add((text, requestId, expectedSessionId, voiceReply));
+    if (draftSendError case final error?) throw error;
+    if (expectedSessionId != currentSession) throw const HostError(409, 'chat-session-changed');
+    return {
+      'accepted': true,
+      'messageId': 'user',
+      'sessionId': currentSession,
+      if (replayDraftReceipt) 'replayed': true,
+    };
+  }
+
+  @override
+  Future<VoiceStream> openVoiceStream(String messageId, Future<void> abort, {void Function()? onFirstByte}) async {
+    final chunks = Stream<Uint8List>.value(Uint8List(1920)).map((block) {
+      onFirstByte?.call();
+      return block;
+    });
+    return (sampleRate: 24000, chunks: chunks, source: VoiceStreamSource.full, playbackId: null);
+  }
+}
