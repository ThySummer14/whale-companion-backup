@@ -0,0 +1,310 @@
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:dsh_app/l10n/l10n.dart';
+import 'package:dsh_app/whale/avatar_viewer.dart';
+import 'package:dsh_app/whale/home.dart';
+import 'package:dsh_app/whale/host.dart';
+import 'package:dsh_app/whale/status.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+final _ticket = List.filled(43, 'a').join();
+const _deviceAuth = 'Device isolated-avatar';
+
+class _RealHttp extends HttpOverrides {}
+
+class _ViewerHost extends CompanionHost {
+  _ViewerHost() : super(Uri.parse('https://viewer.test'), _deviceAuth);
+
+  final requests = <Completer<WhaleAvatarLaunch>>[];
+  final canceled = <int>[];
+
+  @override
+  Future<WhaleAvatarLaunch> openAvatarViewer(Future<void> abort) {
+    final index = requests.length;
+    unawaited(abort.then((_) => canceled.add(index)));
+    final result = Completer<WhaleAvatarLaunch>();
+    requests.add(result);
+    return result.future;
+  }
+}
+
+Future<T> _pairedFixture<T>(Future<T> Function(CompanionHost) run, Future<void> Function(HttpRequest) respond) =>
+    HttpOverrides.runWithHttpOverrides(() async {
+      final server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
+      final host = CompanionHost(Uri.parse('http://127.0.0.1:${server.port}'), _deviceAuth);
+      server.listen(respond);
+      try {
+        return await run(host);
+      } finally {
+        host.close();
+        await server.close(force: true);
+      }
+    }, _RealHttp());
+
+Future<void> _success(HttpRequest request) async {
+  request.response.statusCode = 201;
+  request.response.headers.contentType = ContentType.json;
+  request.response.write(jsonEncode({'ticket': _ticket, 'url': 'https://untrusted.test/'}));
+  await request.response.close();
+}
+
+Widget _shell(Widget body) => MaterialApp(
+  locale: const Locale('en'),
+  localizationsDelegates: L10n.localizationsDelegates,
+  supportedLocales: AppLocale.supported,
+  home: body,
+);
+
+Future<ValueNotifier<bool>> _openPage(
+  WidgetTester tester,
+  _ViewerHost host,
+  List<VoidCallback> ready,
+  List<ValueChanged<WhaleAvatarViewerIssue>> issue,
+) async {
+  tester.binding.handleAppLifecycleStateChanged(AppLifecycleState.resumed);
+  final revoked = ValueNotifier(false);
+  addTearDown(revoked.dispose);
+  addTearDown(host.close);
+  await tester.pumpWidget(
+    _shell(
+      WhaleAvatarViewerPage(
+        host: host,
+        revoked: revoked,
+        onRevoked: () => revoked.value = true,
+        viewerBuilder: (launch, closed, onReady, onIssue) {
+          ready.add(onReady);
+          issue.add(onIssue);
+          return const Center(child: Text('Fixture canvas'));
+        },
+      ),
+    ),
+  );
+  return revoked;
+}
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+
+  test('uses the authenticated paired route for a bodyless POST and hands the WebView only a scoped ticket', () async {
+    final abort = Completer<void>();
+    await _pairedFixture(
+      (host) async {
+        final launch = await host.openAvatarViewer(abort.future);
+        final route = '${host.origin.origin}/companion-device/avatar/';
+        expect(launch.uri.toString(), route);
+        expect(launch.headers, {'Authorization': 'AvatarView $_ticket'});
+        expect(launch.toString(), isNot(contains(_ticket)));
+        expect(launch.allowsNavigation(route), isTrue);
+        for (final address in [
+          '$route?ticket=$_ticket',
+          '$route#',
+          '${host.origin.origin}/companion-device/avatar/../api/state',
+          '${host.origin.origin}/companion-device/avatar/state',
+          route.replaceFirst('127.0.0.1', '127.0.0.2'),
+          route.replaceFirst('http:', 'https:'),
+          'https://untrusted.test/companion-device/avatar/',
+          'file:///companion-device/avatar/',
+        ]) {
+          expect(launch.allowsNavigation(address), isFalse);
+        }
+      },
+      (request) async {
+        expect(request.method, 'POST');
+        expect(request.uri.toString(), '/companion-device/api/avatar/viewer');
+        expect(request.headers.value(HttpHeaders.authorizationHeader), _deviceAuth);
+        expect(await utf8.decoder.bind(request).join(), isEmpty);
+        await _success(request);
+      },
+    );
+  });
+
+  test('rejects redirects and malformed or unexpected ticket responses without leaking input', () async {
+    final replies = <(int, String)>[
+      (307, '{}'),
+      (200, jsonEncode({'ticket': _ticket})),
+      (201, jsonEncode({'ticket': '$_ticket\n'})),
+      (201, '{"ticket":"$_ticket"'),
+      (404, '{"error":"avatar-viewer-unavailable"}'),
+    ];
+    await _pairedFixture(
+      (host) async {
+        for (final (status, code) in [
+          (307, 'http-error'),
+          (0, 'invalid-avatar-viewer'),
+          (0, 'invalid-avatar-viewer'),
+          (0, 'invalid-avatar-viewer'),
+          (404, 'avatar-viewer-unavailable'),
+        ]) {
+          await expectLater(
+            host.openAvatarViewer(Completer<void>().future),
+            throwsA(
+              isA<HostError>()
+                  .having((error) => error.status, 'status', status)
+                  .having((error) => error.code, 'code', code),
+            ),
+          );
+        }
+        expect(replies, isEmpty);
+      },
+      (request) async {
+        expect(request.uri.path, '/companion-device/api/avatar/viewer');
+        final (status, body) = replies.removeAt(0);
+        request.response.statusCode = status;
+        request.response.headers.set(HttpHeaders.locationHeader, '/would-leak-if-followed');
+        request.response.write(body);
+        await request.response.close();
+      },
+    );
+  });
+
+  late WhaleAvatarLaunch launch;
+  setUpAll(() async {
+    launch = await _pairedFixture((host) => host.openAvatarViewer(Completer<void>().future), _success);
+  });
+
+  testWidgets('shows loading until verified frames and lets an expired view reopen without revoking the device', (
+    tester,
+  ) async {
+    final host = _ViewerHost();
+    final ready = <VoidCallback>[];
+    final issues = <ValueChanged<WhaleAvatarViewerIssue>>[];
+    final revoked = await _openPage(tester, host, ready, issues);
+    expect(find.text('Connecting to the private Live2D stage…'), findsOneWidget);
+    host.requests.single.complete(launch);
+    await tester.pump();
+    expect(find.text('Connecting to the private Live2D stage…'), findsOneWidget);
+    ready.last();
+    await tester.pumpAndSettle();
+    expect(find.text('Connecting to the private Live2D stage…'), findsNothing);
+    expect(find.text('Fixture canvas'), findsOneWidget);
+    issues.last(WhaleAvatarViewerIssue.expired);
+    await tester.pumpAndSettle();
+    expect(find.text('Fixture canvas'), findsNothing);
+    expect(find.text('This viewing session has expired. Reconnect to see the stage.'), findsOneWidget);
+    expect(revoked.value, isFalse);
+    await tester.tap(find.text('Reconnect stage'));
+    expect(host.requests.length, 2);
+  });
+
+  testWidgets('closing the foreground request cancels it and returning reopens the stage', (tester) async {
+    final host = _ViewerHost();
+    final ready = <VoidCallback>[];
+    final issues = <ValueChanged<WhaleAvatarViewerIssue>>[];
+    await _openPage(tester, host, ready, issues);
+    tester.binding.handleAppLifecycleStateChanged(AppLifecycleState.hidden);
+    tester.binding.scheduleForcedFrame();
+    await tester.pumpAndSettle();
+    expect(host.canceled, [0]);
+    expect(find.text('Stage paused while the app is in the background.'), findsOneWidget);
+    host.requests.first.complete(launch);
+    await tester.pump();
+    expect(find.text('Fixture canvas'), findsNothing);
+    tester.binding.handleAppLifecycleStateChanged(AppLifecycleState.resumed);
+    await tester.pump();
+    expect(host.requests.length, 2);
+    host.requests.last.complete(launch);
+    await tester.pump();
+    ready.last();
+    await tester.pumpAndSettle();
+    expect(find.text('Fixture canvas'), findsOneWidget);
+    tester.binding.handleAppLifecycleStateChanged(AppLifecycleState.hidden);
+    tester.binding.scheduleForcedFrame();
+    await tester.pumpAndSettle();
+    expect(host.canceled, [0, 1]);
+    expect(find.text('Fixture canvas'), findsNothing);
+    tester.binding.handleAppLifecycleStateChanged(AppLifecycleState.resumed);
+    await tester.pump();
+    expect(host.requests.length, 3);
+  });
+
+  testWidgets('clears active private frames on revocation and ignores late bridge messages', (tester) async {
+    final host = _ViewerHost();
+    final ready = <VoidCallback>[];
+    final issues = <ValueChanged<WhaleAvatarViewerIssue>>[];
+    final revoked = await _openPage(tester, host, ready, issues);
+    host.requests.single.complete(launch);
+    await tester.pump();
+    ready.last();
+    await tester.pumpAndSettle();
+    revoked.value = true;
+    ready.last();
+    issues.last(WhaleAvatarViewerIssue.expired);
+    await tester.pumpAndSettle();
+    expect(find.text('Fixture canvas'), findsNothing);
+    expect(find.text('This device was revoked. Forget this Mac and pair again.'), findsOneWidget);
+    expect(find.text('Reconnect stage'), findsNothing);
+  });
+
+  testWidgets('maps a missing endpoint to a retry and an authenticated 401 to pairing revocation', (tester) async {
+    final host = _ViewerHost();
+    final revoked = await _openPage(tester, host, [], []);
+    host.requests.single.completeError(const HostError(404, 'avatar-viewer-unavailable'));
+    await tester.pumpAndSettle();
+    expect(find.text('The Live2D stage is currently unavailable on this device.'), findsOneWidget);
+    await tester.tap(find.text('Reconnect stage'));
+    host.requests.last.completeError(const HostError(401, 'device-unauthorized'));
+    await tester.pumpAndSettle();
+    expect(revoked.value, isTrue);
+    expect(find.text('Reconnect stage'), findsNothing);
+  });
+
+  testWidgets('status and home offer the stage only to a reachable versioned Host', (tester) async {
+    var opened = 0;
+    final now = DateTime.now();
+    final legacy = WhaleStatusSnapshot.fromState({}, now);
+    final unknown = WhaleStatusSnapshot.fromState({
+      'avatarViewer': {'version': 2},
+    }, now);
+    final current = WhaleStatusSnapshot.fromState({
+      'avatarViewer': {'version': 1},
+    }, now);
+    Future<void> show(WhaleStatusSnapshot state, WhaleStatusConnection connection) async {
+      await tester.pumpWidget(
+        _shell(
+          Scaffold(
+            body: WhaleStatusPage(
+              snapshot: state,
+              connection: connection,
+              refreshing: false,
+              onRefresh: () async {},
+              onOpenAvatar: () => opened++,
+            ),
+          ),
+        ),
+      );
+      await tester.pumpAndSettle();
+    }
+
+    await show(legacy, WhaleStatusConnection.reachable);
+    expect(find.text('Live2D stage'), findsNothing);
+    await show(unknown, WhaleStatusConnection.reachable);
+    expect(find.text('Live2D stage'), findsNothing);
+    await show(current, WhaleStatusConnection.unreachable);
+    expect(find.text('Live2D stage'), findsNothing);
+    await show(current, WhaleStatusConnection.reachable);
+    await tester.tap(find.text('Live2D stage'));
+    expect(opened, 1);
+    await tester.pumpWidget(
+      _shell(
+        Scaffold(
+          body: WhaleHomePage(
+            snapshot: current,
+            connection: WhaleStatusConnection.reachable,
+            refreshing: false,
+            onRefresh: () async {},
+            onOpenAvatar: () => opened++,
+          ),
+        ),
+      ),
+    );
+    await tester.pumpAndSettle();
+    await tester.tap(find.byTooltip('Small stage'));
+    await tester.pumpAndSettle();
+    await tester.ensureVisible(find.text('Live2D stage'));
+    await tester.tap(find.text('Live2D stage'));
+    expect(opened, 2);
+  });
+}
