@@ -0,0 +1,103 @@
+import 'package:dsh_app/whale/bilibili_state.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  const bvid = 'BV1dLx46TEhw';
+  const full = 'https://www.bilibili.com/video/$bvid/';
+
+  test('capability version and duration fail closed, with a bounded forward limit', () {
+    BilibiliConversation? parse(Map value) => BilibiliConversation.fromState({'bilibiliConversation': value});
+    const valid = {'version': 1, 'contextId': bilibiliContext, 'maxClipSeconds': 8};
+    expect(parse(valid)?.maxClipSeconds, 8);
+    expect(parse({...valid, 'maxClipSeconds': 60})?.maxClipSeconds, 12);
+    for (final invalid in [
+      {'version': 2},
+      {'version': 1.0},
+      {'contextId': 'chat.mobile'},
+      {'maxClipSeconds': 0},
+      {'maxClipSeconds': 7.5},
+      {'maxClipSeconds': '12'},
+      {'maxClipSeconds': null},
+    ]) {
+      expect(parse({...valid, ...invalid}), isNull, reason: '$invalid');
+    }
+    expect(BilibiliConversation.fromState({}), isNull);
+  });
+
+  test('link parameters produce a canonical clip command for each modality', () {
+    final source = WhaleBilibiliSource.fromInput(' $full?p=3&t=71&from=tracking ')!;
+    expect(source.time, '1:11');
+    expect(source.uri.toString(), '${full}?p=3&t=71');
+    expect(whaleBilibiliClipDraft(source, 71, 6, WhaleBilibiliMode.both), '看这段 ${full}?p=3 71 6秒 画面和声音');
+    expect(whaleBilibiliClipDraft(source, 10, 3, WhaleBilibiliMode.audio), '看这段 ${full}?p=3 10 3秒 声音');
+    expect(
+      whaleBilibiliClipDraft(WhaleBilibiliSource.fromInput(bvid)!, 0, 1, WhaleBilibiliMode.visual),
+      '看这段 $bvid 0 1秒 画面',
+    );
+  });
+
+  for (final bad in [
+    'https://b23.tv/short',
+    'http://www.bilibili.com/video/$bvid/',
+    'https://www.bilibili.com.evil.test/video/$bvid/',
+    'https://www.bilibili.com@evil.test/video/$bvid/',
+    '${full}extra',
+    '${full}?p=1&p=2',
+    '${full}?p=0',
+    '${full}?p=1001',
+    '${full}?t=5&t=6',
+    '${full}?t=-1',
+    '${full}?t=604801',
+    '$full\\evil',
+    '$full\nother text',
+    '${full}?p=%FF',
+  ]) {
+    test('rejects unsafe or ambiguous target $bad', () => expect(WhaleBilibiliSource.fromInput(bad), isNull));
+  }
+
+  test('start time matches supported seconds, minute and hour forms', () {
+    expect(parseWhaleBilibiliStart(' 0 '), 0);
+    expect(parseWhaleBilibiliStart('00:12'), 12);
+    expect(parseWhaleBilibiliStart('1:04:09'), 3849);
+    expect(parseWhaleBilibiliStart('604800'), 604800);
+    for (final bad in ['-1', '604801', '00:60', '00:1', '1:00:60', '1.5', '']) {
+      expect(parseWhaleBilibiliStart(bad), isNull);
+    }
+  });
+
+  test('receipt links are reconstructed and incomplete or private materials cannot open a source', () {
+    const source = {'bvid': bvid, 'part': 3, 'startSeconds': 12, 'seconds': 6, 'visual': true, 'audio': false};
+    final visual = WhaleBilibiliReceipt.fromWire({'mode': 'clip', 'source': source})!;
+    expect(visual.source?.uri.toString(), '${full}?p=3&t=12');
+    expect(visual.material, WhaleBilibiliMode.visual);
+    expect(visual.seconds, 6);
+    final audio = WhaleBilibiliReceipt.fromWire({
+      'mode': 'clip',
+      'source': {...source, 'visual': false, 'audio': true},
+    });
+    expect(audio?.material, WhaleBilibiliMode.audio);
+    final subtitle = WhaleBilibiliReceipt.fromWire({
+      'mode': 'subtitle',
+      'source': {'bvid': bvid, 'part': 3},
+    });
+    expect(subtitle?.source?.uri.toString(), '${full}?p=3');
+    expect(WhaleBilibiliReceipt.fromWire({'mode': 'clip'})?.source, isNull);
+    for (final changes in [
+      {'bvid': 'https://example.test'},
+      {'startSeconds': null},
+      {'seconds': 13},
+      {'visual': false, 'audio': false},
+      {'part': '3'},
+      {'audio': 'false'},
+    ]) {
+      expect(
+        WhaleBilibiliReceipt.fromWire({
+          'mode': 'clip',
+          'source': {...source, ...changes},
+        })?.source,
+        isNull,
+      );
+    }
+    expect(WhaleBilibiliReceipt.fromWire({'mode': 'future', 'source': source}), isNull);
+  });
+}
diff --git a/app/test/whale/camp_project_state_test.dart b/app/test/whale/camp_project_state_test.dart
new file mode 100644
index 00000000..12d5d1c9
--- /dev/null
+++ b/app/test/whale/camp_project_state_test.dart
@@ -0,0 +1,173 @@
+import 'package:dsh_app/whale/camp_project_state.dart';
+import 'package:dsh_app/whale/camp_state.dart';
+import 'package:dsh_app/whale/home_state.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+const _builtAt = '2026-11-09T20:02:30.000Z';
+const _revisitedAt = '2026-11-10T10:03:20.000+08:00';
+
+Map<String, Object?> _project(String stage, [Map<String, Object?> extra = const {}]) => {
+  'stage': stage,
+  'supplyVisits': 2,
+  'availability': 'active',
+  ...extra,
+};
+
+const _camp = {
+  'version': 1,
+  'connection': 'online',
+  'observedAt': _revisitedAt,
+  'control': {'pairedPauseEnabled': true, 'stopStatus': 'confirmed', 'stopAt': _revisitedAt},
+};
+
+const _community = {
+  'version': 1,
+  'activeSite': 'camp',
+  'recentCamp': [
+    {'kind': 'supply', 'at': _builtAt},
+    {
+      'kind': 'survey',
+      'at': _revisitedAt,
+      'outcome': 'completed',
+      'route': {'kind': 'straight', 'direction': 'north', 'steps': 4},
+    },
+  ],
+};
+
+void main() {
+  test('both mobile projections expose the same optional camp project model', () {
+    final wire = _project('complete', {
+      'builtAt': _builtAt,
+      'revisitedAt': _revisitedAt,
+      'availability': 'paused',
+      'gatheredLogs': 4,
+    });
+    final status = WhaleCampSnapshot.fromJson({..._camp, 'action': 'revisit', 'project': wire});
+    final community = WhaleCommunitySnapshot.fromState({..._community, 'campProject': wire});
+    expect(status.action, WhaleCampAction.revisit);
+    for (final project in [status.campProject!, community!.campProject!]) {
+      expect(project.stage, WhaleCampProjectStage.complete);
+      expect(project.availability, WhaleCampProjectAvailability.paused);
+      expect(project.supplyVisits, 2);
+      expect(project.gatheredLogs, 4);
+      expect(project.builtAt, DateTime.utc(2026, 11, 9, 20, 2, 30));
+      expect(project.revisitedAt, DateTime.utc(2026, 11, 10, 2, 3, 20));
+    }
+  });
+
+  test('the optional log count includes zero and ignores malformed values without hiding progress', () {
+    expect(WhaleCampProject.fromJson(_project('gathering'))?.gatheredLogs, isNull);
+    for (final count in [0, 7]) {
+      final project = WhaleCampProject.fromJson(_project('gathering', {'gatheredLogs': count}))!;
+      expect(project.gatheredLogs, count);
+      expect(project.supplyVisits, 2);
+    }
+    for (final invalid in [null, -1, 8, 2.0, '2', true, []]) {
+      final project = WhaleCampProject.fromJson(
+        _project('complete', {'builtAt': _builtAt, 'revisitedAt': _revisitedAt, 'gatheredLogs': invalid}),
+      )!;
+      expect(project.gatheredLogs, isNull, reason: '$invalid');
+      expect(project.supplyVisits, 2);
+      expect(project.stage, WhaleCampProjectStage.complete);
+      expect(project.revisitedAt, DateTime.parse(_revisitedAt));
+    }
+  });
+
+  test('empty, built, and owner-review proof branches preserve their exact timestamps', () {
+    final gathering = WhaleCampProject.fromJson(_project('gathering', {'supplyVisits': 0}))!;
+    expect(gathering.stage, WhaleCampProjectStage.gathering);
+    expect(gathering.availability, WhaleCampProjectAvailability.active);
+    expect(gathering.supplyVisits, 0);
+    expect(gathering.builtAt, isNull);
+    expect(gathering.revisitedAt, isNull);
+
+    final revisit = WhaleCampProject.fromJson(
+      _project('revisit', {'builtAt': _builtAt, 'supplyVisits': 7, 'availability': 'ended'}),
+    )!;
+    expect(revisit.stage, WhaleCampProjectStage.revisit);
+    expect(revisit.availability, WhaleCampProjectAvailability.ended);
+    expect(revisit.supplyVisits, 7);
+    expect(revisit.builtAt, DateTime.parse(_builtAt));
+    expect(revisit.revisitedAt, isNull);
+
+    final incompleteBuild = WhaleCampProject.fromJson(_project('needs-review'))!;
+    expect(incompleteBuild.stage, WhaleCampProjectStage.needsReview);
+    expect(incompleteBuild.builtAt, isNull);
+    expect(incompleteBuild.revisitedAt, isNull);
+    final changedCamp = WhaleCampProject.fromJson(
+      _project('needs-review', {'builtAt': _builtAt, 'revisitedAt': _revisitedAt}),
+    )!;
+    expect(changedCamp.stage, WhaleCampProjectStage.needsReview);
+    expect(changedCamp.builtAt, DateTime.parse(_builtAt));
+    expect(changedCamp.revisitedAt, DateTime.parse(_revisitedAt));
+  });
+
+  test('missing or malformed projects preserve the old camp controls and community receipts', () {
+    final invalid = _project('complete', {'builtAt': _builtAt});
+    for (final response in [
+      _camp,
+      {..._camp, 'project': invalid},
+      {..._camp, 'project': []},
+    ]) {
+      final camp = WhaleCampSnapshot.fromJson(response);
+      expect(camp.campProject, isNull);
+      expect(camp.connection, WhaleCampConnection.online);
+      expect(camp.pairedPauseEnabled, isTrue);
+      expect(camp.stopStatus, WhaleCampStopStatus.confirmed);
+    }
+    for (final state in [
+      _community,
+      {..._community, 'campProject': invalid},
+      {..._community, 'campProject': []},
+    ]) {
+      final community = WhaleCommunitySnapshot.fromState(state)!;
+      expect(community.campProject, isNull);
+      expect(community.activeSite, WhaleCommunitySite.camp);
+      expect(community.recentCamp.map((receipt) => receipt.kind), [WhaleCampEvent.supply, WhaleCampEvent.survey]);
+      expect(community.recentCamp.last.survey?.route, isA<WhaleStraightRoute>());
+    }
+    expect(WhaleCampSnapshot.fromJson({..._camp, 'action': 'return'}).action, WhaleCampAction.returnToSafety);
+  });
+
+  test('wrong enum, counts, metadata types, and impossible calendar dates are rejected', () {
+    for (final bad in [
+      _project('needsReview'),
+      _project('waiting'),
+      _project('gathering', {'availability': 'suppressed'}),
+      _project('gathering', {'availability': null}),
+      _project('gathering', {'supplyVisits': -1}),
+      _project('gathering', {'supplyVisits': 8}),
+      _project('gathering', {'supplyVisits': 2.0}),
+      _project('gathering', {'supplyVisits': '2'}),
+      _project('gathering', {'builtAt': null}),
+      _project('revisit', {'builtAt': 1794254550000}),
+      _project('revisit', {'builtAt': '2026-11-09T20:02:30'}),
+      _project('revisit', {'builtAt': '2026-02-29T20:02:30Z'}),
+      _project('revisit', {'builtAt': '2026-11-31T20:02:30Z'}),
+      _project('revisit', {'builtAt': '2026-11-09T24:00:00Z'}),
+      _project('revisit', {'builtAt': '2026-11-09T20:02:30+08:60'}),
+    ]) {
+      expect(WhaleCampProject.fromJson(bad), isNull, reason: '$bad');
+    }
+  });
+
+  test('proof combinations are checked by stage and ordered as instants across offsets', () {
+    for (final bad in [
+      _project('gathering', {'builtAt': _builtAt}),
+      _project('revisit'),
+      _project('revisit', {'builtAt': _builtAt, 'revisitedAt': _revisitedAt}),
+      _project('complete', {'revisitedAt': _revisitedAt}),
+      _project('complete', {'builtAt': _builtAt, 'revisitedAt': '2026-11-10T04:02:30.000+08:00'}),
+      _project('complete', {'builtAt': _builtAt, 'revisitedAt': '2026-11-10T03:00:00+08:00'}),
+      _project('needs-review', {'builtAt': _builtAt}),
+      _project('needs-review', {'revisitedAt': _revisitedAt}),
+      _project('needs-review', {'builtAt': _revisitedAt, 'revisitedAt': _builtAt}),
+    ]) {
+      expect(WhaleCampProject.fromJson(bad), isNull, reason: '$bad');
+    }
+    expect(
+      WhaleCampProject.fromJson(_project('revisit', {'builtAt': '2028-02-29T20:02:30.123456Z'}))?.builtAt,
+      DateTime.utc(2028, 2, 29, 20, 2, 30, 123, 456),
+    );
+  });
+}
diff --git a/app/test/whale/camp_test.dart b/app/test/whale/camp_test.dart
