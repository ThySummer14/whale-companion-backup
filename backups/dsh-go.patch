+const _community = {
+  'version': 1,
+  'activeSite': 'camp',
+  'recentCamp': [
+    {'kind': 'supply', 'at': _builtAt},
+    {
+      'kind': 'survey',
+      'at': _revisitedAt,
+      'outcome': 'completed',
+      'route': {'kind': 'straight', 'direction': 'north', 'steps': 4},
+    },
