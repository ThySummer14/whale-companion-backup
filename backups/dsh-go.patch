+
+({WhaleFeedAudio audio, ValueNotifier<bool> revoked, List<MethodCall> calls, Future<MethodCall> playing})
+_mockSongPlayer(WidgetTester tester) {
+  final directory = Directory.systemTemp.createTempSync('whale-feed-audio-test-');
+  final messenger = tester.binding.defaultBinaryMessenger;
+  final revoked = ValueNotifier(false);
+  final player = CompanionVoice(_nativeVoice);
+  final playing = Completer<MethodCall>.sync();
+  final calls = <MethodCall>[];
+  messenger.setMockMethodCallHandler(_nativeVoice, (call) async {
+    calls.add(call);
+    if (call.method == 'play' && !playing.isCompleted) playing.complete(call);
+    return call.method == 'stop' ? null : true;
+  });
+  addTearDown(() {
+    player.dispose();
+    revoked.dispose();
+    messenger.setMockMethodCallHandler(_nativeVoice, null);
+    directory.deleteSync(recursive: true);
+  });
+  return (
+    audio: WhaleFeedAudio(
+      player: player,
+      revoked: revoked,
+      onRevoked: () => revoked.value = true,
+      cacheDirectory: () async => directory,
+    ),
+    revoked: revoked,
+    calls: calls,
+    playing: playing.future,
+  );
+}
+
+Future<void> _startSong(WidgetTester tester, MethodCall play) async {
