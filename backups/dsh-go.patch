+
+class _PostEditorState extends State<_PostEditor> {
+  final _input = TextEditingController();
+  DraftAttachment? _image;
+  String? _mediaId;
+  ({String text, DraftAttachment? image, String id})? _attempt;
+  bool _busy = false;
+  bool _revoked = false;
+  String? _error;
+
+  Future<void> _pick() async {
+    final l = context.l10n;
+    setState(() {
+      _busy = true;
+      _error = null;
+    });
+    try {
+      final file = await ImagePicker().pickImage(source: ImageSource.gallery);
+      if (file == null || !mounted) return;
+      final limit = widget.publishPhotoLimit ?? maxPhotoBytes;
+      if (await file.length() > limit) {
+        if (mounted) setState(() => _error = l.whalePhotoSize);
+        return;
+      }
+      final attachment = DraftAttachment.sniff(file.name, await file.readAsBytes());
+      if (!mounted) return;
+      if (attachment.size > limit) {
+        setState(() => _error = l.whalePhotoSize);
+      } else if (!['image/png', 'image/jpeg', 'image/webp'].contains(attachment.mediaType)) {
+        setState(() => _error = l.whalePhotoFormat);
+      } else {
+        setState(() {
+          _image = attachment;
+          _mediaId = null;
+        });
+      }
+    } catch (_) {
+      if (mounted) setState(() => _error = l.whalePhotoRetry);
+    } finally {
+      if (mounted) setState(() => _busy = false);
+    }
+  }
+
+  Future<void> _submit() async {
+    if (_busy || _revoked) return;
+    final l = context.l10n;
+    final image = _image;
+    final text = _input.text.trim();
+    setState(() {
+      _busy = true;
+      _error = null;
+    });
+    try {
+      if (widget.publishPhotoLimit != null) {
+        final attempt = _attempt;
+        final id = attempt != null && attempt.text == text && identical(attempt.image, image)
+            ? attempt.id
+            : newWhaleRequestId();
+        _attempt = (text: text, image: image, id: id);
+        await widget.host.publishDraft(
+          id,
+          text,
+          parentId: widget.parent,
+          image: image == null ? null : (bytes: image.bytes, mimeType: image.mediaType!),
+        );
+      } else {
+        if (image != null) _mediaId ??= await widget.host.upload(image.bytes, image.mediaType!);
+        if (!mounted) return;
+        await widget.host.publish(text, mediaId: _mediaId, parentId: widget.parent);
+      }
+      if (mounted) Navigator.pop(context, true);
+    } on HostError catch (error) {
+      if (!mounted) return;
+      setState(() {
+        _revoked = error.status == 401;
+        _error = switch (error.code) {
+          'device-unauthorized' => l.whaleRevoked,
+          'feed-request-gone' => l.whalePublishGone,
+          'feed-request-conflict' => l.whalePublishConflict,
+          'not-found' when widget.parent != null => l.whaleActivityPostGone,
+          _ => l.whalePublishFailed,
+        };
+      });
+      if (_revoked) widget.onRevoked?.call();
+    } catch (_) {
+      if (mounted) setState(() => _error = l.whalePublishFailed);
+    } finally {
+      if (mounted) setState(() => _busy = false);
+    }
+  }
+
+  @override
+  void dispose() {
+    _input.dispose();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final l = context.l10n;
+    final image = _image;
+    return PopScope(
+      canPop: !_busy,
+      child: AlertDialog(
+        title: Text(widget.parent == null ? l.whaleNewPost : l.whaleReply),
+        scrollable: true,
+        content: SizedBox(
+          width: 440,
+          child: Column(
+            crossAxisAlignment: CrossAxisAlignment.start,
+            children: [
+              TextField(
+                controller: _input,
+                enabled: !_busy,
+                maxLines: 5,
+                minLines: 2,
+                maxLength: 4000,
+                onChanged: (_) => setState(() {}),
+                decoration: InputDecoration(hintText: l.whalePostHint),
+              ),
+              if (widget.photos) AttachButton(onPressed: _busy || _revoked ? null : _pick),
+              if (image != null)
+                AbsorbPointer(
+                  absorbing: _busy,
+                  child: ComposerTray(
+                    items: [image],
+                    onRemove: (_) => setState(() {
+                      _image = null;
+                      _mediaId = null;
+                    }),
+                  ),
+                ),
+              if (_busy) const LinearProgressIndicator(minHeight: 2),
+              if (_error != null) Text(_error!, style: TextStyle(color: Theme.of(context).colorScheme.error)),
+            ],
+          ),
+        ),
+        actions: [
+          TextButton(onPressed: _busy ? null : () => Navigator.pop(context), child: Text(l.whaleCancel)),
+          FilledButton(
+            onPressed: _busy || _revoked || (_input.text.trim().isEmpty && (image == null || !widget.imageOnly))
+                ? null
+                : _submit,
+            child: Text(l.whalePublish),
+          ),
+        ],
+      ),
+    );
+  }
+}
