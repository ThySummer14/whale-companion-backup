+  Future<void> _beginConversation() async {
+    if (!_canBeginConversation || _conversation != null) return;
+    final approved = await showDialog<bool>(
+      context: context,
+      builder: (context) => AlertDialog(
+        title: Text(context.l10n.whaleConversationStart),
+        content: Text(context.l10n.whaleConversationConsent),
+        actions: [
+          TextButton(onPressed: () => Navigator.pop(context), child: Text(context.l10n.whaleCancel)),
+          FilledButton(onPressed: () => Navigator.pop(context, true), child: Text(context.l10n.whaleConversationStart)),
+        ],
+      ),
+    );
+    if (!mounted || approved != true || !_canBeginConversation || _conversation != null) return;
+    FocusScope.of(context).unfocus();
+    _conversationLimit = Timer(const Duration(minutes: 5), _endConversation);
+    await _prepareConversationMic();
+  }
+
+  Future<void> _prepareConversationMic() async {
+    final run = _conversationLimit;
+    setState(() => _conversation = _ConversationPhase.preparing);
+    _discardVoiceReply(stopPlayback: false);
+    await _voice.stop();
+    if (!mounted || run == null || !identical(run, _conversationLimit)) return;
+    setState(() => _conversation = _ConversationPhase.resuming);
+    _queueConversationMic();
+  }
