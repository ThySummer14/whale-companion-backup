+      WhaleVoicePhase.loading || WhaleVoicePhase.generating => (Icons.close_rounded, l.whaleVoiceLoading),
+      WhaleVoicePhase.finished => (Icons.replay_rounded, l.whaleVoiceReplay),
+      WhaleVoicePhase.failed => (Icons.refresh_rounded, l.whaleVoiceRetry),
