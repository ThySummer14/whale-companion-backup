+class _WhaleFeedState extends State<WhaleFeed> {
+  List<Json>? _posts;
+  String? _cursor;
+  bool _loading = false;
+  bool _refreshPending = false;
+  bool _photos = false;
+  bool _imageOnly = false;
+  int? _publishPhotoLimit;
+  bool _failed = false;
+  final _threads = <String, List<Json>>{};
+  String? _expanded;
+
+  @override
+  void initState() {
+    super.initState();
+    unawaited(_load());
+  }
+
+  Future<void> _load({bool more = false}) async {
+    if (_loading) {
+      if (!more) _refreshPending = true;
+      return;
+    }
+    setState(() => _loading = true);
+    try {
+      final host = widget.host;
+      final page = await host.feed(more ? _cursor : null);
+      Json? health;
+      if (!more) {
+        try {
+          health = await host.health();
+        } on HostError catch (error) {
+          if (error.status == 401) rethrow;
+        }
+      }
+      if (!mounted) return;
+      setState(() {
+        final items = (page['items'] as List).cast<Json>();
+        final posts = more ? _posts ?? [] : <Json>[];
+        _posts = {
+          for (final post in [...posts, ...items]) post['id']: post,
+        }.values.toList();
+        _cursor = page['nextCursor'] as String?;
+        _failed = false;
+        if (health case final details?) {
+          final cap = details['feedPublish'];
+          final limit = cap is Map && cap['version'] == 1 ? cap['maxImageBytes'] : null;
+          _publishPhotoLimit = limit is int && limit > 0 && limit <= maxPhotoBytes ? limit : null;
+          final raw = details['pluginVersion'] as String? ?? '';
+          final parts = raw.split('-').first.split('.');
+          final version = parts.length == 3 ? parts.map((p) => int.tryParse(p) ?? 0).toList() : [0, 0, 0];
+          _photos = _publishPhotoLimit != null || version[0] > 0 || version[1] >= 15;
+          _imageOnly =
+              _publishPhotoLimit != null || version[0] > 0 || version[1] > 15 || version[1] == 15 && version[2] >= 1;
+        }
+      });
+      final expanded = _expanded;
+      if (!more && expanded != null) await _loadThread(expanded);
+    } catch (error) {
+      if (mounted) {
+        setState(() => _failed = true);
+        if (error is HostError && error.status == 401) widget.audio?.onRevoked();
+      }
+    } finally {
+      if (mounted) {
+        setState(() => _loading = false);
+        if (_refreshPending) {
+          _refreshPending = false;
+          unawaited(_load());
+        }
+      }
+    }
+  }
+
+  Future<void> _loadThread(String id) async {
+    try {
+      final thread = await widget.host.thread(id);
+      if (mounted) setState(() => _threads[id] = (thread['replies'] as List).cast<Json>());
+    } catch (error) {
+      if (mounted) {
+        setState(() => _failed = true);
+        if (error is HostError && error.status == 401) widget.audio?.onRevoked();
+      }
+    }
+  }
+
+  Future<void> _compose([String? parent]) async {
+    final posted = await showDialog<bool>(
+      context: context,
+      barrierDismissible: false,
+      builder: (_) => _PostEditor(
+        widget.host,
+        parent,
+        _photos,
+        _imageOnly,
+        publishPhotoLimit: _publishPhotoLimit,
+        onRevoked: widget.audio?.onRevoked,
+      ),
+    );
+    if (posted == true && mounted) {
+      if (parent != null) setState(() => _expanded = parent);
+      await _load();
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) =>
+      _FeedSongPlayback(host: widget.host, audio: widget.audio, active: widget.active, builder: _buildFeed);
+
+  Widget _buildFeed(BuildContext context, WhaleVoice? voice) {
+    final l = context.l10n;
+    final posts = _posts;
+    return Column(
+      children: [
+        Padding(
+          padding: const EdgeInsets.fromLTRB(16, 8, 12, 8),
+          child: Row(
+            children: [
+              Expanded(
+                child: Text(
+                  _failed
+                      ? l.whaleFeedFailed
+                      : _photos
+                      ? l.whaleFeed
+                      : l.whalePhotoNeedsHost,
+                ),
+              ),
+              IconButton(
+                tooltip: l.whaleRefresh,
+                onPressed: _loading ? null : () => _load(),
+                icon: const Icon(Icons.refresh),
+              ),
+              FilledButton.icon(
+                onPressed: posts == null ? null : () => _compose(),
+                icon: const Icon(Icons.edit_outlined),
+                label: Text(l.whaleNewPost),
+              ),
+            ],
+          ),
+        ),
+        if (_loading) const LinearProgressIndicator(minHeight: 2),
+        Expanded(
+          child: RefreshIndicator(
+            onRefresh: _load,
+            child: ListView(
+              physics: const AlwaysScrollableScrollPhysics(),
+              padding: const EdgeInsets.fromLTRB(14, 4, 14, 16),
+              children: [
+                if (posts?.isEmpty == true) Padding(padding: const EdgeInsets.all(12), child: Text(l.whaleFeedEmpty)),
+                for (final post in posts ?? <Json>[])
+                  Card(
+                    key: ValueKey(post['id']),
+                    child: Padding(
+                      padding: const EdgeInsets.all(14),
+                      child: Column(
+                        crossAxisAlignment: CrossAxisAlignment.start,
+                        children: [
+                          _FeedPostContent(widget.host, widget.persona, post, topLevel: true, voice: voice),
+                          Wrap(
+                            children: [
+                              TextButton.icon(
+                                onPressed: () async {
+                                  final id = post['id'] as String;
+                                  final opening = _expanded != id;
+                                  setState(() => _expanded = opening ? id : null);
+                                  if (opening) await _loadThread(id);
+                                },
+                                icon: const Icon(Icons.forum_outlined, size: 18),
+                                label: Text('${l.whaleReplies} · ${post['replyCount'] ?? 0}'),
+                              ),
+                              TextButton(onPressed: () => _compose(post['id'] as String), child: Text(l.whaleReply)),
+                            ],
+                          ),
+                          if (_expanded == post['id'])
+                            for (final reply in _threads[post['id']] ?? <Json>[])
+                              Padding(
+                                key: ValueKey(reply['id']),
+                                padding: const EdgeInsets.only(left: 14, bottom: 10),
+                                child: _FeedPostContent(widget.host, widget.persona, reply),
+                              ),
+                        ],
+                      ),
+                    ),
+                  ),
+                if (_cursor != null)
+                  TextButton(onPressed: _loading ? null : () => _load(more: true), child: Text(l.whaleMore)),
+              ],
+            ),
+          ),
+        ),
+      ],
+    );
+  }
+}
