index 00000000..1a3bbd94
--- /dev/null
+++ b/app/lib/whale/song_player.dart
@@ -0,0 +1,534 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+// Mini player and Now Playing adapted from egoist/mygo-music, see THIRD_PARTY_NOTICES.md.
+
+import 'dart:async';
+import 'dart:math' as math;
+
+import 'package:flutter/material.dart';
+
+import '../l10n/l10n.dart';
+import 'host.dart';
+import 'voice.dart';
+
+enum SongRepeat { off, all, one }
+
+typedef SongPosition = ({int positionMs, int durationMs});
+
+class WhaleSongPlayer extends ChangeNotifier {
+  WhaleSongPlayer(this.voice) {
+    voice.addListener(_voiceChanged);
+  }
+
+  final WhaleVoice voice;
+  final position = ValueNotifier<SongPosition?>(null);
+  List<SongArchiveItem> _archive = const [];
+  List<String> _order = const [];
+  Timer? _clock;
+  bool _reading = false;
+  bool _disposed = false;
+  int _positionRevision = 0;
+  String? _trackId;
+  bool shuffle = false;
+  SongRepeat repeat = SongRepeat.off;
+
+  SongArchiveItem? _song(String? id) => _archive.where((song) => song.id == id).firstOrNull;
+  SongArchiveItem? get current => _song(voice.messageId);
+  WhaleVoicePhase get phase => voice.phase;
+  List<SongArchiveItem> get queue => [for (final id in _order) ?_song(id)];
+
+  void updateArchive(List<SongArchiveItem> songs) {
+    _archive = songs;
+    _order = shuffle
+        ? [
+            ..._order.where((id) => _song(id) != null),
+            ...songs.map((song) => song.id).where((id) => !_order.contains(id)),
+          ]
+        : songs.map((song) => song.id).toList();
+    if (voice.messageId != null && current == null) unawaited(voice.stop());
+    notifyListeners();
+  }
+
+  void toggleShuffle() {
+    shuffle = !shuffle;
+    if (shuffle) {
+      final selected = current?.id;
+      final others = _archive.map((song) => song.id).where((id) => id != selected).toList()..shuffle();
+      _order = [?selected, ...others];
+    } else {
+      _order = _archive.map((song) => song.id).toList();
+    }
+    notifyListeners();
+  }
+
+  void cycleRepeat() {
+    repeat = SongRepeat.values[(repeat.index + 1) % SongRepeat.values.length];
+    notifyListeners();
+  }
+
+  Future<void> play(SongArchiveItem song) => voice.toggleSong(song);
+
+  SongArchiveItem? _step(int offset, {bool automatic = false}) {
+    final song = current;
+    if (song == null || _order.isEmpty) return null;
+    if (automatic && repeat == SongRepeat.one) return song;
+    final index = _order.indexOf(song.id);
+    if (index < 0) return null;
+    final next = index + offset;
+    if (next >= 0 && next < _order.length) return _song(_order[next]);
+    return repeat == SongRepeat.all && (automatic || _order.length > 1) ? _song(_order[next % _order.length]) : null;
+  }
+
+  bool get canPrevious => _step(-1) != null || (position.value?.positionMs ?? 0) > 3000;
+  bool get canNext => _step(1) != null;
+
+  Future<void> previous() async {
+    if ((position.value?.positionMs ?? 0) > 3000 && await seek(0)) return;
+    if (_step(-1) case final song?) await play(song);
+  }
+
+  Future<void> next() async {
+    if (_step(1) case final song?) await play(song);
+  }
+
+  Future<bool> seek(int positionMs) async {
+    final track = voice.messageId;
+    final before = position.value;
+    if (before == null || track == null) return false;
+    final target = positionMs.clamp(0, before.durationMs - 1);
+    final revision = ++_positionRevision;
+    if (!await voice.seekSong(target) || _disposed || voice.messageId != track || revision != _positionRevision) {
+      return false;
+    }
+    position.value = (positionMs: target, durationMs: before.durationMs);
+    return true;
+  }
+
+  void _voiceChanged() {
+    final track = voice.messageId;
+    if (_trackId != track) {
+      _trackId = track;
+      position.value = null;
+    }
+    if (phase == WhaleVoicePhase.loading) position.value = null;
+    _clock?.cancel();
+    _clock = null;
+    if (phase == WhaleVoicePhase.playing) {
+      unawaited(_readPosition());
+      _clock = Timer.periodic(const Duration(milliseconds: 500), (_) => unawaited(_readPosition()));
+    } else if (phase == WhaleVoicePhase.paused) {
+      unawaited(_readPosition());
+    } else if (phase == WhaleVoicePhase.finished) {
+      if (position.value case final pos?) position.value = (positionMs: pos.durationMs, durationMs: pos.durationMs);
+      final next = _step(1, automatic: true);
+      if (next != null) {
+        scheduleMicrotask(() {
+          if (!_disposed && voice.messageId == track && phase == WhaleVoicePhase.finished) unawaited(play(next));
+        });
+      }
+    }
+    notifyListeners();
+  }
+
+  Future<void> _readPosition() async {
+    if (_reading) return;
+    _reading = true;
+    final track = voice.messageId;
+    final revision = _positionRevision;
+    try {
+      final currentPosition = await voice.songPosition();
+      if (!_disposed && voice.messageId == track && revision == _positionRevision && currentPosition != null) {
+        position.value = currentPosition;
+      }
+    } finally {
+      _reading = false;
+    }
+  }
+
+  @override
+  void dispose() {
+    _disposed = true;
+    _clock?.cancel();
+    voice.removeListener(_voiceChanged);
+    position.dispose();
+    super.dispose();
+  }
+}
+
+String songTime(int ms) {
+  final duration = Duration(milliseconds: ms);
+  final minutes = duration.inMinutes;
+  final seconds = duration.inSeconds.remainder(60).toString().padLeft(2, '0');
+  return '$minutes:$seconds';
+}
