+    if (joined.length > 16000) return false;
+    _dictatedText = text;
+    _input.value = TextEditingValue(
+      text: joined,
+      selection: TextSelection.collapsed(offset: joined.length),
+    );
+    if (_conversation == _ConversationPhase.listening) {
+      final run = _conversationLimit;
+      scheduleMicrotask(() {
+        if (!mounted || !identical(run, _conversationLimit) || _conversation != _ConversationPhase.listening) return;
+        unawaited(_send(fromConversation: true));
+      });
+    }
+    return true;
+  }
+
+  Future<void> _cancel() async {
+    _endConversation();
+    _discardVoiceReply();
+    setState(() => _stopping = true);
+    try {
+      await widget.host.cancel();
+    } catch (error) {
+      if (mounted) setState(() => _error = error);
+    } finally {
+      if (mounted) setState(() => _stopping = false);
+    }
+  }
