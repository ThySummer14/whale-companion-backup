index 0000000000000000000000000000000000000000..2d4986b3acf23cd62fb5c051c0c2f024bb8a6d44
--- /dev/null
+++ b/app/test/whale/voice_reply_test.dart
@@ -0,0 +1,46 @@
+import 'package:dsh_app/whale/voice_reply.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  test('a fast WS event can arrive first, but only the POST receipt confirms the exact message and scene', () {
+    var elapsed = 100;
+    final reply = VoiceReplyTicket(elapsedMs: () => elapsed);
+    final send = reply.begin();
+    expect(reply.receive(sessionId: 'other', userMessageId: 'user', assistantMessageId: 'wrong session'), isNull);
+    expect(reply.receive(sessionId: 'chat', userMessageId: 'other', assistantMessageId: 'wrong user'), isNull);
+    elapsed = 148;
+    expect(reply.receive(sessionId: 'chat', userMessageId: 'user', assistantMessageId: 'final'), isNull);
+    elapsed = 200;
+    expect(reply.receive(sessionId: 'chat', userMessageId: 'user', assistantMessageId: 'duplicate'), isNull);
+    elapsed = 220;
+    final match = reply.confirm(send, sessionId: 'chat', userMessageId: 'user')!;
+    expect(match.assistantMessageId, 'final');
+    expect(match.readyMs, 48);
+    expect(match.elapsedMs, 120);
+    expect(reply.pending, isFalse);
+    expect(reply.receive(sessionId: 'chat', userMessageId: 'user', assistantMessageId: 'final'), isNull);
+  });
+
+  test('without a current send, late and duplicate events cannot play', () {
+    final reply = VoiceReplyTicket();
+    expect(reply.receive(sessionId: 'chat', userMessageId: 'typed', assistantMessageId: 'ordinary reply'), isNull);
+    final cancelled = reply.begin();
+    reply.clear();
+    expect(reply.confirm(cancelled, sessionId: 'chat', userMessageId: 'one'), isNull);
+    final current = reply.begin();
+    expect(reply.confirm(cancelled, sessionId: 'chat', userMessageId: 'one'), isNull);
+    expect(reply.confirm(current, sessionId: 'chat', userMessageId: 'two'), isNull);
+    expect(reply.receive(sessionId: 'chat', userMessageId: 'one', assistantMessageId: 'stale'), isNull);
+    expect(reply.receive(sessionId: 'chat', userMessageId: 'two', assistantMessageId: 'current')?.assistantMessageId, 'current');
+  });
+
+  test('a pending send expires even if its event was already buffered', () {
+    var elapsed = 0;
+    final reply = VoiceReplyTicket(elapsedMs: () => elapsed);
+    final send = reply.begin();
+    reply.receive(sessionId: 'chat', userMessageId: 'user', assistantMessageId: 'late');
+    elapsed += VoiceReplyTicket.lifetime.inMilliseconds;
+    expect(reply.confirm(send, sessionId: 'chat', userMessageId: 'user'), isNull);
+    expect(reply.pending, isFalse);
+  });
+}
