+class WhaleCampProjectCard extends StatelessWidget {
+  const WhaleCampProjectCard({required this.project, required this.fresh, this.compact = false, super.key});
+
+  final WhaleCampProject project;
+  final bool fresh;
+  final bool compact;
+
+  @override
+  Widget build(BuildContext context) {
+    final l = context.l10n;
+    final theme = Theme.of(context);
+    final stage = switch (project.stage) {
+      WhaleCampProjectStage.gathering => l.whaleCampProjectGathering,
+      WhaleCampProjectStage.revisit => l.whaleCampProjectRevisit,
+      WhaleCampProjectStage.complete => l.whaleCampProjectComplete,
+      WhaleCampProjectStage.needsReview => l.whaleCampProjectNeedsReview,
+    };
+    final availability = switch (project.availability) {
+      WhaleCampProjectAvailability.active => l.whaleCampProjectActive,
+      WhaleCampProjectAvailability.paused => l.whaleCampProjectPaused,
+      WhaleCampProjectAvailability.ended => l.whaleCampProjectEnded,
+    };
+    return Card(
+      margin: EdgeInsets.zero,
+      child: Padding(
+        padding: const EdgeInsets.all(12),
+        child: Column(
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: [
+            Text(l.whaleCampProjectTitle, style: compact ? theme.textTheme.titleSmall : theme.textTheme.titleMedium),
+            const SizedBox(height: 4),
+            Semantics(liveRegion: true, child: Text(fresh ? stage : l.whaleCampLastKnown(stage))),
+            if (fresh) Text(availability),
+            Text(l.whaleCampProjectSupplies(project.supplyVisits)),
+            if (project.gatheredLogs case final count?) Text(l.whaleCampProjectGatheredLogs(count)),
+            if (!compact) ...[
+              if (project.builtAt case final time?) Text(l.whaleCampProjectBuiltAt(formatCampTime(context, time))),
+              if (project.revisitedAt case final time?)
+                Text(l.whaleCampProjectRevisitedAt(formatCampTime(context, time))),
+            ],
+          ],
+        ),
+      ),
+    );
+  }
+}
+
+String formatCampTime(BuildContext context, DateTime time) {
+  final local = time.toLocal();
+  final material = MaterialLocalizations.of(context);
+  return '${material.formatShortDate(local)} ${material.formatTimeOfDay(TimeOfDay.fromDateTime(local))}';
+}
diff --git a/app/lib/whale/camp_project_state.dart b/app/lib/whale/camp_project_state.dart
new file mode 100644
index 0000000000000000000000000000000000000000..85efda91779c935100dcddca9ab6047ba0e6ea15
--- /dev/null
+++ b/app/lib/whale/camp_project_state.dart
@@ -0,0 +1,69 @@
+enum WhaleCampProjectStage { gathering, revisit, complete, needsReview }
+
+enum WhaleCampProjectAvailability { active, paused, ended }
+
+class WhaleCampProject {
+  const WhaleCampProject._(
+    this.stage,
+    this.availability,
+    this.supplyVisits,
+    this.builtAt,
+    this.revisitedAt, {
+    this.gatheredLogs,
+  });
+
+  final WhaleCampProjectStage stage;
+  final WhaleCampProjectAvailability availability;
+  final int supplyVisits;
+  final int? gatheredLogs;
+  final DateTime? builtAt;
+  final DateTime? revisitedAt;
+
+  static const _stages = {
+    'gathering': WhaleCampProjectStage.gathering,
+    'revisit': WhaleCampProjectStage.revisit,
+    'complete': WhaleCampProjectStage.complete,
+    'needs-review': WhaleCampProjectStage.needsReview,
+  };
+  static final _availability = WhaleCampProjectAvailability.values.asNameMap();
+  static final _iso = RegExp(
+    r'^(\d{4})-(\d{2})-(\d{2})T(?:[01]\d|2[0-3]):[0-5]\d:[0-5]\d(?:\.\d{1,6})?(?:Z|[+-](?:[01]\d|2[0-3]):[0-5]\d)$',
+  );
+
+  static WhaleCampProject? fromJson(Object? value) {
+    if (value is! Map) return null;
+    final stage = _stages[value['stage']];
+    if (stage == null) return null;
+    final availability = _availability[value['availability']];
+    final visits = value['supplyVisits'];
+    if (availability == null || visits is! int || visits < 0 || visits > 7) return null;
+    final logs = value['gatheredLogs'];
+    final gatheredLogs = logs is int && logs >= 0 && logs <= 7 ? logs : null;
+
+    final built = _instant(value['builtAt']);
+    final checked = _instant(value['revisitedAt']);
+    if ((value.containsKey('builtAt') && built == null) || (value.containsKey('revisitedAt') && checked == null)) {
+      return null;
+    }
+    final hasProof = built != null && checked != null && checked.isAfter(built);
+    final valid = switch (stage) {
+      WhaleCampProjectStage.gathering => built == null && checked == null,
+      WhaleCampProjectStage.revisit => built != null && checked == null,
+      WhaleCampProjectStage.complete => hasProof,
+      WhaleCampProjectStage.needsReview => (built == null && checked == null) || hasProof,
+    };
+    return valid ? WhaleCampProject._(stage, availability, visits, built, checked, gatheredLogs: gatheredLogs) : null;
+  }
+
+  static DateTime? _instant(Object? value) {
+    if (value is! String) return null;
+    final match = _iso.firstMatch(value);
+    if (match == null) return null;
+    final year = int.parse(match[1]!);
+    final month = int.parse(match[2]!);
+    final day = int.parse(match[3]!);
+    final calendar = DateTime.utc(year, month, day);
+    if (calendar.month != month || calendar.day != day) return null;
+    return DateTime.tryParse(value);
+  }
+}
