+
+class _WhaleSongNowPlayingState extends State<WhaleSongNowPlaying> {
+  bool _queueOpen = false;
+  double? _drag;
+
+  @override
+  Widget build(BuildContext context) {
+    final l = context.l10n;
+    final player = widget.player;
+    return FractionallySizedBox(
+      heightFactor: .96,
+      child: Theme(
+        data: ThemeData.dark(useMaterial3: true),
+        child: Material(
+          color: const Color(0xff0b0b0d),
+          borderRadius: const BorderRadius.vertical(top: Radius.circular(24)),
+          clipBehavior: Clip.antiAlias,
+          child: SafeArea(
+            child: ListenableBuilder(
+              listenable: player,
+              builder: (context, _) {
+                final song = player.current;
+                if (song == null) return const SizedBox.shrink();
+                return LayoutBuilder(
+                  builder: (context, size) => CustomScrollView(
+                    slivers: [
+                      SliverPadding(
+                        padding: const EdgeInsets.fromLTRB(24, 4, 24, 16),
+                        sliver: SliverList.list(
+                          children: [
+                            Row(
+                              children: [
+                                IconButton(
+                                  onPressed: () => Navigator.of(context).pop(),
+                                  tooltip: MaterialLocalizations.of(context).closeButtonTooltip,
+                                  icon: const Icon(Icons.keyboard_arrow_down_rounded),
+                                ),
+                                Expanded(
+                                  child: Text(
+                                    l.whaleMusicNowPlaying,
+                                    textAlign: TextAlign.center,
+                                    style: Theme.of(context).textTheme.labelLarge,
+                                  ),
+                                ),
+                                IconButton(
+                                  onPressed: () => setState(() => _queueOpen = !_queueOpen),
+                                  isSelected: _queueOpen,
+                                  tooltip: l.whaleMusicQueue,
+                                  icon: const Icon(Icons.queue_music_rounded),
+                                ),
+                              ],
+                            ),
+                            if (!_queueOpen) ...[
+                              const SizedBox(height: 14),
+                              Center(
+                                child: WhaleSongCover(
+                                  size: math.min(344.0, math.min(size.maxWidth - 48, size.maxHeight * .47)),
+                                ),
+                              ),
+                              const SizedBox(height: 24),
+                            ] else
+                              const SizedBox(height: 14),
+                            Text(
+                              song.title,
+                              style: Theme.of(context).textTheme.headlineSmall?.copyWith(fontWeight: FontWeight.w700),
+                            ),
+                            const SizedBox(height: 3),
+                            Text(
+                              player.phase == WhaleVoicePhase.failed ? l.whaleSongPlaybackFailed : l.whaleMusicArtist,
+                              style: const TextStyle(color: Color(0xffb1afbb)),
+                            ),
+                            const SizedBox(height: 8),
+                            _transport(l, player, song),
+                          ],
+                        ),
+                      ),
+                      if (_queueOpen)
+                        SliverPadding(
+                          padding: const EdgeInsets.symmetric(horizontal: 24),
+                          sliver: SliverList.builder(
+                            itemCount: player.queue.length,
+                            itemBuilder: (context, index) {
+                              final entry = player.queue[index];
+                              return ListTile(
+                                contentPadding: EdgeInsets.zero,
+                                leading: const WhaleSongCover(size: 36),
+                                title: Text(entry.title, maxLines: 1, overflow: TextOverflow.ellipsis),
+                                selected: entry.id == song.id,
+                                onTap: () => unawaited(player.play(entry)),
+                              );
+                            },
+                          ),
+                        ),
+                    ],
+                  ),
+                );
+              },
+            ),
+          ),
+        ),
+      ),
+    );
+  }
+
+  Widget _transport(L10n l, WhaleSongPlayer player, SongArchiveItem song) {
+    final repeatLabel = switch (player.repeat) {
+      SongRepeat.off => l.whaleMusicRepeatOff,
+      SongRepeat.all => l.whaleMusicRepeatAll,
+      SongRepeat.one => l.whaleMusicRepeatOne,
+    };
+    return ValueListenableBuilder(
+      valueListenable: player.position,
+      builder: (context, position, _) {
+        final duration = position?.durationMs ?? ((song.durationSeconds ?? 0) * 1000).round();
+        final elapsed = (_drag?.round() ?? position?.positionMs ?? 0).clamp(0, duration);
+        final seekable =
+            position != null && (player.phase == WhaleVoicePhase.playing || player.phase == WhaleVoicePhase.paused);
+        return Column(
+          children: [
+            Slider(
+              key: ValueKey(song.id),
+              max: math.max(duration.toDouble(), 1),
+              value: elapsed.toDouble(),
+              activeColor: const Color(0xffe5e2f1),
+              semanticFormatterCallback: (value) => songTime(value.round()),
+              onChanged: seekable ? (value) => setState(() => _drag = value) : null,
+              onChangeEnd: seekable
+                  ? (value) {
+                      setState(() => _drag = null);
+                      unawaited(player.seek(value.round()));
+                    }
+                  : null,
+            ),
+            Row(
+              mainAxisAlignment: MainAxisAlignment.spaceBetween,
+              children: [
+                Text(songTime(elapsed), style: const TextStyle(color: Color(0xffb1afbb))),
+                Text(songTime(duration), style: const TextStyle(color: Color(0xffb1afbb))),
+              ],
+            ),
+            const SizedBox(height: 10),
+            Row(
+              mainAxisAlignment: MainAxisAlignment.spaceBetween,
+              children: [
+                IconButton(
+                  onPressed: player.toggleShuffle,
+                  tooltip: l.whaleMusicShuffle,
+                  isSelected: player.shuffle,
+                  icon: const Icon(Icons.shuffle_rounded),
+                  selectedIcon: const Icon(Icons.shuffle_on_rounded),
+                ),
+                IconButton(
+                  onPressed: player.canPrevious ? () => unawaited(player.previous()) : null,
+                  tooltip: l.whaleMusicPrevious,
+                  icon: const Icon(Icons.skip_previous_rounded, size: 28),
+                ),
+                WhaleSongPlayButton(player: player, song: song, filled: true),
+                IconButton(
+                  onPressed: player.canNext ? () => unawaited(player.next()) : null,
+                  tooltip: l.whaleMusicNext,
+                  icon: const Icon(Icons.skip_next_rounded, size: 28),
+                ),
+                IconButton(
+                  onPressed: player.cycleRepeat,
+                  tooltip: repeatLabel,
+                  isSelected: player.repeat != SongRepeat.off,
+                  icon: const Icon(Icons.repeat_rounded),
+                  selectedIcon: Icon(
+                    player.repeat == SongRepeat.one ? Icons.repeat_one_on_rounded : Icons.repeat_on_rounded,
+                  ),
+                ),
+              ],
+            ),
+          ],
+        );
+      },
+    );
+  }
+}
