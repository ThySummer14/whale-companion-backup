@@ -0,0 +1,137 @@
+import 'camp_project_state.dart';
+
+enum WhaleCampConnection { online, offline, unavailable }
+
+enum WhaleCampAction { follow, move, dig, returnToSafety, craft, shield, build, prepare, survey, revisit, patrol, gather, chat }
+
+enum WhaleCampStopStatus { pending, confirmed, offline, unconfirmed }
+
+enum WhaleCampPatrolStatus { running, completed, partial, cancelled, failed }
+
+enum WhaleCampGatherStatus { running, completed, cancelled, failed }
+
+enum WhaleCampVisitStatus { starting, online, offline, unconfirmed }
+
+class WhaleCampPatrol {
+  const WhaleCampPatrol._(this.status, this.completedSegments, this.totalSegments, this.visitStatus);
+
+  final WhaleCampPatrolStatus status;
+  final int completedSegments;
+  final int totalSegments;
+  final WhaleCampVisitStatus visitStatus;
+
+  static WhaleCampPatrol? fromJson(Object? value) {
+    if (value is! Map) return null;
+    final status = WhaleCampPatrolStatus.values.asNameMap()[value['status']];
+    final completed = value['completedSegments'];
+    final total = value['totalSegments'];
+    final visit = WhaleCampVisitStatus.values.asNameMap()[value['visitStatus']];
+    if (status == null ||
+        total is! int ||
+        total != 2 ||
+        completed is! int ||
+        completed < 0 ||
+        completed > total ||
+        visit == null) {
+      return null;
+    }
+    final consistent = switch (status) {
+      WhaleCampPatrolStatus.completed => completed == total && visit == WhaleCampVisitStatus.offline,
+      WhaleCampPatrolStatus.partial => completed > 0,
+      WhaleCampPatrolStatus.failed => completed == 0,
+      WhaleCampPatrolStatus.running || WhaleCampPatrolStatus.cancelled => true,
+    };
+    return consistent ? WhaleCampPatrol._(status, completed, total, visit) : null;
+  }
+}
+
+class WhaleCampGather {
+  const WhaleCampGather._(this.status, this.collected, this.visitStatus);
+
+  final WhaleCampGatherStatus status;
+  final int collected;
+  final WhaleCampVisitStatus visitStatus;
+
+  static WhaleCampGather? fromJson(Object? value) {
+    if (value is! Map) return null;
+    final status = WhaleCampGatherStatus.values.asNameMap()[value['status']];
+    final collected = value['collected'];
+    final visit = WhaleCampVisitStatus.values.asNameMap()[value['visitStatus']];
+    if (status == null || collected is! int || collected < 0 || collected > 1 || visit == null) return null;
+    if (status == WhaleCampGatherStatus.completed && (collected != 1 || visit != WhaleCampVisitStatus.offline)) {
+      return null;
+    }
+    return WhaleCampGather._(status, collected, visit);
+  }
+}
+
+class WhaleCampSnapshot {
+  const WhaleCampSnapshot._({
+    required this.connection,
+    required this.observedAt,
+    required this.pairedPauseEnabled,
+    this.action,
+    this.pausedAt,
+    this.stopStatus,
+    this.stopAt,
+    this.campProject,
+    this.patrol,
+    this.gather,
+  });
+
+  final WhaleCampConnection connection;
+  final WhaleCampAction? action;
+  final DateTime observedAt;
+  final bool pairedPauseEnabled;
+  final DateTime? pausedAt;
+  final WhaleCampStopStatus? stopStatus;
+  final DateTime? stopAt;
+  final WhaleCampProject? campProject;
+  final WhaleCampPatrol? patrol;
+  final WhaleCampGather? gather;
+
+  static bool supportedBy(Object? capability) => capability is Map && capability['version'] == 1;
+
+  factory WhaleCampSnapshot.fromJson(Map<String, Object?> value) {
+    final control = value['control'];
+    final connection = WhaleCampConnection.values.asNameMap()[value['connection']];
+    final observedAt = _date(value['observedAt']);
+    if (!supportedBy(value) || control is! Map || connection == null || observedAt == null) {
+      throw const FormatException('invalid-camp-status');
+    }
+    final enabled = control['pairedPauseEnabled'];
+    final actionValue = value['action'];
+    final action = switch (actionValue) {
+      'return' => WhaleCampAction.returnToSafety,
+      null when connection == WhaleCampConnection.online && value['shieldHold'] == true => WhaleCampAction.shield,
+      'shield' => null,
+      _ => WhaleCampAction.values.asNameMap()[actionValue],
+    };
+    final pausedAt = _date(control['pausedAt']);
+    final stopStatus = WhaleCampStopStatus.values.asNameMap()[control['stopStatus']];
+    final stopAt = _date(control['stopAt']);
+    if (enabled is! bool ||
+        actionValue != null && action == null ||
+        control['pausedAt'] != null && pausedAt == null ||
+        control['stopStatus'] != null && stopStatus == null ||
+        control['stopAt'] != null && stopAt == null) {
+      throw const FormatException('invalid-camp-status');
+    }
+    return WhaleCampSnapshot._(
+      connection: connection,
+      action: action,
+      observedAt: observedAt,
+      pairedPauseEnabled: enabled,
+      pausedAt: pausedAt,
+      stopStatus: stopStatus,
+      stopAt: stopAt,
+      campProject: WhaleCampProject.fromJson(value['project']),
+      patrol: WhaleCampPatrol.fromJson(value['patrol']),
+      gather: WhaleCampGather.fromJson(value['gather']),
+    );
+  }
+
+  static final _offset = RegExp(r'(?:Z|[+-]\d\d:\d\d)$');
+
+  static DateTime? _date(Object? value) => value is String && _offset.hasMatch(value) ? DateTime.tryParse(value) : null;
+}
