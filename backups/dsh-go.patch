+
+const _post = '64a01081-78c7-4bc6-a575-17e5bf029420';
+const _reply = '7ab0881c-a630-487c-b380-9b93fdb5d73f';
+const _removed = 'f6da62b4-a8cd-4dba-9b33-16d5d2553d62';
+const _timestamp = '2026-11-09T01:02:03Z';
+
+Json _event(int id, String source, String kind, {String? scene, String status = 'success', Json data = const {}}) => {
+  'id': id,
+  'source': source,
+  'kind': kind,
+  'contextId': scene,
+  'status': status,
+  'occurredAt': _timestamp,
+  'data': data,
+  'summary': 'private summary must stay out of the UI',
+};
+
+final _replyEvent = _event(
+  1,
+  'core.feed',
+  'post.replied',
+  data: {'postId': _reply, 'parentId': _post, 'author': 'companion'},
+);
+final _gameEvent = _event(2, 'minecraft.dig', 'task.succeeded', scene: 'game.minecraft');
+final _stageEvent = _event(
+  3,
+  'media.avatar',
+  'avatar.action.completed',
+  scene: 'avatar.stage',
+  data: {'action': 'point'},
+);
+
+const _watchReceipt = {
+  'activityId': 4,
+  'title': 'Tea house soundtrack',
+  'source': {'bvid': 'BV1dLx46TEhw', 'part': 2, 'startSeconds': 12, 'seconds': 4, 'visual': false, 'audio': true},
+};
+const _watchThread = '099be55c-0776-4fdb-a1f3-b0cf4c1411a8';
+
+class _WatchHost extends CompanionHost {
+  _WatchHost() : super(Uri.parse('https://localhost.invalid'), '');
+
+  bool active = true;
+  final shared = <int>[];
+  final sent = <({String? clip, String? threadId, String question})>[];
+
+  @override
+  Future<Json> bilibiliWatchSession(Future<void> abort) async => {
+    'thread': active
+        ? {
+            'threadId': _watchThread,
+            'receipt': _watchReceipt,
+            'turns': [
+              {'role': 'user', 'content': 'What do you hear?'},
+              {'role': 'assistant', 'content': 'Two bells.'},
+            ],
+          }
+        : null,
+  };
+
+  @override
+  Future<Json> watchBilibili({
+    String? clip,
+    String? threadId,
+    required String question,
+    required Future<void> abort,
+  }) async {
+    sent.add((clip: clip, threadId: threadId, question: question));
+    return {
+      'threadId': _watchThread,
+      'title': _watchReceipt['title'],
+      'text': 'A wooden bell.',
+      'receipt': _watchReceipt,
+    };
+  }
+
+  @override
+  Future<Json> rememberBilibiliWatch(int activityId, Future<void> abort) async {
+    shared.add(activityId);
+    return {'shared': true};
+  }
+}
+
+class _ThreadHost extends CompanionHost {
+  _ThreadHost() : super(Uri.parse('https://localhost.invalid'), '');
+
+  final requested = <String>[];
+
+  @override
+  Future<Json> thread(String id) async {
+    requested.add(id);
+    if (id == _removed) throw const HostError(404, 'not-found');
+    return {
+      'id': id,
+      'author': 'user',
+      'body': 'Original post',
+      'replies': [
+        {'id': 'other', 'author': 'companion', 'body': 'Another reply'},
+        {'id': _reply, 'author': 'companion', 'body': 'The selected reply'},
+      ],
+    };
+  }
+}
+
+class _ProjectHost extends CompanionHost {
+  _ProjectHost() : super(Uri.parse('https://localhost.invalid'), '');
+
+  final requested = <int?>[];
+  bool malformedCursor = false;
+
+  @override
+  Future<Json> houseProjectSections(String id, {int? after, Future<void>? abort}) async {
+    expect(id, 'tea-house');
+    requested.add(after);
+    return {
