+  @override
+  Widget build(BuildContext context) =>
+      _FeedSongPlayback(host: widget.host, audio: widget.audio, builder: _buildThread);
+
+  Widget _buildThread(BuildContext context, WhaleVoice? voice) {
+    final l = context.l10n;
+    return Scaffold(
+      appBar: AppBar(title: Text(l.whaleActivityThread)),
+      body: FutureBuilder<Json>(
+        future: _thread,
+        builder: (context, snapshot) {
+          if (snapshot.connectionState != ConnectionState.done) {
+            return const Center(child: CircularProgressIndicator());
+          }
+          final thread = snapshot.data;
+          if (thread == null) {
+            final error = snapshot.error;
+            final code = error is HostError ? error.status : null;
+            final message = switch (code) {
+              401 => l.whaleRevoked,
+              404 => l.whaleActivityPostGone,
+              _ => l.whaleFeedFailed,
+            };
+            return Center(
+              child: Padding(
+                padding: const EdgeInsets.all(16),
+                child: Column(
+                  mainAxisSize: MainAxisSize.min,
+                  children: [
+                    Text(message, textAlign: TextAlign.center),
+                    if (code != 401 && code != 404)
+                      TextButton(onPressed: () => setState(() => _thread = _load()), child: Text(l.whaleRefresh)),
+                  ],
+                ),
+              ),
+            );
+          }
+          final replies = (thread['replies'] as List).whereType<Json>().toList();
+          final reply = replies.where((item) => item['id'] == widget.replyId).firstOrNull;
+          return ListView(
+            padding: const EdgeInsets.all(16),
+            children: [
+              _postCard(thread, topLevel: true, voice: voice),
+              if (widget.replyId != null) ...[
+                const SizedBox(height: 12),
+                Text(l.whaleActivitySelectedReply, style: Theme.of(context).textTheme.titleMedium),
+                if (reply == null) Text(l.whaleActivityReplyGone) else _postCard(reply),
+              ],
+              if (replies.any((item) => !identical(item, reply))) ...[
+                const SizedBox(height: 12),
+                Text(l.whaleReplies, style: Theme.of(context).textTheme.titleMedium),
+                for (final item in replies)
+                  if (!identical(item, reply)) _postCard(item),
+              ],
+            ],
+          );
+        },
+      ),
+    );
+  }
+
+  Widget _postCard(Json post, {bool topLevel = false, WhaleVoice? voice}) => Card(
+    child: Padding(
+      padding: const EdgeInsets.all(14),
+      child: _FeedPostContent(widget.host, widget.persona, post, topLevel: topLevel, voice: voice),
+    ),
+  );
+}
+
+WhaleBilibiliSource? _bilibiliSource(Json post) {
+  final wire = post['bilibiliSource'];
+  if (post['author'] != 'companion' || post['parentId'] != null || wire is! Json || wire.length != 3) return null;
+  final source = WhaleBilibiliSource.fromWire(wire);
+  return source?.startSeconds != null ? source : null;
+}
