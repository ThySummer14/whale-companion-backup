diff --git a/app/lib/whale/bilibili_state.dart b/app/lib/whale/bilibili_state.dart
new file mode 100644
index 0000000000000000000000000000000000000000..5b9d4df8cb813af06504ec972575e82d34910998
--- /dev/null
+++ b/app/lib/whale/bilibili_state.dart
@@ -0,0 +1,148 @@
+const bilibiliContext = 'world.bilibili';
+const bilibiliClipLimit = 12;
+const _lastStartSecond = 604800;
+final _videoId = RegExp(r'^BV[A-Za-z0-9]{10}$');
+final _videoPath = RegExp(r'^/video/(BV[A-Za-z0-9]{10})/?$');
+final _timeInput = RegExp(r'^\d{1,6}(?::\d{2}){0,2}$');
+
+enum WhaleBilibiliMode {
+  both('画面和声音'),
+  visual('画面'),
+  audio('声音');
+
+  const WhaleBilibiliMode(this.command);
+  final String command;
+}
+
+class BilibiliConversation {
+  const BilibiliConversation._(this.maxClipSeconds);
+  final int maxClipSeconds;
+
+  static BilibiliConversation? fromState(Map state) {
+    final capability = state['bilibiliConversation'];
+    if (capability is! Map ||
+        capability['version'] is! int ||
+        capability['version'] != 1 ||
+        capability['contextId'] != bilibiliContext) {
+      return null;
+    }
+    final maxSeconds = capability['maxClipSeconds'];
+    return maxSeconds is int && maxSeconds > 0 ? BilibiliConversation._(maxSeconds.clamp(1, bilibiliClipLimit)) : null;
+  }
+}
+
+class WhaleBilibiliSource {
+  const WhaleBilibiliSource._(this.bvid, this.part, this.startSeconds);
+  final String bvid;
+  final int part;
+  final int? startSeconds;
+
+  Uri get uri => Uri.https('www.bilibili.com', '/video/$bvid/', {
+    'p': '$part',
+    if (startSeconds case final seconds?) 't': '$seconds',
+  });
+
+  String get time {
+    final seconds = startSeconds ?? 0;
+    final minutes = seconds ~/ 60;
+    final rest = (seconds % 60).toString().padLeft(2, '0');
+    return '$minutes:$rest';
+  }
+
+  static WhaleBilibiliSource? fromWire(Object? value) {
+    if (value is! Map) return null;
+    final bvid = value['bvid'];
+    final part = value['part'];
+    final start = value['startSeconds'];
+    if (bvid is! String ||
+        bvid.length != 12 ||
+        !_videoId.hasMatch(bvid) ||
+        part is! int ||
+        part < 1 ||
+        part > 1000 ||
+        value.containsKey('startSeconds') && (start is! int || start < 0 || start > _lastStartSecond)) {
+      return null;
+    }
+    return WhaleBilibiliSource._(bvid, part, start as int?);
+  }
+
+  static WhaleBilibiliSource? fromInput(String text) {
+    final value = text.trim();
+    if (value.length > 2000) return null;
+    if (value.length == 12 && _videoId.hasMatch(value)) return WhaleBilibiliSource._(value, 1, null);
+    if (!value.startsWith('https://www.bilibili.com/video/') || RegExp(r'[\\\s]').hasMatch(value)) return null;
+    final uri = Uri.tryParse(value);
+    if (uri == null || uri.host != 'www.bilibili.com' || uri.port != 443 || uri.userInfo.isNotEmpty) return null;
+    final bvid = _videoPath.firstMatch(uri.path)?.group(1);
+    if (bvid == null) return null;
+    final Map<String, List<String>> query;
+    try {
+      query = uri.queryParametersAll;
+    } on FormatException {
+      return null;
+    }
+    final pages = query['p'];
+    final timestamps = query['t'];
+    if ((pages?.length ?? 0) > 1 || (timestamps?.length ?? 0) > 1) return null;
+    final page = pages?.single;
+    final timestamp = timestamps?.single;
+    if (page != null && !RegExp(r'^\d{1,4}$').hasMatch(page) ||
+        timestamp != null && !RegExp(r'^\d{1,6}$').hasMatch(timestamp)) {
+      return null;
+    }
+    return fromWire({
+      'bvid': bvid,
+      'part': page == null ? 1 : int.parse(page),
+      if (timestamp != null) 'startSeconds': int.parse(timestamp),
+    });
+  }
+}
+
+int? parseWhaleBilibiliStart(String text) {
+  final value = text.trim();
+  if (!_timeInput.hasMatch(value)) return null;
+  final parts = value.split(':').map(int.parse).toList(growable: false);
+  if (parts.skip(1).any((part) => part >= 60)) return null;
+  final seconds = parts.fold<int>(0, (total, part) => total * 60 + part);
+  return seconds <= _lastStartSecond ? seconds : null;
+}
+
+String whaleBilibiliClipDraft(WhaleBilibiliSource source, int start, int seconds, WhaleBilibiliMode mode) {
+  final target = source.part == 1 ? source.bvid : 'https://www.bilibili.com/video/${source.bvid}/?p=${source.part}';
+  return '看这段 $target $start $seconds秒 ${mode.command}';
+}
+
+class WhaleBilibiliReceipt {
+  const WhaleBilibiliReceipt._({required this.clip, this.source, this.seconds, this.material});
+  final bool clip;
+  final WhaleBilibiliSource? source;
+  final int? seconds;
+  final WhaleBilibiliMode? material;
+
+  static WhaleBilibiliReceipt? fromWire(Object? value) {
+    if (value is! Map || value['mode'] != 'clip' && value['mode'] != 'subtitle') return null;
+    final data = value['source'];
+    final source = WhaleBilibiliSource.fromWire(data);
+    if (value['mode'] == 'subtitle') {
+      return WhaleBilibiliReceipt._(clip: false, source: source?.startSeconds == null ? source : null);
+    }
+    if (source?.startSeconds == null || data is! Map) return const WhaleBilibiliReceipt._(clip: true);
+    final seconds = data['seconds'];
+    final visual = data['visual'];
+    final audio = data['audio'];
+    if (seconds is! int ||
+        seconds < 1 ||
+        seconds > bilibiliClipLimit ||
+        visual is! bool ||
+        audio is! bool ||
+        !visual && !audio) {
+      return const WhaleBilibiliReceipt._(clip: true);
+    }
+    return WhaleBilibiliReceipt._(
+      clip: true,
+      source: source,
+      seconds: seconds,
+      material: visual ? (audio ? WhaleBilibiliMode.both : WhaleBilibiliMode.visual) : WhaleBilibiliMode.audio,
+    );
+  }
+}
