+  );
+
+  test(
+    'voice stream rejects redirects, corrupt PCM metadata and an incomplete final sample',
+    () => HttpOverrides.runWithHttpOverrides(() async {
+      final server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
+      addTearDown(() => server.close(force: true));
+      final host = CompanionHost(Uri.parse('http://127.0.0.1:${server.port}'), 'Device fake.credential');
+      addTearDown(host.close);
+      final abort = Completer<void>();
+      addTearDown(abort.complete);
+      var status = 302;
+      var rate = '7999';
+      var leaked = false;
+      server.listen((request) async {
+        if (request.uri.path == '/outside') leaked = true;
+        await request.drain<void>();
+        final response = request.response..bufferOutput = false;
+        response.statusCode = status;
+        if (status == 302) response.headers.set('location', '/outside');
+        if (status == 200) {
+          response.headers.contentType = ContentType('application', 'octet-stream');
+          response.headers.set('x-companion-sample-rate', rate);
+          response.add([1, 2, 3]);
+          await response.flush();
+        }
+        await response.close();
+      });
+      await expectLater(
+        host.openVoiceStream('redirect', abort.future),
+        throwsA(isA<HostError>().having((error) => error.status, 'status', 302)),
