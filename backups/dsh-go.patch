+  final headerLength = header.getUint32(4);
+  if (headerLength < 6 || headerLength > bytes.length - 20) return false;
+  final format = header.getUint16(8);
+  final tracks = header.getUint16(10);
+  final division = header.getUint16(12);
+  return format <= 1 && tracks > 0 && tracks <= 32 && (format != 0 || tracks == 1) && division > 0 && division < 0x8000;
