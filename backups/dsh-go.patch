+      final recording = _dictation.phase == DictationPhase.recording;
+      final access = _dictation.access;
+      final enabled = _online && !_revoked && !_submitting && widget.active;
+      final singing = widget.host.singingConversation;
+      final browsing = widget.host.bilibiliConversation;
+      final canPick = enabled && !_pickingAttachments && !_dictation.active && conversation == null;
+      final hint = switch (_dictation.phase) {
+        DictationPhase.permission || DictationPhase.starting => l.whaleDictationPreparing,
+        DictationPhase.recording => conversation == null ? l.whaleDictationRecording : l.whaleConversationListening,
+        DictationPhase.transcribing => l.whaleDictationTranscribing,
+        DictationPhase.idle when conversation != null => switch (conversation) {
+          _ConversationPhase.waiting => l.whaleConversationWaiting,
+          _ConversationPhase.speaking => l.whaleConversationSpeaking,
+          _ => l.whaleDictationPreparing,
+        },
+        DictationPhase.idle when !enabled => null,
+        DictationPhase.idle => switch (_dictation.notice) {
+          DictationNotice.ready => l.whaleDictationDraft,
+          DictationNotice.denied => l.chatVoicePermissionNeeded,
+          DictationNotice.blocked => l.chatVoicePermissionOff,
+          DictationNotice.recordingFailed => l.chatVoiceMicrophoneFailed,
+          DictationNotice.noSpeech => l.chatVoiceNotHeard,
+          DictationNotice.busy => l.chatVoiceBusy,
+          DictationNotice.failed => l.chatVoiceTranscriptionFailed,
+          DictationNotice.draftFull => l.whaleDictationDraftFull,
+          null => switch (access) {
+            DictationAccess.unavailable => l.whaleDictationUnavailable,
+            DictationAccess.failed => l.whaleDictationCheckFailed,
+            _ => null,
+          },
+        },
+      };
+      final action = recording
+          ? () => unawaited(_dictation.stop(automatic: conversation != null))
+          : !enabled || _dictation.active || conversation != null || _pickingAttachments
+          ? null
