+class _Socket extends Stream<dynamic> implements WebSocket {
+  _Socket(this.contextId);
+
+  final String contextId;
+  final frames = StreamController<String>();
+
+  void emit(String type, [Json payload = const {}]) => frames.add(
+    jsonEncode({'type': type, 'contextId': contextId, 'sessionId': 'session', 'cursor': null, 'payload': payload}),
+  );
+
+  @override
+  StreamSubscription<dynamic> listen(
+    void Function(dynamic)? onData, {
+    Function? onError,
+    void Function()? onDone,
+    bool? cancelOnError,
+  }) => frames.stream.listen(onData, onError: onError, onDone: onDone, cancelOnError: cancelOnError);
+
+  @override
+  Future<void> close([int? code, String? reason]) => frames.close();
+
+  @override
+  dynamic noSuchMethod(Invocation invocation) => super.noSuchMethod(invocation);
+}
