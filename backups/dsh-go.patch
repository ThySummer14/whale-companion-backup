+  Widget _userBubble(String text, String? messageId, List<ChatAttachment> attachments, ColorScheme colors) => Align(
+    alignment: Alignment.centerRight,
+    child: Container(
+      constraints: BoxConstraints(maxWidth: MediaQuery.sizeOf(context).width * .78),
+      padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 10),
+      decoration: BoxDecoration(color: colors.primaryContainer, borderRadius: BorderRadius.circular(18)),
+      child: Column(
+        mainAxisSize: MainAxisSize.min,
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          if (text.isNotEmpty) SelectableText(text),
+          if (messageId != null && attachments.isNotEmpty)
+            Wrap(
+              spacing: 6,
+              runSpacing: 4,
+              children: [
+                for (final attachment in attachments)
+                  ActionChip(
+                    avatar: _openingAttachment == (messageId, attachment.id)
+                        ? const SizedBox.square(dimension: 15, child: CircularProgressIndicator(strokeWidth: 2))
+                        : Icon(attachment.isImage ? Icons.image_outlined : Icons.file_download_outlined, size: 16),
+                    label: Text(
+                      '${attachment.name} · ${formatBytes(attachment.bytes)}',
+                      overflow: TextOverflow.ellipsis,
+                    ),
+                    onPressed:
+                        _voiceForeground && _attachmentDownload == null && _conversation == null && !_pickingAttachments
+                        ? () => unawaited(_openAttachment(messageId, attachment))
+                        : null,
+                  ),
+              ],
+            ),
+        ],
+      ),
+    ),
+  );
+
+  @override
+  Widget build(BuildContext context) {
+    final l = context.l10n;
+    final colors = Theme.of(context).colorScheme;
+    return Column(
+      children: [
+        if (!_online || _error != null)
+          Padding(
+            padding: const EdgeInsets.all(12),
+            child: Text(
+              _revoked
+                  ? l.whaleRevoked
+                  : switch (_error) {
+                      HostError(code: 'turn-failed') => l.whaleTurnFailed,
+                      HostError(code: 'chat-send-failed') => l.whaleChatSendFailed,
+                      HostError(code: 'chat-session-changed') => l.whaleChatSessionChanged,
+                      HostError(code: 'chat-request-conflict') => l.whaleChatRequestConflict,
+                      HostError(code: 'chat-retry-unavailable') => l.whaleChatRetryUnavailable,
+                      HostError(code: 'chat-attachment-send-failed') => l.whaleChatAttachmentSendFailed,
+                      HostError(code: 'singing-conversation-unavailable') => l.whaleSingingConversationUnavailable,
+                      HostError(code: 'singing-conversation-binding-conflict') =>
+                        l.whaleSingingConversationBindingConflict,
+                      _ => l.whaleConnecting,
+                    },
+            ),
+          ),
+        Expanded(
+          child: ListView.builder(
+            reverse: true,
+            controller: _scroll,
+            padding: const EdgeInsets.all(16),
+            itemCount: _messages.length + 1,
+            itemBuilder: (context, index) {
+              if (index == 0) {
+                return _stream.isEmpty
+                    ? Padding(
+                        padding: const EdgeInsets.only(top: 8),
+                        child: Text(
+                          _waiting
+                              ? l.whaleThinking
+                              : _messages.isEmpty
+                              ? l.whaleChatEmpty
+                              : '',
+                        ),
+                      )
+                    : MarkdownBody(text: _stream, streaming: true);
+              }
+              final item = _messages[_messages.length - index];
+              final text = item['text'] as String? ?? '';
+              final id = item['id'];
+              final attachments = ChatAttachment.fromMessage(item['attachments']);
+              if (text.isEmpty && (item['role'] != 'user' || attachments.isEmpty)) return const SizedBox.shrink();
+              return Padding(
+                key: ValueKey(item['id']),
+                padding: const EdgeInsets.only(bottom: 18),
+                child: item['role'] == 'user'
+                    ? _userBubble(text, id is String ? id : null, attachments, colors)
+                    : Column(
+                        crossAxisAlignment: CrossAxisAlignment.start,
+                        children: [
+                          MarkdownBody(text: text),
+                          if (item['role'] == 'assistant' && item['id'] is String)
+                            _voiceButton(item['id'] as String, text),
+                        ],
+                      ),
+              );
+            },
+          ),
+        ),
+        _composer(l),
+      ],
+    );
+  }
+}
