+// SPDX-License-Identifier: AGPL-3.0-only
+// Now Playing stage adapted from egoist/mygo-music, see THIRD_PARTY_NOTICES.md.
+
+import 'dart:async';
+import 'dart:math' as math;
+import 'dart:ui' as ui;
+
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+
+import '../l10n/l10n.dart';
+import 'host.dart';
+import 'song_player.dart';
+
+const myGoStage = Color(0xff0b0b0d);
+const myGoSurface = Color(0xff1c1c1f);
+const myGoText = Color(0xfff5f5f7);
+const myGoMuted = Color(0xff9a9aa2);
+
+Future<Color>? _tint;
+
+Future<Color> whaleAlbumTint() => _tint ??= () async {
+  try {
+    final data = await rootBundle.load('assets/whale_app/album-background.webp');
+    final codec = await ui.instantiateImageCodec(data.buffer.asUint8List(), targetWidth: 24, targetHeight: 24);
+    final frame = await codec.getNextFrame();
+    final bytes = await frame.image.toByteData(format: ui.ImageByteFormat.rawRgba);
+    frame.image.dispose();
+    codec.dispose();
+    if (bytes == null) return const ui.Color(0xff787882);
+    var r = 0, g = 0, b = 0;
+    final pixels = bytes.lengthInBytes ~/ 4;
+    for (var i = 0; i < pixels; i++) {
+      r += bytes.getUint8(i * 4);
+      g += bytes.getUint8(i * 4 + 1);
+      b += bytes.getUint8(i * 4 + 2);
+    }
+    return Color.fromARGB(255, r ~/ pixels, g ~/ pixels, b ~/ pixels);
+  } catch (_) {
+    return const Color(0xff787882);
+  }
+}();
+
+typedef LyricLine = ({int ms, String text});
+
+List<LyricLine> parseLrc(String source) {
+  final stamp = RegExp(r'\[(\d{1,2}):(\d{2})(?:[.:](\d{1,3}))?\]');
+  final lines = <LyricLine>[];
+  for (final raw in source.split('\n')) {
+    final matches = stamp.allMatches(raw).toList();
+    if (matches.isEmpty) continue;
+    final text = raw.replaceAll(stamp, '').trim();
+    if (text.isEmpty) continue;
+    for (final match in matches) {
+      final fraction = match.group(3) ?? '0';
+      final ms = int.parse(match.group(1)!) * 60_000 + int.parse(match.group(2)!) * 1000 +
+          int.parse(fraction.padRight(3, '0').substring(0, 3));
+      lines.add((ms: ms, text: text));
+    }
+  }
+  lines.sort((a, b) => a.ms.compareTo(b.ms));
+  return lines;
+}
+
+int activeLyricIndex(List<LyricLine> lines, int positionMs) {
+  var index = -1;
+  for (var i = 0; i < lines.length; i++) {
+    if (lines[i].ms <= positionMs) {
+      index = i;
+    } else {
+      break;
+    }
+  }
+  return index;
+}
