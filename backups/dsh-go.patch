diff --git a/app/lib/whale/activity.dart b/app/lib/whale/activity.dart
new file mode 100644
index 0000000000000000000000000000000000000000..f2d230faa09e96ebcf9593ea8bca9d065a41a6d9
--- /dev/null
+++ b/app/lib/whale/activity.dart
@@ -0,0 +1,225 @@
+import 'package:flutter/material.dart';
+
+import '../l10n/l10n.dart';
+import 'status.dart';
+
+enum WhaleActivityCategory { feed, game, stage }
+
+enum WhaleActivityKind {
+  post(WhaleActivityCategory.feed),
+  reply(WhaleActivityCategory.feed),
+  move(WhaleActivityCategory.game),
+  gather(WhaleActivityCategory.game),
+  craft(WhaleActivityCategory.game),
+  build(WhaleActivityCategory.game),
+  camp(WhaleActivityCategory.game),
+  safeReturn(WhaleActivityCategory.game),
+  follow(WhaleActivityCategory.game),
+  blush(WhaleActivityCategory.stage),
+  point(WhaleActivityCategory.stage),
+  speech(WhaleActivityCategory.stage);
+
+  const WhaleActivityKind(this.category);
+  final WhaleActivityCategory category;
+
+  String label(L10n l) => switch (this) {
+    post => l.whaleActivityPost,
+    reply => l.whaleActivityReply,
+    move => l.whaleActivityMove,
+    gather => l.whaleActivityGather,
+    craft => l.whaleActivityCraft,
+    build => l.whaleActivityBuild,
+    camp => l.whaleActivityCamp,
+    safeReturn => l.whaleActivityReturn,
+    follow => l.whaleActivityFollow,
+    blush => l.whaleActivityBlush,
+    point => l.whaleActivityPoint,
+    speech => l.whaleActivitySpeech,
+  };
+}
+
+class WhaleActivity {
+  const WhaleActivity(this.id, this.at, this.kind, {this.threadId, this.replyId});
+
+  final int id;
+  final DateTime at;
+  final WhaleActivityKind kind;
+  final String? threadId;
+  final String? replyId;
+
+  static final _uuid = RegExp(r'^[\da-f]{8}(?:-[\da-f]{4}){3}-[\da-f]{12}$', caseSensitive: false);
+  static String? _postId(Object? id) => id is String && _uuid.hasMatch(id) ? id : null;
+
+  static List<WhaleActivity>? fromRecords(Object? records) {
+    if (records is! List) return null;
+    final deleted = <String>{};
+    for (final row in records.whereType<Map>()) {
+      if (row['source'] == 'core.feed' && row['kind'] == 'post.deleted' && row['status'] == 'success') {
+        final data = row['data'];
+        if (data is Map) {
+          final postId = _postId(data['postId']);
+          if (postId != null) deleted.add(postId);
+        }
+      }
+    }
+    final events = <int, WhaleActivity>{};
+    for (final row in records.whereType<Map>()) {
+      final item = _fromRecord(row, deleted);
+      if (item != null) events.putIfAbsent(item.id, () => item);
+    }
+    return events.values.toList()..sort((a, b) {
+      final order = b.at.compareTo(a.at);
+      return order == 0 ? b.id.compareTo(a.id) : order;
+    });
+  }
+
+  static WhaleActivity? _fromRecord(Map row, Set<String> deleted) {
+    final id = row['id'];
+    final stamp = row['occurredAt'];
+    if (id is! int || id <= 0 || stamp is! String || row['status'] != 'success') return null;
+    final at = DateTime.tryParse(stamp);
+    if (at == null) return null;
+    final source = row['source'];
+    final kind = row['kind'];
+    final data = row['data'];
+    if (source == 'core.feed' && data is Map && data['author'] == 'companion') {
+      final postId = _postId(data['postId']);
+      if (postId == null || deleted.contains(postId)) return null;
+      if (kind == 'post.created' && data['parentId'] == null) {
+        return WhaleActivity(id, at, WhaleActivityKind.post, threadId: postId);
+      }
+      final parentId = _postId(data['parentId']);
+      if (kind == 'post.replied' && parentId != null && !deleted.contains(parentId)) {
+        return WhaleActivity(id, at, WhaleActivityKind.reply, threadId: parentId, replyId: postId);
+      }
+      return null;
+    }
+    final activity = switch ((kind, source, row['contextId'])) {
+      ('task.succeeded', 'minecraft.move', 'game.minecraft') => WhaleActivityKind.move,
+      ('task.succeeded', 'minecraft.dig', 'game.minecraft') => WhaleActivityKind.gather,
+      ('task.succeeded', 'minecraft.craft', 'game.minecraft') => WhaleActivityKind.craft,
+      ('task.succeeded', 'minecraft.build', 'game.minecraft') => WhaleActivityKind.build,
+      ('task.succeeded', 'minecraft.prepare', 'game.minecraft') => WhaleActivityKind.camp,
+      ('task.succeeded', 'minecraft.return', 'game.minecraft') => WhaleActivityKind.safeReturn,
+      ('task.succeeded', 'minecraft.follow', 'game.minecraft') => WhaleActivityKind.follow,
+      ('task.succeeded', 'media.realtime', _) => WhaleActivityKind.speech,
+      ('avatar.action.completed', 'media.avatar', 'avatar.stage') when data is Map => switch (data['action']) {
+        'blush' => WhaleActivityKind.blush,
+        'point' => WhaleActivityKind.point,
+        _ => null,
+      },
+      _ => null,
+    };
+    return activity == null ? null : WhaleActivity(id, at, activity);
+  }
+}
+
+class WhaleActivityPage extends StatefulWidget {
+  const WhaleActivityPage({
+    required this.items,
+    required this.syncedAt,
+    required this.connection,
+    required this.refreshing,
+    required this.onRefresh,
+    required this.onOpenThread,
+    super.key,
+  });
+
+  final List<WhaleActivity>? items;
+  final DateTime? syncedAt;
+  final WhaleStatusConnection connection;
+  final bool refreshing;
+  final Future<void> Function() onRefresh;
+  final void Function(String threadId, String? replyId) onOpenThread;
+
+  @override
+  State<WhaleActivityPage> createState() => _WhaleActivityPageState();
+}
+
+class _WhaleActivityPageState extends State<WhaleActivityPage> {
+  WhaleActivityCategory? _category;
+
+  String _label(L10n l, WhaleActivityCategory? category) => switch (category) {
+    null => l.whaleActivityAll,
+    WhaleActivityCategory.feed => l.whaleFeed,
+    WhaleActivityCategory.game => 'Minecraft',
+    WhaleActivityCategory.stage => l.whaleStatusAvatar,
+  };
+
+  @override
+  Widget build(BuildContext context) {
+    final l = context.l10n;
+    final local = MaterialLocalizations.of(context);
+    final theme = Theme.of(context);
+    final visible = widget.connection == WhaleStatusConnection.revoked
+        ? null
+        : widget.items?.where((item) => _category == null || item.kind.category == _category).toList();
+    final status = switch (widget.connection) {
+      WhaleStatusConnection.reachable => widget.refreshing && widget.syncedAt == null ? l.whaleActivityLoading : null,
+      WhaleStatusConnection.unreachable => l.whaleStatusUnreachable,
+      WhaleStatusConnection.revoked => l.whaleRevoked,
+    };
+    final syncedAt = widget.syncedAt?.toLocal();
+    return RefreshIndicator(
+      onRefresh: widget.onRefresh,
+      child: ListView(
+        physics: const AlwaysScrollableScrollPhysics(),
+        padding: const EdgeInsets.fromLTRB(16, 12, 16, 24),
+        children: [
+          Row(
+            children: [
+              Expanded(child: Text(l.whaleActivityTab, style: theme.textTheme.titleLarge)),
+              IconButton(
+                tooltip: l.whaleRefresh,
+                onPressed: widget.refreshing ? null : widget.onRefresh,
+                icon: widget.refreshing
+                    ? const SizedBox.square(dimension: 18, child: CircularProgressIndicator(strokeWidth: 2))
+                    : const Icon(Icons.refresh),
+              ),
+            ],
+          ),
+          if (status != null) Text(status),
+          if (syncedAt != null)
+            Text(
+              l.whaleStatusLastSync(
+                '${local.formatShortDate(syncedAt)} ${local.formatTimeOfDay(TimeOfDay.fromDateTime(syncedAt))}',
+              ),
+              style: theme.textTheme.bodySmall,
+            ),
+          const SizedBox(height: 8),
+          Wrap(
+            spacing: 8,
+            children: [
+              for (final category in [null, ...WhaleActivityCategory.values])
+                ChoiceChip(
+                  label: Text(_label(l, category)),
+                  selected: _category == category,
+                  onSelected: (_) => setState(() => _category = category),
+                ),
+            ],
+          ),
+          const SizedBox(height: 8),
+          if (visible == null && status == null) Text(l.whaleActivityUnavailable),
+          if (visible?.isEmpty == true) Text(l.whaleActivityEmpty),
+          for (final item in visible ?? const <WhaleActivity>[])
+            Card(
+              key: ValueKey(item.id),
+              child: ListTile(
+                leading: Icon(switch (item.kind.category) {
+                  WhaleActivityCategory.feed => Icons.forum_outlined,
+                  WhaleActivityCategory.game => Icons.sports_esports_outlined,
+                  WhaleActivityCategory.stage => Icons.face_outlined,
+                }),
+                title: Text(item.kind.label(l)),
+                subtitle: Text(
+                  '${local.formatShortDate(item.at.toLocal())} · ${local.formatTimeOfDay(TimeOfDay.fromDateTime(item.at.toLocal()))}',
+                ),
+                trailing: item.threadId == null ? null : const Icon(Icons.chevron_right),
+                onTap: item.threadId == null ? null : () => widget.onOpenThread(item.threadId!, item.replyId),
+              ),
+            ),
+        ],
+      ),
+    );
+  }
+}
