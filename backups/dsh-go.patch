+      expect(blocks.current, first);
+      expect(release.isCompleted, isFalse);
+      release.complete();
+      expect(await blocks.moveNext(), isTrue);
+      expect(blocks.current, [10, 11]);
+      expect(await blocks.moveNext(), isFalse);
+    }, _RealHttp()),
+  );
+
+  test(
+    'voice stream uses known synthesis sources and leaves old or unknown sources absent',
+    () => HttpOverrides.runWithHttpOverrides(() async {
+      final server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
+      addTearDown(() => server.close(force: true));
+      final host = CompanionHost(Uri.parse('http://127.0.0.1:${server.port}'), '');
+      addTearDown(host.close);
+      final abort = Completer<void>();
+      addTearDown(abort.complete);
+      const sources = {
+        'full': VoiceStreamSource.full,
+        'prefetch-complete': VoiceStreamSource.prefetchComplete,
+        'prefetch-live': VoiceStreamSource.prefetchLive,
+        'unknown': null,
+        'absent': null,
+      };
+      server.listen((request) async {
+        final body = jsonDecode(await utf8.decoder.bind(request).join()) as Json;
+        final id = body['messageId'] as String;
+        final response = request.response;
+        response.headers.contentType = ContentType('application', 'octet-stream');
+        response.headers.set('x-companion-sample-rate', '24000');
+        if (id != 'absent') response.headers.set('x-companion-voice-source', id);
+        response.add([1, 0]);
+        await response.close();
+      });
+      for (final entry in sources.entries) {
+        final voice = await host.openVoiceStream(entry.key, abort.future);
