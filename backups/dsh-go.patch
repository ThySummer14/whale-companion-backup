+import 'dart:async';
+
+import 'package:flutter/material.dart';
+
+import '../l10n/l10n.dart';
+import 'host.dart';
+
+class WhaleHouseProjectProgress {
+  const WhaleHouseProjectProgress._(
+    this.id,
+    this.name,
+    this.total,
+    this.verified,
+    this.running,
+    this.interrupted,
+    this.lastVerification,
+  );
+
+  final String id;
+  final String name;
+  final int total;
+  final int verified;
+  final int running;
+  final int interrupted;
+  final ({bool matched, int checked, int unmatched, DateTime at})? lastVerification;
+
+  static List<WhaleHouseProjectProgress> fromState(Object? payload) {
+    if (payload case {'version': 1, 'items': final List items}) {
+      return items.map(_parse).whereType<WhaleHouseProjectProgress>().toList(growable: false);
+    }
+    return const [];
+  }
+
+  static WhaleHouseProjectProgress? _parse(Object? row) {
+    if (row
+        case {
+          'id': final String id,
+          'name': final String name,
+          'totalSections': final int total,
+          'verifiedSections': final int verified,
+          'runningSections': final int running,
+          'interruptedSections': final int interrupted,
+        }
+        when id.isNotEmpty &&
+            name.trim().isNotEmpty &&
+            total > 0 &&
+            verified >= 0 &&
+            running >= 0 &&
+            interrupted >= 0 &&
+            verified + running + interrupted <= total) {
+      final value = (row as Map)['lastVerification'];
+      if (value
+          case {
+            'matched': final bool matched,
+            'checked': final int checked,
+            'unmatchedSections': final int unmatched,
+            'checkedAt': final String checkedAt,
+          }
+          when checked > 0 && unmatched >= 0 && unmatched <= total && matched == (unmatched == 0)) {
+        final at = DateTime.tryParse(checkedAt);
+        if (at != null) {
+          return WhaleHouseProjectProgress._(id, name, total, verified, running, interrupted, (
+            matched: matched,
+            checked: checked,
+            unmatched: unmatched,
+            at: at,
+          ));
+        }
+      }
+      return WhaleHouseProjectProgress._(id, name, total, verified, running, interrupted, null);
+    }
+    return null;
+  }
+
+  String summary(L10n l) => '${l.whaleHouseProjectSections(verified, total)} · ${_label(l)}';
+
+  String _label(L10n l) {
+    if (running > 0) return l.whaleApprovalBuilding;
+    if (interrupted > 0) return l.whaleHouseProjectNeedsWork;
+    if (verified == total) {
+      return lastVerification?.matched == true ? l.whaleHouseProjectVerified : l.whaleHouseProjectAwaitingVerification;
+    }
+    return l.whaleHouseProjectPending;
+  }
+}
+
+class WhaleHouseProjectList extends StatelessWidget {
+  const WhaleHouseProjectList({
+    required this.projects,
+    required this.host,
+    required this.loadSections,
+    required this.onRevoked,
+    super.key,
+  });
+
+  final List<WhaleHouseProjectProgress> projects;
+  final CompanionHost host;
+  final bool loadSections;
+  final VoidCallback onRevoked;
+
+  @override
+  Widget build(BuildContext context) {
+    final l = context.l10n;
+    final newest = projects.first;
+    return Card(
+      child: ExpansionTile(
+        key: const PageStorageKey('house-projects'),
+        title: Text(l.whaleHouseProjects),
+        subtitle: Text('${newest.name} · ${newest.summary(l)}'),
+        children: [for (final project in projects) _project(context, project)],
+      ),
+    );
+  }
+
+  Widget _project(BuildContext context, WhaleHouseProjectProgress project) {
+    final l = context.l10n;
+    final local = MaterialLocalizations.of(context);
+    final last = project.lastVerification;
+    return ExpansionTile(
+      key: PageStorageKey(('house-project', project.id)),
+      title: Text(project.name),
+      subtitle: Text(project.summary(l)),
+      expandedCrossAxisAlignment: CrossAxisAlignment.stretch,
+      childrenPadding: const EdgeInsets.fromLTRB(16, 0, 16, 16),
+      children: [
+        if (last != null) ...[
+          Text(
+            l.whaleHouseProjectLastCheck(
+              local.formatShortDate(last.at.toLocal()),
+              local.formatTimeOfDay(TimeOfDay.fromDateTime(last.at.toLocal())),
+            ),
+          ),
+          Text(
+            last.matched
+                ? l.whaleActivityHouseVerifiedDetail(last.checked)
+                : l.whaleHouseProjectLastMismatch(last.unmatched),
+          ),
+        ],
+        if (loadSections)
+          _WhaleHouseProjectSections(
+            key: ValueKey((
+              host,
+              project.id,
+              project.total,
+              project.verified,
+              project.running,
+              project.interrupted,
+              last?.at,
+            )),
+            host: host,
+            id: project.id,
+            onRevoked: onRevoked,
+          ),
+      ],
+    );
+  }
+}
+
+class _WhaleHouseProjectSections extends StatefulWidget {
+  const _WhaleHouseProjectSections({required this.host, required this.id, required this.onRevoked, super.key});
+
+  final CompanionHost host;
+  final String id;
+  final VoidCallback onRevoked;
+
+  @override
+  State<_WhaleHouseProjectSections> createState() => _WhaleHouseProjectSectionsState();
+}
+
+class _WhaleHouseProjectSectionsState extends State<_WhaleHouseProjectSections> {
+  final _abort = Completer<void>();
+  final _items = <Json>[];
+  bool _loading = false;
+  bool _failed = false;
+  int? _after;
+
+  @override
+  void initState() {
+    super.initState();
+    unawaited(_load());
+  }
+
+  @override
+  void dispose() {
+    _abort.complete();
+    super.dispose();
+  }
+
+  Future<void> _load() async {
+    if (_loading) return;
+    setState(() {
+      _loading = true;
+      _failed = false;
+    });
+    try {
+      final page = await widget.host.houseProjectSections(widget.id, after: _after, abort: _abort.future);
+      if (!mounted) return;
+      if (page case {'version': 1, 'items': final List items}) {
+        final rows = items.whereType<Json>().toList(growable: false);
+        var previous = _after ?? -1;
+        for (final row in rows) {
+          if (row case {'index': final int index, 'name': final String _, 'status': final String status}
+              when index > previous && const ['pending', 'running', 'interrupted', 'built'].contains(status)) {
+            previous = index;
+          } else {
+            throw const FormatException('Invalid house section');
+          }
+        }
+        final next = page['nextAfter'];
+        if (rows.length != items.length || (next != null && (next is! int || rows.isEmpty || next != previous))) {
+          throw const FormatException('Invalid house section page');
+        }
+        setState(() {
+          _items.addAll(rows);
+          _after = next as int?;
+        });
+      } else {
+        throw const FormatException('Unsupported house section page');
+      }
+    } on Exception catch (error) {
+      if (!mounted) return;
+      if (error is HostError && error.status == 401) widget.onRevoked();
+      setState(() {
+        if (error is HostError && (error.status == 401 || error.status == 404)) {
+          _items.clear();
+          _after = null;
+        }
+        _failed = true;
+      });
+    } finally {
+      if (mounted) setState(() => _loading = false);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final l = context.l10n;
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.stretch,
+      children: [
+        for (final row in _items)
+          ListTile(
+            contentPadding: EdgeInsets.zero,
+            title: Text('${(row['index'] as int) + 1} · ${row['name']}'),
+            subtitle: Text(switch (row) {
+              {'status': 'built', 'index': final int index, 'checked': final int checked, 'placed': final int placed} =>
+                l.whaleActivityHouseSectionDetail(index + 1, checked, placed),
+              {'status': 'built'} => l.whaleApprovalBuilt,
+              {'status': 'running'} => l.whaleApprovalBuilding,
+              {'status': 'interrupted'} => l.whaleApprovalInterrupted,
+              _ => l.whaleHouseProjectPending,
+            }),
+          ),
+        if (_loading) const LinearProgressIndicator(),
+        if (_failed) Text(l.whaleHouseProjectSectionsUnavailable),
+        if (!_loading && (_failed || _after != null))
+          TextButton(onPressed: _load, child: Text(_failed ? l.whaleRefresh : l.whaleHouseProjectMoreSections)),
+      ],
+    );
+  }
+}
