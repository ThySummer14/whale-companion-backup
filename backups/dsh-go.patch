diff --git a/app/test/whale/home_live_watch_test.dart b/app/test/whale/home_live_watch_test.dart
new file mode 100644
index 0000000000000000000000000000000000000000..6038b7cbc37e142a8fd525ada41fbc5be3ea1b38
--- /dev/null
+++ b/app/test/whale/home_live_watch_test.dart
@@ -0,0 +1,79 @@
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:dsh_app/whale/home_live.dart';
+import 'package:dsh_app/whale/home_state.dart';
+import 'package:dsh_app/whale/host.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+class _RealHttp extends HttpOverrides {}
+
+Future<void> _until(bool Function() check) async {
+  final end = DateTime.now().add(const Duration(seconds: 6));
+  while (!check() && DateTime.now().isBefore(end)) {
+    await Future<void>.delayed(const Duration(milliseconds: 15));
+  }
+  expect(check(), isTrue);
+}
+
+void _send(WebSocket socket, String activity, String anchor, String site) {
+  final at = DateTime.now().toUtc().toIso8601String();
+  socket.add(
+    jsonEncode({
+      'type': 'home.live',
+      'schemaVersion': 1,
+      'occurredAt': at,
+      'cursor': null,
+      'payload': {'version': 1, 'activity': activity, 'anchor': anchor, 'activeSite': site, 'observedAt': at},
+    }),
+  );
+}
+
+void main() {
+  test('watch uses a scoped paired socket, reconnects and closes when the tab is hidden', () {
+    return HttpOverrides.runWithHttpOverrides(() async {
+      final server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
+      final host = CompanionHost(Uri.parse('http://127.0.0.1:${server.port}'), 'Device home-fixture');
+      final watch = WhaleHomeLiveWatch();
+      final requests = <(String, Map<String, String>, String?)>[];
+      final sockets = <WebSocket>[];
+      var disconnected = 0;
+      final subscription = server.listen((request) async {
+        requests.add((request.uri.path, request.uri.queryParameters, request.headers.value('authorization')));
+        final socket = await WebSocketTransformer.upgrade(request);
+        sockets.add(socket);
+        socket.listen((_) {}, onDone: () => disconnected++);
+        if (sockets.length == 1) {
+          _send(socket, 'browsing', 'phone', 'library');
+        } else {
+          _send(socket, 'singing', 'stage', 'studio');
+        }
+      });
+      addTearDown(() async {
+        watch.dispose();
+        host.close();
+        await subscription.cancel();
+        await server.close(force: true);
+      });
+
+      watch.watch(host);
+      await _until(() => watch.value?.home.activity == WhaleHomeActivity.browsing);
+      watch.watch(host);
+      expect(requests.single.$1, '/companion-device/api/events');
+      expect(requests.single.$2, {'view': 'home'});
+      expect(requests.single.$3, 'Device home-fixture');
+      sockets.first.add('untyped event');
+      expect(watch.value?.activeSite, WhaleCommunitySite.library);
+      await sockets.first.close();
+      await _until(() => watch.value == null);
+      await _until(() => watch.value?.home.activity == WhaleHomeActivity.singing);
+      expect(requests.length, 2);
+      expect(watch.value?.activeSite, WhaleCommunitySite.studio);
+      watch.watch(null);
+      expect(watch.value, isNull);
+      await _until(() => disconnected == 2);
+      expect(requests.length, 2);
+    }, _RealHttp());
+  });
+}
