+        _acceptedMessage = (session: session, message: message);
+        if (drafts.isNotEmpty) {
+          _drafts = const [];
+          _midiRequestMissing = false;
+        }
+        if (!_messages.any((message) => message['id'] == id)) _messages.add(message);
