+    expect(items.last.threadId, _post);
+    expect(items.last.replyId, _reply);
+    expect(WhaleActivity.fromRecords(null), isNull);
+    expect(WhaleActivity.fromRecords([]), isEmpty);
+  });
+
+  testWidgets('filters the timeline, opens the original thread and hides it after revocation', (tester) async {
+    final items = WhaleActivity.fromRecords([_replyEvent, _gameEvent, _stageEvent]);
+    final selection = <(String, String?)>[];
+    Future<void> show(WhaleStatusConnection connection) => tester.pumpWidget(
+      _app(
+        Scaffold(
+          body: WhaleActivityPage(
+            items: items,
+            syncedAt: DateTime.parse(_timestamp),
