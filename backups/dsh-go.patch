+class WhaleHomeSignal {
+  const WhaleHomeSignal._(this.home, this.activeSite, this.receivedAt);
+
+  static const freshness = Duration(seconds: 25);
+  final WhaleHomeSnapshot home;
+  final WhaleCommunitySite? activeSite;
+  final DateTime receivedAt;
+
+  static WhaleHomeSignal? fromEvent(Object? value, DateTime receivedAt) {
+    if (value is! String || value.length > 2048) return null;
+    Object? decoded;
+    try {
+      decoded = jsonDecode(value);
+    } on FormatException {
+      return null;
+    }
+    if (decoded is! Map ||
+        decoded['type'] != 'home.live' ||
+        decoded['schemaVersion'] != 1 ||
+        decoded['cursor'] != null) {
+      return null;
+    }
+    final payload = decoded['payload'];
+    if (payload is! Map || !payload.containsKey('activeSite') || decoded['occurredAt'] != payload['observedAt']) {
+      return null;
+    }
+    final home = WhaleHomeSnapshot.fromState(payload);
+    final site = WhaleCommunitySite.values.asNameMap()[payload['activeSite']];
+    if (home == null || payload['activeSite'] != null && site == null) return null;
+    return WhaleHomeSignal._(home, site, receivedAt);
+  }
+}
+
+/// Owns one read-only socket while the app has a visible, authorized Home tab.
+class WhaleHomeLiveWatch extends ValueNotifier<WhaleHomeSignal?> {
+  WhaleHomeLiveWatch() : super(null);
+
+  CompanionHost? _host;
+  HttpClient? _transport;
+  WebSocket? _socket;
+  StreamSubscription<dynamic>? _subscription;
+  Timer? _retry;
+  int _generation = 0;
+
+  void watch(CompanionHost? host) {
+    if (identical(host, _host)) return;
+    _stop();
+    _host = host;
+    value = null;
+    if (host != null) unawaited(_connect(host, _generation));
+  }
+
+  Future<void> _connect(CompanionHost host, int generation) async {
+    final transport = HttpClient()..connectionTimeout = const Duration(seconds: 6);
+    _transport = transport;
+    try {
+      final socket = await host.homeEvents(transport).timeout(const Duration(seconds: 8));
+      if (generation != _generation) {
+        unawaited(socket.close());
+        return;
+      }
+      _socket = socket;
+      _subscription = socket
+          .timeout(WhaleHomeSignal.freshness)
+          .listen(
+            (frame) {
+              if (generation == _generation) {
+                final signal = WhaleHomeSignal.fromEvent(frame, DateTime.now());
+                if (signal != null) value = signal;
+              }
+            },
+            onError: (Object _) => _reconnect(host, generation),
+            onDone: () => _reconnect(host, generation),
+            cancelOnError: true,
+          );
+    } catch (_) {
+      _reconnect(host, generation);
+    }
+  }
+
+  void _reconnect(CompanionHost host, int generation) {
+    if (generation != _generation) return;
+    _stop();
+    value = null;
+    final next = _generation;
+    _retry = Timer(const Duration(seconds: 3), () => unawaited(_connect(host, next)));
+  }
+
+  void _stop() {
+    _generation++;
+    _retry?.cancel();
+    _retry = null;
+    unawaited(_subscription?.cancel());
+    _subscription = null;
+    unawaited(_socket?.close());
+    _socket = null;
+    _transport?.close(force: true);
+    _transport = null;
+  }
+
+  @override
+  void dispose() {
+    _stop();
+    super.dispose();
+  }
+}
