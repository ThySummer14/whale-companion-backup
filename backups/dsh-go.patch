+import 'dart:async';
+
+import 'package:flutter/material.dart';
+import 'package:url_launcher/url_launcher.dart';
+
+import '../l10n/l10n.dart';
+import 'bilibili_state.dart';
+import 'host.dart';
+
+Future<void> openWhaleBilibiliSource(BuildContext context, Uri uri) async {
+  final opened = await launchUrl(uri, mode: LaunchMode.externalApplication).catchError((_) => false);
+  if (!opened && context.mounted) {
+    ScaffoldMessenger.maybeOf(context)
+        ?.showSnackBar(SnackBar(content: Text(context.l10n.whaleBilibiliSourceOpenFailed)));
+  }
+}
+
+String whaleBilibiliModeLabel(L10n l, WhaleBilibiliMode mode) => switch (mode) {
+  WhaleBilibiliMode.both => l.whaleBilibiliBoth,
+  WhaleBilibiliMode.visual => l.whaleBilibiliVisual,
+  WhaleBilibiliMode.audio => l.whaleBilibiliAudio,
+};
+
+String whaleBilibiliWatchDetails(L10n l, WhaleBilibiliWatchReceipt receipt) => l.whaleBilibiliClipDetails(
+  receipt.source.part,
+  receipt.source.time,
+  receipt.seconds,
+  whaleBilibiliModeLabel(l, receipt.material),
+);
+
+Future<String?> pickWhaleBilibiliClip(BuildContext context, BilibiliConversation capability) =>
+    showModalBottomSheet<String>(
+      context: context,
+      isScrollControlled: true,
+      useSafeArea: true,
+      builder: (_) => _ClipSheet(maxSeconds: capability.maxClipSeconds),
+    );
+
+class _ClipSheet extends StatefulWidget {
+  const _ClipSheet({required this.maxSeconds});
+  final int maxSeconds;
+
+  @override
+  State<_ClipSheet> createState() => _ClipSheetState();
+}
+
+class _ClipSheetState extends State<_ClipSheet> {
+  final _form = GlobalKey<FormState>();
+  final _target = TextEditingController();
+  final _start = TextEditingController();
+  late final _duration = TextEditingController(text: '${widget.maxSeconds.clamp(1, 6)}');
+  WhaleBilibiliMode _mode = WhaleBilibiliMode.both;
+
+  int? get _seconds {
+    final value = _duration.text.trim();
+    if (!RegExp(r'^\d{1,2}$').hasMatch(value)) return null;
+    final seconds = int.parse(value);
+    return seconds >= 1 && seconds <= widget.maxSeconds ? seconds : null;
+  }
+
+  @override
+  void dispose() {
+    _target.dispose();
+    _start.dispose();
+    _duration.dispose();
+    super.dispose();
+  }
+
+  void _makeDraft() {
+    if (_form.currentState?.validate() != true) return;
+    final source = WhaleBilibiliSource.fromInput(_target.text)!;
+    final start = _start.text.trim().isEmpty ? source.startSeconds ?? 0 : parseWhaleBilibiliStart(_start.text)!;
+    Navigator.of(context).pop(whaleBilibiliClipDraft(source, start, _seconds!, _mode));
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final l = context.l10n;
+    return SafeArea(
+      top: false,
+      child: SingleChildScrollView(
+        padding: EdgeInsets.fromLTRB(20, 16, 20, 16 + MediaQuery.viewInsetsOf(context).bottom),
+        child: Form(
+          key: _form,
+          child: Column(
+            crossAxisAlignment: CrossAxisAlignment.stretch,
+            mainAxisSize: MainAxisSize.min,
+            children: [
+              Text(l.whaleBilibiliClipForm, style: Theme.of(context).textTheme.titleLarge),
+              const SizedBox(height: 12),
+              TextFormField(
+                key: const ValueKey('bilibili-target'),
+                controller: _target,
+                keyboardType: TextInputType.url,
+                decoration: InputDecoration(labelText: l.whaleBilibiliTarget),
+                validator: (text) =>
+                    WhaleBilibiliSource.fromInput(text ?? '') == null ? l.whaleBilibiliInvalidTarget : null,
+              ),
+              const SizedBox(height: 10),
+              TextFormField(
+                key: const ValueKey('bilibili-start'),
+                controller: _start,
+                keyboardType: TextInputType.datetime,
+                decoration: InputDecoration(labelText: l.whaleBilibiliStart, hintText: '00:12'),
+                validator: (text) => text != null && text.trim().isNotEmpty && parseWhaleBilibiliStart(text) == null
+                    ? l.whaleBilibiliInvalidStart
+                    : null,
+              ),
+              const SizedBox(height: 10),
+              TextFormField(
+                key: const ValueKey('bilibili-duration'),
+                controller: _duration,
+                keyboardType: TextInputType.number,
+                decoration: InputDecoration(labelText: l.whaleBilibiliDuration(widget.maxSeconds)),
+                validator: (_) => _seconds == null ? l.whaleBilibiliDuration(widget.maxSeconds) : null,
+              ),
+              const SizedBox(height: 10),
+              DropdownButtonFormField<WhaleBilibiliMode>(
+                key: const ValueKey('bilibili-mode'),
+                initialValue: _mode,
+                decoration: InputDecoration(labelText: l.whaleBilibiliMode),
+                items: [
+                  for (final mode in WhaleBilibiliMode.values)
+                    DropdownMenuItem(value: mode, child: Text(whaleBilibiliModeLabel(l, mode))),
+                ],
+                onChanged: (mode) {
+                  if (mode != null) _mode = mode;
+                },
+              ),
+              const SizedBox(height: 16),
+              FilledButton(onPressed: _makeDraft, child: Text(l.whaleBilibiliUseDraft)),
+            ],
+          ),
+        ),
+      ),
+    );
+  }
+}
+
+class WhaleBilibiliWatch extends StatefulWidget {
+  const WhaleBilibiliWatch({
+    required this.host,
+    required this.capability,
+    required this.ready,
+    required this.onRevoked,
+    this.resume = false,
+    this.receipt,
+    super.key,
+  });
+
+  final CompanionHost host;
+  final BilibiliConversation capability;
+  final bool ready;
+  final VoidCallback onRevoked;
+  final bool resume;
+  final WhaleBilibiliWatchReceipt? receipt;
+
+  @override
+  State<WhaleBilibiliWatch> createState() => _WhaleBilibiliWatchState();
+}
+
+class _WhaleBilibiliWatchState extends State<WhaleBilibiliWatch> {
+  final _question = TextEditingController();
+  final _scroll = ScrollController();
+  final _messages = <({bool reply, String text})>[];
+  Completer<void>? _abort;
+  String? _clip;
+  String? _thread;
+  String? _title;
+  String? _error;
+  late WhaleBilibiliWatchReceipt? _receipt = widget.receipt;
+  bool _remembered = false;
+  bool _resumeFailed = false;
+  bool _revoked = false;
+
+  @override
+  void initState() {
+    super.initState();
+    if (widget.ready && widget.resume) unawaited(_restore());
+  }
+
+  @override
+  void dispose() {
+    _abort?.complete();
+    _scroll.dispose();
+    _question.dispose();
+    super.dispose();
+  }
+
+  void _handleRevocation() {
+    setState(() {
+      _revoked = true;
+      _messages.clear();
+      _receipt = null;
+    });
+    widget.onRevoked();
+  }
+
+  Future<void> _restore() async {
+    final abort = Completer<void>();
+    setState(() {
+      _abort = abort;
+      _resumeFailed = false;
+    });
+    try {
+      final result = await widget.host.bilibiliWatchSession(abort.future);
+      if (!mounted) return;
+      if (result['thread'] case {
+        'threadId': final String thread,
+        'receipt': final Map data,
+        'turns': final List turns,
+      }) {
+        final receipt = WhaleBilibiliWatchReceipt.fromWire(data);
+        if (receipt == null || (widget.receipt != null && widget.receipt?.activityId != receipt.activityId)) return;
+        final messages = <({bool reply, String text})>[];
+        for (final turn in turns.take(4)) {
+          if (turn case {'role': final String role, 'content': final String text}
+              when (role == 'user' || role == 'assistant') && text.isNotEmpty && text.length <= 2400) {
+            messages.add((reply: role == 'assistant', text: text));
+          }
+        }
+        setState(() {
+          _thread = thread;
+          _receipt = receipt;
+          _messages
+            ..clear()
+            ..addAll(messages);
+        });
+        _scrollDown();
+      }
+    } on HostError catch (error) {
+      if (!mounted) return;
+      if (error.status == 401) {
+        _handleRevocation();
+      } else {
+        setState(() => _resumeFailed = true);
+      }
+    } on FormatException {
+      if (mounted) setState(() => _resumeFailed = true);
+    } finally {
+      if (mounted) setState(() => _abort = null);
+    }
+  }
+
+  void _scrollDown() => WidgetsBinding.instance.addPostFrameCallback((_) {
+    if (mounted && _scroll.hasClients) _scroll.jumpTo(_scroll.position.maxScrollExtent);
+  });
+
+  Future<void> _pick() async {
+    final clip = await pickWhaleBilibiliClip(context, widget.capability);
+    if (!mounted || clip == null) return;
+    setState(() {
+      _clip = clip;
+      _error = null;
+    });
+  }
+
+  Future<void> _send() async {
+    final question = _question.text.trim();
+    final clip = _clip;
+    if (_abort != null || _revoked || !widget.ready || (clip == null && (_thread == null || question.isEmpty))) return;
+    final abort = Completer<void>();
+    setState(() {
+      _abort = abort;
+      _error = null;
+    });
+    try {
+      final reply = await widget.host.watchBilibili(
+        clip: clip,
+        threadId: clip == null ? _thread : null,
+        question: question,
+        abort: abort.future,
+      );
+      if (!mounted) return;
+      if (reply case {'threadId': final String thread, 'title': final String title, 'text': final String text}) {
+        final receipt = WhaleBilibiliWatchReceipt.fromWire(reply['receipt']);
+        setState(() {
+          if (clip != null) {
+            _messages.clear();
+            _receipt = receipt;
+            _remembered = false;
+          }
+          _resumeFailed = false;
+          _clip = null;
+          _thread = thread;
+          _title = title;
+          _messages.add((reply: false, text: question.isEmpty ? clip! : question));
+          _messages.add((reply: true, text: text));
+          _question.clear();
+        });
+        _scrollDown();
+      } else {
+        setState(() => _error = context.l10n.whaleWatchFailed);
+      }
+    } on HostError catch (error) {
+      if (!mounted) return;
+      if (error.status == 401) {
+        _handleRevocation();
+      } else {
+        setState(() {
+          if (error.code == 'qwen-watch-thread-expired') {
+            _thread = null;
+            _error = context.l10n.whaleWatchExpired;
+          } else {
+            _error = context.l10n.whaleWatchFailed;
+          }
+        });
+      }
+    } finally {
+      if (mounted) setState(() => _abort = null);
+    }
+  }
+
+  Future<void> _remember(WhaleBilibiliWatchReceipt receipt) async {
+    if (_abort != null || _revoked || _remembered) return;
+    final abort = Completer<void>();
+    setState(() {
+      _abort = abort;
+      _error = null;
+    });
+    try {
+      final result = await widget.host.rememberBilibiliWatch(receipt.activityId, abort.future);
+      if (!mounted) return;
+      setState(() {
+        _remembered = result['shared'] == true;
+        if (!_remembered) _error = context.l10n.whaleWatchRememberFailed;
+      });
+    } on HostError catch (error) {
+      if (!mounted) return;
+      if (error.status == 401) {
+        _handleRevocation();
+      } else {
+        final l = context.l10n;
+        setState(
+          () => _error = error.code == 'bili-watch-memory-withdrawn'
+              ? l.whaleWatchMemoryWithdrawn
+              : l.whaleWatchRememberFailed,
+        );
+      }
+    } on FormatException {
+      if (mounted) setState(() => _error = context.l10n.whaleWatchRememberFailed);
+    } finally {
+      if (mounted) setState(() => _abort = null);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final l = context.l10n;
+    final colors = Theme.of(context).colorScheme;
+    final busy = _abort != null;
+    final receipt = _receipt;
+    return Scaffold(
+      appBar: AppBar(title: Text(l.whaleBilibiliConversation)),
+      body: SafeArea(
+        child: _revoked
+            ? Center(child: Text(l.whaleRevoked))
+            : Column(
+                crossAxisAlignment: CrossAxisAlignment.stretch,
+                children: [
+                  if (receipt != null)
+                    Padding(
+                      padding: const EdgeInsets.fromLTRB(16, 8, 16, 4),
+                      child: Column(
+                        crossAxisAlignment: CrossAxisAlignment.start,
+                        children: [
+                          Text(
+                            receipt.title,
+                            style: Theme.of(context).textTheme.titleSmall,
+                            maxLines: 2,
+                            overflow: TextOverflow.ellipsis,
+                          ),
+                          Text(whaleBilibiliWatchDetails(l, receipt), style: Theme.of(context).textTheme.bodySmall),
+                          Wrap(
+                            spacing: 8,
+                            children: [
+                              TextButton.icon(
+                                onPressed: () => openWhaleBilibiliSource(context, receipt.source.uri),
+                                icon: const Icon(Icons.open_in_new, size: 16),
+                                label: Text(l.whaleWatchOpenSource),
+                              ),
+                              if (widget.ready && _thread == null && _clip == null)
+                                TextButton(
+                                  onPressed: busy
+                                      ? null
+                                      : () => setState(() {
+                                          _clip = receipt.draft;
+                                          _error = null;
+                                        }),
+                                  child: Text(l.whaleWatchReplay),
+                                ),
+                              if (widget.resume)
+                                TextButton(
+                                  onPressed: busy || _remembered ? null : () => _remember(receipt),
+                                  child: Text(_remembered ? l.whaleWatchRemembered : l.whaleWatchRemember),
+                                ),
+                            ],
+                          ),
+                        ],
+                      ),
+                    )
+                  else if (_title case final title?)
+                    Padding(padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8), child: Text(title)),
+                  Expanded(
+                    child: _messages.isEmpty
+                        ? Center(
+                            child: Padding(
+                              padding: const EdgeInsets.all(24),
+                              child: _resumeFailed
+                                  ? TextButton(onPressed: busy ? null : _restore, child: Text(l.whaleWatchResumeFailed))
+                                  : Text(widget.ready ? l.whaleWatchHelp : l.whaleWatchUnavailable),
+                            ),
+                          )
+                        : ListView(
+                            controller: _scroll,
+                            padding: const EdgeInsets.all(12),
+                            children: [
+                              for (final message in _messages)
+                                Align(
+                                  alignment: message.reply ? Alignment.centerLeft : Alignment.centerRight,
+                                  child: Container(
+                                    constraints: const BoxConstraints(maxWidth: 460),
+                                    margin: const EdgeInsets.only(bottom: 8),
+                                    padding: const EdgeInsets.all(12),
+                                    decoration: BoxDecoration(
+                                      color: message.reply ? colors.surfaceContainer : colors.primaryContainer,
+                                      borderRadius: BorderRadius.circular(14),
+                                    ),
+                                    child: SelectableText(message.text),
+                                  ),
+                                ),
+                            ],
+                          ),
+                  ),
+                  if (busy) const LinearProgressIndicator(),
+                  if (_error case final error?)
+                    Padding(
+                      padding: const EdgeInsets.all(12),
+                      child: Text(error, style: TextStyle(color: colors.error)),
+                    ),
+                  if (_clip case final clip?)
+                    ListTile(
+                      leading: const Icon(Icons.movie_outlined),
+                      title: Text(clip, maxLines: 2, overflow: TextOverflow.ellipsis),
+                      trailing: IconButton(
+                        tooltip: MaterialLocalizations.of(context).closeButtonTooltip,
+                        onPressed: busy ? null : () => setState(() => _clip = null),
+                        icon: const Icon(Icons.close),
+                      ),
+                    ),
+                  if (widget.ready)
+                    Padding(
+                      padding: const EdgeInsets.fromLTRB(8, 4, 8, 8),
+                      child: Row(
+                        children: [
+                          IconButton(
+                            tooltip: l.whaleBilibiliClipForm,
+                            onPressed: busy ? null : _pick,
+                            icon: const Icon(Icons.add_circle_outline),
+                          ),
+                          Expanded(
+                            child: TextField(
+                              controller: _question,
+                              enabled: !busy,
+                              maxLength: 800,
+                              minLines: 1,
+                              maxLines: 3,
+                              decoration: InputDecoration(hintText: l.whaleWatchQuestion, counterText: ''),
+                              onChanged: (_) => setState(() {}),
+                            ),
+                          ),
+                          IconButton(
+                            tooltip: l.whaleSend,
+                            onPressed: busy || (_clip == null && (_thread == null || _question.text.trim().isEmpty))
+                                ? null
+                                : _send,
+                            icon: const Icon(Icons.send_rounded),
+                          ),
+                        ],
+                      ),
+                    ),
+                ],
+              ),
+      ),
+    );
+  }
+}
diff --git a/app/lib/whale/bilibili_state.dart b/app/lib/whale/bilibili_state.dart
new file mode 100644
index 00000000..a74e022a
--- /dev/null
+++ b/app/lib/whale/bilibili_state.dart
@@ -0,0 +1,173 @@
+const bilibiliContext = 'world.bilibili';
+const bilibiliClipLimit = 12;
+const _lastStartSecond = 604800;
+final _videoId = RegExp(r'^BV[A-Za-z0-9]{10}$');
+final _videoPath = RegExp(r'^/video/(BV[A-Za-z0-9]{10})/?$');
+final _timeInput = RegExp(r'^\d{1,6}(?::\d{2}){0,2}$');
+
+enum WhaleBilibiliMode {
+  both('画面和声音'),
+  visual('画面'),
+  audio('声音');
+
+  const WhaleBilibiliMode(this.command);
+  final String command;
+}
+
+class BilibiliConversation {
+  const BilibiliConversation._(this.maxClipSeconds);
+  final int maxClipSeconds;
+
+  static BilibiliConversation? fromState(Map state) {
+    final capability = state['bilibiliConversation'];
+    if (capability is! Map ||
+        capability['version'] is! int ||
+        capability['version'] != 1 ||
+        capability['contextId'] != bilibiliContext) {
+      return null;
+    }
+    final maxSeconds = capability['maxClipSeconds'];
+    return maxSeconds is int && maxSeconds > 0 ? BilibiliConversation._(maxSeconds.clamp(1, bilibiliClipLimit)) : null;
+  }
+}
+
+class WhaleBilibiliSource {
+  const WhaleBilibiliSource._(this.bvid, this.part, this.startSeconds);
+  final String bvid;
+  final int part;
+  final int? startSeconds;
+
+  Uri get uri => Uri.https('www.bilibili.com', '/video/$bvid/', {
+    'p': '$part',
+    if (startSeconds case final seconds?) 't': '$seconds',
+  });
+
+  String get time {
+    final seconds = startSeconds ?? 0;
+    final minutes = seconds ~/ 60;
+    final rest = (seconds % 60).toString().padLeft(2, '0');
+    return '$minutes:$rest';
+  }
+
+  static WhaleBilibiliSource? fromWire(Object? value) {
+    if (value is! Map) return null;
+    final bvid = value['bvid'];
+    final part = value['part'];
+    final start = value['startSeconds'];
+    if (bvid is! String ||
+        bvid.length != 12 ||
+        !_videoId.hasMatch(bvid) ||
+        part is! int ||
+        part < 1 ||
+        part > 1000 ||
+        value.containsKey('startSeconds') && (start is! int || start < 0 || start > _lastStartSecond)) {
+      return null;
+    }
+    return WhaleBilibiliSource._(bvid, part, start as int?);
+  }
+
+  static WhaleBilibiliSource? fromInput(String text) {
+    final value = text.trim();
+    if (value.length > 2000) return null;
+    if (value.length == 12 && _videoId.hasMatch(value)) return WhaleBilibiliSource._(value, 1, null);
+    if (!value.startsWith('https://www.bilibili.com/video/') || RegExp(r'[\\\s]').hasMatch(value)) return null;
+    final uri = Uri.tryParse(value);
+    if (uri == null || uri.host != 'www.bilibili.com' || uri.port != 443 || uri.userInfo.isNotEmpty) return null;
+    final bvid = _videoPath.firstMatch(uri.path)?.group(1);
+    if (bvid == null) return null;
+    final Map<String, List<String>> query;
+    try {
+      query = uri.queryParametersAll;
+    } on FormatException {
+      return null;
+    }
+    final pages = query['p'];
+    final timestamps = query['t'];
+    if ((pages?.length ?? 0) > 1 || (timestamps?.length ?? 0) > 1) return null;
+    final page = pages?.single;
+    final timestamp = timestamps?.single;
+    if (page != null && !RegExp(r'^\d{1,4}$').hasMatch(page) ||
+        timestamp != null && !RegExp(r'^\d{1,6}$').hasMatch(timestamp)) {
+      return null;
+    }
+    return fromWire({
+      'bvid': bvid,
+      'part': page == null ? 1 : int.parse(page),
+      if (timestamp != null) 'startSeconds': int.parse(timestamp),
+    });
+  }
+}
+
+int? parseWhaleBilibiliStart(String text) {
+  final value = text.trim();
+  if (!_timeInput.hasMatch(value)) return null;
+  final parts = value.split(':').map(int.parse).toList(growable: false);
+  if (parts.skip(1).any((part) => part >= 60)) return null;
+  final seconds = parts.fold<int>(0, (total, part) => total * 60 + part);
+  return seconds <= _lastStartSecond ? seconds : null;
+}
+
+String whaleBilibiliClipDraft(WhaleBilibiliSource source, int start, int seconds, WhaleBilibiliMode mode) {
+  final target = source.part == 1 ? source.bvid : 'https://www.bilibili.com/video/${source.bvid}/?p=${source.part}';
+  return '看这段 $target $start $seconds秒 ${mode.command}';
+}
+
+class WhaleBilibiliReceipt {
+  const WhaleBilibiliReceipt._({required this.clip, this.source, this.seconds, this.material});
+  final bool clip;
+  final WhaleBilibiliSource? source;
+  final int? seconds;
+  final WhaleBilibiliMode? material;
+
+  static WhaleBilibiliReceipt? fromWire(Object? value) {
+    if (value is! Map || value['mode'] != 'clip' && value['mode'] != 'subtitle') return null;
+    final data = value['source'];
+    final source = WhaleBilibiliSource.fromWire(data);
+    if (value['mode'] == 'subtitle') {
+      return WhaleBilibiliReceipt._(clip: false, source: source?.startSeconds == null ? source : null);
+    }
+    if (source?.startSeconds == null || data is! Map) return const WhaleBilibiliReceipt._(clip: true);
+    final seconds = data['seconds'];
+    final visual = data['visual'];
+    final audio = data['audio'];
+    if (seconds is! int ||
+        seconds < 1 ||
+        seconds > bilibiliClipLimit ||
+        visual is! bool ||
+        audio is! bool ||
+        !visual && !audio) {
+      return const WhaleBilibiliReceipt._(clip: true);
+    }
+    return WhaleBilibiliReceipt._(
+      clip: true,
+      source: source,
+      seconds: seconds,
+      material: visual ? (audio ? WhaleBilibiliMode.both : WhaleBilibiliMode.visual) : WhaleBilibiliMode.audio,
+    );
+  }
+}
+
+class WhaleBilibiliWatchReceipt {
+  const WhaleBilibiliWatchReceipt._(this.activityId, this.title, this.source, this.seconds, this.material);
+
+  final int activityId;
+  final String title;
+  final WhaleBilibiliSource source;
+  final int seconds;
+  final WhaleBilibiliMode material;
+
+  String get draft => whaleBilibiliClipDraft(source, source.startSeconds!, seconds, material);
+
+  static WhaleBilibiliWatchReceipt? fromWire(Object? value) {
+    if (value is! Map) return null;
+    final id = value['activityId'];
+    final title = value['title'];
+    if (id is! int || id < 1 || title is! String || title.trim().isEmpty || title.length > 240) return null;
+    final clip = WhaleBilibiliReceipt.fromWire({'mode': 'clip', 'source': value['source']});
+    final source = clip?.source;
+    final seconds = clip?.seconds;
+    final material = clip?.material;
+    if (source == null || seconds == null || material == null) return null;
+    return WhaleBilibiliWatchReceipt._(id, title.trim(), source, seconds, material);
+  }
+}
diff --git a/app/lib/whale/camp.dart b/app/lib/whale/camp.dart
