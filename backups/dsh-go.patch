+}
+
+String _siteLabel(L10n l, WhaleCommunitySite site) => switch (site) {
+  WhaleCommunitySite.home => l.whaleCommunityHome,
+  WhaleCommunitySite.studio => l.whaleCommunityStudio,
+  WhaleCommunitySite.library => l.whaleCommunityLibrary,
+  WhaleCommunitySite.camp => l.whaleCommunityCamp,
+};
+
+String _directionLabel(L10n l, WhaleSurveyDirection direction) => switch (direction) {
+  WhaleSurveyDirection.north => l.whaleCommunityNorth,
+  WhaleSurveyDirection.east => l.whaleCommunityEast,
+  WhaleSurveyDirection.south => l.whaleCommunitySouth,
+  WhaleSurveyDirection.west => l.whaleCommunityWest,
+};
+
+class _CampReceiptTile extends StatelessWidget {
+  const _CampReceiptTile(this.receipt);
+
+  final WhaleCampReceipt receipt;
+
+  @override
+  Widget build(BuildContext context) {
+    final l = context.l10n;
+    final local = MaterialLocalizations.of(context);
+    final at = receipt.at.toLocal();
+    final survey = receipt.survey;
+    final (title, icon) = switch (receipt.kind) {
+      WhaleCampEvent.supply => (l.whaleCommunitySupplied, Icons.inventory_2_outlined),
+      WhaleCampEvent.build => (l.whaleCommunityBuilt, Icons.construction_outlined),
+      WhaleCampEvent.prepare => (l.whaleCommunityPrepared, Icons.handyman_outlined),
+      WhaleCampEvent.survey =>
+        survey?.outcome == WhaleSurveyOutcome.recovered
+            ? (l.whaleCommunitySurveyRecovered, Icons.turn_left)
+            : (l.whaleCommunitySurveyCompleted, Icons.route_outlined),
+    };
+    final route = switch (survey?.route) {
+      WhaleStraightRoute(:final direction, :final steps) => l.whaleCommunityStraightRoute(
+        _directionLabel(l, direction),
+        steps,
+      ),
+      WhaleTrailRoute(:final first, :final second, :final checkpoints) => l.whaleCommunityTrailRoute(
+        _directionLabel(l, first),
+        _directionLabel(l, second),
+        checkpoints,
+      ),
+      null => null,
+    };
+    return ListTile(
+      dense: true,
+      contentPadding: EdgeInsets.zero,
+      leading: Icon(icon),
+      title: Text(title),
+      subtitle: Text(
+        [?route, '${local.formatShortDate(at)} ${local.formatTimeOfDay(TimeOfDay.fromDateTime(at))}'].join('\n'),
+      ),
+    );
+  }
+}
+
+enum _Roof { gable, terrace, hip }
+
+typedef _Building = ({double width, double height, int windows, _Roof roof, Color wall, Color cover});
+
+class _BuildingPainter extends CustomPainter {
+  const _BuildingPainter(this.site);
+
+  final WhaleCommunitySite site;
+
+  static const _recipes = <WhaleCommunitySite, _Building>{
+    WhaleCommunitySite.home: (
+      width: 56,
+      height: 20,
+      windows: 2,
+      roof: _Roof.gable,
+      wall: Color(0xffe7c8a0),
+      cover: Color(0xffb67567),
+    ),
+    WhaleCommunitySite.studio: (
+      width: 66,
+      height: 27,
+      windows: 4,
+      roof: _Roof.terrace,
+      wall: Color(0xffd5c4dd),
+      cover: Color(0xff917da4),
+    ),
+    WhaleCommunitySite.library: (
+      width: 62,
+      height: 24,
+      windows: 3,
+      roof: _Roof.hip,
+      wall: Color(0xffc5d7b5),
+      cover: Color(0xff709781),
+    ),
+    WhaleCommunitySite.camp: (
+      width: 50,
+      height: 19,
+      windows: 2,
+      roof: _Roof.gable,
+      wall: Color(0xffdcbd89),
+      cover: Color(0xffa57546),
+    ),
+  };
+
+  @override
+  void paint(Canvas canvas, Size size) {
+    final building = _recipes[site]!;
+    final brush = Paint()..isAntiAlias = false;
+    void rect(double x, double y, double width, double height, Color color) =>
+        canvas.drawRect(Rect.fromLTWH(x, y, width, height), brush..color = color);
+
+    canvas.save();
+    canvas.scale(size.width / 96, size.height / 55);
+    const front = 46.0;
+    final left = (96 - building.width) / 2;
+    final right = left + building.width;
+    final top = front - building.height;
+    rect(left - 6, front - 4, building.width + 12, 9, const Color(0xffcfdbc0));
+    rect(43, front, 10, 9, const Color(0xffd9bf95));
+    rect(left, top, building.width, building.height, building.wall);
+    rect(left, front - 2, building.width, 2, building.cover);
+    for (var column = 0; column < building.windows; column++) {
+      final x = left + building.width * (column + .5) / building.windows - 3;
+      rect(x, top + 6, 6, 6, const Color(0xff576d6c));
+      rect(x + 1, top + 7, 4, 2, const Color(0xffd2e3cf));
+    }
+    rect(43, front - 12, 10, 12, building.cover);
+    if (building.roof == _Roof.terrace) {
+      rect(left - 4, top - 8, building.width + 8, 9, building.cover);
+      rect(left + 2, top - 6, building.width - 4, 3, const Color(0xffded0e2));
+    } else {
+      final inset = building.roof == _Roof.hip ? 15.0 : 0.0;
+      final roof = Path()
+        ..moveTo(left - 4, top)
+        ..lineTo(left - 4 + inset, top - 13)
+        ..lineTo(right + 4 - inset, top - 13)
+        ..lineTo(right + 4, top)
+        ..close();
+      canvas.drawPath(roof, brush..color = building.cover);
+      rect(left + inset, top - 11, building.width - inset * 2, 2, Colors.white30);
+      if (building.roof == _Roof.gable) rect(left - 3, top - 5, building.width + 6, 3, Colors.black26);
+    }
+    canvas.restore();
+  }
+
+  @override
+  bool shouldRepaint(covariant _BuildingPainter oldDelegate) => oldDelegate.site != site;
+}
diff --git a/app/lib/whale/dictation.dart b/app/lib/whale/dictation.dart
new file mode 100644
index 0000000000000000000000000000000000000000..46c52741e5137802ee8795fe531ffdeb9ac15f5e
--- /dev/null
+++ b/app/lib/whale/dictation.dart
@@ -0,0 +1,191 @@
+import 'dart:async';
+
+import 'package:flutter/foundation.dart';
+
+import '../ui/chat/voice/voice_bridge.dart';
+import 'host.dart';
+
+enum DictationAccess { unknown, checking, available, unavailable, failed }
+
+enum DictationPhase { idle, permission, starting, recording, transcribing }
+
+enum DictationNotice { ready, denied, blocked, recordingFailed, noSpeech, busy, failed, draftFull }
+
+class WhaleDictation extends ChangeNotifier {
+  WhaleDictation(this._host, {VoiceBridge? bridge, required this.onDraft, required this.onRevoked})
+    : _bridge = bridge ?? MethodChannelVoiceBridge();
+
+  final CompanionHost _host;
+  final VoiceBridge _bridge;
+  final bool Function(String) onDraft;
+  final void Function(HostError) onRevoked;
+
+  DictationAccess access = DictationAccess.unknown;
+  DictationPhase phase = DictationPhase.idle;
+  DictationNotice? notice;
+  StreamSubscription<VoiceEvent>? _events;
+  Completer<void>? _upload;
+  Timer? _limit;
+  int _operation = 0;
+  bool _disposed = false;
+  bool _voiceReplyReady = false;
+
+  bool get active => phase != DictationPhase.idle;
+  bool get voiceReplyReady => access == DictationAccess.available && _voiceReplyReady;
+
+  Future<void> refreshAccess() async {
+    if (_disposed || access == DictationAccess.checking) return;
+    access = DictationAccess.checking;
+    _changed();
+    try {
+      final capabilities = await _host.transcriptionCapabilities();
+      if (_disposed) return;
+      access = capabilities.available ? DictationAccess.available : DictationAccess.unavailable;
+      _voiceReplyReady = capabilities.voiceReplyReady;
+    } catch (error) {
+      if (_disposed) return;
+      access = DictationAccess.failed;
+      if (error is HostError && error.status == 401) onRevoked(error);
+    }
+    _changed();
+  }
+
+  Future<void> start() async {
+    if (_disposed || active || access != DictationAccess.available) return;
+    final operation = ++_operation;
+    _set(DictationPhase.permission);
+    try {
+      final permission = await _bridge.requestPermission();
+      if (!_current(operation)) return;
+      if (permission != VoicePermission.granted) {
+        _set(
+          DictationPhase.idle,
+          permission == VoicePermission.blocked ? DictationNotice.blocked : DictationNotice.denied,
+        );
+        return;
+      }
+      _events ??= _bridge.events.listen(_handleEvent, onError: (_) => _recordingFailed());
+      _set(DictationPhase.starting);
+      await _bridge.startRecorder(maxSeconds: whaleRecordingSeconds);
+      if (!_current(operation)) return;
+      _set(DictationPhase.recording);
+      _limit = Timer(const Duration(seconds: whaleRecordingSeconds), () => unawaited(stop(automatic: true)));
+    } catch (_) {
+      if (_current(operation)) _recordingFailed();
+    }
+  }
+
+  Future<void> stop({bool automatic = false}) async {
+    if (_disposed || phase != DictationPhase.recording) return;
+    final operation = _operation;
+    _limit?.cancel();
+    _set(DictationPhase.transcribing);
+    Completer<void>? upload;
+    try {
+      final wav = await _bridge.stop(automatic: automatic);
+      if (!_current(operation)) return;
+      if (wav == null || wav.length <= 44) {
+        _set(DictationPhase.idle, DictationNotice.noSpeech);
+        return;
+      }
+      upload = _upload = Completer<void>();
+      final clock = Stopwatch()..start();
+      final text = await _host.transcribeVoice(wav, upload.future);
+      if (!_current(operation)) return;
+      _host.lastVoiceTranscriptionMs = clock.elapsedMilliseconds;
+      _set(DictationPhase.idle, onDraft(text) ? DictationNotice.ready : DictationNotice.draftFull);
+    } on HostError catch (error) {
+      if (!_current(operation)) return;
+      if (error.status == 401) {
+        _set(DictationPhase.idle);
+        onRevoked(error);
+      } else if (error.status == 404) {
+        access = DictationAccess.unavailable;
+        _set(DictationPhase.idle);
+      } else {
+        _set(DictationPhase.idle, switch (error.code) {
+          'asr-no-speech' => DictationNotice.noSpeech,
+          _ when error.status == 409 => DictationNotice.busy,
+          _ => DictationNotice.failed,
+        });
+      }
+    } catch (_) {
+      if (_current(operation)) {
+        _set(DictationPhase.idle, upload == null ? DictationNotice.recordingFailed : DictationNotice.failed);
+      }
+    } finally {
+      if (upload != null && !upload.isCompleted) upload.complete();
+      if (identical(_upload, upload)) _upload = null;
+    }
+  }
+
+  Future<void> cancel() async {
+    if (!active) return;
+    final wasRecording = phase == DictationPhase.starting || phase == DictationPhase.recording;
+    _operation++;
+    _limit?.cancel();
+    final upload = _upload;
+    if (upload != null && !upload.isCompleted) upload.complete();
+    _upload = null;
+    _set(DictationPhase.idle);
+    if (wasRecording) await _discardRecording();
+  }
+
+  Future<void> openSettings() => _bridge.openSettings();
+
+  void clearNotice() {
+    if (notice == null) return;
+    notice = null;
+    _changed();
+  }
+
+  void _handleEvent(VoiceEvent event) {
+    switch (event) {
+      case VoiceLimit() when phase == DictationPhase.recording:
+        unawaited(stop(automatic: true));
+      case VoiceEnd() when phase == DictationPhase.recording || phase == DictationPhase.starting:
+        unawaited(cancel());
+      case VoiceError():
+        _recordingFailed();
+      default:
+        break;
+    }
+  }
+
+  void _recordingFailed() {
+    if (_disposed || !active || phase == DictationPhase.transcribing) return;
+    final wasRecording = phase != DictationPhase.permission;
+    _operation++;
+    _limit?.cancel();
+    _set(DictationPhase.idle, DictationNotice.recordingFailed);
+    if (wasRecording) unawaited(_discardRecording());
+  }
+
+  Future<void> _discardRecording() async {
+    try {
+      await _bridge.cancel();
+    } catch (_) {
+      // The recorder may already have closed during the lifecycle transition.
+    }
+  }
+
+  bool _current(int operation) => !_disposed && operation == _operation;
+
+  void _set(DictationPhase value, [DictationNotice? nextNotice]) {
+    phase = value;
+    notice = nextNotice;
+    _changed();
+  }
+
+  void _changed() {
+    if (!_disposed) notifyListeners();
+  }
+
+  @override
+  void dispose() {
+    _disposed = true;
+    unawaited(cancel());
+    unawaited(_events?.cancel());
+    super.dispose();
+  }
+}
diff --git a/app/lib/whale/feed.dart b/app/lib/whale/feed.dart
new file mode 100644
index 0000000000000000000000000000000000000000..539ce34acb95dfcd12a0681e3a49c192f1003596
--- /dev/null
+++ b/app/lib/whale/feed.dart
@@ -0,0 +1,685 @@
+import 'dart:async';
+import 'dart:io';
+
+import 'package:flutter/foundation.dart';
+import 'package:flutter/material.dart';
+import 'package:image_picker/image_picker.dart';
+
+import '../companion/companion_voice.dart';
+import '../l10n/l10n.dart';
+import '../state/attachments.dart';
+import '../ui/chat/widgets/attachments.dart';
+import 'bilibili.dart';
+import 'bilibili_state.dart';
+import 'host.dart';
+import 'song_tile.dart';
+import 'voice.dart';
+
+class WhaleFeedAudio {
+  const WhaleFeedAudio({required this.player, required this.revoked, required this.onRevoked, this.cacheDirectory});
+
+  final CompanionVoice player;
+  final ValueListenable<bool> revoked;
+  final VoidCallback onRevoked;
+  final Future<Directory> Function()? cacheDirectory;
+}
+
+class _FeedSongPlayback extends StatefulWidget {
+  const _FeedSongPlayback({required this.host, required this.audio, required this.builder, this.active = true});
+
+  final CompanionHost host;
+  final WhaleFeedAudio? audio;
+  final Widget Function(BuildContext, WhaleVoice?) builder;
+  final bool active;
+
+  @override
+  State<_FeedSongPlayback> createState() => _FeedSongPlaybackState();
+}
+
+class _FeedSongPlaybackState extends State<_FeedSongPlayback> with WidgetsBindingObserver {
+  WhaleVoice? _voice;
+  bool _revoked = false;
+  bool _currentRoute = true;
+  bool _foreground = true;
+
+  static bool _isForeground(AppLifecycleState? state) =>
+      state == null || state == AppLifecycleState.resumed || state == AppLifecycleState.inactive;
+
+  bool get _enabled => widget.active && _currentRoute && _foreground && !_revoked;
+
+  @override
+  void initState() {
+    super.initState();
+    _foreground = _isForeground(WidgetsBinding.instance.lifecycleState);
+    WidgetsBinding.instance.addObserver(this);
+    _bind();
+  }
+
+  void _bind() {
+    final audio = widget.audio;
+    _revoked = audio?.revoked.value ?? false;
+    if (audio == null) return;
+    audio.revoked.addListener(_revocationChanged);
+    _voice = WhaleVoice(
+      widget.host,
+      player: audio.player,
+      ownsPlayer: false,
+      cacheDirectory: audio.cacheDirectory,
+      onRevoked: (_) => _reportRevoked(),
+    );
+  }
+
+  void _unbind(WhaleFeedAudio? audio) {
+    audio?.revoked.removeListener(_revocationChanged);
+    _voice?.dispose();
+    _voice = null;
+  }
+
+  void _revocationChanged() {
+    if (widget.audio?.revoked.value != true || _revoked) return;
+    setState(() => _revoked = true);
+    _stopWhenHidden();
+  }
+
+  void _reportRevoked() {
+    if (!mounted || _revoked) return;
+    setState(() => _revoked = true);
+    _stopWhenHidden();
+    widget.audio?.onRevoked();
+  }
+
+  void _stopWhenHidden() {
+    if (_voice case final voice? when !_enabled && voice.messageId != null) unawaited(voice.stop());
+  }
+
+  @override
+  void didChangeDependencies() {
+    super.didChangeDependencies();
+    _currentRoute = ModalRoute.isCurrentOf(context) != false;
+    _stopWhenHidden();
+  }
+
+  @override
+  void didUpdateWidget(covariant _FeedSongPlayback oldWidget) {
+    super.didUpdateWidget(oldWidget);
+    if (!identical(widget.host, oldWidget.host) ||
+        !identical(widget.audio?.player, oldWidget.audio?.player) ||
+        !identical(widget.audio?.revoked, oldWidget.audio?.revoked) ||
+        widget.audio?.cacheDirectory != oldWidget.audio?.cacheDirectory) {
+      _unbind(oldWidget.audio);
+      _bind();
+    }
+    _stopWhenHidden();
+  }
+
+  @override
+  void didChangeAppLifecycleState(AppLifecycleState state) {
+    final foreground = _isForeground(state);
+    if (_foreground == foreground) return;
+    setState(() => _foreground = foreground);
+    _stopWhenHidden();
+  }
+
+  @override
+  void dispose() {
+    WidgetsBinding.instance.removeObserver(this);
+    _unbind(widget.audio);
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) => widget.builder(context, _enabled ? _voice : null);
+}
+
+class WhaleFeed extends StatefulWidget {
+  const WhaleFeed(this.host, this.persona, {this.audio, this.active = true, super.key});
+  final CompanionHost host;
+  final String persona;
+  final WhaleFeedAudio? audio;
+  final bool active;
+
+  @override
+  State<WhaleFeed> createState() => _WhaleFeedState();
+}
+
+class _WhaleFeedState extends State<WhaleFeed> {
+  List<Json>? _posts;
+  String? _cursor;
+  bool _loading = false;
+  bool _refreshPending = false;
+  bool _photos = false;
+  bool _imageOnly = false;
+  int? _publishPhotoLimit;
+  bool _failed = false;
+  final _threads = <String, List<Json>>{};
+  String? _expanded;
+
+  @override
+  void initState() {
+    super.initState();
+    unawaited(_load());
+  }
+
+  Future<void> _load({bool more = false}) async {
+    if (_loading) {
+      if (!more) _refreshPending = true;
+      return;
+    }
+    setState(() => _loading = true);
+    try {
+      final host = widget.host;
+      final page = await host.feed(more ? _cursor : null);
+      Json? health;
+      if (!more) {
+        try {
+          health = await host.health();
+        } on HostError catch (error) {
+          if (error.status == 401) rethrow;
+        }
+      }
+      if (!mounted) return;
+      setState(() {
+        final items = (page['items'] as List).cast<Json>();
+        final posts = more ? _posts ?? [] : <Json>[];
+        _posts = {
+          for (final post in [...posts, ...items]) post['id']: post,
+        }.values.toList();
+        _cursor = page['nextCursor'] as String?;
+        _failed = false;
+        if (health case final details?) {
+          final cap = details['feedPublish'];
+          final limit = cap is Map && cap['version'] == 1 ? cap['maxImageBytes'] : null;
+          _publishPhotoLimit = limit is int && limit > 0 && limit <= maxPhotoBytes ? limit : null;
+          final raw = details['pluginVersion'] as String? ?? '';
+          final parts = raw.split('-').first.split('.');
+          final version = parts.length == 3 ? parts.map((p) => int.tryParse(p) ?? 0).toList() : [0, 0, 0];
+          _photos = _publishPhotoLimit != null || version[0] > 0 || version[1] >= 15;
+          _imageOnly =
+              _publishPhotoLimit != null || version[0] > 0 || version[1] > 15 || version[1] == 15 && version[2] >= 1;
+        }
+      });
+      final expanded = _expanded;
+      if (!more && expanded != null) await _loadThread(expanded);
+    } catch (error) {
+      if (mounted) {
+        setState(() => _failed = true);
+        if (error is HostError && error.status == 401) widget.audio?.onRevoked();
+      }
+    } finally {
+      if (mounted) {
+        setState(() => _loading = false);
+        if (_refreshPending) {
+          _refreshPending = false;
+          unawaited(_load());
+        }
+      }
+    }
+  }
+
+  Future<void> _loadThread(String id) async {
+    try {
+      final thread = await widget.host.thread(id);
+      if (mounted) setState(() => _threads[id] = (thread['replies'] as List).cast<Json>());
+    } catch (error) {
+      if (mounted) {
+        setState(() => _failed = true);
+        if (error is HostError && error.status == 401) widget.audio?.onRevoked();
+      }
+    }
+  }
+
+  Future<void> _compose([String? parent]) async {
+    final posted = await showDialog<bool>(
+      context: context,
+      barrierDismissible: false,
+      builder: (_) => _PostEditor(
+        widget.host,
+        parent,
+        _photos,
+        _imageOnly,
+        publishPhotoLimit: _publishPhotoLimit,
+        onRevoked: widget.audio?.onRevoked,
+      ),
+    );
+    if (posted == true && mounted) {
+      if (parent != null) setState(() => _expanded = parent);
+      await _load();
+    }
+  }
+
+  @override
