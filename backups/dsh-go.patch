+    }
+    final singing = widget.host.singingConversation;
+    final sourceLimit = singing?.byteLimitFor(singingSource);
+    if (singing != null && sourceLimit == null) return;
+    final byteLimit = min(limits.maxTotalBytes, sourceLimit ?? limits.maxTotalBytes);
+    final picker =
+        widget.attachmentPicker ??
+        DeviceAttachmentPicker(messageByteLimit: byteLimit, messageItemLimit: limits.maxItems);
+    setState(() => _pickingAttachments = true);
+    try {
+      var used = totalAttachmentBytes(_drafts);
+      final picks = switch (source) {
+        AttachSource.gallery => PickedAttachments(await picker.pickImages(limit: room)),
+        AttachSource.camera => PickedAttachments([?await picker.takePhoto()]),
+        AttachSource.files => await picker.pickFiles(limit: room, heldBytes: used),
+      };
