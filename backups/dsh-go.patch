@@ -0,0 +1,37 @@
+package io.github.ccch1mneyyy.dsh_app.voice
+
+import io.github.ccch1mneyyy.dsh_app.nativemedia.SpeechGate
+
+/** Feed the shared gate complete PCM frames, even when AudioRecord splits reads arbitrarily. */
+internal class RecorderEndpoint(sampleRate: Int) {
+    private val gate = SpeechGate()
+    private val frame = ShortArray((sampleRate * SpeechGate.FRAME_MS / 1000).toInt())
+    private var filled = 0
+    private var elapsedMs = 0L
+
+    var heardSpeech = false
+        private set
+    var ended = false
+        private set
+
+    /** Number of samples to retain in the WAV, including the final quiet hangover. */
+    fun consume(samples: ShortArray, count: Int): Int {
+        var used = 0
+        while (used < count && !ended) {
+            val size = minOf(count - used, frame.size - filled)
+            samples.copyInto(frame, filled, used, used + size)
+            filled += size
+            used += size
+            if (filled == frame.size) {
+                filled = 0
+                elapsedMs += SpeechGate.FRAME_MS
+                when (gate.consume(SpeechGate.levelOf(frame, frame.size), elapsedMs)) {
+                    SpeechGate.Edge.START -> heardSpeech = true
+                    SpeechGate.Edge.END -> ended = true
+                    SpeechGate.Edge.NONE -> Unit
+                }
+            }
+        }
+        return used
+    }
+}
diff --git a/app/android/app/src/test/kotlin/io/github/ccch1mneyyy/dsh_app/voice/RecorderEndpointTest.kt b/app/android/app/src/test/kotlin/io/github/ccch1mneyyy/dsh_app/voice/RecorderEndpointTest.kt
new file mode 100644
index 0000000000000000000000000000000000000000..cd134a91360698ee8a9b97ce440fb1861556f721
--- /dev/null
+++ b/app/android/app/src/test/kotlin/io/github/ccch1mneyyy/dsh_app/voice/RecorderEndpointTest.kt
@@ -0,0 +1,72 @@
+package io.github.ccch1mneyyy.dsh_app.voice
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class RecorderEndpointTest {
+    private fun feed(endpoint: RecorderEndpoint, samples: Int, amplitude: Int, chunkSize: Int = 977): Int {
+        val pcm = ShortArray(chunkSize) { if (it % 2 == 0) amplitude.toShort() else (-amplitude).toShort() }
+        var used = 0
+        while (used < samples && !endpoint.ended) used += endpoint.consume(pcm, minOf(chunkSize, samples - used))
+        return used
+    }
+
+    @Test fun fifteenSecondsOfSilenceNeverConfirmsSpeech() {
+        val endpoint = RecorderEndpoint(16000)
+        assertEquals(240000, feed(endpoint, 240000, 0))
+        assertFalse(endpoint.heardSpeech)
+        assertFalse(endpoint.ended)
+    }
+
+    @Test fun isolatedLoudPulsesNeverArmAutomaticStop() {
+        val endpoint = RecorderEndpoint(16000)
+        repeat(3) {
+            feed(endpoint, 1600, 14000) // 100 ms, below the 120 ms confirmation window.
+            feed(endpoint, 16000, 18)
+        }
+        assertFalse(endpoint.heardSpeech)
+        assertFalse(endpoint.ended)
+    }
+
+    @Test fun fragmentedReadsMustProvideSixCompleteSpeechFrames() {
+        val endpoint = RecorderEndpoint(16000)
+        feed(endpoint, 1919, 4200, chunkSize = 117)
+        assertFalse(endpoint.heardSpeech)
+        feed(endpoint, 1, 4200)
+        assertTrue(endpoint.heardSpeech)
+        assertFalse(endpoint.ended)
+    }
+
+    @Test fun shortPausesAndWeakSpeechTailsDoNotEndTheUtterance() {
+        val endpoint = RecorderEndpoint(16000)
+        feed(endpoint, 3200, 5000)
+        feed(endpoint, 10880, 0) // 680 ms.
+        assertFalse(endpoint.ended)
+        feed(endpoint, 320, 100) // About -50 dBFS: below start, above the continuation threshold.
+        feed(endpoint, 10880, 0)
+        assertFalse(endpoint.ended)
+        feed(endpoint, 320, 0)
+        assertTrue(endpoint.ended)
+    }
+
+    @Test fun preservesExactlySevenHundredMillisecondsOfQuietAndStopsConsuming() {
+        val endpoint = RecorderEndpoint(16000)
+        feed(endpoint, 3200, 4200)
+        feed(endpoint, 10880, 0)
+        val lastBlock = ShortArray(960)
+        assertEquals(320, endpoint.consume(lastBlock, lastBlock.size))
+        assertTrue(endpoint.ended)
+        assertEquals(0, endpoint.consume(lastBlock, lastBlock.size))
+    }
+
+    @Test fun captureRateDoesNotChangeTheEndpointTime() {
+        for (rate in listOf(16000, 44100, 48000)) {
+            val endpoint = RecorderEndpoint(rate)
+            feed(endpoint, rate / 5, 4200)
+            assertEquals(rate * 7 / 10, feed(endpoint, rate, 0))
+            assertTrue(endpoint.ended)
+        }
+    }
+}
