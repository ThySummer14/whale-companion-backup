+final _homeOffset = RegExp(r'(?:Z|[+-]\d{2}:\d{2})$');
+
+DateTime? _homeInstant(Object? value) =>
+    value is String && _homeOffset.hasMatch(value) ? DateTime.tryParse(value) : null;
+
+final _journalIso = RegExp(
+  r'^(\d{4})-(\d{2})-(\d{2})T(?:[01]\d|2[0-3]):[0-5]\d:[0-5]\d(?:\.\d{1,6})?(?:Z|[+-](?:[01]\d|2[0-3]):[0-5]\d)$',
+);
+
+WhaleHomeJournal? _homeJournal(Object? value, WhaleHomeActivity activity, DateTime observedAt) {
+  if (value is! Map) return null;
+  final state = WhaleHomeJournalState.values.asNameMap()[value['state']];
+  final stamp = value['at'];
+  final match = stamp is String ? _journalIso.firstMatch(stamp) : null;
+  if (state == null || match == null) return null;
+  final year = int.parse(match[1]!);
+  final month = int.parse(match[2]!);
+  final day = int.parse(match[3]!);
+  final calendar = DateTime.utc(year, month, day);
+  if (calendar.month != month || calendar.day != day) return null;
+  final at = _homeInstant(stamp);
+  if (at == null || at.isAfter(observedAt)) return null;
+  if (state == WhaleHomeJournalState.reflecting && activity != WhaleHomeActivity.idle) return null;
+  if (state == WhaleHomeJournalState.revised && observedAt.difference(at) >= WhaleHomeSnapshot.journalRevisionWindow) {
+    return null;
+  }
+  return (state: state, at: at);
+}
