+    host.pcmError = const HostError(404, 'not-found');
+    await voice.toggle('legacy');
+    expect(host.syntheses, 1);
+    expect(host.downloads, 1);
+    expect(calls.last.method, 'play');
+  });
+
+  test('stop disconnects a held native write and ignores its late reply', () async {
+    final pcm = StreamController<Uint8List>();
+    host.pcm = pcm.stream;
+    nativeWrite = Completer<bool>();
+    final pending = voice.toggle('live');
+    pcm.add(Uint8List.fromList([1, 2]));
+    await waitForCall('writePcm');
+    voice.stop();
+    await host.pcmAbort;
+    nativeWrite!.complete(false);
+    await pcm.close();
+    await pending;
+    expect(voice.phase, WhaleVoicePhase.idle);
+    expect(host.syntheses, 0);
+    expect(calls.any((call) => call.method == 'endPcm'), isFalse);
+  });
+
+  test('automatic replies leave active and paused manual audio alone', () async {
+    await voice.toggle('manual');
+    await event('start');
+    await voice.playAutomatically(_reply());
+    expect(voice.messageId, 'manual');
+    expect(voice.phase, WhaleVoicePhase.playing);
+    await voice.toggle('manual');
+    await voice.playAutomatically(_reply());
+    voice.stopAutomatic();
+    expect(voice.phase, WhaleVoicePhase.paused);
+    expect(host.syntheses, 1);
+    expect(host.lastVoiceReplyTiming, isNull);
+  });
+
+  test('the automatic stop only cancels the playback started by a voice reply', () async {
+    await voice.playAutomatically(_reply());
+    expect(voice.playingAutomatically, isTrue);
+    voice.stopAutomatic();
+    expect(voice.phase, WhaleVoicePhase.idle);
+    expect(voice.playingAutomatically, isFalse);
+    await event('start');
+    expect(voice.phase, WhaleVoicePhase.idle);
+    expect(host.lastVoiceReplyTiming!.nativeStartMs, isNull);
+  });
+
+  test('automatic WAV fallback measures native start without creating PCM timing', () async {
+    var elapsed = 0;
+    final reply = _reply(elapsedMs: () => elapsed);
+    await voice.playAutomatically(reply);
+    expect(host.lastVoiceReplyTiming, (readyMs: 0, nativeStartMs: null));
+    elapsed = 160;
+    await event('start', id: 'older-clip');
+    expect(host.lastVoiceReplyTiming!.nativeStartMs, isNull);
+    elapsed = 240;
+    await event('start');
+    expect(host.lastVoiceReplyTiming, (readyMs: 0, nativeStartMs: 240));
+    expect(host.lastVoicePlaybackTiming, isNull);
+    elapsed = 420;
+    await event('start');
+    expect(host.lastVoiceReplyTiming!.nativeStartMs, 240);
+  });
+}
