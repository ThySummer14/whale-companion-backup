+  String get _state => _status ?? widget.draft['status'] as String;
+  List<WhaleHouseZone> get _zones =>
+      widget.zones.where((zone) => widget.draft['zoneId'] == null || widget.draft['zoneId'] == zone.id).toList();
+
+  Future<void> _submit(String zoneId) async {
+    if (_busy || !widget.reachable) return;
+    final preview = _preview;
+    final id = widget.draft['id'] as String;
+    final revision = widget.draft['revision'] as int;
+    setState(() {
+      _busy = true;
+      _failure = null;
