+  WhaleCommunitySnapshot withActiveSite(WhaleCommunitySite? site) => WhaleCommunitySnapshot._(site, recentCamp, campProject);
+
+  static final _sites = WhaleCommunitySite.values.asNameMap();
+  static final _events = WhaleCampEvent.values.asNameMap();
+  static final _outcomes = WhaleSurveyOutcome.values.asNameMap();
+  static final _directions = WhaleSurveyDirection.values.asNameMap();
+  static const _trails = {
