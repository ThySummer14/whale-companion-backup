+
+const _builtAt = '2026-11-09T20:02:30.000Z';
+const _revisitedAt = '2026-11-10T10:03:20.000+08:00';
+
+Map<String, Object?> _project(String stage, [Map<String, Object?> extra = const {}]) => {
+  'stage': stage,
+  'supplyVisits': 2,
+  'availability': 'active',
+  ...extra,
