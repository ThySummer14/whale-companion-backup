+    expect(host.playbackReports, isEmpty);
+    await event('start');
+    expect(voice.phase, WhaleVoicePhase.playing);
+    expect(host.playbackReports.single.$1, _task);
+    final timing = host.lastVoicePlaybackTiming!;
+    expect(timing.firstByteMs, greaterThanOrEqualTo(0));
+    expect(timing.nativeStartMs, greaterThanOrEqualTo(timing.firstByteMs));
+    expect(timing.source, VoiceStreamSource.prefetchLive);
