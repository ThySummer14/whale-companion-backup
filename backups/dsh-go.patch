+      if (!mounted) return;
+      setState(() {
+        _preview = result['previewId'] is String && result['ready'] == true ? result['previewId'] as String : null;
+        if (preview != null && result['status'] == 'built') {
+          _status = 'built';
+        } else if (_preview == null) {
+          _failure = _siteFailure(context.l10n, result['reason']);
+          final needs = result['materials'];
+          if (needs is List) {
+            final missing = needs
+                .whereType<Map>()
