index 00000000..9d81c835
--- /dev/null
+++ b/app/lib/whale/voxel_blueprints.dart
@@ -0,0 +1,362 @@
+import 'dart:async';
+import 'dart:math' as math;
+import 'dart:typed_data';
+
+import 'package:file_picker/file_picker.dart';
+import 'package:flutter/material.dart';
+
+import '../l10n/l10n.dart';
+import 'host.dart';
+
+typedef WhaleVoxelBlueprint = ({
+  String id,
+  String name,
+  String sourceName,
+  String sha256,
+  int width,
+  int height,
+  int depth,
+  int blocks,
+  int materials,
+  bool approved,
+  WhaleVoxelConstruction? construction,
+});
+
+typedef WhaleVoxelZone = ({String id, String name, String dimension, int x, int y, int z, int radius});
+typedef WhaleVoxelConstruction = ({
+  String status,
+  String zoneId,
+  String zoneName,
+  int? checked,
+  int? matched,
+  String? reason,
+});
+
+List<WhaleVoxelZone> whaleVoxelZones(Object? payload) => [
+  if (payload is List)
+    for (final item in payload)
+      if (item case {
+        'id': final String id,
+        'name': final String name,
+        'dimension': final String dimension,
+        'x': final int x,
+        'y': final int y,
+        'z': final int z,
+        'radius': final int radius,
+      })
+        (id: id, name: name, dimension: dimension, x: x, y: y, z: z, radius: radius),
+];
+
+WhaleVoxelConstruction? _construction(Object? payload) {
+  if (payload case {'status': final String status, 'zoneId': final String zoneId, 'zoneName': final String zoneName}
+      when const ['running', 'interrupted', 'built'].contains(status)) {
+    final receipt = payload['receipt'];
+    return (
+      status: status,
+      zoneId: zoneId,
+      zoneName: zoneName,
+      checked: receipt is Map && receipt['checked'] is int ? receipt['checked'] as int : null,
+      matched: receipt is Map && receipt['matched'] is int ? receipt['matched'] as int : null,
+      reason: payload['reason'] is String ? payload['reason'] as String : null,
+    );
+  }
+  return null;
+}
+
+List<WhaleVoxelBlueprint> whaleVoxelBlueprints(Object? payload) {
+  if (payload is! List) return const [];
+  return [
+    for (final item in payload)
+      if (item
+          case {
+            'id': final String id,
+            'name': final String name,
+            'sourceName': final String sourceName,
+            'sha256': final String hash,
+            'size': {'x': final int width, 'y': final int height, 'z': final int depth},
+            'declared': final int blocks,
+            'materialStates': final int materials,
+          }
+          when width > 0 && height > 0 && depth > 0 && blocks > 0 && materials > 0)
+        (
+          id: id,
+          name: name,
+          sourceName: sourceName,
+          sha256: hash,
+          width: width,
+          height: height,
+          depth: depth,
+          blocks: blocks,
+          materials: materials,
+          approved: item['approvedAt'] is String,
+          construction: _construction(item['construction']),
+        ),
+  ];
+}
+
+class WhaleVoxelBlueprintCard extends StatefulWidget {
+  const WhaleVoxelBlueprintCard({
+    required this.blueprint,
+    required this.host,
+    required this.reachable,
+    required this.onRefresh,
+    required this.onRevoked,
+    this.zones = const [],
+    super.key,
+  });
+
+  final WhaleVoxelBlueprint blueprint;
+  final CompanionHost host;
+  final bool reachable;
+  final List<WhaleVoxelZone> zones;
+  final Future<void> Function() onRefresh;
+  final VoidCallback onRevoked;
+
+  @override
+  State<WhaleVoxelBlueprintCard> createState() => _WhaleVoxelBlueprintCardState();
+}
+
+class _WhaleVoxelBlueprintCardState extends State<WhaleVoxelBlueprintCard> {
+  Uint8List? _preview;
+  Completer<void>? _previewRequest;
+  bool? _review;
+  bool _expanded = false;
+  bool _previewFailed = false;
+  bool _busy = false;
+  bool _siteBusy = false;
+  String? _zoneId;
+  String? _previewId;
+  String? _siteReason;
+  int? _siteChecked;
+  WhaleVoxelConstruction? _latestConstruction;
+
+  void _cancelPreview() {
+    _previewRequest?.complete();
+    _previewRequest = null;
+  }
+
+  @override
+  void dispose() {
+    _cancelPreview();
+    super.dispose();
+  }
+
+  @override
+  void didUpdateWidget(WhaleVoxelBlueprintCard oldWidget) {
+    super.didUpdateWidget(oldWidget);
+    if (oldWidget.blueprint.approved != widget.blueprint.approved) {
+      _review = null;
+      _previewId = null;
+    }
+    if (oldWidget.blueprint.construction != widget.blueprint.construction) _latestConstruction = null;
+    if (!widget.reachable) _cancelPreview();
+    if (widget.reachable && !oldWidget.reachable && _expanded) unawaited(_loadPreview());
+  }
+
+  Future<void> _loadPreview() async {
+    if (_preview != null || _previewRequest != null || !_expanded || !widget.reachable) return;
+    final abort = Completer<void>();
+    setState(() {
+      _previewRequest = abort;
+      _previewFailed = false;
+    });
+    try {
+      final image = await widget.host.voxelBlueprintFile(widget.blueprint.id, preview: true, abort: abort.future);
+      if (mounted && identical(_previewRequest, abort)) setState(() => _preview = image);
+    } on Exception catch (error) {
+      if (!mounted || !identical(_previewRequest, abort)) return;
+      if (error is HostError && error.status == 401) widget.onRevoked();
+      setState(() => _previewFailed = true);
+    } finally {
+      if (mounted && identical(_previewRequest, abort)) setState(() => _previewRequest = null);
+    }
+  }
+
+  Future<void> _action({bool? approve}) async {
+    if (_busy || !widget.reachable) return;
+    final blueprint = widget.blueprint;
+    setState(() => _busy = true);
+    try {
+      if (approve != null) {
+        final result = await widget.host.reviewVoxelBlueprint(blueprint.id, blueprint.sha256, approved: approve);
+        if (mounted) {
+          setState(() {
+            _review = result['approvedAt'] is String;
+            _previewId = null;
+            _siteChecked = null;
+          });
+          await widget.onRefresh();
+        }
+      } else {
+        final bytes = await widget.host.voxelBlueprintFile(blueprint.id, preview: false);
+        if (!mounted || !widget.reachable) return;
+        await FilePicker.saveFile(fileName: 'blueprint-${blueprint.id}.schem', bytes: bytes);
+      }
+    } on Exception catch (error) {
+      if (!mounted) return;
+      if (error is HostError && error.status == 401) widget.onRevoked();
+      ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(context.l10n.whaleVoxelActionFailed)));
+    } finally {
+      if (mounted) setState(() => _busy = false);
+    }
+  }
+
+  Future<void> _site(WhaleVoxelZone zone) async {
+    if (_busy || _siteBusy || !widget.reachable) return;
+    final previewId = _zoneId == zone.id ? _previewId : null;
+    setState(() {
+      _siteBusy = true;
+      _previewId = null;
+      _siteReason = null;
+      _siteChecked = null;
+    });
+    try {
+      final blueprint = widget.blueprint;
+      final result = await widget.host.voxelBlueprintSite(
+        blueprint.id,
+        blueprint.sha256,
+        zone.id,
+        previewId: previewId,
+      );
+      if (!mounted) return;
+      setState(() {
+        if (previewId == null) {
+          if (result case {'ready': true, 'previewId': final String id, 'checked': final int checked}) {
+            _zoneId = zone.id;
+            _previewId = id;
+            _siteChecked = checked;
+          } else {
+            _siteReason = result['reason'] is String ? result['reason'] as String : 'blueprint-receipt-unconfirmed';
+          }
+        } else {
+          _latestConstruction = _construction(result);
+        }
+      });
+    } on Exception catch (error) {
+      if (!mounted) return;
+      if (error is HostError && error.status == 401) widget.onRevoked();
+      setState(() => _siteReason = error is HostError ? error.code : 'blueprint-receipt-unconfirmed');
+    } finally {
+      if (mounted) {
+        setState(() => _siteBusy = false);
+        if (previewId != null) await widget.onRefresh();
+      }
+    }
+  }
+
+  String _siteMessage(L10n l, String? reason) => switch (reason) {
+    'blueprint-site-unloaded' => l.whaleVoxelSiteUnloaded,
+    'blueprint-site-obstructed' || 'blueprint-site-verification-failed' => l.whaleVoxelSiteBlocked,
+    'blueprint-site-player-present' => l.whaleVoxelSiteOccupied,
+    'blueprint-site-preview-required' || 'blueprint-operation-changed' => l.whaleApprovalStale,
+    'minecraft-camp-paused' || 'blueprint-stopped' => l.whaleVoxelBuildPaused,
+    _ => l.whaleVoxelActionFailed,
+  };
+
+  @override
+  Widget build(BuildContext context) {
+    final l = context.l10n;
+    final blueprint = widget.blueprint;
+    final approved = _review ?? blueprint.approved;
+    final construction = _latestConstruction ?? blueprint.construction;
+    final zones = widget.zones
+        .where(
+          (zone) =>
+              (construction == null || construction.zoneId == zone.id) &&
+              zone.radius >= math.max(blueprint.height - 1, math.max(blueprint.width ~/ 2, blueprint.depth ~/ 2)),
+        )
+        .toList();
+    final zone = zones.where((zone) => zone.id == _zoneId).firstOrNull ?? (zones.length == 1 ? zones.first : null);
+    final status = switch (construction?.status) {
+      'built' => l.whaleVoxelBuildComplete,
+      'running' => l.whaleApprovalBuilding,
+      'interrupted' => l.whaleApprovalInterrupted,
+      _ => approved ? l.whaleVoxelReviewed : l.whaleApprovalPending,
+    };
+    return Card(
+      child: ExpansionTile(
+        title: Text(blueprint.name),
+        subtitle: Text(status),
+        childrenPadding: const EdgeInsets.fromLTRB(16, 0, 16, 16),
+        expandedCrossAxisAlignment: CrossAxisAlignment.stretch,
+        onExpansionChanged: (expanded) {
+          _expanded = expanded;
+          if (expanded) {
+            unawaited(_loadPreview());
+          } else {
+            _cancelPreview();
+          }
+        },
+        children: [
+          if (_preview case final bytes?)
+            Image.memory(
+              bytes,
+              semanticLabel: blueprint.name,
+              fit: BoxFit.contain,
+              errorBuilder: (context, error, stack) => Text(l.whaleVoxelPreviewFailed),
+            )
+          else if (_previewRequest != null)
+            const LinearProgressIndicator()
+          else if (_previewFailed)
+            TextButton(onPressed: widget.reachable ? _loadPreview : null, child: Text(l.whaleVoxelPreviewFailed)),
+          const SizedBox(height: 8),
+          Text(blueprint.sourceName, style: Theme.of(context).textTheme.bodySmall),
+          Text('${blueprint.width} × ${blueprint.height} × ${blueprint.depth}'),
+          Text(l.whaleVoxelSize(blueprint.blocks, blueprint.materials)),
+          if (construction?.status == 'built' && construction?.checked != null && construction?.matched != null)
+            Text(l.whaleVoxelBuildReceipt(construction!.zoneName, construction.checked!, construction.matched!)),
+          const SizedBox(height: 8),
+          Wrap(
+            spacing: 8,
+            runSpacing: 4,
+            children: [
+              if (approved)
+                TextButton(
+                  onPressed: widget.reachable && !_busy ? () => _action(approve: false) : null,
+                  child: Text(l.whaleVoxelUnreview),
+                )
+              else
+                FilledButton(
+                  onPressed: widget.reachable && !_busy && _preview != null ? () => _action(approve: true) : null,
+                  child: Text(l.whaleVoxelReview),
+                ),
+              OutlinedButton.icon(
+                onPressed: widget.reachable && !_busy ? _action : null,
+                icon: const Icon(Icons.download_outlined),
+                label: Text(l.whaleVoxelExport),
+              ),
+            ],
+          ),
+          if (approved && construction?.status != 'running' && construction?.status != 'built' && zones.isNotEmpty) ...[
+            const SizedBox(height: 12),
+            DropdownButton<String>(
+              value: zone?.id,
+              isExpanded: true,
+              hint: Text(l.whaleVoxelSiteChoice),
+              items: [for (final site in zones) DropdownMenuItem(value: site.id, child: Text(site.name))],
+              onChanged: !widget.reachable || _busy || _siteBusy
+                  ? null
+                  : (value) => setState(() {
+                      _zoneId = value;
+                      _previewId = null;
+                      _siteChecked = null;
+                      _siteReason = null;
+                    }),
+            ),
+            if (zone != null)
+              Text('${zone.dimension} · ${zone.x - blueprint.width ~/ 2}, ${zone.y}, ${zone.z - blueprint.depth ~/ 2}'),
+            if (_siteChecked case final checked?) Text(l.whaleVoxelSiteReady(checked)),
+            Align(
+              alignment: Alignment.centerLeft,
+              child: FilledButton(
+                onPressed: zone == null || !widget.reachable || _busy || _siteBusy ? null : () => _site(zone),
+                child: Text(_previewId == null || _zoneId != zone?.id ? l.whaleVoxelSiteCheck : l.whaleVoxelStartBuild),
+              ),
+            ),
+          ],
+          if ((_siteReason ?? construction?.reason) case final reason?) Text(_siteMessage(l, reason)),
+        ],
+      ),
+    );
+  }
+}
