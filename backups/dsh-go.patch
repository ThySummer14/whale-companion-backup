+import 'status.dart';
+
+enum WhaleActivityCategory { feed, game, stage, video }
+
+enum WhaleActivityKind {
+  post(WhaleActivityCategory.feed),
+  reply(WhaleActivityCategory.feed),
+  move(WhaleActivityCategory.game),
+  gather(WhaleActivityCategory.game),
+  craft(WhaleActivityCategory.game),
+  build(WhaleActivityCategory.game),
+  voxelBuilt(WhaleActivityCategory.game),
+  houseSection(WhaleActivityCategory.game),
+  houseVerified(WhaleActivityCategory.game),
+  houseMismatch(WhaleActivityCategory.game),
+  camp(WhaleActivityCategory.game),
+  safeReturn(WhaleActivityCategory.game),
+  follow(WhaleActivityCategory.game),
+  blush(WhaleActivityCategory.stage),
+  point(WhaleActivityCategory.stage),
+  video(WhaleActivityCategory.video),
+  speech(WhaleActivityCategory.stage);
+
+  const WhaleActivityKind(this.category);
+  final WhaleActivityCategory category;
+
+  String label(L10n l) => switch (this) {
+    post => l.whaleActivityPost,
+    reply => l.whaleActivityReply,
+    move => l.whaleActivityMove,
+    gather => l.whaleActivityGather,
+    craft => l.whaleActivityCraft,
+    build => l.whaleActivityBuild,
+    voxelBuilt => l.whaleVoxelBuildComplete,
+    houseSection => l.whaleActivityHouseSection,
+    houseVerified => l.whaleActivityHouseVerified,
+    houseMismatch => l.whaleActivityHouseMismatch,
+    camp => l.whaleActivityCamp,
+    safeReturn => l.whaleActivityReturn,
+    follow => l.whaleActivityFollow,
+    blush => l.whaleActivityBlush,
+    point => l.whaleActivityPoint,
+    video => l.whaleBilibiliConversation,
+    speech => l.whaleActivitySpeech,
+  };
+}
+
+class WhaleActivity {
+  const WhaleActivity(this.id, this.at, this.kind, {this.threadId, this.replyId, this.house, this.watch, this.voxel});
+
+  final int id;
+  final DateTime at;
+  final WhaleActivityKind kind;
+  final String? threadId;
+  final String? replyId;
+  final ({String? name, int checked, int? section, int? placed, int? unmatched})? house;
+  final WhaleBilibiliWatchReceipt? watch;
+  final ({String name, String zone, String dimension, int x, int y, int z, int checked, int matched})? voxel;
+
+  static final _uuid = RegExp(r'^[\da-f]{8}(?:-[\da-f]{4}){3}-[\da-f]{12}$', caseSensitive: false);
+  static final _dimension = RegExp(r'^[a-z0-9_.-]+:[a-z0-9_./-]+$');
+  static String? _postId(Object? id) => id is String && _uuid.hasMatch(id) ? id : null;
+
+  static List<WhaleActivity>? fromRecords(Object? records) {
+    if (records is! List) return null;
+    final deleted = <String>{};
+    for (final row in records.whereType<Map>()) {
+      if (row['source'] == 'core.feed' && row['kind'] == 'post.deleted' && row['status'] == 'success') {
+        final data = row['data'];
+        if (data is Map) {
+          final postId = _postId(data['postId']);
+          if (postId != null) deleted.add(postId);
+        }
+      }
+    }
+    final events = <int, WhaleActivity>{};
+    for (final row in records.whereType<Map>()) {
+      final item = _fromRecord(row, deleted);
+      if (item != null) events.putIfAbsent(item.id, () => item);
+    }
+    return events.values.toList()..sort((a, b) {
+      final order = b.at.compareTo(a.at);
+      return order == 0 ? b.id.compareTo(a.id) : order;
+    });
+  }
+
+  static WhaleActivity? _fromRecord(Map row, Set<String> deleted) {
+    final id = row['id'];
+    final stamp = row['occurredAt'];
+    if (id is! int || id <= 0 || stamp is! String) return null;
+    final at = DateTime.tryParse(stamp);
+    if (at == null) return null;
+    final source = row['source'];
+    final kind = row['kind'];
+    final data = row['data'];
+    final status = row['status'];
+    if (source == 'game.minecraft' && row['contextId'] == 'game.minecraft' && data is Map) {
+      if (kind == 'world.house-project-section' || kind == 'world.house-project-verification') {
+        return _houseReceipt(id, at, kind == 'world.house-project-section', status, data);
+      }
+      if (kind == 'world.blueprint-built' && status == 'success') {
+        return _voxelReceipt(id, at, data);
+      }
+    }
+    if (status != 'success') return null;
+    if (source == 'media.bilibili' && row['contextId'] == bilibiliContext && kind == 'video.watched') {
+      if (data is Map && data.containsKey('source')) {
+        final watch = WhaleBilibiliWatchReceipt.fromWire({...data, 'activityId': id});
+        return watch == null ? null : WhaleActivity(id, at, WhaleActivityKind.video, watch: watch);
+      }
+      return WhaleActivity(id, at, WhaleActivityKind.video);
+    }
+    if (source == 'core.feed' && data is Map && data['author'] == 'companion') {
+      final postId = _postId(data['postId']);
+      if (postId == null || deleted.contains(postId)) return null;
+      if (kind == 'post.created' && data['parentId'] == null) {
+        return WhaleActivity(id, at, WhaleActivityKind.post, threadId: postId);
+      }
+      final parentId = _postId(data['parentId']);
+      if (kind == 'post.replied' && parentId != null && !deleted.contains(parentId)) {
+        return WhaleActivity(id, at, WhaleActivityKind.reply, threadId: parentId, replyId: postId);
+      }
+      return null;
+    }
+    final activity = switch ((kind, source, row['contextId'])) {
+      ('task.succeeded', 'minecraft.move', 'game.minecraft') => WhaleActivityKind.move,
+      ('task.succeeded', 'minecraft.dig', 'game.minecraft') => WhaleActivityKind.gather,
+      ('task.succeeded', 'minecraft.craft', 'game.minecraft') => WhaleActivityKind.craft,
+      ('task.succeeded', 'minecraft.build', 'game.minecraft') => WhaleActivityKind.build,
+      ('task.succeeded', 'minecraft.prepare', 'game.minecraft') => WhaleActivityKind.camp,
+      ('task.succeeded', 'minecraft.return', 'game.minecraft') => WhaleActivityKind.safeReturn,
+      ('task.succeeded', 'minecraft.follow', 'game.minecraft') => WhaleActivityKind.follow,
+      ('task.succeeded', 'media.realtime', _) => WhaleActivityKind.speech,
+      ('avatar.action.completed', 'media.avatar', 'avatar.stage') when data is Map => switch (data['action']) {
+        'blush' => WhaleActivityKind.blush,
+        'point' => WhaleActivityKind.point,
+        _ => null,
+      },
+      _ => null,
+    };
+    return activity == null ? null : WhaleActivity(id, at, activity);
+  }
+
+  static WhaleActivity? _voxelReceipt(int id, DateTime at, Map data) {
+    if (data
+        case {
+          'name': final String name,
+          'zoneName': final String zone,
+          'dimension': final String dimension,
+          'x': final int x,
+          'y': final int y,
+          'z': final int z,
+          'checked': final int checked,
+          'matched': final int matched,
+        }
+        when name.trim().isNotEmpty &&
+            zone.trim().isNotEmpty &&
+            name.length <= 80 &&
+            zone.length <= 80 &&
+            dimension.length <= 64 &&
+            _dimension.hasMatch(dimension) &&
+            matched > 0 &&
+            matched <= checked &&
+            checked <= 256 * 256 * 256) {
+      return WhaleActivity(
+        id,
+        at,
+        WhaleActivityKind.voxelBuilt,
+        voxel: (name: name, zone: zone, dimension: dimension, x: x, y: y, z: z, checked: checked, matched: matched),
+      );
+    }
+    return null;
+  }
+
+  static WhaleActivity? _houseReceipt(int id, DateTime at, bool section, Object? status, Map data) {
+    final checked = data['checked'];
+    if (checked is! int || checked < 1) return null;
+    final rawName = data['projectName'];
+    final name = rawName is String ? rawName.trim() : null;
+    final projectName = name != null && name.isNotEmpty && name.length <= 80 ? name : null;
+    if (section) {
+      final index = data['index'];
+      final placed = data['placed'];
+      if (status != 'success' ||
+          data['built'] != true ||
+          index is! int ||
+          index < 0 ||
+          placed is! int ||
+          placed < 0 ||
+          placed > checked) {
+        return null;
+      }
+      return WhaleActivity(
+        id,
+        at,
+        WhaleActivityKind.houseSection,
+        house: (name: projectName, checked: checked, section: index + 1, placed: placed, unmatched: null),
+      );
+    }
+    final matched = data['matched'];
+    final unmatched = data['unmatchedSections'];
+    if (checked < 101 ||
+        matched is! bool ||
+        unmatched is! List ||
+        matched != unmatched.isEmpty ||
+        unmatched.any((value) => value is! int || value < 0) ||
+        status != (matched ? 'success' : 'warning') ||
+        data.containsKey('dailyTaskId')) {
+      return null;
+    }
+    return WhaleActivity(
+      id,
+      at,
+      matched ? WhaleActivityKind.houseVerified : WhaleActivityKind.houseMismatch,
+      house: (name: projectName, checked: checked, section: null, placed: null, unmatched: unmatched.length),
+    );
+  }
+}
+
+class WhaleActivityTile extends StatelessWidget {
+  const WhaleActivityTile({
+    required this.item,
+    required this.onOpenThread,
+    this.onOpenWatch,
+    this.contentPadding,
+    super.key,
+  });
+
+  final WhaleActivity item;
+  final void Function(String threadId, String? replyId) onOpenThread;
+  final ValueChanged<WhaleBilibiliWatchReceipt>? onOpenWatch;
+  final EdgeInsetsGeometry? contentPadding;
+
+  @override
+  Widget build(BuildContext context) {
+    final l = context.l10n;
+    final local = MaterialLocalizations.of(context);
+    final at = item.at.toLocal();
+    final date = '${local.formatShortDate(at)} · ${local.formatTimeOfDay(TimeOfDay.fromDateTime(at))}';
+    final threadId = item.threadId;
+    final watch = item.watch;
+    final openWatch = onOpenWatch;
+    final voxel = item.voxel;
+    final details = switch ((watch, voxel)) {
+      (final watch?, _) => whaleBilibiliWatchDetails(l, watch),
+      (_, final voxel?) =>
+        '${l.whaleActivityVoxelDetail(voxel.zone, voxel.matched, voxel.checked - voxel.matched)}\n'
+            '${l.whaleActivityVoxelOrigin(voxel.dimension, voxel.x, voxel.y, voxel.z)}',
+      _ => switch (item.house) {
+        (section: final int section, placed: final int placed, :final checked, name: _, unmatched: _) =>
+          l.whaleActivityHouseSectionDetail(section, checked, placed),
+        (unmatched: 0, :final checked, name: _, section: _, placed: _) => l.whaleActivityHouseVerifiedDetail(checked),
+        (unmatched: final int count, name: _, checked: _, section: _, placed: _) => l.whaleActivityHouseMismatchDetail(
+          count,
+        ),
+        _ => null,
+      },
+    };
+    final VoidCallback? onTap;
+    if (threadId != null) {
+      onTap = () => onOpenThread(threadId, item.replyId);
+    } else if (watch != null) {
+      onTap = openWatch != null ? () => openWatch(watch) : () => openWhaleBilibiliSource(context, watch.source.uri);
+    } else {
+      onTap = null;
+    }
+    return ListTile(
+      contentPadding: contentPadding,
+      leading: Icon(switch (item.kind.category) {
+        WhaleActivityCategory.feed => Icons.forum_outlined,
+        WhaleActivityCategory.game => Icons.sports_esports_outlined,
+        WhaleActivityCategory.stage => Icons.face_outlined,
+        WhaleActivityCategory.video => Icons.ondemand_video_outlined,
+      }),
+      title: Text(
+        watch?.title ?? voxel?.name ?? item.house?.name ?? item.kind.label(l),
+        maxLines: 2,
+        overflow: TextOverflow.ellipsis,
+      ),
+      subtitle: Text(details == null ? date : '$details\n$date'),
+      isThreeLine: details != null,
+      trailing: onTap == null ? null : const Icon(Icons.chevron_right),
+      onTap: onTap,
+    );
+  }
+}
