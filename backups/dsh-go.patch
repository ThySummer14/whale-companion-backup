+                child: Stack(
+                  alignment: Alignment.center,
+                  children: [
+                    CustomPaint(painter: _BuildingPainter(site), size: const Size(96, 55)),
+                    if (active == site)
+                      Positioned(
+                        top: 1,
+                        right: 3,
+                        child: Icon(
+                          Icons.circle,
+                          key: const ValueKey('whale-community-live'),
+                          size: 10,
+                          color: colors.primary,
+                        ),
+                      ),
+                  ],
+                ),
+              ),
+              Text(_siteLabel(l, site), textAlign: TextAlign.center),
+            ],
+          ),
+        ),
+      ),
