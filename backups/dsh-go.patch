+++ b/app/lib/whale_main.dart
@@ -0,0 +1,590 @@
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+import 'companion/companion_voice.dart';
+import 'l10n/l10n.dart';
+import 'ui/common/third_party_licenses.dart';
+import 'ui/settings/font_licenses.dart';
+import 'ui/theme/theme.dart';
+import 'whale/activity.dart';
+import 'whale/avatar_viewer.dart';
+import 'whale/camp.dart';
+import 'whale/chat.dart';
+import 'whale/feed.dart';
+import 'whale/home.dart';
+import 'whale/home_live.dart';
+import 'whale/host.dart';
+import 'whale/notice_state.dart';
+import 'whale/notices.dart';
+import 'whale/songs.dart';
+import 'whale/status.dart';
+
+void main() {
+  WidgetsFlutterBinding.ensureInitialized();
+  registerThirdPartyLicenses();
+  registerFontLicenses();
+  runApp(const ProviderScope(child: WhaleApp()));
+}
+
+class WhaleApp extends StatelessWidget {
+  const WhaleApp({super.key});
+
+  @override
+  Widget build(BuildContext context) => MaterialApp(
+    debugShowCheckedModeBanner: false,
+    onGenerateTitle: (context) => context.l10n.whaleTitle,
+    theme: buildLightTheme(),
+    darkTheme: buildDarkTheme(),
+    localizationsDelegates: L10n.localizationsDelegates,
+    supportedLocales: AppLocale.supported,
+    localeListResolutionCallback: (locales, _) => AppLocale.resolve(null, locales),
+    home: const _WhaleHome(),
+  );
+}
+
+class _WhaleHome extends StatefulWidget {
+  const _WhaleHome();
+
+  @override
+  State<_WhaleHome> createState() => _WhaleHomeState();
+}
+
+class _WhaleHomeState extends State<_WhaleHome> with WidgetsBindingObserver {
+  static const _chatTab = 0;
+  static const _feedTab = 1;
+  static const _statusTab = 2;
+  static const _activityTab = 3;
+  static const _homeTab = 4;
+
+  final _link = TextEditingController();
+  final _player = CompanionVoice();
+  final _deviceRevoked = ValueNotifier(false);
+  final _homeLive = WhaleHomeLiveWatch();
+  CompanionHost? _host;
+  WhaleStatusSnapshot? _status;
+  List<WhaleActivity>? _activities;
+  WhaleNoticeSummary? _notices;
+  int _noticeRevision = 0;
+  WhaleStatusConnection _connection = WhaleStatusConnection.reachable;
+  Timer? _statusTimer;
+  Future<void>? _statusRefresh;
+  bool _foreground = true;
+  Object? _error;
+  bool _busy = true;
+  int _tab = _chatTab;
+  bool _songsOpen = false;
+  bool _bilibiliOpen = false;
+  bool _campOpen = false;
+  bool _inboxOpen = false;
+  bool _avatarOpen = false;
+
+  @override
+  void initState() {
+    super.initState();
+    WidgetsBinding.instance.addObserver(this);
+    unawaited(_restore());
+  }
+
+  Future<void> _restore() async {
+    try {
+      final host = await CompanionHost.load();
+      if (!mounted) {
+        host?.close();
+        return;
+      }
+      setState(() => _host = host);
+      _watchStatus();
+    } catch (error) {
+      if (mounted) setState(() => _error = error);
+    } finally {
+      if (mounted) setState(() => _busy = false);
+    }
+  }
+
+  Future<void> _pair() async {
+    if (_busy) return;
+    setState(() {
+      _busy = true;
+      _error = null;
+    });
+    try {
+      final host = await CompanionHost.pair(_link.text);
+      if (!mounted) {
+        host.close();
+        return;
+      }
+      _link.clear();
+      _deviceRevoked.value = false;
+      setState(() {
+        _host = host;
+        _tab = _chatTab;
+      });
+      _watchStatus();
+    } catch (error) {
+      if (mounted) setState(() => _error = error);
+    } finally {
+      if (mounted) setState(() => _busy = false);
+    }
+  }
+
+  @override
+  void didChangeAppLifecycleState(AppLifecycleState state) {
+    if (state == AppLifecycleState.resumed) {
+      _foreground = true;
+      _watchStatus();
+    } else if (state == AppLifecycleState.hidden ||
+        state == AppLifecycleState.paused ||
+        state == AppLifecycleState.detached) {
+      _foreground = false;
+      _statusTimer?.cancel();
+      _syncHomeLive();
+    }
+  }
+
+  void _watchStatus() {
+    _statusTimer?.cancel();
+    _syncHomeLive();
+    if (_host == null || !_foreground) return;
+    unawaited(_refreshStatus());
+    _statusTimer = Timer.periodic(Duration(seconds: _tab == _homeTab ? 5 : 30), (_) {
+      final latest = _status;
+      final live = _homeLive.value;
+      if (_tab == _homeTab && latest != null && live != null &&
+          DateTime.now().difference(live.receivedAt).abs() < WhaleHomeSignal.freshness &&
+          DateTime.now().difference(latest.syncedAt).abs() < const Duration(seconds: 20)) {
+        return;
+      }
+      unawaited(_refreshStatus());
+    });
+  }
+
+  void _syncHomeLive() => _homeLive.watch(
+    _foreground && _tab == _homeTab && _connection == WhaleStatusConnection.reachable &&
+            !_deviceRevoked.value && _status?.homeLiveAvailable == true
+        ? _host
+        : null,
+  );
+
+  void _openTab(int index) {
+    final homeVisibilityChanged = (_tab == _homeTab) != (index == _homeTab);
+    setState(() => _tab = index);
+    if (homeVisibilityChanged) {
+      _watchStatus();
+    } else if (index == _statusTab || index == _activityTab) {
+      unawaited(_refreshStatus());
+    }
+  }
+
+  Future<void> _refreshStatus() {
+    final host = _host;
+    if (host == null || !_foreground) return Future.value();
+    final pending = _statusRefresh;
+    if (pending != null) return pending;
+    final refresh = _fetchStatus(host);
+    setState(() => _statusRefresh = refresh);
+    return refresh;
+  }
+
+  Future<void> _fetchStatus(CompanionHost host) async {
+    final noticeRevision = _noticeRevision;
+    WhaleStatusSnapshot? snapshot;
+    List<WhaleActivity>? activities;
+    WhaleNoticeSummary? notices;
+    var connection = WhaleStatusConnection.reachable;
+    try {
+      final state = await host.state();
+      snapshot = WhaleStatusSnapshot.fromState(state, DateTime.now());
+      activities = WhaleActivity.fromRecords(state['activities']);
+      notices = WhaleNoticeSummary.fromJson(state['notices']);
+    } catch (error) {
+      connection = error is HostError && error.status == 401
+          ? WhaleStatusConnection.revoked
+          : WhaleStatusConnection.unreachable;
+    }
+    if (!mounted || !identical(_host, host)) return;
+    if (_deviceRevoked.value) connection = WhaleStatusConnection.revoked;
+    if (connection == WhaleStatusConnection.revoked) _deviceRevoked.value = true;
+    setState(() {
+      _status = connection == WhaleStatusConnection.revoked ? null : snapshot ?? _status;
+      if (connection == WhaleStatusConnection.revoked || snapshot != null) _activities = activities;
+      if (connection == WhaleStatusConnection.revoked) {
+        _notices = null;
+      } else if (connection == WhaleStatusConnection.reachable && noticeRevision == _noticeRevision) {
+        _notices = notices;
+      }
+      _connection = connection;
+      _statusRefresh = null;
+    });
+    _syncHomeLive();
+  }
+
+  void _onDeviceRevoked(CompanionHost host) {
+    if (!mounted || !identical(_host, host) || _deviceRevoked.value) return;
+    _deviceRevoked.value = true;
+    setState(() {
+      _connection = WhaleStatusConnection.revoked;
+      _status = null;
+      _activities = null;
+      _notices = null;
+    });
+    _syncHomeLive();
+  }
+
+  Future<void> _openInbox(CompanionHost host) async {
+    if (_inboxOpen || _deviceRevoked.value) return;
+    _inboxOpen = true;
+    try {
+      await Navigator.of(context).push<void>(
+        MaterialPageRoute(
+          builder: (_) => WhaleInboxPage(
+            host: host,
+            revoked: _deviceRevoked,
+            onRevoked: () => _onDeviceRevoked(host),
+            onSummary: (summary) {
+              if (!mounted || !identical(_host, host) || _deviceRevoked.value) return;
+              setState(() {
+                _noticeRevision++;
+                _notices = summary;
+              });
+            },
+            onOpen: (inboxContext, item) async {
+              if (!mounted || !identical(_host, host) || _deviceRevoked.value) return;
+              switch (item.kind) {
+                case WhaleNoticeKind.chatReply:
+                  Navigator.of(inboxContext).pop();
+                  _openTab(_chatTab);
+                case WhaleNoticeKind.feedPost || WhaleNoticeKind.feedReply:
+                  final name = _status?.name ?? context.l10n.whaleTitle;
+                  await Navigator.of(
+                    inboxContext,
+                  ).push<void>(MaterialPageRoute(builder: (_) => _feedThread(host, name, item.postId!, item.replyId)));
+                case WhaleNoticeKind.songReady || WhaleNoticeKind.songFailed:
+                  await _openSongs(host);
+                case WhaleNoticeKind.campCompleted || WhaleNoticeKind.campReturned:
+                  await _openCamp(host);
+              }
+            },
+          ),
+        ),
+      );
+    } finally {
+      _inboxOpen = false;
+    }
+  }
+
+  WhaleFeedAudio _feedAudio(CompanionHost host) =>
+      WhaleFeedAudio(player: _player, revoked: _deviceRevoked, onRevoked: () => _onDeviceRevoked(host));
+
+  WhaleFeedThread _feedThread(CompanionHost host, String name, String postId, String? replyId) =>
+      WhaleFeedThread(host, name, postId, replyId: replyId, audio: _feedAudio(host));
+
+  Future<void> _openSongs(CompanionHost host) async {
+    if (_songsOpen) return;
+    _songsOpen = true;
+    try {
+      await Navigator.of(context).push<void>(
+        MaterialPageRoute(
+          builder: (_) => WhaleSongsPage(
+            host: host,
+            player: _player,
+            revoked: _deviceRevoked,
+            onRevoked: () => _onDeviceRevoked(host),
+            singingConversation: _status?.singingConversation,
+          ),
+        ),
+      );
+    } finally {
+      _songsOpen = false;
+    }
+  }
+
+  Future<void> _openBilibili(CompanionHost host) async {
+    final capability = _status?.bilibiliConversation;
+    if (_bilibiliOpen || capability == null || _deviceRevoked.value || _connection != WhaleStatusConnection.reachable) {
+      return;
+    }
+    _bilibiliOpen = true;
+    final topic = host.forBilibiliConversation(capability);
+    try {
+      await Navigator.of(context).push<void>(
+        MaterialPageRoute(
+          builder: (context) {
+            final l = context.l10n;
+            return Scaffold(
+              appBar: AppBar(title: Text(l.whaleBilibiliConversation)),
+              body: ValueListenableBuilder<bool>(
+                valueListenable: _deviceRevoked,
+                builder: (_, revoked, _) => revoked
+                    ? Center(child: Text(l.whaleRevoked))
+                    : Column(
+                        crossAxisAlignment: CrossAxisAlignment.stretch,
+                        children: [
+                          Padding(
+                            padding: const EdgeInsets.fromLTRB(16, 8, 16, 0),
+                            child: Text(l.whaleBilibiliConversationHelp),
+                          ),
+                          Expanded(
+                            child: WhaleChat(
+                              topic,
+                              active: true,
+                              player: _player,
+                              onRevoked: () => _onDeviceRevoked(host),
+                            ),
+                          ),
+                        ],
+                      ),
+              ),
+            );
+          },
+        ),
+      );
+    } finally {
+      topic.close();
+      _bilibiliOpen = false;
+    }
+    if (mounted && identical(_host, host) && !_deviceRevoked.value) await _refreshStatus();
+  }
+
+  Future<void> _openCamp(CompanionHost host) async {
+    if (_campOpen || _deviceRevoked.value) return;
+    _campOpen = true;
+    try {
+      await Navigator.of(context).push<void>(
+        MaterialPageRoute(
+          builder: (_) => WhaleCampPage(host: host, revoked: _deviceRevoked, onRevoked: () => _onDeviceRevoked(host)),
+        ),
+      );
+    } finally {
+      _campOpen = false;
+    }
+    // An in-flight read may predate a pause made in the station.
+    await _statusRefresh;
+    if (mounted && identical(_host, host) && !_deviceRevoked.value) await _refreshStatus();
+  }
+
+  Future<void> _openAvatar(CompanionHost host) async {
+    if (_avatarOpen ||
+        _deviceRevoked.value ||
+        _connection != WhaleStatusConnection.reachable ||
+        _status?.avatarViewerAvailable != true) {
+      return;
+    }
+    _avatarOpen = true;
+    try {
+      await Navigator.of(context).push<void>(
+        MaterialPageRoute(
+          builder: (_) =>
+              WhaleAvatarViewerPage(host: host, revoked: _deviceRevoked, onRevoked: () => _onDeviceRevoked(host)),
+        ),
+      );
+    } finally {
+      _avatarOpen = false;
+    }
+  }
+
+  Future<void> _forget() async {
+    final l = context.l10n;
+    final confirmed = await showDialog<bool>(
+      context: context,
+      builder: (context) => AlertDialog(
+        title: Text(l.whaleForget),
+        content: Text(l.whaleForgetHint),
+        actions: [
+          TextButton(onPressed: () => Navigator.pop(context), child: Text(l.whaleCancel)),
+          FilledButton(onPressed: () => Navigator.pop(context, true), child: Text(l.whaleForget)),
+        ],
+      ),
+    );
+    if (confirmed != true || !mounted) return;
+    try {
+      await CompanionHost.forget();
+      if (!mounted) return;
+      final host = _host;
+      _statusTimer?.cancel();
+      _deviceRevoked.value = false;
+      setState(() {
+        _host = null;
+        _status = null;
+        _activities = null;
+        _notices = null;
+        _statusRefresh = null;
+        _connection = WhaleStatusConnection.reachable;
+        _error = null;
+      });
+      _syncHomeLive();
+      host?.close();
+    } catch (_) {
+      if (mounted) ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(l.whalePairFailed)));
+    }
+  }
+
+  @override
+  void dispose() {
+    WidgetsBinding.instance.removeObserver(this);
+    _statusTimer?.cancel();
+    _homeLive.dispose();
+    _host?.close();
+    _deviceRevoked.dispose();
+    _player.dispose();
+    _link.dispose();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final l = context.l10n;
+    final host = _host;
+    final name = _status?.name ?? l.whaleTitle;
+    return Scaffold(
+      appBar: AppBar(
+        title: host == null
+            ? Text(name)
+            : Column(
+                crossAxisAlignment: CrossAxisAlignment.start,
+                children: [
+                  Text(name, maxLines: 1, overflow: TextOverflow.ellipsis),
+                  Text(
+                    whaleStatusLabel(l, _status, _connection),
+                    maxLines: 1,
+                    overflow: TextOverflow.ellipsis,
+                    style: Theme.of(context).textTheme.labelMedium,
+                  ),
+                ],
+              ),
+        actions: [
+          if (_notices case final summary? when host != null)
+            IconButton(
+              onPressed: () => unawaited(_openInbox(host)),
+              tooltip: summary.unread == 0 ? l.whaleInbox : l.whaleInboxBadge(summary.unread),
+              icon: Badge.count(
+                count: summary.unread,
+                isLabelVisible: summary.unread > 0,
+                child: const Icon(Icons.notifications_none),
+              ),
+            ),
+          if (host != null) IconButton(onPressed: _forget, tooltip: l.whaleForget, icon: const Icon(Icons.link_off)),
+        ],
+      ),
+      body: host == null
+          ? SafeArea(
+              child: Center(
+                child: ConstrainedBox(
+                  constraints: const BoxConstraints(maxWidth: 460),
+                  child: ListView(
+                    shrinkWrap: true,
+                    padding: const EdgeInsets.all(24),
+                    children: [
+                      Center(child: ClipOval(child: Image.asset('assets/whale_app/icon.png', width: 80, height: 80))),
+                      const SizedBox(height: 18),
+                      Text(
+                        l.whalePairHint,
+                        style: Theme.of(context).textTheme.titleMedium,
+                        textAlign: TextAlign.center,
+                      ),
+                      const SizedBox(height: 14),
+                      TextField(
+                        controller: _link,
+                        minLines: 2,
+                        maxLines: 4,
+                        enabled: !_busy,
+                        autocorrect: false,
+                        enableSuggestions: false,
+                        keyboardType: TextInputType.url,
+                        decoration: InputDecoration(labelText: l.whalePairLink, hintText: 'companion://pair?p=…'),
+                      ),
+                      const SizedBox(height: 14),
+                      if (_error != null)
+                        Padding(
+                          padding: const EdgeInsets.only(bottom: 12),
+                          child: Text(
+                            _error is HostError && (_error as HostError).status == 401
+                                ? l.whalePairExpired
+                                : l.whalePairFailed,
+                            style: TextStyle(color: Theme.of(context).colorScheme.error),
+                          ),
+                        ),
+                      FilledButton.icon(
+                        onPressed: _busy ? null : _pair,
+                        icon: _busy
+                            ? const SizedBox.square(dimension: 18, child: CircularProgressIndicator(strokeWidth: 2))
+                            : const Icon(Icons.link),
+                        label: Text(l.whalePair),
+                      ),
+                      TextButton(
+                        onPressed: () => showLicensePage(context: context, applicationName: l.whaleTitle),
+                        child: Text(l.whaleLicenses),
+                      ),
+                    ],
+                  ),
+                ),
+              ),
+            )
+          : SafeArea(
+              bottom: false,
+              child: IndexedStack(
+                index: _tab,
+                children: [
+                  WhaleChat(
+                    host,
+                    active: _tab == _chatTab,
+                    player: _player,
+                    onRevoked: () => _onDeviceRevoked(host),
+                    key: ObjectKey(host),
+                  ),
+                  WhaleFeed(host, name, active: _tab == _feedTab, audio: _feedAudio(host), key: ObjectKey(host)),
+                  WhaleStatusPage(
+                    snapshot: _status,
+                    connection: _connection,
+                    refreshing: _statusRefresh != null,
+                    onRefresh: _refreshStatus,
+                    voiceTiming: host.lastVoicePlaybackTiming,
+                    voiceReplyTiming: host.lastVoiceReplyTiming,
+                    voiceTranscriptionMs: host.lastVoiceTranscriptionMs,
+                    onOpenSongs: () => unawaited(_openSongs(host)),
+                    onOpenAvatar: () => unawaited(_openAvatar(host)),
+                  ),
+                  WhaleActivityPage(
+                    items: _activities,
+                    syncedAt: _status?.syncedAt,
+                    connection: _connection,
+                    refreshing: _statusRefresh != null,
+                    onRefresh: _refreshStatus,
+                    onOpenThread: (threadId, replyId) =>
+                        Navigator.of(context)
+                            .push<void>(MaterialPageRoute(builder: (_) => _feedThread(host, name, threadId, replyId))),
+                  ),
+                  WhaleHomePage(
+                    snapshot: _status,
+                    connection: _connection,
+                    refreshing: _statusRefresh != null,
+                    onRefresh: _refreshStatus,
+                    live: _homeLive,
+                    onOpenChat: () => _openTab(_chatTab),
+                    onOpenBilibili: () => unawaited(_openBilibili(host)),
+                    onOpenActivity: () => _openTab(_activityTab),
+                    onOpenSongs: () => unawaited(_openSongs(host)),
+                    onOpenAvatar: () => unawaited(_openAvatar(host)),
+                    onOpenFeed: () => _openTab(_feedTab),
+                    onOpenCamp: () => unawaited(_openCamp(host)),
+                  ),
+                ],
+              ),
+            ),
+      bottomNavigationBar: host == null
+          ? null
+          : NavigationBar(
+              selectedIndex: _tab,
+              onDestinationSelected: _openTab,
+              destinations: [
+                NavigationDestination(icon: const Icon(Icons.chat_bubble_outline), label: l.whaleChat),
+                NavigationDestination(icon: const Icon(Icons.view_stream_outlined), label: l.whaleFeed),
+                NavigationDestination(icon: const Icon(Icons.monitor_heart_outlined), label: l.whaleStatusTab),
+                NavigationDestination(icon: const Icon(Icons.history_outlined), label: l.whaleActivityTab),
+                NavigationDestination(icon: const Icon(Icons.home_outlined), label: l.whaleHomeTab),
+              ],
+            ),
+    );
+  }
+}
