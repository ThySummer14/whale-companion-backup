+  static WhaleCommunitySnapshot? fromState(Object? value) {
+    if (value is! Map || value['version'] != 1 || !value.containsKey('activeSite')) return null;
+    final active = _sites[value['activeSite']];
+    if (value['activeSite'] != null && active == null) return null;
+    final entries = value['recentCamp'];
+    if (entries is! List) return null;
+    final receipts = <WhaleCampReceipt>[];
+    for (final row in entries.whereType<Map>()) {
+      final kind = _events[row['kind']];
+      final at = _homeInstant(row['at']);
+      if (kind == null || at == null) continue;
+      final survey = kind == WhaleCampEvent.survey ? _survey(row) : null;
+      if (kind == WhaleCampEvent.survey && survey == null) continue;
+      receipts.add((kind: kind, at: at, survey: survey));
+      if (receipts.length == 4) break;
+    }
+    return WhaleCommunitySnapshot._(
+      active,
+      List.unmodifiable(receipts),
+      WhaleCampProject.fromJson(value['campProject']),
+    );
+  }
+
+  static WhaleCampSurvey? _survey(Map row) {
+    final outcome = _outcomes[row['outcome']];
+    final route = row['route'];
+    if (outcome == null || route is! Map) return null;
+    switch (route['kind']) {
+      case 'straight':
+        final direction = _directions[route['direction']];
+        final steps = route['steps'];
+        if (direction == null || steps is! int || steps < 4 || steps > 7) return null;
+        return (outcome: outcome, route: WhaleStraightRoute(direction, steps));
+      case 'trail':
+        final trail = route['trail'];
+        final checkpoints = route['checkpoints'];
+        if (trail is! String ||
+            !_trails.contains(trail) ||
+            checkpoints is! int ||
+            checkpoints < 0 ||
+            (outcome == WhaleSurveyOutcome.completed ? checkpoints != 2 : checkpoints > 1)) {
+          return null;
+        }
+        final legs = trail.split('-');
+        return (outcome: outcome, route: WhaleTrailRoute(_directions[legs[0]]!, _directions[legs[1]]!, checkpoints));
+      default:
+        return null;
+    }
+  }
+}
