+    if (socket != null) unawaited(socket.close().then<void>((_) {}, onError: (Object _) {}));
+  }
+
+  void _event(Json event) {
+    final type = event['type'];
+    final payload = event['payload'] as Json;
+    final cursor = int.tryParse(event['cursor'] as String? ?? '');
+    if (cursor != null && type != 'stream.ready' && cursor > _cursor) _cursor = cursor;
+    if (type == 'stream.replay.complete') {
+      setState(() {
+        _online = true;
+        _error = null;
+      });
+      unawaited(_load(reconnect: true));
+      unawaited(_checkAttachments());
+      if (widget.active && _foreground) unawaited(_dictation.refreshAccess());
+      return;
+    }
+    if (event['contextId'] != widget.host.chatContextId || !_online) return;
+    if (type == 'voice.reply.ready') {
+      final session = event['sessionId'];
+      final user = payload['userMessageId'];
+      final assistant = payload['assistantMessageId'];
+      if (event.containsKey('cursor') &&
+          event['cursor'] == null &&
+          session is String &&
+          session.isNotEmpty &&
+          user is String &&
+          user.isNotEmpty &&
+          assistant is String &&
+          assistant.isNotEmpty) {
+        _playVoiceReply(_voiceReply.receive(sessionId: session, userMessageId: user, assistantMessageId: assistant));
+      }
+    } else if (type == 'message.delta') {
+      final phase = payload['phase'];
+      final attempt = '${payload['attemptId']}:${payload['revision']}';
+      if (phase == 'start' || (phase == 'chunk' && attempt != _attempt)) {
+        _resetStream();
+        _attempt = attempt;
+        setState(() => _waiting = true);
+      }
+      if (phase != 'chunk' || attempt != _attempt) return;
+      final index = payload['index'] as int? ?? -1;
+      if (index <= _index) return;
+      _index = index;
+      _buffer += payload['text'] as String? ?? '';
+      _paint ??= Timer(const Duration(milliseconds: 32), () {
+        _paint = null;
+        if (mounted) setState(() => _stream = _buffer);
+      });
+    } else if (type == 'message.completed') {
+      final id = payload['messageId'];
+      final text = payload['text'];
+      setState(() {
+        _resetStream();
+        if (id is String && text is String && !_messages.any((m) => m['id'] == id)) {
+          _messages.add({'id': id, 'text': text, 'role': 'assistant'});
+        }
+      });
+      unawaited(_load());
+    } else if (type == 'message.failed' ||
+        type == 'activity' && ['turn.completed', 'turn.aborted', 'turn.interrupted'].contains(payload['kind'])) {
+      if (type == 'message.failed' || payload['kind'] != 'turn.completed') {
+        _endConversation();
+        _discardVoiceReply();
+      }
+      setState(() {
+        _resetStream();
+        _waiting = false;
+        if (type == 'message.failed') _error = const HostError(0, 'turn-failed');
+      });
+      _queueConversationMic();
+      unawaited(_load());
+    }
+  }
+
+  void _resetStream() {
+    _paint?.cancel();
+    _paint = null;
+    _attempt = null;
+    _index = -1;
+    _buffer = '';
+    _stream = '';
+  }
+
+  Future<void> _load({bool reconnect = false, bool recoveredReceipt = false}) async {
+    final request = ++_historyRequest;
+    try {
+      final host = widget.host;
+      final history = await host.history();
+      final state = reconnect || recoveredReceipt ? await host.state() : null;
+      if (!mounted || request != _historyRequest) return;
+      setState(() {
+        _messages = (history['messages'] as List).cast<Json>().toList();
+        final sessionId = history['sessionId'];
+        _sessionId = sessionId is String && sessionId.isNotEmpty ? sessionId : null;
+        if (_acceptedMessage case final pending?) {
+          if (history['sessionId'] != pending.session || _messages.any((item) => item['id'] == pending.message['id'])) {
+            _acceptedMessage = null;
+          } else {
+            _messages.add(pending.message);
+          }
+        }
+        if (state != null && _attempt == null && !_submitting) {
+          final sessions = state['sessions'] as List;
+          _resetStream();
+          _waiting = sessions.any((s) => s['id'] == history['sessionId'] && s['status'] == 'running');
+        }
+      });
+      if (recoveredReceipt && !_waiting && _voiceReply.pending) _discardVoiceReply(stopPlayback: false);
+      _queueConversationMic();
+    } catch (error) {
+      if (!mounted || request != _historyRequest) return;
+      if (error is HostError && error.status == 401) {
+        _revokeDevice(error);
+      } else {
+        setState(() => _error = error);
+      }
+    }
+  }
+
+  Future<void> _checkAttachments() async {
+    final socket = _socket;
+    try {
+      final limits = await widget.host.chatAttachmentLimits();
+      if (mounted && _online && !_revoked && identical(socket, _socket)) {
+        setState(() => _attachmentLimits = limits);
+      }
+    } on HostError catch (error) {
+      if (error.status == 401 && identical(socket, _socket)) _revokeDevice(error);
+    } catch (_) {
+      // A host without a compatible response still supports ordinary chat.
+    }
+  }
+
+  ({String id, String? session}) _requestIdentity(String text, List<DraftAttachment> drafts, bool voiceReply) {
+    final previous = _submission;
+    if (previous != null &&
+        previous.text == text &&
+        identical(previous.drafts, drafts) &&
+        previous.voiceReply == voiceReply &&
+        (previous.session != null || drafts.isNotEmpty)) {
+      return (id: previous.id, session: previous.session);
+    }
+    final id = newWhaleRequestId();
+    final session = _chatSendV1 ? _sessionId : null;
+    _submission = (text: text, drafts: drafts, voiceReply: voiceReply, id: id, session: session);
+    return (id: id, session: session);
+  }
+
+  Future<void> _pickAttachments(AttachSource source, {SingingSource? singingSource}) async {
+    final limits = _attachmentLimits;
+    if (limits == null ||
+        !_voiceForeground ||
+        _conversation != null ||
+        _dictation.active ||
+        _submitting ||
+        _pickingAttachments) {
+      return;
+    }
+    final room = limits.maxItems - _drafts.length;
+    final l = context.l10n;
+    if (room <= 0) {
+      _attachmentNotice(l.chatAttachmentLimit(limits.maxItems));
+      return;
+    }
+    final singing = widget.host.singingConversation;
+    final sourceLimit = singing?.byteLimitFor(singingSource);
+    if (singing != null && sourceLimit == null) return;
+    final byteLimit = min(limits.maxTotalBytes, sourceLimit ?? limits.maxTotalBytes);
+    final picker =
+        widget.attachmentPicker ??
+        DeviceAttachmentPicker(messageByteLimit: byteLimit, messageItemLimit: limits.maxItems);
+    setState(() => _pickingAttachments = true);
+    try {
+      var used = totalAttachmentBytes(_drafts);
+      final picks = switch (source) {
+        AttachSource.gallery => PickedAttachments(await picker.pickImages(limit: room)),
+        AttachSource.camera => PickedAttachments([?await picker.takePhoto()]),
+        AttachSource.files => await picker.pickFiles(limit: room, heldBytes: used),
+      };
+      if (!mounted || !widget.active || _revoked) return;
+      String? problem = picks.problem;
+      final added = <DraftAttachment>[];
+      for (final file in picks.attachments) {
+        if (added.length == room) {
+          problem ??= l.chatAttachmentLimit(limits.maxItems);
+          break;
+        }
+        final name = file.name.trim();
+        final invalidSource =
+            singing != null &&
+            (SingingSource.fromFilename(name) != singingSource || singing.attachmentError(name, file.bytes) != null);
+        final issue = !validChatAttachmentName(name)
+            ? l.whaleChatAttachmentBadName
+            : used + file.size > byteLimit
+            ? l.whaleChatAttachmentBudget
+            : invalidSource
+            ? (singingSource == SingingSource.midi ? l.whaleSingingMidiRequired : l.whaleSingingWavRequired)
+            : attachmentProblem(file);
+        if (issue != null) {
+          problem ??= issue;
+        } else {
+          added.add(file);
+          used += file.size;
+        }
+      }
+      if (added.isNotEmpty) {
+        setState(() {
+          _drafts = [..._drafts, ...added];
+          _midiRequestMissing = false;
+          _submission = null;
+        });
+      }
+      if (problem != null) _attachmentNotice(problem);
+    } on PlatformException catch (error) {
+      if (mounted && widget.active) {
+        _attachmentNotice(
+          error.code.contains('denied') || error.code.contains('permission')
+              ? l.chatAttachmentPermission
+              : l.chatOpenAttachmentFailed,
+        );
+      }
+    } catch (_) {
+      if (mounted && widget.active) _attachmentNotice(l.chatReadFailed);
+    } finally {
+      if (mounted) setState(() => _pickingAttachments = false);
+    }
+  }
+
+  void _attachmentNotice(String text) {
+    ScaffoldMessenger.maybeOf(context)?.showSnackBar(SnackBar(content: Text(text)));
+  }
+
+  bool get _hasMidiDraft =>
+      widget.host.singingConversation != null &&
+      _drafts.length == 1 &&
+      SingingSource.fromFilename(_drafts.single.name.trim()) == SingingSource.midi;
+
+  void _insertMidiRequest() {
+    const prefix = '$singingMidiRequestHeader\n曲名：';
+    _input.value = TextEditingValue(
+      text: '$prefix\n轨道：1\n通道：1\n起始：1\n音符数：8',
+      selection: TextSelection.collapsed(offset: prefix.length),
+    );
+  }
+
+  void _cancelAttachmentDownload({bool rebuild = true}) {
+    final download = _attachmentDownload;
+    if (download == null) return;
+    _attachmentDownload = null;
+    _openingAttachment = null;
+    download.complete();
+    if (rebuild && mounted) setState(() {});
+  }
+
+  Future<void> _openAttachment(String messageId, ChatAttachment attachment) async {
+    if (!_voiceForeground || _attachmentDownload != null || _pickingAttachments || _conversation != null) return;
+    final abort = Completer<void>();
+    setState(() {
+      _attachmentDownload = abort;
+      _openingAttachment = (messageId, attachment.id);
+    });
+    try {
+      final bytes = await widget.host.chatAttachment(messageId, attachment, abort.future);
+      if (!mounted || !identical(abort, _attachmentDownload) || !_voiceForeground) return;
+      if (attachment.isImage) {
+        if (inlineImageType(bytes) != attachment.mimeType) throw const HostError(0, 'invalid-chat-attachment');
+        await openImageViewer(context, MemoryImage(bytes), heroTag: (messageId, attachment.id), name: attachment.name);
+      } else {
+        final result = await FilePicker.saveFile(fileName: attachment.name, bytes: bytes);
+        if (mounted && result != null) _attachmentNotice(context.l10n.commonSaved);
+      }
+    } catch (error) {
+      if (!mounted || !identical(abort, _attachmentDownload)) return;
+      if (error is HostError && error.status == 401) {
+        _revokeDevice(error);
+      } else if (widget.active) {
+        _attachmentNotice(context.l10n.whaleChatAttachmentOpenFailed);
+      }
+    } finally {
+      if (identical(abort, _attachmentDownload)) _cancelAttachmentDownload();
+    }
+  }
+
+  Future<void> _send({bool fromConversation = false}) async {
+    final text = _input.text.trim();
+    final drafts = _drafts;
+    if ((text.isEmpty && drafts.isEmpty) ||
+        !_online ||
+        _waiting ||
+        _submitting ||
+        _dictation.active ||
+        _revoked ||
+        _chatSendV1 && _sessionId == null ||
+        _pickingAttachments ||
+        drafts.isNotEmpty && (_attachmentLimits == null || fromConversation)) {
+      if (fromConversation) _endConversation();
+      return;
+    }
+    if (_attachmentLimits case final limits? when drafts.isNotEmpty) {
+      if (drafts.length > limits.maxItems || totalAttachmentBytes(drafts) > limits.maxTotalBytes) {
+        _attachmentNotice(context.l10n.whaleChatAttachmentBudget);
+        return;
+      }
+    }
+    if (_hasMidiDraft && !isSingingMidiRequest(text)) {
+      setState(() => _midiRequestMissing = true);
+      return;
+    }
+    if (widget.host.singingConversation != null && drafts.isNotEmpty && text.isEmpty) {
+      _attachmentNotice(context.l10n.whaleSingingRequestRequired);
+      return;
+    }
+    if (fromConversation && (_conversation != _ConversationPhase.listening || !_canReadDraft || !_voiceForeground)) {
+      _endConversation();
+      return;
+    }
+    _discardVoiceReply();
+    final ticket = _canReadDraft && (fromConversation || _readNextReply) && _voiceForeground
+        ? _voiceReply.begin()
+        : null;
+    if (ticket != null) {
+      _replyTimeout = Timer(VoiceReplyTicket.lifetime, () {
+        _endConversation();
+        _discardVoiceReply();
+      });
+    }
+    setState(() {
+      if (fromConversation) _conversation = _ConversationPhase.waiting;
+      _submitting = true;
+      _waiting = true;
+      _error = null;
+    });
+    var recoveredReceipt = false;
+    try {
+      final voiceReply = ticket != null;
+      final files = [for (final file in drafts) (name: file.name.trim(), bytes: file.bytes)];
+      final identity = _requestIdentity(text, drafts, voiceReply);
+      if (identity.session != null && !_chatSendV1) throw const HostError(0, 'chat-retry-unavailable');
+      final host = widget.host;
+      final result = switch (identity.session) {
+        final String session => await host.sendDraft(
+          text,
+          files,
+          requestId: identity.id,
+          expectedSessionId: session,
+          voiceReply: voiceReply,
+        ),
+        null when files.isNotEmpty => await host.sendAttachments(
+          text,
+          files,
+          requestId: identity.id,
+          voiceReply: voiceReply,
+        ),
+        null => await host.send(text, voiceReply: voiceReply),
+      };
+      if (!mounted) return;
+      final id = result['messageId'];
+      final session = result['sessionId'];
+      final accepted =
+          result['accepted'] == true && id is String && id.isNotEmpty && session is String && session.isNotEmpty;
+      if (!accepted) throw const HostError(0, 'chat-invalid-receipt');
+      recoveredReceipt = result['replayed'] == true;
+      if (_input.text.trim() == text) _input.clear();
+      _dictation.clearNotice();
+      final message = <String, dynamic>{
+        'id': id,
+        'role': 'user',
+        'text': text,
+        if (result['attachments'] is List) 'attachments': result['attachments'],
+      };
+      if (ticket != null) {
+        _playVoiceReply(_voiceReply.confirm(ticket, sessionId: session, userMessageId: id));
+      }
+      setState(() {
+        _submission = null;
+        _acceptedMessage = (session: session, message: message);
+        if (drafts.isNotEmpty) {
+          _drafts = const [];
+          _midiRequestMissing = false;
+        }
+        if (!_messages.any((message) => message['id'] == id)) _messages.add(message);
+      });
+      if (_scroll.hasClients) _scroll.animateTo(0, duration: const Duration(milliseconds: 180), curve: Curves.easeOut);
+      if (!recoveredReceipt) unawaited(_load());
+    } catch (error) {
+      if (mounted) {
+        if (error is HostError && error.status == 401) _revokeDevice(error);
+        final code = error is HostError ? error.code : null;
+        final preservesDetail =
+            code == 'chat-session-changed' || code == 'chat-request-conflict' || code == 'chat-retry-unavailable';
+        if (fromConversation) _endConversation();
+        _discardVoiceReply();
+        setState(() {
+          _waiting = false;
+          _error = _revoked || preservesDetail
+              ? error
+              : HostError(0, drafts.isNotEmpty ? 'chat-attachment-send-failed' : 'chat-send-failed');
+        });
+        if (code == 'chat-session-changed') unawaited(_load());
+      }
+    } finally {
+      if (mounted) {
+        setState(() => _submitting = false);
+        if (recoveredReceipt) unawaited(_load(recoveredReceipt: true));
+        _queueConversationMic();
+      }
+    }
+  }
+
+  bool get _canReadDraft => _dictation.voiceReplyReady && _dictatedText != null;
+  bool get _voiceForeground => widget.active && _foreground && _online && !_revoked;
+
+  bool get _canBeginConversation =>
+      _voiceForeground &&
+      _dictation.voiceReplyReady &&
+      !_dictation.active &&
+      !_waiting &&
+      !_submitting &&
+      (!_chatSendV1 || _sessionId != null) &&
+      !_stopping &&
+      !_pickingAttachments &&
+      _drafts.isEmpty &&
+      _input.text.trim().isEmpty;
+
+  Future<void> _beginConversation() async {
+    if (!_canBeginConversation || _conversation != null) return;
+    final approved = await showDialog<bool>(
+      context: context,
+      builder: (context) => AlertDialog(
+        title: Text(context.l10n.whaleConversationStart),
+        content: Text(context.l10n.whaleConversationConsent),
+        actions: [
+          TextButton(onPressed: () => Navigator.pop(context), child: Text(context.l10n.whaleCancel)),
+          FilledButton(onPressed: () => Navigator.pop(context, true), child: Text(context.l10n.whaleConversationStart)),
+        ],
+      ),
+    );
+    if (!mounted || approved != true || !_canBeginConversation || _conversation != null) return;
+    FocusScope.of(context).unfocus();
+    _conversationLimit = Timer(const Duration(minutes: 5), _endConversation);
+    await _prepareConversationMic();
+  }
+
+  Future<void> _prepareConversationMic() async {
+    final run = _conversationLimit;
+    setState(() => _conversation = _ConversationPhase.preparing);
+    _discardVoiceReply(stopPlayback: false);
+    await _voice.stop();
+    if (!mounted || run == null || !identical(run, _conversationLimit)) return;
+    setState(() => _conversation = _ConversationPhase.resuming);
+    _queueConversationMic();
+  }
+
+  void _queueConversationMic() {
+    if (_conversation != _ConversationPhase.resuming || _reopenMic != null || _waiting || _submitting) return;
+    _reopenMic = Timer(const Duration(milliseconds: 180), () {
+      _reopenMic = null;
+      if (_conversation != _ConversationPhase.resuming) return;
+      if (_waiting || _submitting) return;
+      if (!_canBeginConversation) {
+        _endConversation();
+        return;
+      }
+      setState(() => _conversation = _ConversationPhase.listening);
+      unawaited(_dictation.start());
+    });
+  }
+
+  void _endConversation({bool stopPlayback = true}) {
+    if (_conversation == null) return;
+    _conversationLimit?.cancel();
+    _conversationLimit = null;
+    _reopenMic?.cancel();
+    _reopenMic = null;
+    setState(() => _conversation = null);
+    _discardVoiceReply(stopPlayback: stopPlayback);
+    unawaited(_dictation.cancel());
+  }
+
+  void _leaveVoice() {
+    if (_conversation != null) {
+      _endConversation(stopPlayback: false);
+    } else {
+      _discardVoiceReply(stopPlayback: false);
+      unawaited(_dictation.cancel());
+    }
+    unawaited(_voice.stop());
+  }
+
+  void _observeConversationDictation() {
+    if (_conversation == _ConversationPhase.listening &&
+        !_dictation.active &&
+        _dictation.notice != DictationNotice.ready) {
+      _endConversation();
+    }
+  }
+
+  void _observeConversationPlayback() {
+    if (_conversation != _ConversationPhase.speaking) return;
+    switch (_voice.phase) {
+      case WhaleVoicePhase.playing:
+        _conversationStartedAudio = true;
+      case WhaleVoicePhase.finished when _conversationStartedAudio:
+        setState(() => _conversation = _ConversationPhase.resuming);
+        _queueConversationMic();
+      case WhaleVoicePhase.failed || WhaleVoicePhase.finished:
+        _endConversation();
+      default:
+        break;
+    }
+  }
+
+  void _trackDictatedDraft() {
+    final dictated = _dictatedText;
+    if (dictated == null || _input.text.contains(dictated)) return;
+    setState(() {
+      _dictatedText = null;
+      _readNextReply = true;
+    });
+  }
+
+  void _discardVoiceReply({bool stopPlayback = true}) {
+    final hadPending = _replyTimeout != null;
+    _replyTimeout?.cancel();
+    _replyTimeout = null;
+    _voiceReply.clear();
+    if (stopPlayback) _voice.stopAutomatic();
+    if (hadPending && mounted) setState(() {});
+  }
+
+  void _playVoiceReply(VoiceReplyMatch? reply) {
+    if (reply == null) return;
+    _discardVoiceReply(stopPlayback: false);
+    if (!_voiceForeground || _dictation.active || !_voice.canPlayAutomatically) {
+      _endConversation();
+      return;
+    }
+    if (_conversation == _ConversationPhase.waiting) {
+      _conversationStartedAudio = false;
+      setState(() => _conversation = _ConversationPhase.speaking);
+    }
+    unawaited(_voice.playAutomatically(reply));
+  }
+
+  bool _appendDictation(String text) {
+    final current = _input.text;
+    final joined = current.trim().isEmpty ? text : '$current\n$text';
+    if (joined.length > 16000) return false;
+    _dictatedText = text;
+    _input.value = TextEditingValue(
+      text: joined,
+      selection: TextSelection.collapsed(offset: joined.length),
+    );
+    if (_conversation == _ConversationPhase.listening) {
+      final run = _conversationLimit;
+      scheduleMicrotask(() {
+        if (!mounted || !identical(run, _conversationLimit) || _conversation != _ConversationPhase.listening) return;
+        unawaited(_send(fromConversation: true));
+      });
+    }
+    return true;
+  }
+
+  Future<void> _cancel() async {
+    _endConversation();
+    _discardVoiceReply();
+    setState(() => _stopping = true);
+    try {
+      await widget.host.cancel();
+    } catch (error) {
+      if (mounted) setState(() => _error = error);
+    } finally {
+      if (mounted) setState(() => _stopping = false);
+    }
+  }
+
+  @override
+  void dispose() {
+    WidgetsBinding.instance.removeObserver(this);
+    _cancelAttachmentDownload(rebuild: false);
+    _conversationLimit?.cancel();
+    _reopenMic?.cancel();
+    _dictation.removeListener(_observeConversationDictation);
+    _voice.removeListener(_observeConversationPlayback);
+    _dictation.dispose();
+    _voice.dispose();
+    _replyTimeout?.cancel();
+    _input.removeListener(_trackDictatedDraft);
+    _input.dispose();
+    _scroll.dispose();
+    _paint?.cancel();
+    unawaited(_socket?.close());
+    super.dispose();
+  }
