+import 'host.dart';
+import 'voice.dart';
+
+class WhaleSongTile extends StatelessWidget {
+  const WhaleSongTile({required this.song, required this.voice, this.inFeed = false, super.key});
+
+  final SongArchiveItem song;
+  final WhaleVoice voice;
+  final bool inFeed;
+
+  @override
+  Widget build(BuildContext context) => ListenableBuilder(
+    listenable: voice,
+    builder: (context, _) {
+      final l = context.l10n;
+      final phase = song.id == voice.messageId ? voice.phase : WhaleVoicePhase.idle;
+      final (icon, action) = switch (phase) {
+        WhaleVoicePhase.idle => (Icons.play_arrow, l.whaleSongListen),
+        WhaleVoicePhase.generating || WhaleVoicePhase.loading => (Icons.close, l.whaleVoiceLoading),
+        WhaleVoicePhase.playing => (Icons.pause, l.whaleVoicePause),
+        WhaleVoicePhase.paused => (Icons.play_arrow, l.whaleVoiceResume),
+        WhaleVoicePhase.finished => (Icons.replay, l.whaleVoiceReplay),
+        WhaleVoicePhase.failed => (Icons.refresh, l.whaleVoiceRetry),
+      };
+      final duration = song.durationSeconds?.round();
+      final metadata = [
+        inFeed ? l.whaleFeedSong : MaterialLocalizations.of(context).formatShortDate(song.createdAt.toLocal()),
+        if (duration != null) '${duration ~/ 60}:${(duration % 60).toString().padLeft(2, '0')}',
+        if (!inFeed) '${(song.bytes / (1024 * 1024)).toStringAsFixed(1)} MiB',
+      ];
+      return ListTile(
+        contentPadding: inFeed ? EdgeInsets.zero : null,
+        leading: const Icon(Icons.music_note_outlined),
+        title: Text(song.title, maxLines: 2, overflow: TextOverflow.ellipsis),
+        subtitle: Text(phase == WhaleVoicePhase.failed ? l.whaleSongPlaybackFailed : metadata.join(' · ')),
+        trailing: IconButton(icon: Icon(icon), tooltip: action, onPressed: () => unawaited(voice.toggleSong(song))),
+      );
+    },
+  );
+}
diff --git a/app/lib/whale/songs.dart b/app/lib/whale/songs.dart
new file mode 100644
index 0000000000000000000000000000000000000000..2d03a7817f1d3ee7ffc880dfe632b0c921296c15
--- /dev/null
+++ b/app/lib/whale/songs.dart
@@ -0,0 +1,248 @@
+import 'dart:async';
+
+import 'package:flutter/foundation.dart';
+import 'package:flutter/material.dart';
+
+import '../companion/companion_voice.dart';
+import '../l10n/l10n.dart';
+import '../state/attachments.dart';
+import 'chat.dart';
+import 'host.dart';
+import 'song_tile.dart';
+import 'voice.dart';
+
+class WhaleSongsPage extends StatefulWidget {
+  const WhaleSongsPage({
+    required this.host,
+    required this.player,
+    required this.revoked,
+    required this.onRevoked,
+    this.singingConversation,
+    super.key,
+  });
+
+  final CompanionHost host;
+  final CompanionVoice player;
+  final ValueListenable<bool> revoked;
+  final VoidCallback onRevoked;
+  final SingingConversation? singingConversation;
+
+  @override
+  State<WhaleSongsPage> createState() => _WhaleSongsPageState();
+}
+
+class _WhaleSongsPageState extends State<WhaleSongsPage> with WidgetsBindingObserver {
+  late final WhaleVoice _voice;
+  Completer<void>? _listAbort;
+  List<SongArchiveItem>? _items;
+  bool _foreground = true;
+  bool _revoked = false;
+  bool _unsupported = false;
+  bool _failed = false;
+  bool _songChatOpen = false;
+
+  @override
+  void initState() {
+    super.initState();
+    _voice = WhaleVoice(widget.host, player: widget.player, ownsPlayer: false, onRevoked: (_) => _markRevoked());
+    _revoked = widget.revoked.value;
+    widget.revoked.addListener(_revocationChanged);
+    WidgetsBinding.instance.addObserver(this);
+    if (!_revoked) unawaited(_refresh());
+  }
+
+  void _revocationChanged() {
+    if (widget.revoked.value) _markRevoked();
+  }
+
+  void _markRevoked() {
+    if (!mounted || _revoked) return;
+    _leave();
+    setState(() {
+      _revoked = true;
+      _items = null;
+    });
+    widget.onRevoked();
+  }
+
+  Future<void> _refresh() async {
+    if (_revoked || !_foreground || _listAbort != null) return;
+    final abort = Completer<void>();
+    setState(() {
+      _listAbort = abort;
+      _failed = false;
+    });
+    try {
+      final items = await widget.host.songArchive(abort.future);
+      if (!mounted || !identical(_listAbort, abort)) return;
+      if (!(items?.any((item) => item.id == _voice.messageId) ?? false)) unawaited(_voice.stop());
+      setState(() {
+        _items = items;
+        _unsupported = items == null;
+      });
+    } catch (error) {
+      if (!mounted || !identical(_listAbort, abort)) return;
+      if (error is HostError && error.status == 401) {
+        _markRevoked();
+      } else {
+        setState(() => _failed = true);
+      }
+    } finally {
+      if (!abort.isCompleted) abort.complete();
+      if (mounted && identical(_listAbort, abort)) setState(() => _listAbort = null);
+    }
+  }
+
+  Future<void> _openSingingConversation(SingingConversation capability) async {
+    if (_revoked || _songChatOpen) return;
+    _songChatOpen = true;
+    try {
+      await _voice.stop();
+      if (!mounted || _revoked) return;
+      final host = widget.host.forSingingConversation(capability);
+      try {
+        await Navigator.of(context).push<void>(
+          MaterialPageRoute(
+            builder: (context) {
+              final l = context.l10n;
+              return Scaffold(
+                appBar: AppBar(title: Text(l.whaleSingingConversation)),
+                body: Column(
+                  crossAxisAlignment: CrossAxisAlignment.stretch,
+                  children: [
+                    Padding(
+                      padding: const EdgeInsets.fromLTRB(16, 8, 16, 0),
+                      child: Text(
+                        [
+                          if (capability.canAttach || capability.scoreMaxSeconds != null || !capability.shareAvailable)
+                            switch (capability.midiMaxBytes) {
+                              final midi? when capability.wavAvailable => l.whaleSingingBothHelp(
+                                formatBytes(capability.maxTotalBytes),
+                                formatBytes(midi),
+                              ),
+                              final midi? => l.whaleSingingMidiHelp(formatBytes(midi)),
+                              null when capability.wavAvailable => l.whaleSingingConversationHelp(
+                                formatBytes(capability.maxTotalBytes),
+                              ),
+                              null => l.whaleSingingWrittenScoreHelp,
+                            },
+                          if (capability.scoreMaxSeconds case final seconds?) l.whaleSingingScoreDurationLimit(seconds),
+                          if (capability.shareAvailable) l.whaleSingingShareHelp,
+                        ].join('\n'),
+                      ),
+                    ),
+                    Expanded(
+                      child: WhaleChat(host, active: true, player: widget.player, onRevoked: _markRevoked),
+                    ),
+                  ],
+                ),
+              );
+            },
+          ),
+        );
+      } finally {
+        host.close();
+      }
+      if (mounted) await _refresh();
+    } finally {
+      _songChatOpen = false;
+    }
+  }
+
+  void _cancelList() {
+    _listAbort?.complete();
+    _listAbort = null;
+  }
+
+  void _leave() {
+    _cancelList();
+    unawaited(_voice.stop());
+  }
+
+  @override
+  void didChangeAppLifecycleState(AppLifecycleState state) {
+    switch (state) {
+      case AppLifecycleState.resumed:
+        _foreground = true;
+        unawaited(_refresh());
+      case AppLifecycleState.hidden || AppLifecycleState.paused || AppLifecycleState.detached:
+        _foreground = false;
+        _leave();
+      case AppLifecycleState.inactive:
+        break;
+    }
+  }
+
+  @override
+  void dispose() {
+    widget.revoked.removeListener(_revocationChanged);
+    WidgetsBinding.instance.removeObserver(this);
+    _cancelList();
+    _voice.dispose();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final l = context.l10n;
+    final items = _items;
+    final message = _revoked
+        ? l.whaleRevoked
+        : _failed
+        ? l.whaleSongArchiveFailed
+        : _listAbort != null && items == null
+        ? l.whaleStatusSyncing
+        : _unsupported
+        ? l.whaleSongArchiveUnavailable
+        : items?.isEmpty == true
+        ? l.whaleSongArchiveEmpty
+        : null;
+    return PopScope<void>(
+      onPopInvokedWithResult: (popped, _) {
+        if (popped) _leave();
+      },
+      child: Scaffold(
+        appBar: AppBar(
+          title: Text(l.whaleSongArchive),
+          actions: [
+            IconButton(
+              onPressed: _listAbort != null || _revoked ? null : _refresh,
+              tooltip: l.whaleRefresh,
+              icon: const Icon(Icons.refresh),
+            ),
+          ],
+        ),
+        body: SafeArea(
+          child: RefreshIndicator(
+            onRefresh: _refresh,
+            child: ListView(
+              physics: const AlwaysScrollableScrollPhysics(),
+              padding: const EdgeInsets.fromLTRB(16, 8, 16, 24),
+              children: [
+                if (widget.singingConversation case final capability? when !_revoked)
+                  ListTile(
+                    leading: const Icon(Icons.chat_bubble_outline),
+                    title: Text(l.whaleSingingConversation),
+                    subtitle: capability.scoreMaxSeconds != null
+                        ? Text(l.whaleSingingScoreDurationLimit(capability.scoreMaxSeconds!))
+                        : capability.shareAvailable
+                        ? Text(l.whaleSingingShareSubtitle)
+                        : null,
+                    trailing: const Icon(Icons.chevron_right),
+                    onTap: () => unawaited(_openSingingConversation(capability)),
+                  ),
+                if (message != null)
+                  Padding(
+                    padding: const EdgeInsets.symmetric(vertical: 16),
+                    child: Semantics(liveRegion: true, child: Text(message)),
+                  ),
+                if (items != null)
+                  for (final item in items) WhaleSongTile(song: item, voice: _voice, key: ValueKey(item.id)),
+              ],
+            ),
+          ),
+        ),
+      ),
+    );
+  }
+}
diff --git a/app/lib/whale/status.dart b/app/lib/whale/status.dart
new file mode 100644
index 0000000000000000000000000000000000000000..84d30547de626fc7b1d74ae50e13dabefda8a811
--- /dev/null
+++ b/app/lib/whale/status.dart
@@ -0,0 +1,330 @@
+import 'package:flutter/material.dart';
+
+import '../l10n/l10n.dart';
+import 'bilibili_state.dart';
+import 'camp_state.dart';
+import 'home_state.dart';
+import 'host.dart';
+
+enum WhalePresence { unconfigured, offline, idle, running, unknown }
+
+enum WhaleCapability { ready, planned, unavailable, error, unknown }
+
+enum WhaleStatusConnection { reachable, unreachable, revoked }
+
+enum WhaleWorldHealth { unconfigured, standby, ready, busy, paused, unavailable }
+
+typedef WhaleWorld = ({String id, String label, WhaleWorldHealth status});
+
+class WhaleStatusSnapshot {
+  WhaleStatusSnapshot._(
+    this.syncedAt,
+    this.name,
+    this.tagline,
+    this.presence,
+    this.inputTokens,
+    this.outputTokens,
+    this._capabilities,
+    this.home,
+    this.homeLiveAvailable,
+    this.singingConversation,
+    this.bilibiliConversation,
+    this.community,
+    this.minecraftCampAvailable,
+    this.avatarViewerAvailable,
+    this.worlds,
+  );
+
+  factory WhaleStatusSnapshot.fromState(Json state, DateTime syncedAt) {
+    final persona = state['persona'] is Map ? state['persona'] as Map : const {};
+    final stats = state['stats'] is Map ? state['stats'] as Map : const {};
+    final capabilities = <String, WhaleCapability>{};
+    final entries = state['capabilities'];
+    final avatarViewer = state['avatarViewer'];
+    final homeLive = state['homeLive'];
+    if (entries is List) {
+      for (final entry in entries) {
+        if (entry is Map && entry['id'] is String) {
+          capabilities[entry['id'] as String] =
+              WhaleCapability.values.asNameMap()[entry['status']] ?? WhaleCapability.unknown;
+        }
+      }
+    }
+    return WhaleStatusSnapshot._(
+      syncedAt,
+      _text(persona['name']),
+      _text(persona['tagline']),
+      WhalePresence.values.asNameMap()[state['presence']] ?? WhalePresence.unknown,
+      _counter(stats['inputTokens']),
+      _counter(stats['outputTokens']),
+      capabilities,
+      WhaleHomeSnapshot.fromState(state['home']),
+      homeLive is Map && homeLive['version'] is int && homeLive['version'] == 1,
+      SingingConversation.fromState(state),
+      BilibiliConversation.fromState(state),
+      WhaleCommunitySnapshot.fromState(state['community']),
+      WhaleCampSnapshot.supportedBy(state['minecraftCamp']),
+      avatarViewer is Map && avatarViewer['version'] is int && avatarViewer['version'] == 1,
+      _worlds(state['worlds']),
+    );
+  }
+
+  final DateTime syncedAt;
+  final String? name;
+  final String? tagline;
+  final WhalePresence presence;
+  final int? inputTokens;
+  final int? outputTokens;
+  final Map<String, WhaleCapability> _capabilities;
+  final WhaleHomeSnapshot? home;
+  final bool homeLiveAvailable;
+  final SingingConversation? singingConversation;
+  final BilibiliConversation? bilibiliConversation;
+  final WhaleCommunitySnapshot? community;
+  final bool minecraftCampAvailable;
+  final bool avatarViewerAvailable;
+  final List<WhaleWorld> worlds;
+
+  WhaleCapability capability(String id) => _capabilities[id] ?? WhaleCapability.unknown;
+
+  static int? _counter(Object? value) => value is int && value >= 0 ? value : null;
+  static String? _text(Object? value) => value is String && value.trim().isNotEmpty ? value.trim() : null;
+
+  static List<WhaleWorld> _worlds(Object? value) {
+    if (value is! Map || value['version'] != 1 || value['items'] is! List) return const [];
+    final worlds = <String, WhaleWorld>{};
+    final idPattern = RegExp(r'^[a-z][a-z0-9-]{0,31}$');
+    for (final row in (value['items'] as List).take(16)) {
+      if (row is! Map) continue;
+      final id = row['id'];
+      final label = _text(row['label']);
+      final status = WhaleWorldHealth.values.asNameMap()[row['status']];
+      if (id is! String || !idPattern.hasMatch(id) || label == null || label.length > 80 || status == null) continue;
+      worlds.putIfAbsent(id, () => (id: id, label: label, status: status));
+    }
+    return List.unmodifiable(worlds.values);
+  }
+}
+
+String whaleStatusLabel(L10n l, WhaleStatusSnapshot? snapshot, WhaleStatusConnection connection) {
+  if (connection == WhaleStatusConnection.unreachable) return l.whaleStatusUnreachable;
+  if (connection == WhaleStatusConnection.revoked) return l.whaleRevoked;
+  return switch (snapshot?.presence) {
+    null => l.whaleStatusSyncing,
+    WhalePresence.idle => l.whaleStatusIdle,
+    WhalePresence.running => l.whaleStatusRunning,
+    WhalePresence.offline => l.whaleStatusOffline,
+    WhalePresence.unconfigured => l.whaleStatusUnconfigured,
+    WhalePresence.unknown => l.whaleStatusUnknown,
+  };
+}
+
+class WhaleStatusPage extends StatelessWidget {
+  const WhaleStatusPage({
+    required this.snapshot,
+    required this.connection,
+    required this.refreshing,
+    required this.onRefresh,
+    this.voiceTiming,
+    this.voiceReplyTiming,
+    this.voiceTranscriptionMs,
+    this.onOpenSongs,
+    this.onOpenAvatar,
+    super.key,
+  });
+
+  final WhaleStatusSnapshot? snapshot;
+  final WhaleStatusConnection connection;
+  final bool refreshing;
+  final Future<void> Function() onRefresh;
+  final VoicePlaybackTiming? voiceTiming;
+  final VoiceReplyTiming? voiceReplyTiming;
+  final int? voiceTranscriptionMs;
+  final VoidCallback? onOpenSongs;
+  final VoidCallback? onOpenAvatar;
+
+  @override
+  Widget build(BuildContext context) {
+    final l = context.l10n;
+    final material = MaterialLocalizations.of(context);
+    final theme = Theme.of(context);
+    final colors = theme.colorScheme;
+    final syncedAt = snapshot?.syncedAt.toLocal();
+    final input = snapshot?.inputTokens;
+    final output = snapshot?.outputTokens;
+    final stateColor = connection == WhaleStatusConnection.reachable ? colors.primary : colors.error;
+    final detailStyle = theme.textTheme.bodySmall?.copyWith(color: colors.onSurfaceVariant);
+    final voiceSource = switch (voiceTiming?.source) {
+      VoiceStreamSource.full => l.whaleVoiceSourceFull,
+      VoiceStreamSource.prefetchComplete => l.whaleVoiceSourcePrefetchComplete,
+      VoiceStreamSource.prefetchLive => l.whaleVoiceSourcePrefetchLive,
+      null => null,
+    };
+    return RefreshIndicator(
+      onRefresh: onRefresh,
+      child: ListView(
+        physics: const AlwaysScrollableScrollPhysics(),
+        padding: const EdgeInsets.fromLTRB(16, 16, 16, 24),
+        children: [
+          Row(
+            children: [
+              ClipOval(child: Image.asset('assets/whale_app/icon.png', width: 52, height: 52)),
+              const SizedBox(width: 12),
+              Expanded(
+                child: Column(
+                  crossAxisAlignment: CrossAxisAlignment.start,
+                  children: [
+                    Text(snapshot?.name ?? l.whaleTitle, style: theme.textTheme.titleLarge),
+                    Text(whaleStatusLabel(l, snapshot, connection), style: TextStyle(color: stateColor)),
+                  ],
+                ),
+              ),
+              IconButton(
+                tooltip: l.whaleRefresh,
+                onPressed: refreshing ? null : () async => onRefresh(),
+                icon: refreshing
+                    ? const SizedBox.square(dimension: 18, child: CircularProgressIndicator(strokeWidth: 2))
+                    : const Icon(Icons.refresh),
+              ),
+            ],
+          ),
+          if (snapshot?.tagline case final String tagline) ...[
+            const SizedBox(height: 12),
+            Text(tagline, style: theme.textTheme.bodyMedium),
+          ],
+          if (syncedAt != null) ...[
+            const SizedBox(height: 8),
+            Text(
+              l.whaleStatusLastSync(
+                '${material.formatShortDate(syncedAt)} ${material.formatTimeOfDay(TimeOfDay.fromDateTime(syncedAt))}',
+              ),
+              style: theme.textTheme.bodySmall?.copyWith(color: colors.onSurfaceVariant),
+            ),
+          ],
+          if (onOpenSongs != null) ...[
+            const SizedBox(height: 14),
+            ListTile(
+              contentPadding: EdgeInsets.zero,
+              leading: const Icon(Icons.library_music_outlined),
+              title: Text(l.whaleSongArchive),
+              trailing: const Icon(Icons.chevron_right),
+              onTap: onOpenSongs,
+            ),
+          ],
+          if (connection == WhaleStatusConnection.reachable &&
+              snapshot?.avatarViewerAvailable == true &&
+              onOpenAvatar != null)
+            ListTile(
+              contentPadding: EdgeInsets.zero,
+              leading: const Icon(Icons.face_outlined),
+              title: Text(l.whaleAvatarViewerTitle),
+              trailing: const Icon(Icons.chevron_right),
+              onTap: onOpenAvatar,
+            ),
+          const SizedBox(height: 28),
+          Text(l.whaleStatusTokens, style: theme.textTheme.titleMedium),
+          const SizedBox(height: 8),
+          if (input == null && output == null)
+            Text(l.whaleStatusNoData)
+          else if (input == 0 && output == 0)
+            Text(l.whaleStatusNoUsage)
+          else
+            Row(
+              children: [
+                Expanded(child: _tokenMetric(context, l.whaleStatusInput, input)),
+                const SizedBox(width: 8),
+                Expanded(child: _tokenMetric(context, l.whaleStatusOutput, output)),
+              ],
+            ),
+          const SizedBox(height: 8),
+          Text(l.whaleStatusTokenScope, style: theme.textTheme.bodySmall?.copyWith(color: colors.onSurfaceVariant)),
+          const SizedBox(height: 28),
+          Text(l.whaleStatusCapabilities, style: theme.textTheme.titleMedium),
+          _capability(context, 'media.tts', l.whaleStatusTts, Icons.volume_up_outlined),
+          if (voiceTiming case final timing?)
+            Text(l.whaleStatusVoiceTiming(timing.firstByteMs, timing.nativeStartMs), style: detailStyle),
+          if (voiceSource != null) Text(l.whaleStatusVoiceSource(voiceSource), style: detailStyle),
+          if (voiceTranscriptionMs case final int ms) Text(l.whaleStatusVoiceTranscription(ms), style: detailStyle),
+          if (voiceReplyTiming case final timing?)
+            Text(
+              timing.nativeStartMs == null
+                  ? l.whaleStatusVoiceReplyReady(timing.readyMs)
+                  : l.whaleStatusVoiceReplyTiming(timing.readyMs, timing.nativeStartMs!),
+              style: detailStyle,
+            ),
+          if (!(snapshot?.worlds.any((world) => world.id == 'minecraft') ?? false))
+            _capability(context, 'game.minecraft', 'Minecraft', Icons.sports_esports_outlined),
+          _capability(context, 'media.avatar', l.whaleStatusAvatar, Icons.face_outlined),
+          if (snapshot?.worlds case final worlds? when worlds.isNotEmpty) ...[
+            const SizedBox(height: 22),
+            Text(l.whaleStatusWorlds, style: theme.textTheme.titleMedium),
+            for (final world in worlds) _world(context, world),
+          ],
+        ],
+      ),
+    );
+  }
+
+  Widget _tokenMetric(BuildContext context, String label, int? value) {
+    final theme = Theme.of(context);
+    return Card(
+      margin: EdgeInsets.zero,
+      child: Padding(
+        padding: const EdgeInsets.all(12),
+        child: Column(
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: [
+            Text(label, style: theme.textTheme.bodySmall),
+            Text(
+              value == null ? '—' : MaterialLocalizations.of(context).formatDecimal(value),
+              style: theme.textTheme.titleLarge,
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+
+  Widget _capability(BuildContext context, String id, String label, IconData icon) {
+    final l = context.l10n;
+    final health = snapshot?.capability(id) ?? WhaleCapability.unknown;
+    final detail = switch (health) {
+      WhaleCapability.ready => l.whaleCapabilityReady,
+      WhaleCapability.planned => l.whaleCapabilityPlanned,
+      WhaleCapability.unavailable || WhaleCapability.error => l.whaleCapabilityUnavailable,
+      WhaleCapability.unknown => l.whaleStatusUnknown,
+    };
+    return ListTile(
+      contentPadding: EdgeInsets.zero,
+      dense: true,
+      leading: Icon(icon),
+      title: Text(label),
+      subtitle: Text(detail),
+    );
+  }
+
+  Widget _world(BuildContext context, WhaleWorld world) {
+    final l = context.l10n;
+    final (label, icon) = switch (world.id) {
+      'minecraft' => ('Minecraft', Icons.sports_esports_outlined),
+      'bilibili' => (l.whaleStatusWorldBilibili, Icons.video_library_outlined),
+      'singing' => (l.whaleStatusWorldSinging, Icons.library_music_outlined),
+      _ => (world.label, Icons.public_outlined),
+    };
+    final detail = switch (world.status) {
+      WhaleWorldHealth.unconfigured => l.whaleStatusWorldUnconfigured,
+      WhaleWorldHealth.standby => l.whaleStatusWorldStandby,
+      WhaleWorldHealth.ready => l.whaleCapabilityReady,
+      WhaleWorldHealth.busy => l.whaleStatusWorldBusy,
+      WhaleWorldHealth.paused => l.whaleStatusWorldPaused,
+      WhaleWorldHealth.unavailable => l.whaleCapabilityUnavailable,
+    };
+    return ListTile(
+      contentPadding: EdgeInsets.zero,
+      dense: true,
+      leading: Icon(icon),
+      title: Text(label),
+      subtitle: Text(detail),
+    );
+  }
+}
diff --git a/app/lib/whale/voice.dart b/app/lib/whale/voice.dart
new file mode 100644
index 0000000000000000000000000000000000000000..c5cc92da1a89230ba8d49647e12ef9bfe87f9963
--- /dev/null
+++ b/app/lib/whale/voice.dart
@@ -0,0 +1,429 @@
+import 'dart:async';
+import 'dart:io';
+
+import 'package:flutter/foundation.dart';
+import 'package:path_provider/path_provider.dart';
+
+import '../companion/companion_voice.dart';
+import 'host.dart';
+import 'voice_reply.dart';
+
+enum WhaleVoicePhase { idle, generating, loading, playing, paused, finished, failed }
+
+class WhaleVoice extends ChangeNotifier {
+  WhaleVoice(
+    this._host, {
+    CompanionVoice? player,
+    this.ownsPlayer = true,
+    Future<Directory> Function()? cacheDirectory,
+    this.onRevoked,
+  }) : _player = player ?? CompanionVoice(),
+       _cacheDirectory = cacheDirectory ?? getTemporaryDirectory {
+    _events = _player.events.listen(_onEvent);
+  }
+
+  final CompanionHost _host;
+  final CompanionVoice _player;
+  final bool ownsPlayer;
+  final Future<Directory> Function() _cacheDirectory;
+  final void Function(HostError)? onRevoked;
+  late final StreamSubscription<CompanionVoiceEvent> _events;
+  Completer<void>? _abort;
+  Future<void>? _expressiveDone;
+  File? _clip;
+  String? _playId;
+  String? _playbackId;
+  ({String id, int sequence, Timer timer})? _playbackPulse;
+  ({Stopwatch clock, int firstByteMs, VoiceStreamSource? source})? _pcmTiming;
+  VoiceReplyMatch? _pendingReplyTiming;
+  int _selection = 0;
+  bool _changingPlayback = false;
+  bool _disposed = false;
+  bool _automatic = false;
+  bool _songPlayback = false;
+
+  String? messageId;
+  ExpressiveVoiceStyle? expressiveStyle;
+  String? errorCode;
+  WhaleVoicePhase phase = WhaleVoicePhase.idle;
+
+  bool get _busy => switch (phase) {
+    WhaleVoicePhase.generating || WhaleVoicePhase.loading || WhaleVoicePhase.playing || WhaleVoicePhase.paused => true,
+    _ => false,
+  };
+
+  bool get playingAutomatically => _automatic && _busy;
+  bool get canPlayAutomatically => !_disposed && !_changingPlayback && !_busy;
+
+  Future<void> playAutomatically(VoiceReplyMatch reply) async {
+    if (!canPlayAutomatically) return;
+    await _load(reply.assistantMessageId, reply: reply);
+  }
+
+  void stopAutomatic() {
+    if (playingAutomatically) unawaited(stop());
+  }
+
+  Future<void> toggle(String id) {
+    final style = id == messageId && !_songPlayback ? expressiveStyle : null;
+    return _toggle(id, () => _load(id, style: style), samePlayback: !_songPlayback);
+  }
+
+  Future<void> chooseStyle(String id, ExpressiveVoiceStyle? style) async {
+    if (_disposed || _changingPlayback) return;
+    if (id == messageId && style == expressiveStyle && !_songPlayback && _busy) return;
+    await _load(id, style: style);
+  }
+
+  Future<void> toggleSong(SongArchiveItem song) =>
+      _toggle(song.id, () => _load(song.id, song: song), samePlayback: _songPlayback);
+
+  Future<void> _toggle(String id, Future<void> Function() load, {required bool samePlayback}) async {
+    if (_disposed || _changingPlayback) return;
+    if (id == messageId && samePlayback) {
+      switch (phase) {
+        case WhaleVoicePhase.generating:
+        case WhaleVoicePhase.loading:
+          await stop();
+          return;
+        case WhaleVoicePhase.playing:
+          await _changePlayback(pause: true);
+          return;
+        case WhaleVoicePhase.paused:
+          await _changePlayback(pause: false);
+          return;
+        case WhaleVoicePhase.finished:
+          if (_clip != null) {
+            await _play(_selection);
+          } else {
+            await load();
+          }
+          return;
+        case WhaleVoicePhase.idle:
+        case WhaleVoicePhase.failed:
+          break;
+      }
+    }
+    await load();
+  }
+
+  Future<void> stop() {
+    final stopped = _clear();
+    messageId = null;
+    expressiveStyle = null;
+    _show(WhaleVoicePhase.idle);
+    return stopped;
+  }
+
+  Future<void> _load(String id, {VoiceReplyMatch? reply, SongArchiveItem? song, ExpressiveVoiceStyle? style}) async {
+    unawaited(_clear());
+    _automatic = reply != null;
+    _songPlayback = song != null;
+    if (reply != null) {
+      _pendingReplyTiming = reply;
+      _host.lastVoiceReplyTiming = (readyMs: reply.readyMs, nativeStartMs: null);
+    }
+    final selection = _selection;
+    final abort = _abort = Completer<void>();
+    final timeout = Timer(song == null ? const Duration(minutes: 5) : const Duration(minutes: 1), () {
+      if (!abort.isCompleted) abort.complete();
+      if (selection != _selection) return;
+      _pendingReplyTiming = null;
+      if (_playId != null) {
+        _playId = null;
+        _pcmTiming = null;
+        unawaited(_player.stop());
+      }
+      _show(WhaleVoicePhase.failed, 'voice-timeout');
+    });
+    messageId = id;
+    expressiveStyle = style;
+    _show(song == null ? WhaleVoicePhase.generating : WhaleVoicePhase.loading);
+    Directory? incoming;
+    String? pendingExpressiveTask;
+    final previousExpressive = _expressiveDone;
+    final expressiveDone = style == null ? null : Completer<void>();
+    if (expressiveDone != null) _expressiveDone = expressiveDone.future;
+    try {
+      if (song != null) {
+        incoming = await (await _cacheDirectory()).createTemp('whale-song-');
+        if (selection != _selection || abort.isCompleted) return;
+        final file = File('${incoming.path}/song.wav');
+        final playbackId = await _host.saveSong(song, file, abort.future);
+        if (selection != _selection || abort.isCompleted) return;
+        _playbackId = playbackId;
+        _clip = file;
+        incoming = null;
+        await _play(selection);
+        return;
+      }
+      if (style == null && (await _tryPcm(id, selection, abort) || selection != _selection)) return;
+      if (style != null) {
+        // Release a stopped admission before asking for the same cache key again.
+        await previousExpressive;
+        if (selection != _selection || abort.isCompleted) return;
+      }
+      var task = style == null
+          ? await _host.synthesizeVoice(id, abort.future)
+          : await _host.synthesizeExpressiveVoice(id, style);
+      final taskId = task['id'] as String?;
+      if (taskId == null || !RegExp(r'^[a-fA-F0-9-]{36}$').hasMatch(taskId)) {
+        throw const HostError(0, 'invalid-voice');
+      }
+      while (task['status'] == 'accepted' || task['status'] == 'running') {
+        if (style != null) pendingExpressiveTask = taskId;
+        if (selection != _selection || abort.isCompleted) return;
+        await Future.any([Future<void>.delayed(const Duration(milliseconds: 650)), abort.future]);
+        if (abort.isCompleted) throw const HostError(0, 'voice-timeout');
+        task = await _host.voiceTask(taskId, abort.future);
+      }
+      pendingExpressiveTask = null;
+      if (selection != _selection) return;
+      if (abort.isCompleted) throw const HostError(0, 'voice-timeout');
+      final audio = task['audio'];
+      if (task['status'] != 'succeeded' || audio is! Map || audio['bytes'] is! int) {
+        throw const HostError(0, 'voice-failed');
+      }
+      _show(WhaleVoicePhase.loading);
+      incoming = await (await _cacheDirectory()).createTemp('whale-voice-');
+      final file = File('${incoming.path}/message.wav');
+      final playbackId = await _host.saveVoice(taskId, audio['bytes'] as int, file, abort.future);
+      if (selection != _selection) return;
+      if (abort.isCompleted) throw const HostError(0, 'voice-timeout');
+      _playbackId = playbackId;
+      _clip = file;
+      incoming = null;
+      await _play(selection);
+    } catch (error) {
+      if (selection == _selection) {
+        _pendingReplyTiming = null;
+        _show(WhaleVoicePhase.failed, error is HostError ? error.code : null);
+        if (error is HostError && error.status == 401) onRevoked?.call(error);
+      }
+    } finally {
+      timeout.cancel();
+      if (!abort.isCompleted) abort.complete();
+      if (identical(_abort, abort)) _abort = null;
+      if (expressiveDone != null) {
+        try {
+          if (pendingExpressiveTask != null) await _host.cancelExpressiveVoice(pendingExpressiveTask);
+        } finally {
+          expressiveDone.complete();
+          if (identical(_expressiveDone, expressiveDone.future)) _expressiveDone = null;
+        }
+      }
+      await _remove(incoming);
+    }
+  }
+
+  // Once a block was handed to AudioTrack, a second rendition could repeat audible speech.
+  Future<bool> _tryPcm(String message, int selection, Completer<void> abort) async {
+    final disconnect = Completer<void>();
+    void close() {
+      if (!disconnect.isCompleted) disconnect.complete();
+    }
+
+    unawaited(abort.future.then((_) => close()));
+    String? id;
+    bool isCurrent() => selection == _selection && (id == null || _playId == id);
+    var submitted = false;
+    try {
+      final clock = Stopwatch()..start();
+      int? firstByteMs;
+      final stream = await _host.openVoiceStream(
+        message,
+        disconnect.future,
+        onFirstByte: () {
+          firstByteMs = clock.elapsedMilliseconds;
+        },
+      );
+      if (selection != _selection) return true;
+      await for (final block in stream.chunks) {
+        if (!isCurrent()) return true;
+        if (abort.isCompleted) throw const HostError(0, 'voice-timeout');
+        if (id == null) {
+          id = _playId = 'whale-${DateTime.now().microsecondsSinceEpoch}';
+          _playbackId = stream.playbackId;
+          if (firstByteMs case final int first) {
+            _pcmTiming = (clock: clock, firstByteMs: first, source: stream.source);
+          }
+          _show(WhaleVoicePhase.loading);
+          final ready = await _player.beginPcm(id, stream.sampleRate);
+          if (!isCurrent()) return true;
+          if (!ready) throw const HostError(503, 'voice-stream-unavailable');
+        }
+        submitted = true;
+        if (!await _player.writePcm(id, block)) {
+          if (!isCurrent()) return true;
+          throw const HostError(0, 'voice-failed');
+        }
+      }
+      if (!isCurrent()) return true;
+      if (abort.isCompleted) throw const HostError(0, 'voice-timeout');
+      if (id == null) throw const HostError(0, 'invalid-voice');
+      if (!await _player.endPcm(id) && isCurrent()) {
+        throw const HostError(0, 'voice-failed');
+      }
+      return true;
+    } on HostError catch (error) {
+      if (!isCurrent()) return true;
+      if (id != null) {
+        _endPlayback('stopped');
+        _playbackId = null;
+        _playId = null;
+        _pcmTiming = null;
+        await _player.stop();
+      }
+      if (selection != _selection) return true;
+      if (abort.isCompleted) throw const HostError(0, 'voice-timeout');
+      if (submitted || !const {0, 404, 409, 422, 502, 503}.contains(error.status)) rethrow;
+      if (id != null) _show(WhaleVoicePhase.generating);
+      return false;
+    } finally {
+      close();
+    }
+  }
+
+  Future<void> _play(int selection) async {
+    final file = _clip;
+    if (file == null) return;
+    final id = _playId = 'whale-${DateTime.now().microsecondsSinceEpoch}';
+    _show(WhaleVoicePhase.loading);
+    if (!await _player.play(id, file.path) && selection == _selection && id == _playId) {
+      _pendingReplyTiming = null;
+      if (_songPlayback) {
+        _playId = null;
+        _removeSongClip();
+      }
+      _show(WhaleVoicePhase.failed);
+    }
+  }
+
+  Future<void> _changePlayback({required bool pause}) async {
+    final id = _playId;
+    if (id == null) return;
+    final before = phase;
+    _changingPlayback = true;
+    try {
+      final ok = await (pause ? _player.pause(id) : _player.resume(id));
+      if (id != _playId || phase != before) return;
+      if (ok) {
+        _show(pause ? WhaleVoicePhase.paused : WhaleVoicePhase.playing);
+      } else {
+        unawaited(_clear());
+        _show(WhaleVoicePhase.failed);
+      }
+    } finally {
+      _changingPlayback = false;
+    }
+  }
+
+  void _onEvent(CompanionVoiceEvent event) {
+    if (event.id != _playId) return;
+    switch (event.type) {
+      case CompanionVoiceEventType.start:
+        if (_pcmTiming case final timing?) {
+          timing.clock.stop();
+          _host.lastVoicePlaybackTiming = (
+            firstByteMs: timing.firstByteMs,
+            nativeStartMs: timing.clock.elapsedMilliseconds,
+            source: timing.source,
+          );
+          _pcmTiming = null;
+        }
+        if (_pendingReplyTiming case final reply?) {
+          _host.lastVoiceReplyTiming = (readyMs: reply.readyMs, nativeStartMs: reply.elapsedMs);
+          _pendingReplyTiming = null;
+        }
+        _show(WhaleVoicePhase.playing);
+      case CompanionVoiceEventType.done:
+        _playId = null;
+        _pcmTiming = null;
+        _pendingReplyTiming = null;
+        _removeSongClip();
+        _show(WhaleVoicePhase.finished);
+      case CompanionVoiceEventType.stopped:
+      case CompanionVoiceEventType.error:
+        _playId = null;
+        _pcmTiming = null;
+        _pendingReplyTiming = null;
+        final abort = _abort;
+        if (abort != null && !abort.isCompleted) abort.complete();
+        _removeSongClip();
+        _show(WhaleVoicePhase.failed);
+      default:
+        break;
+    }
+  }
+
+  void _show(WhaleVoicePhase next, [String? error]) {
+    if (_disposed) return;
+    if (next == WhaleVoicePhase.playing) {
+      _beginPlayback();
+    } else {
+      _endPlayback(next == WhaleVoicePhase.paused ? 'paused' : 'stopped');
+    }
+    phase = next;
+    errorCode = error;
+    notifyListeners();
+  }
+
+  void _beginPlayback() {
+    final id = _playbackId;
+    if (id == null || _playbackPulse != null) return;
+    final sequence = CompanionHost.nextPlaybackSequence();
+    void report() => unawaited(_host.reportPlayback(id, sequence, 'playing'));
+    _playbackPulse = (id: id, sequence: sequence, timer: Timer.periodic(const Duration(seconds: 2), (_) => report()));
+    report();
+  }
+
+  void _endPlayback(String state) {
+    final pulse = _playbackPulse;
+    if (pulse == null) return;
+    _playbackPulse = null;
+    pulse.timer.cancel();
+    unawaited(_host.reportPlayback(pulse.id, pulse.sequence, state));
+  }
+
+  void _removeSongClip() {
+    if (!_songPlayback) return;
+    final folder = _clip?.parent;
+    _clip = null;
+    unawaited(_remove(folder));
+  }
+
+  Future<void> _clear() {
+    _selection++;
+    _endPlayback('stopped');
+    _playbackId = null;
+    _automatic = false;
+    _songPlayback = false;
+    final abort = _abort;
+    if (abort != null && !abort.isCompleted) abort.complete();
+    _abort = null;
+    final wasPlaying = _playId != null;
+    _playId = null;
+    _pcmTiming = null;
+    _pendingReplyTiming = null;
+    final folder = _clip?.parent;
+    _clip = null;
+    return wasPlaying ? _player.stop().whenComplete(() => _remove(folder)) : _remove(folder);
+  }
+
+  static Future<void> _remove(Directory? folder) async {
+    try {
+      await folder?.delete(recursive: true);
+    } on FileSystemException {
+      // The OS can reclaim the app cache independently.
+    }
+  }
+
+  @override
+  void dispose() {
+    _disposed = true;
+    unawaited(_clear());
+    unawaited(_events.cancel());
+    if (ownsPlayer) _player.dispose();
+    super.dispose();
+  }
+}
diff --git a/app/lib/whale/voice_reply.dart b/app/lib/whale/voice_reply.dart
new file mode 100644
index 0000000000000000000000000000000000000000..41e55f1a0d9e87297e8f198fad0fa2fc995dd8f1
--- /dev/null
+++ b/app/lib/whale/voice_reply.dart
@@ -0,0 +1,77 @@
+class VoiceReplyMatch {
+  VoiceReplyMatch._(this.assistantMessageId, this.readyMs, this._elapsedMs, this._sentAt);
+
+  final String assistantMessageId;
+  final int readyMs;
+  final int Function() _elapsedMs;
+  final int _sentAt;
+
+  int get elapsedMs => _elapsedMs() - _sentAt;
+}
+
+/// The one voice reply this phone is allowed to play. The WebSocket can beat the POST receipt.
+class VoiceReplyTicket {
+  VoiceReplyTicket({int Function()? elapsedMs}) : _elapsedMs = elapsedMs ?? _monotonicClock();
+
+  static const lifetime = Duration(minutes: 2);
+  final int Function() _elapsedMs;
+  final _early = <(String, String), VoiceReplyMatch>{};
+  Object? _send;
+  int? _sentAt;
+  (String, String)? _receipt;
+
+  static int Function() _monotonicClock() {
+    final clock = Stopwatch()..start();
+    return () => clock.elapsedMilliseconds;
+  }
+
+  bool get pending {
+    final sentAt = _sentAt;
+    if (sentAt == null) return false;
+    if (_elapsedMs() - sentAt < lifetime.inMilliseconds) return true;
+    clear();
+    return false;
+  }
+
+  Object begin() {
+    clear();
+    _sentAt = _elapsedMs();
+    return _send = Object();
+  }
+
+  VoiceReplyMatch? confirm(Object send, {required String sessionId, required String userMessageId}) {
+    if (!pending || !identical(send, _send) || _receipt != null) return null;
+    _receipt = (sessionId, userMessageId);
+    final assistant = _early[_receipt];
+    _early.clear();
+    return assistant == null ? null : _consume(assistant);
+  }
+
+  VoiceReplyMatch? receive({
+    required String sessionId,
+    required String userMessageId,
+    required String assistantMessageId,
+  }) {
+    if (!pending) return null;
+    final key = (sessionId, userMessageId);
+    final receipt = _receipt;
+    if (receipt != null && receipt != key) return null;
+    final sentAt = _sentAt!;
+    final match = VoiceReplyMatch._(assistantMessageId, _elapsedMs() - sentAt, _elapsedMs, sentAt);
+    if (receipt != null) return _consume(match);
+    if (_early.length < 8) _early.putIfAbsent(key, () => match);
+    return null;
+  }
+
+  VoiceReplyMatch _consume(VoiceReplyMatch assistant) {
+    clear();
+    return assistant;
+  }
+
+  void clear() {
+    _send = null;
+    _sentAt = null;
+    _receipt = null;
+    _early.clear();
+  }
+}
diff --git a/app/lib/whale_main.dart b/app/lib/whale_main.dart
