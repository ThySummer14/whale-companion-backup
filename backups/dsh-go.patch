+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+import 'dart:math';
+
+import 'package:file_picker/file_picker.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+
+import '../l10n/l10n.dart';
+import '../state/attachments.dart';
+import '../ui/chat/render/markdown_body.dart';
+import '../companion/companion_voice.dart';
+import '../ui/chat/widgets/attachments.dart';
+import 'bilibili.dart';
+import 'dictation.dart';
+import 'host.dart';
+import 'voice.dart';
+import 'voice_reply.dart';
+
+enum _ConversationPhase { preparing, listening, waiting, speaking, resuming }
+
+class WhaleChat extends StatefulWidget {
+  const WhaleChat(this.host, {required this.active, this.attachmentPicker, this.player, this.onRevoked, super.key});
+  final CompanionHost host;
+  final bool active;
+  final AttachmentPicker? attachmentPicker;
+  final CompanionVoice? player;
+  final VoidCallback? onRevoked;
+
+  @override
+  State<WhaleChat> createState() => _WhaleChatState();
+}
+
+class _WhaleChatState extends State<WhaleChat> with WidgetsBindingObserver {
+  final _input = TextEditingController();
+  final _scroll = ScrollController();
+  final _voiceReply = VoiceReplyTicket();
+  late final WhaleVoice _voice;
+  late final WhaleDictation _dictation;
+  late final Listenable _speech;
+  WebSocket? _socket;
+  List<Json> _messages = [];
+  List<DraftAttachment> _drafts = const [];
+  ChatAttachmentLimits? _attachmentLimits;
+  ExpressiveVoice? _expressiveVoice;
+  bool _pickingAttachments = false;
+  bool _midiRequestMissing = false;
+  ({String text, List<DraftAttachment> drafts, bool voiceReply, String id, String? session})? _submission;
+  ({String session, Json message})? _acceptedMessage;
+  String? _sessionId;
+  bool _chatSendV1 = false;
+  Completer<void>? _attachmentDownload;
+  (String, String)? _openingAttachment;
+  String _stream = '';
+  String _buffer = '';
+  String? _attempt;
+  int _index = -1;
+  int _cursor = 0;
+  int _historyRequest = 0;
+  Timer? _paint;
+  Timer? _replyTimeout;
+  Timer? _conversationLimit;
+  Timer? _reopenMic;
+  _ConversationPhase? _conversation;
+  bool _conversationStartedAudio = false;
+  String? _dictatedText;
+  bool _readNextReply = true;
+  bool _online = false;
+  bool _waiting = false;
+  bool _submitting = false;
+  bool _stopping = false;
+  bool _revoked = false;
+  bool _foreground = true;
+  Object? _error;
+
+  @override
+  void initState() {
+    super.initState();
+    _voice = WhaleVoice(
+      widget.host,
+      player: widget.player,
+      ownsPlayer: widget.player == null,
+      onRevoked: _revokeDevice,
+    );
+    _dictation = WhaleDictation(widget.host, onDraft: _appendDictation, onRevoked: _revokeDevice);
+    _dictation.addListener(_observeConversationDictation);
+    _voice.addListener(_observeConversationPlayback);
+    _speech = Listenable.merge([_voice, _dictation]);
+    _input.addListener(_trackDictatedDraft);
+    WidgetsBinding.instance.addObserver(this);
+    unawaited(_listen());
+  }
+
+  @override
+  void didUpdateWidget(covariant WhaleChat oldWidget) {
+    super.didUpdateWidget(oldWidget);
+    if (oldWidget.active && !widget.active) {
+      _cancelAttachmentDownload();
+      _leaveVoice();
+    } else if (!oldWidget.active && widget.active && _online && !_revoked && _foreground) {
+      unawaited(_dictation.refreshAccess());
+    }
+  }
+
+  @override
+  void didChangeAppLifecycleState(AppLifecycleState state) {
+    // The Android permission dialog can make the activity inactive without leaving the app.
+    switch (state) {
+      case AppLifecycleState.hidden || AppLifecycleState.paused || AppLifecycleState.detached:
+        _foreground = false;
+        _cancelAttachmentDownload();
+        _leaveVoice();
+      case AppLifecycleState.resumed:
+        _foreground = true;
+        if (widget.active && _online && !_revoked && !_dictation.active && _conversation == null) {
+          unawaited(_dictation.refreshAccess());
+        }
+      case AppLifecycleState.inactive:
+        break;
+    }
+  }
+
+  Future<void> _listen() async {
+    var backoff = 1;
+    while (mounted && !_revoked) {
+      final transport = HttpClient()..connectionTimeout = const Duration(seconds: 8);
+      WebSocket? socket;
+      try {
+        final host = widget.host;
+        final state = await host.state();
+        if (!mounted) return;
+        final chatSend = state['chatSend'];
+        setState(() {
+          _expressiveVoice = ExpressiveVoice.fromState(state);
+          _chatSendV1 = chatSend is Map && chatSend['version'] == 1;
+        });
+        await host.ensureChat(state);
+        if (!mounted) return;
+        socket = await host.events(_cursor, transport);
+        if (!mounted) return;
+        _socket = socket;
+        await for (final frame in socket.timeout(const Duration(seconds: 26))) {
+          if (!mounted) return;
+          if (frame is! String) continue;
+          final event = jsonDecode(frame) as Json;
+          if (event['type'] == 'stream.replay.complete') backoff = 1;
+          _event(event);
+        }
+      } catch (error) {
+        if (!mounted) return;
+        if (error is HostError && error.status == 401) {
+          _revokeDevice(error);
+        } else {
+          setState(() => _error = error);
+        }
+      } finally {
+        transport.close(force: true);
+        if (socket != null) unawaited(socket.close().then<void>((_) {}, onError: (Object _) {}));
+        _socket = null;
+        if (mounted) {
+          _endConversation();
+          _discardVoiceReply();
+          _cancelAttachmentDownload();
+          unawaited(_dictation.cancel());
+          setState(() {
+            _online = false;
+            _attachmentLimits = null;
+            _resetStream();
+          });
+        }
+      }
+      if (!mounted || _revoked) break;
+      await Future<void>.delayed(Duration(seconds: backoff));
+      backoff = (backoff * 2).clamp(1, 8);
+    }
+  }
+
+  void _revokeDevice(HostError error) {
+    if (!mounted || _revoked) return;
+    _cancelAttachmentDownload();
+    _leaveVoice();
