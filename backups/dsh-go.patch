+
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.start,
+      children: [
+        Text(l.whaleCommunityTitle, style: theme.textTheme.titleMedium),
+        const SizedBox(height: 4),
+        Semantics(
+          liveRegion: true,
+          child: Text(active == null ? l.whaleCommunityHint : l.whaleCommunityLive(_siteLabel(l, active))),
+        ),
+        const SizedBox(height: 8),
+        DecoratedBox(
+          decoration: BoxDecoration(color: colors.surfaceContainerHighest, borderRadius: BorderRadius.circular(14)),
+          child: Padding(
+            padding: const EdgeInsets.all(8),
+            child: Column(
+              children: [
+                Row(
+                  children: [
+                    place(WhaleCommunitySite.home),
+                    const SizedBox(width: 8),
+                    place(WhaleCommunitySite.studio),
+                  ],
+                ),
+                const SizedBox(height: 8),
+                Row(
+                  children: [
+                    place(WhaleCommunitySite.library),
+                    const SizedBox(width: 8),
+                    place(WhaleCommunitySite.camp),
+                  ],
+                ),
+              ],
+            ),
+          ),
+        ),
+        const SizedBox(height: 8),
+        Text(detail),
+        if (_selected == WhaleCommunitySite.camp && widget.onOpenCamp != null)
+          FilledButton.tonal(onPressed: widget.onOpenCamp, child: Text(l.whaleCampOpen)),
+        if (open != null) TextButton(onPressed: open, child: Text(action)),
+        if (_selected == WhaleCommunitySite.camp) ...[
+          if (widget.snapshot.campProject case final project?) ...[
+            const SizedBox(height: 8),
+            WhaleCampProjectCard(project: project, fresh: widget.fresh),
+          ],
+          const SizedBox(height: 8),
+          Text(widget.fresh ? l.whaleCommunityCampLog : l.whaleCommunityLastCampLog, style: theme.textTheme.titleSmall),
+          if (widget.snapshot.recentCamp.isEmpty) Text(l.whaleCommunityNoCampReceipts),
+          for (final receipt in widget.snapshot.recentCamp) _CampReceiptTile(receipt),
+        ],
