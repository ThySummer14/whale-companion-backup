+      _reopenMic = null;
+      if (_conversation != _ConversationPhase.resuming) return;
+      if (_waiting || _submitting) return;
+      if (!_canBeginConversation) {
+        _endConversation();
+        return;
+      }
+      setState(() => _conversation = _ConversationPhase.listening);
+      unawaited(_dictation.start());
+    });
+  }
+
+  void _endConversation({bool stopPlayback = true}) {
+    if (_conversation == null) return;
+    _conversationLimit?.cancel();
+    _conversationLimit = null;
+    _reopenMic?.cancel();
+    _reopenMic = null;
+    setState(() => _conversation = null);
+    _discardVoiceReply(stopPlayback: stopPlayback);
+    unawaited(_dictation.cancel());
+  }
+
+  void _leaveVoice() {
