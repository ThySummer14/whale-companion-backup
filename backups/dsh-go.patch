+          text,
+          files,
+          requestId: identity.id,
+          expectedSessionId: session,
+          voiceReply: voiceReply,
+        ),
+        null when files.isNotEmpty => await host.sendAttachments(
+          text,
+          files,
+          requestId: identity.id,
+          voiceReply: voiceReply,
+        ),
+        null => await host.send(text, voiceReply: voiceReply),
