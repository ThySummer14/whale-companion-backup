+import 'package:dsh_app/whale/notices.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+const _stamp = '2026-11-09T10:12:34.000Z';
+const _post = '880e833a-d7d7-4caa-a067-a3b0c4df8af2';
+const _reply = '90daebbe-ce12-4c5e-96ce-62bf1d35165a';
+
+Json _row(int id, {String kind = 'chat-reply', bool read = false}) => {
+  'id': id,
+  'kind': kind,
+  'occurredAt': _stamp,
+  'read': read,
+};
+
+Json _summary(int unread) => {'version': 1, 'unread': unread};
+Json _page(List<Json> items, {int unread = 2, int? next}) => {..._summary(unread), 'items': items, 'nextBefore': ?next};
+
+Json _feedReply(int id) => {..._row(id, kind: 'feed-reply'), 'postId': _post, 'replyId': _reply};
+
+class _RealHttp extends HttpOverrides {}
+
+class _NoticeHost extends CompanionHost {
+  _NoticeHost() : super(Uri.parse('https://notices.test'), 'Device isolated-notices');
+
+  Future<Json> Function(int?) load = (_) async => _page([_row(12)]);
+  Future<Json> Function() acknowledge = () async => _summary(0);
+  final queries = <int?>[];
+  final acknowledgements = <(int, bool)>[];
+
+  @override
+  Future<WhaleNoticePage> notices(Future<void> abort, {int? before}) async {
+    queries.add(before);
+    return WhaleNoticePage.fromJson(await load(before), before: before);
+  }
+
+  @override
+  Future<WhaleNoticeSummary> markNoticesRead(int id, Future<void> abort, {bool through = false}) async {
+    acknowledgements.add((id, through));
+    return WhaleNoticeSummary.fromJson(await acknowledge())!;
+  }
+}
+
+Future<ValueNotifier<bool>> _show(
+  WidgetTester tester,
+  _NoticeHost host, {
+  List<WhaleNotice>? opened,
+  List<int?>? counts,
+  Locale locale = const Locale('en'),
+}) async {
+  await tester.binding.setSurfaceSize(const Size(390, 844));
+  addTearDown(() => tester.binding.setSurfaceSize(null));
+  addTearDown(host.close);
+  final revoked = ValueNotifier(false);
+  addTearDown(revoked.dispose);
+  await tester.pumpWidget(
+    MaterialApp(
+      locale: locale,
+      localizationsDelegates: L10n.localizationsDelegates,
+      supportedLocales: AppLocale.supported,
+      home: WhaleInboxPage(
+        host: host,
+        revoked: revoked,
+        onRevoked: () => revoked.value = true,
+        onSummary: (summary) => counts?.add(summary?.unread),
+        onOpen: (_, notice) async => opened?.add(notice),
+      ),
+    ),
+  );
+  await tester.pumpAndSettle();
+  return revoked;
+}
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+
+  test('parses only a versioned summary and routes allowlisted notices by validated identifiers', () {
+    expect(WhaleNoticeSummary.fromJson(null), isNull);
+    expect(WhaleNoticeSummary.fromJson({'version': 2, 'unread': 3}), isNull);
+    expect(WhaleNoticeSummary.fromJson(_summary(-1)), isNull);
+    expect(WhaleNoticeSummary.fromJson(_summary(201)), isNull);
+    final page = WhaleNoticePage.fromJson(
+      _page([
+        _row(8),
+        _feedReply(16),
+        {..._row(15, kind: 'feed-post'), 'postId': _post, 'replyId': _reply},
+        for (final (id, kind) in [
+          (14, 'song-ready'),
+          (13, 'song-failed'),
+          (12, 'camp-completed'),
+          (11, 'camp-returned'),
+        ])
+          {..._row(id, kind: kind), 'taskId': _post},
+        {..._feedReply(10), 'postId': 'https://example.test/'},
+        {..._feedReply(9), 'replyId': '$_reply\n'},
+        _row(9, kind: 'song-ready'),
+        {..._row(7), 'occurredAt': '2026-11-09T10:12:34'},
+        _row(6, kind: 'unsupported'),
+        _row(5, kind: 'song-failed'),
+        _row(8),
+        _row(17),
+      ], next: 5),
+      before: 17,
+    );
+    expect(page.items.map((item) => item.id), [16, 15, 14, 13, 12, 11, 8]);
+    expect(page.items.map((item) => item.kind), [
+      WhaleNoticeKind.feedReply,
+      WhaleNoticeKind.feedPost,
+      WhaleNoticeKind.songReady,
+      WhaleNoticeKind.songFailed,
+      WhaleNoticeKind.campCompleted,
+      WhaleNoticeKind.campReturned,
+      WhaleNoticeKind.chatReply,
+    ]);
+    expect(page.items.first.postId, _post);
+    expect(page.items.first.replyId, _reply);
+    expect(page.items[1].replyId, isNull);
+    expect(page.items.first.at, DateTime.parse(_stamp));
+    expect(page.nextBefore, 5);
+    expect(() => WhaleNoticePage.fromJson(_page([], next: 5), before: 5), throwsFormatException);
+  });
+
+  test('paired relay uses authorization, exclusive cursors and distinct id or through bodies', () async {
+    await HttpOverrides.runWithHttpOverrides(() async {
+      final server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
+      addTearDown(() => server.close(force: true));
+      final host = CompanionHost(Uri.parse('http://127.0.0.1:${server.port}'), 'Device isolated-notices');
+      addTearDown(host.close);
+      final requests = <List<Object?>>[];
+      server.listen((request) async {
+        expect(request.headers.value(HttpHeaders.authorizationHeader), 'Device isolated-notices');
+        final data = request.method == 'POST' ? jsonDecode(await utf8.decoder.bind(request).join()) : null;
+        requests.add([request.method, request.uri.path, request.uri.queryParameters, data]);
+        request.response.headers.contentType = ContentType.json;
+        if (requests.length == 5) request.response.statusCode = 401;
+        request.response.write(
+          jsonEncode(switch (request.uri.path.split('/').last) {
+            'state' => {'notices': _summary(2)},
+            'read' => _summary(1),
+            _ => _page([_row(12)], next: 12),
+          }),
+        );
+        await request.response.close();
+      });
+      final abort = Completer<void>();
+      expect(WhaleNoticeSummary.fromJson((await host.state())['notices'])?.unread, 2);
+      expect((await host.notices(abort.future, before: 20)).items.single.id, 12);
+      expect((await host.markNoticesRead(12, abort.future)).unread, 1);
+      await host.markNoticesRead(12, abort.future, through: true);
+      await expectLater(
+        host.notices(abort.future),
+        throwsA(isA<HostError>().having((error) => error.status, 'status', 401)),
+      );
+      expect(requests, [
+        ['GET', '/companion-device/api/state', <String, String>{}, null],
+        [
+          'GET',
+          '/companion-device/api/notices',
+          {'limit': '25', 'before': '20'},
+          null,
+        ],
+        [
+          'POST',
+          '/companion-device/api/notices/read',
+          <String, String>{},
+          {'id': 12},
+        ],
+        [
+          'POST',
+          '/companion-device/api/notices/read',
+          <String, String>{},
+          {'through': 12},
+        ],
+        [
+          'GET',
+          '/companion-device/api/notices',
+          {'limit': '25'},
+          null,
+        ],
+      ]);
+    }, _RealHttp());
+  });
+
+  testWidgets('opening an unread reply waits for host acknowledgement and allows retry', (tester) async {
+    final pending = Completer<Json>();
+    final host = _NoticeHost();
+    host.load = (_) async => _page([_feedReply(12)], unread: 1);
+    host.acknowledge = () => pending.future;
+    final opened = <WhaleNotice>[];
+    final counts = <int?>[];
+    await _show(tester, host, opened: opened, counts: counts);
+    final reply = find.text('Little Whale replied to a post');
+    await tester.tap(reply);
+    await tester.pump();
+    expect(opened, isEmpty);
+    expect(counts, [1]);
+    expect(find.textContaining('Unread'), findsOneWidget);
+    pending.completeError(const HostError(0, 'offline'));
+    await tester.pumpAndSettle();
+    expect(opened, isEmpty);
+    expect(find.textContaining('Could not confirm'), findsOneWidget);
+    host.acknowledge = () async => _summary(0);
+    await tester.tap(reply);
+    await tester.pumpAndSettle();
+    expect(host.acknowledgements, [(12, false), (12, false)]);
+    expect(opened.single.replyId, _reply);
+    expect(opened.single.read, isTrue);
+    expect(counts, [1, 0]);
+  });
+
+  testWidgets('older pages append and marking through the displayed maximum leaves newly arrived notices unread', (
+    tester,
+  ) async {
+    final host = _NoticeHost();
+    host.load = (before) async => before == null ? _page([_row(15)], next: 15) : _page([_row(8)]);
+    host.acknowledge = () async => _summary(1);
+    final counts = <int?>[];
+    await _show(tester, host, counts: counts);
+    await tester.tap(find.text('Load older notices'));
+    await tester.pumpAndSettle();
+    expect(host.queries, [null, 15]);
+    expect(find.text('New chat reply'), findsNWidgets(2));
+    await tester.tap(find.byTooltip('Mark everything so far as read'));
+    await tester.pumpAndSettle();
+    expect(host.acknowledgements, [(15, true)]);
+    expect(counts, [2, 2, 1]);
+    expect(find.textContaining('Unread'), findsNothing);
+    host.load = (_) async => _page([_row(16), _row(15, read: true)], unread: 1);
+    await tester.drag(find.byType(ListView), const Offset(0, 360));
+    await tester.pumpAndSettle();
+    expect(host.queries, [null, 15, null]);
+    expect(find.byKey(const ValueKey(16)), findsOneWidget);
+    expect(find.byKey(const ValueKey(8)), findsNothing);
+    expect(find.textContaining('Unread'), findsOneWidget);
+  });
+
+  testWidgets('revocation clears private rows and suppresses a late mark-read result', (tester) async {
+    final pending = Completer<Json>();
+    final host = _NoticeHost()..acknowledge = () => pending.future;
+    final counts = <int?>[];
+    final opened = <WhaleNotice>[];
+    final revoked = await _show(tester, host, counts: counts, opened: opened, locale: const Locale('zh'));
+    expect(find.text('收件箱'), findsOneWidget);
+    await tester.tap(find.text('收到新的聊天回复'));
+    await tester.pump();
+    revoked.value = true;
+    pending.complete(_summary(0));
+    await tester.pumpAndSettle();
+    expect(find.text('收到新的聊天回复'), findsNothing);
+    expect(opened, isEmpty);
+    expect(counts, [2]);
+  });
+
+  testWidgets('older host loses the stale capability when opening the inbox returns 404', (tester) async {
+    final host = _NoticeHost()..load = (_) async => throw const HostError(404, 'not-found');
+    final counts = <int?>[];
+    await _show(tester, host, counts: counts);
+    expect(find.text('This Mac does not offer an inbox yet.'), findsOneWidget);
+    expect(counts, [null]);
+  });
+}
