+      _dictation.voiceReplyReady &&
+      !_dictation.active &&
+      !_waiting &&
+      !_submitting &&
+      (!_chatSendV1 || _sessionId != null) &&
+      !_stopping &&
+      !_pickingAttachments &&
+      _drafts.isEmpty &&
+      _input.text.trim().isEmpty;
