+class _WhaleHouseApprovalCardState extends State<WhaleHouseApprovalCard> {
+  String? _selectedZone;
+  String? _preview;
+  String? _failure;
+  String? _status;
+  bool _busy = false;
+  bool _exporting = false;
+  int _layer = 0;
