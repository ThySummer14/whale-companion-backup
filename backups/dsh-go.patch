index 00000000..a6651624
--- /dev/null
+++ b/app/test/whale/camp_test.dart
@@ -0,0 +1,433 @@
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:dsh_app/l10n/l10n.dart';
+import 'package:dsh_app/whale/camp.dart';
+import 'package:dsh_app/whale/camp_state.dart';
+import 'package:dsh_app/whale/host.dart';
+import 'package:dsh_app/whale/status.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+const _at = '2026-11-09T12:12:34.000Z';
+
+Json _status({
+  bool enabled = true,
+  String? stop,
+  String connection = 'online',
+  Json? project,
+  Object? patrol,
+  Object? gather,
+}) => {
+  'version': 1,
+  'connection': connection,
+  if (stop == null && connection == 'online') 'action': 'survey',
+  'observedAt': _at,
+  'project': ?project,
+  'patrol': ?patrol,
+  'gather': ?gather,
+  'control': {
+    'pairedPauseEnabled': enabled,
+    if (stop != null) ...{'pausedAt': _at, 'stopStatus': stop, if (stop != 'pending') 'stopAt': _at},
+  },
+};
+
+Json _patrol(String status, int completed, String visit) => {
+  'status': status,
+  'completedSegments': completed,
+  'totalSegments': 2,
+  'visitStatus': visit,
+};
+
+Json _gather(String status, int collected, String visit) => {
+  'status': status,
+  'collected': collected,
+  'visitStatus': visit,
+};
+
+class _CampHost extends CompanionHost {
+  _CampHost() : super(Uri.parse('https://camp.test'), 'Device isolated-camp');
+
+  Future<WhaleCampSnapshot> Function() getStatus = () async => WhaleCampSnapshot.fromJson(_status());
+  Future<WhaleCampSnapshot> Function() postPause = () async => WhaleCampSnapshot.fromJson(_status(stop: 'confirmed'));
+  int pauseCount = 0;
+
+  @override
+  Future<WhaleCampSnapshot> minecraftCamp(Future<void> abort) => getStatus();
+
+  @override
+  Future<WhaleCampSnapshot> pauseMinecraft(Future<void> abort) {
+    pauseCount++;
+    return postPause();
+  }
+}
+
+class _RealHttp extends HttpOverrides {}
