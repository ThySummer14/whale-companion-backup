+
+  Future<({int positionMs, int durationMs})?> position(String id) async {
+    try {
+      final result = await _channel.invokeMapMethod<String, int>('position', {'id': id});
+      final position = result?['positionMs'];
+      final duration = result?['durationMs'];
+      if (position == null || duration == null || position < 0 || duration <= 0) return null;
+      return (positionMs: position.clamp(0, duration), durationMs: duration);
+    } on Object {
+      return null;
+    }
+  }
+
+  Future<bool> beginPcm(String id, int sampleRate) => _control('beginPcm', id, {'sampleRate': sampleRate});
+  Future<bool> writePcm(String id, Uint8List bytes) => _control('writePcm', id, {'bytes': bytes});
+  Future<bool> endPcm(String id) => _control('endPcm', id);
+
+  Future<bool> _control(String method, String id, [Map<String, Object>? options]) async {
+    try {
+      return await _channel.invokeMethod<bool>(method, {'id': id, ...?options}) ?? false;
+    } on Object {
+      return false;
+    }
+  }
+
