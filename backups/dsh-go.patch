+    required String expectedSessionId,
+    bool voiceReply = false,
+  }) async {
+    final receipt = files.isNotEmpty
+        ? await sendAttachments(
+            text,
+            files,
+            requestId: requestId,
+            expectedSessionId: expectedSessionId,
+            voiceReply: voiceReply,
+          )
+        : await _json(
+            'messages',
+            data: {
+              'contextId': chatContextId,
+              'text': text,
+              'requestId': requestId,
+              'expectedSessionId': expectedSessionId,
+              if (voiceReply) 'voiceReply': true,
+            },
+          );
+    if (receipt['contextId'] != chatContextId || receipt['sessionId'] != expectedSessionId) {
+      throw const HostError(0, 'chat-invalid-receipt');
+    }
+    return receipt;
+  }
+
+  Future<ChatAttachmentLimits?> chatAttachmentLimits() async {
+    final conversation = singingConversation;
+    if (conversation?.canAttach == false) return null;
+    try {
+      final result = await _json('messages/attachments', timeout: const Duration(seconds: 8));
+      final items = result['maxItems'];
+      final bytes = result['maxTotalBytes'];
+      if (result['available'] != true || items is! int || items < 1 || bytes is! int || bytes < 1) return null;
+      return (
+        maxItems: items.clamp(1, conversation == null ? maxChatAttachmentItems : 1),
+        maxTotalBytes: bytes.clamp(1, conversation?.maxTotalBytes ?? maxChatAttachmentBytes),
+      );
+    } on HostError catch (error) {
+      if (error.status == 404) return null;
+      rethrow;
+    }
+  }
+
+  Future<Json> sendAttachments(
+    String text,
+    List<ChatAttachmentUpload> files, {
+    required String requestId,
+    String? expectedSessionId,
+    bool voiceReply = false,
+  }) async {
+    if (files.isEmpty ||
+        files.length > maxChatAttachmentItems ||
+        files.any((file) => file.bytes.isEmpty || !validChatAttachmentName(file.name))) {
+      throw const HostError(400, 'invalid-chat-attachment');
+    }
+    if (singingConversation case final conversation?) {
+      if (files.length != 1 || text.trim().isEmpty) {
+        throw const HostError(400, 'singing-conversation-invalid-source');
+      }
+      final file = files.single;
+      final error = conversation.attachmentError(file.name, file.bytes);
+      if (error != null) throw HostError(error == 'chat-attachments-too-large' ? 413 : 400, error);
+      if (SingingSource.fromFilename(file.name) == SingingSource.midi && !isSingingMidiRequest(text)) {
+        throw const HostError(400, 'singing-conversation-midi-request-required');
+      }
+    }
+    final total = files.fold(0, (sum, file) => sum + file.bytes.length);
+    if (total > (singingConversation?.maxTotalBytes ?? maxChatAttachmentBytes)) {
+      throw const HostError(413, 'chat-attachments-too-large');
+    }
+    const timeout = Duration(seconds: 60);
+    final abort = Completer<void>();
+    final deadline = Timer(timeout, abort.complete);
+    try {
+      return await _json(
+        'messages',
+        timeout: timeout,
+        abort: abort.future,
+        data: {
+          'contextId': chatContextId,
+          'text': text,
+          'requestId': requestId,
+          'expectedSessionId': ?expectedSessionId,
+          if (voiceReply) 'voiceReply': true,
+          'attachments': [
+            for (final file in files) {'name': file.name, 'dataBase64': base64Encode(file.bytes)},
+          ],
+        },
+      );
+    } finally {
+      deadline.cancel();
+    }
+  }
+
+  Future<Uint8List> chatAttachment(String messageId, ChatAttachment attachment, Future<void> abort) async {
+    final response = await _request(
+      'messages/attachment',
+      query: {'contextId': chatContextId, 'messageId': messageId, 'attachmentId': attachment.id},
+      maxBytes: attachment.bytes,
+      timeout: const Duration(seconds: 35),
+      abort: abort,
+    );
+    if (response.bodyBytes.length != attachment.bytes) throw const HostError(0, 'invalid-chat-attachment');
+    return response.bodyBytes;
+  }
+
+  Future<Json> cancel() => _json('messages/cancel', data: {'contextId': chatContextId});
+  Future<Json> synthesizeVoice(String messageId, Future<void> abort) =>
+      _json('tts', data: {'contextId': chatContextId, 'messageId': messageId}, abort: abort);
+  Future<Json> synthesizeExpressiveVoice(String messageId, ExpressiveVoiceStyle style) => _json(
+    'tts',
+    data: {'contextId': chatContextId, 'messageId': messageId, 'style': style.name},
+    timeout: const Duration(seconds: 15),
+  );
+
+  Future<void> cancelExpressiveVoice(String id) async {
+    try {
+      await _json('tts/${Uri.encodeComponent(id)}/cancel', data: const {}, timeout: const Duration(seconds: 5));
+    } on HostError {
+      // The host also enforces a deadline if the phone disconnects.
+    }
+  }
+
+  Future<Json> voiceTask(String id, Future<void> abort) => _json('tts/${Uri.encodeComponent(id)}', abort: abort);
+
+  Future<List<SongArchiveItem>?> songArchive(Future<void> abort) async {
+    try {
+      return SongArchiveItem.fromArchive(await _json('singing', abort: abort));
+    } on HostError catch (error) {
+      if (error.status == 404) return null;
+      rethrow;
+    }
+  }
+
+  Future<TranscriptionCapabilities> transcriptionCapabilities() async {
+    try {
+      final result = await _json('transcribe', timeout: const Duration(seconds: 8));
+      return (available: result['available'] == true, voiceReplyReady: result['voiceReplyReady'] == true);
+    } on HostError catch (error) {
+      if (error.status == 404) return (available: false, voiceReplyReady: false);
+      rethrow;
+    }
+  }
+
+  Future<String> transcribeVoice(Uint8List wav, Future<void> abort) async {
+    if (wav.length <= 44) throw const HostError(422, 'asr-no-speech');
+    if (wav.length > _maxRecordingBytes) throw const HostError(413, 'invalid-recording');
+    final response = await _request(
+      'transcribe',
+      recording: wav,
+      abort: abort,
+      timeout: const Duration(seconds: 35),
+      maxBytes: 32768,
+    );
+    final result = jsonDecode(utf8.decode(response.bodyBytes));
+    final text = result is Map ? result['text'] : null;
+    if (text is! String) throw const HostError(502, 'invalid-transcription');
+    if (text.trim().isEmpty) throw const HostError(422, 'asr-no-speech');
+    return text.trim();
+  }
+
+  Future<VoiceStream> openVoiceStream(String messageId, Future<void> abort, {void Function()? onFirstByte}) async {
+    const timeout = Duration(seconds: 15);
+    final request = _authenticatedRequest('POST', 'voice-stream', null, abort)
+      ..headers['Content-Type'] = 'application/json'
+      ..headers['X-Companion-Playback-Client'] = _playbackClient
+      ..body = jsonEncode({'contextId': chatContextId, 'messageId': messageId});
+    final http.StreamedResponse response;
+    try {
+      response = await _client.send(request).timeout(timeout);
+    } on Exception {
+      throw const HostError(0, 'offline');
+    }
+    if (response.statusCode != 200) {
+      await response.stream.listen(null).cancel();
+      throw HostError(response.statusCode, response.statusCode == 401 ? 'device-revoked' : 'voice-stream-unavailable');
+    }
+    final rate = int.tryParse(response.headers['x-companion-sample-rate'] ?? '');
+    final type = response.headers['content-type']?.split(';').first.trim().toLowerCase();
+    final length = response.contentLength;
+    if (type != 'application/octet-stream' ||
+        rate == null ||
+        rate < 8000 ||
+        rate > 48000 ||
+        (length != null && (length == 0 || length.isOdd || length > rate * 120))) {
+      await response.stream.listen(null).cancel();
+      throw const HostError(0, 'invalid-voice');
+    }
+    final source = switch (response.headers['x-companion-voice-source']) {
+      'full' => VoiceStreamSource.full,
+      'prefetch-complete' => VoiceStreamSource.prefetchComplete,
+      'prefetch-live' => VoiceStreamSource.prefetchLive,
+      _ => null,
+    };
+    return (
+      sampleRate: rate,
+      chunks: _pcmBlocks(response.stream.timeout(timeout), rate, length, onFirstByte),
+      source: source,
+      playbackId: _readPlaybackId(response),
+    );
+  }
+
+  // Bound the bridge traffic to 40 ms blocks and align PCM16 even if HTTP splits a sample.
+  static Stream<Uint8List> _pcmBlocks(
+    Stream<List<int>> stream,
+    int rate,
+    int? length,
+    void Function()? onFirstByte,
+  ) async* {
+    final blockSize = (rate ~/ 25) * 2;
+    var block = Uint8List(blockSize);
+    var used = 0;
+    var received = 0;
+    var first = true;
+    try {
+      await for (final part in stream) {
+        if (received == 0 && part.isNotEmpty) onFirstByte?.call();
+        received += part.length;
+        if (received > rate * 120 || (length != null && received > length)) {
+          throw const HostError(0, 'invalid-voice');
+        }
+        for (var offset = 0; offset < part.length;) {
+          final count = (part.length - offset).clamp(0, blockSize - used);
+          block.setRange(used, used + count, part, offset);
+          offset += count;
+          used += count;
+          if (used == blockSize) {
+            if (first) _rejectWav(block);
+            first = false;
+            yield block;
+            block = Uint8List(blockSize);
+            used = 0;
+          }
+        }
+      }
+    } on HostError {
+      rethrow;
+    } on Exception {
+      throw const HostError(0, 'offline');
+    }
+    if (received == 0 || received.isOdd || (length != null && received != length)) {
+      throw const HostError(0, 'invalid-voice');
+    }
+    if (used > 0) {
+      final tail = Uint8List.sublistView(block, 0, used);
+      if (first) _rejectWav(tail);
+      yield tail;
+    }
+  }
+
+  static void _rejectWav(Uint8List bytes) {
+    if (bytes.length < 12) return;
+    final tag = ascii.decode(bytes.sublist(0, 4), allowInvalid: true);
+    if ((tag == 'RIFF' || tag == 'RF64' || tag == 'RIFX') &&
+        ascii.decode(bytes.sublist(8, 12), allowInvalid: true) == 'WAVE') {
+      throw const HostError(0, 'invalid-voice');
+    }
+  }
+
+  Future<String?> saveVoice(String id, int size, File file, Future<void> abort) =>
+      _saveWav('tts/${Uri.encodeComponent(id)}/audio', size, _maxVoiceBytes, file, abort);
+
+  Future<String?> saveSong(SongArchiveItem item, File file, Future<void> abort) =>
+      _saveWav('singing/${item.id}/audio', item.bytes, _maxSongBytes, file, abort);
+
+  Future<String?> _saveWav(String path, int size, int maxBytes, File file, Future<void> abort) async {
+    if (size < 44 || size > maxBytes) throw const HostError(0, 'invalid-voice');
+    final request = _authenticatedRequest('GET', path, null, abort)
+      ..headers['X-Companion-Playback-Client'] = _playbackClient;
+    final response = await _client.send(request);
+    if (response.statusCode != 200 ||
+        response.headers['content-type']?.split(';').first != 'audio/wav' ||
+        (response.contentLength != null && response.contentLength != size)) {
+      await response.stream.listen(null).cancel();
+      throw HostError(response.statusCode, 'invalid-voice');
+    }
+    final handle = await file.open(mode: FileMode.write);
+    final header = <int>[];
+    var received = 0;
+    try {
+      await for (final chunk in response.stream) {
+        received += chunk.length;
+        if (received > size) throw const HostError(0, 'invalid-voice');
+        if (header.length < 12) {
+          header.addAll(chunk.take(12 - header.length));
+          if (header.length == 12 &&
+              (String.fromCharCodes(header.take(4)) != 'RIFF' || String.fromCharCodes(header.skip(8)) != 'WAVE')) {
+            throw const HostError(0, 'invalid-voice');
+          }
+        }
+        await handle.writeFrom(chunk);
+      }
+      if (received != size) throw const HostError(0, 'invalid-voice');
+    } finally {
+      await handle.close();
+    }
+    return _readPlaybackId(response);
+  }
+
+  static String? _readPlaybackId(http.StreamedResponse response) {
+    final id = response.headers['x-companion-playback-id'];
+    return id != null && _playbackIdPattern.hasMatch(id) ? id : null;
+  }
+
+  Future<void> reportPlayback(String id, int sequence, String state) async {
+    final abort = Completer<void>();
+    final timer = Timer(const Duration(seconds: 3), abort.complete);
+    try {
+      await _request(
+        'audio-playback',
+        data: {'id': id, 'sequence': sequence, 'state': state},
+        abort: abort.future,
+        timeout: const Duration(seconds: 4),
+        maxBytes: 1024,
+      );
+    } on HostError {
+      // Home presence expires on the host if the phone loses its connection.
+    } finally {
+      timer.cancel();
+    }
+  }
+
+  Future<void> ensureChat(Json state) async {
+    final singing = singingConversation != null;
+    final browsing = bilibiliConversation != null;
+    if (browsing && BilibiliConversation.fromState(state) == null) {
+      throw const HostError(503, 'bilibili-conversation-unavailable');
+    }
+    if (singing && SingingConversation.fromState(state) == null) {
+      throw const HostError(503, 'singing-conversation-unavailable');
+    }
+    final bindings = state['bindings'] as List;
+    for (final binding in bindings.whereType<Map>()) {
+      if (binding['contextId'] != chatContextId) continue;
+      if ((browsing || singing) && binding['kind'] != 'topic') {
+        throw HostError(
+          409,
+          browsing ? 'bilibili-conversation-binding-conflict' : 'singing-conversation-binding-conflict',
+        );
+      }
+      return;
+    }
+    await _json(
+      'sessions',
+      data: {
+        'contextId': chatContextId,
+        'kind': browsing || singing ? 'topic' : 'chat',
+        'label': browsing
+            ? 'B 站浏览'
+            : singing
+            ? '歌唱'
+            : '手机主聊天',
+      },
+    );
+  }
+
+  Future<WebSocket> events(int cursor, HttpClient transport) => WebSocket.connect(
+    _uri('events', {
+      'contextId': chatContextId,
+      'cursor': '$cursor',
+    }).replace(scheme: origin.scheme == 'https' ? 'wss' : 'ws').toString(),
+    headers: {'Authorization': credential},
+    customClient: transport,
+  );
+
+  Future<WebSocket> homeEvents(HttpClient transport) => WebSocket.connect(
+    _uri('events', {'view': 'home'}).replace(scheme: origin.scheme == 'https' ? 'wss' : 'ws').toString(),
+    headers: {'Authorization': credential},
+    customClient: transport,
+  );
+
+  Future<Json> feed([String? cursor]) => _json('feed', query: {'cursor': ?cursor});
+  Future<Json> thread(String id) => _json('feed/${Uri.encodeComponent(id)}');
+
+  Future<String> upload(Uint8List bytes, String type) async {
+    final result = await _json(
+      'media',
+      data: {'mimeType': type, 'dataBase64': base64Encode(bytes)},
+      timeout: const Duration(seconds: 60),
+    );
+    return result['id'] as String;
+  }
+
+  Future<Json> publish(String text, {String? mediaId, String? parentId}) => _json(
+    parentId == null ? 'feed' : 'feed/${Uri.encodeComponent(parentId)}/replies',
+    data: {'body': text, 'mediaId': ?mediaId},
+  );
+
+  Future<Json> publishDraft(
+    String requestId,
+    String text, {
+    String? parentId,
+    ({Uint8List bytes, String mimeType})? image,
+  }) async {
+    final body = text.trim();
+    final result = await _json(
+      'feed/publish',
+      data: {
+        'requestId': requestId,
+        'body': body,
+        'parentId': ?parentId,
+        if (image != null) 'image': {'mimeType': image.mimeType, 'dataBase64': base64Encode(image.bytes)},
+      },
+      timeout: image == null ? const Duration(seconds: 20) : const Duration(seconds: 60),
+    );
+    if (result['id'] is! String ||
+        (result['id'] as String).isEmpty ||
+        result['author'] != 'user' ||
+        result['parentId'] != parentId ||
+        result['body'] != body ||
+        (image != null) != (result['mediaId'] is String)) {
+      throw const HostError(0, 'invalid-feed-receipt');
+    }
+    return result;
+  }
+
+  Future<Uint8List> photo(String id) async =>
+      (await _request('media/${Uri.encodeComponent(id)}', maxBytes: maxPhotoBytes)).bodyBytes;
+
+  void close() => _client.close();
+}
diff --git a/app/lib/whale/notice_state.dart b/app/lib/whale/notice_state.dart
new file mode 100644
index 0000000000000000000000000000000000000000..e766b65310b9227fc0fe295fc8841a2aacb34357
--- /dev/null
+++ b/app/lib/whale/notice_state.dart
@@ -0,0 +1,90 @@
+const _maxNoticeId = 9007199254740991;
+const _maxUnread = 200;
+
+bool _validId(Object? value) => value is int && value > 0 && value <= _maxNoticeId;
+
+enum WhaleNoticeKind { chatReply, feedPost, feedReply, songReady, songFailed, campCompleted, campReturned }
+
+class WhaleNoticeSummary {
+  const WhaleNoticeSummary._(this.unread);
+
+  final int unread;
+
+  static WhaleNoticeSummary? fromJson(Object? value) => switch (value) {
+    {'version': 1, 'unread': final int unread} when unread >= 0 && unread <= _maxUnread => WhaleNoticeSummary._(unread),
+    _ => null,
+  };
+}
+
+class WhaleNotice {
+  const WhaleNotice._(this.id, this.at, this.kind, {required this.read, this.postId, this.replyId});
+
+  final int id;
+  final DateTime at;
+  final WhaleNoticeKind kind;
+  final bool read;
+  final String? postId;
+  final String? replyId;
+
+  WhaleNotice markRead() => WhaleNotice._(id, at, kind, read: true, postId: postId, replyId: replyId);
+
+  static final _uuid = RegExp(r'^[\da-f]{8}(?:-[\da-f]{4}){3}-[\da-f]{12}$');
+  static final _timeOffset = RegExp(r'(?:Z|[+-]\d\d:\d\d)$');
+  static String? _reference(Object? value) =>
+      value is String && value.length == 36 && _uuid.hasMatch(value) ? value : null;
+
+  static WhaleNotice? _fromJson(Map item) {
+    final id = item['id'];
+    final stamp = item['occurredAt'];
+    final read = item['read'];
+    if (!_validId(id) || stamp is! String || !_timeOffset.hasMatch(stamp) || read is! bool) return null;
+    final at = DateTime.tryParse(stamp);
+    if (at == null) return null;
+    final postId = _reference(item['postId']);
+    final replyId = _reference(item['replyId']);
+    final taskId = _reference(item['taskId']);
+    final kind = switch (item['kind']) {
+      'chat-reply' => WhaleNoticeKind.chatReply,
+      'feed-post' when postId != null => WhaleNoticeKind.feedPost,
+      'feed-reply' when postId != null && replyId != null => WhaleNoticeKind.feedReply,
+      'song-ready' when taskId != null => WhaleNoticeKind.songReady,
+      'song-failed' when taskId != null => WhaleNoticeKind.songFailed,
+      'camp-completed' when taskId != null => WhaleNoticeKind.campCompleted,
+      'camp-returned' when taskId != null => WhaleNoticeKind.campReturned,
+      _ => null,
+    };
+    if (kind == null) return null;
+    return WhaleNotice._(
+      id as int,
+      at,
+      kind,
+      read: read,
+      postId: kind == WhaleNoticeKind.feedPost || kind == WhaleNoticeKind.feedReply ? postId : null,
+      replyId: kind == WhaleNoticeKind.feedReply ? replyId : null,
+    );
+  }
+}
+
+class WhaleNoticePage {
+  const WhaleNoticePage._(this.summary, this.items, this.nextBefore);
+
+  final WhaleNoticeSummary summary;
+  final List<WhaleNotice> items;
+  final int? nextBefore;
+
+  factory WhaleNoticePage.fromJson(Map value, {int? before}) {
+    final summary = WhaleNoticeSummary.fromJson(value);
+    final items = value['items'];
+    final next = value['nextBefore'];
+    if (summary == null || items is! List || next != null && (!_validId(next) || before != null && next >= before)) {
+      throw const FormatException('Invalid notice page');
+    }
+    final byId = <int, WhaleNotice>{};
+    for (final item in items.whereType<Map>()) {
+      final notice = WhaleNotice._fromJson(item);
+      if (notice != null && (before == null || notice.id < before)) byId.putIfAbsent(notice.id, () => notice);
+    }
+    final ordered = byId.values.toList()..sort((a, b) => b.id.compareTo(a.id));
+    return WhaleNoticePage._(summary, List.unmodifiable(ordered), next as int?);
+  }
+}
diff --git a/app/lib/whale/notices.dart b/app/lib/whale/notices.dart
new file mode 100644
index 0000000000000000000000000000000000000000..27bef85f3a1ae7e2113b5dc5f7501e5567e00a25
--- /dev/null
+++ b/app/lib/whale/notices.dart
@@ -0,0 +1,234 @@
+import 'dart:async';
+
+import 'package:flutter/foundation.dart';
+import 'package:flutter/material.dart';
+
+import '../l10n/l10n.dart';
+import 'host.dart';
+import 'notice_state.dart';
+
+class WhaleInboxPage extends StatefulWidget {
+  const WhaleInboxPage({
+    required this.host,
+    required this.revoked,
+    required this.onRevoked,
+    required this.onSummary,
+    required this.onOpen,
+    super.key,
+  });
+
+  final CompanionHost host;
+  final ValueListenable<bool> revoked;
+  final VoidCallback onRevoked;
+  final ValueChanged<WhaleNoticeSummary?> onSummary;
+  final Future<void> Function(BuildContext, WhaleNotice) onOpen;
+
+  @override
+  State<WhaleInboxPage> createState() => _WhaleInboxPageState();
+}
+
+class _WhaleInboxPageState extends State<WhaleInboxPage> with WidgetsBindingObserver {
+  List<WhaleNotice>? _items;
+  WhaleNoticeSummary? _summary;
+  int? _nextBefore;
+  Completer<void>? _pending;
+  bool _foreground = true;
+  bool _unsupported = false;
+  bool _loadFailed = false;
+  bool _readFailed = false;
+
+  bool get _blocked => !_foreground || widget.revoked.value || _unsupported || _pending != null;
+
+  @override
+  void initState() {
+    super.initState();
+    widget.revoked.addListener(_revocationChanged);
+    WidgetsBinding.instance.addObserver(this);
+    unawaited(_load());
+  }
+
+  void _cancelRequest() {
+    _pending?.complete();
+    _pending = null;
+  }
+
+  void _revocationChanged() {
+    if (!widget.revoked.value) return;
+    setState(() {
+      _cancelRequest();
+      _items = null;
+      _summary = null;
+      _nextBefore = null;
+    });
+  }
+
+  @override
+  void didChangeAppLifecycleState(AppLifecycleState state) {
+    switch (state) {
+      case AppLifecycleState.resumed:
+        _foreground = true;
+        if (ModalRoute.of(context)?.isCurrent == true) unawaited(_load());
+      case AppLifecycleState.hidden || AppLifecycleState.paused || AppLifecycleState.detached:
+        setState(() {
+          _foreground = false;
+          _cancelRequest();
+        });
+      case AppLifecycleState.inactive:
+        break;
+    }
+  }
+
+  @override
+  void dispose() {
+    _cancelRequest();
+    WidgetsBinding.instance.removeObserver(this);
+    widget.revoked.removeListener(_revocationChanged);
+    super.dispose();
+  }
+
+  Future<void> _load({int? before}) => _request((abort) async {
+    final page = await widget.host.notices(abort.future, before: before);
+    if (!mounted || !identical(_pending, abort)) return;
+    setState(() {
+      _summary = page.summary;
+      _items = [if (before != null) ...?_items, ...page.items];
+      _nextBefore = page.nextBefore;
+    });
+    widget.onSummary(page.summary);
+  });
+
+  Future<void> _markRead(int id, {bool through = false}) => _request((abort) async {
+    final summary = await widget.host.markNoticesRead(id, abort.future, through: through);
+    if (!mounted || !identical(_pending, abort)) return;
+    setState(() {
+      _summary = summary;
+      _items = _items?.map((item) {
+        final affected = through ? item.id <= id : item.id == id;
+        return affected && !item.read ? item.markRead() : item;
+      }).toList();
+    });
+    widget.onSummary(summary);
+  }, markingRead: true);
+
+  Future<void> _request(Future<void> Function(Completer<void>) work, {bool markingRead = false}) async {
+    if (_blocked) return;
+    final abort = Completer<void>();
+    setState(() {
+      _pending = abort;
+      _loadFailed = false;
+      _readFailed = false;
+    });
+    try {
+      await work(abort);
+    } catch (error) {
+      if (!mounted || !identical(_pending, abort)) return;
+      if (error is HostError && error.status == 401) {
+        widget.onRevoked();
+      } else if (!markingRead && error is HostError && error.status == 404) {
+        setState(() {
+          _unsupported = true;
+          _items = null;
+          _summary = null;
+          _nextBefore = null;
+        });
+        widget.onSummary(null);
+      } else {
+        setState(() {
+          _loadFailed = !markingRead;
+          _readFailed = markingRead;
+        });
+      }
+    } finally {
+      if (mounted && identical(_pending, abort)) setState(_cancelRequest);
+    }
+  }
+
+  Future<void> _open(WhaleNotice item) async {
+    if (_blocked) return;
+    if (!item.read) await _markRead(item.id);
+    if (!mounted || _blocked || ModalRoute.of(context)?.isCurrent != true) return;
+    final current = _items?.where((candidate) => candidate.id == item.id).firstOrNull;
+    if (current?.read == true) await widget.onOpen(context, current!);
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final l = context.l10n;
+    final items = _items;
+    final highestShown = items?.firstOrNull?.id;
+    final before = _nextBefore;
+    final canMarkAll =
+        !_blocked &&
+        highestShown != null &&
+        (items!.any((item) => !item.read) || before != null && _summary!.unread > 0);
+    final message = switch ((widget.revoked.value, _unsupported, _loadFailed, _readFailed, items)) {
+      (true, _, _, _, _) => l.whaleRevoked,
+      (_, true, _, _, _) => l.whaleInboxUnavailable,
+      (_, _, true, _, _) => l.whaleInboxLoadFailed,
+      (_, _, _, true, _) => l.whaleInboxReadFailed,
+      (_, _, _, _, null) => l.whaleStatusSyncing,
+      (_, _, _, _, []) when before == null => l.whaleInboxEmpty,
+      _ => null,
+    };
+    return Scaffold(
+      appBar: AppBar(
+        title: Text(l.whaleInbox),
+        actions: [
+          IconButton(
+            tooltip: l.whaleInboxMarkAll,
+            onPressed: canMarkAll ? () => unawaited(_markRead(highestShown, through: true)) : null,
+            icon: const Icon(Icons.done_all),
+          ),
+          IconButton(tooltip: l.whaleRefresh, onPressed: _blocked ? null : _load, icon: const Icon(Icons.refresh)),
+        ],
+      ),
+      body: SafeArea(
+        child: RefreshIndicator(
+          onRefresh: _load,
+          child: ListView(
+            physics: const AlwaysScrollableScrollPhysics(),
+            padding: const EdgeInsets.fromLTRB(16, 8, 16, 24),
+            children: [
+              if (_pending != null) const LinearProgressIndicator(),
+              if (message != null)
+                Padding(
+                  padding: const EdgeInsets.symmetric(vertical: 16),
+                  child: Semantics(liveRegion: true, child: Text(message)),
+                ),
+              for (final item in items ?? const <WhaleNotice>[]) _row(context, item),
+              if (before != null)
+                TextButton(
+                  onPressed: _blocked ? null : () => _load(before: before),
+                  child: Text(l.whaleInboxOlder),
+                ),
+            ],
+          ),
+        ),
+      ),
+    );
+  }
+
+  Widget _row(BuildContext context, WhaleNotice item) {
+    final l = context.l10n;
+    final (icon, title) = switch (item.kind) {
+      WhaleNoticeKind.chatReply => (Icons.chat_bubble_outline, l.whaleInboxChatReply),
+      WhaleNoticeKind.feedPost => (Icons.view_stream_outlined, l.whaleActivityPost),
+      WhaleNoticeKind.feedReply => (Icons.reply, l.whaleActivityReply),
+      WhaleNoticeKind.songReady => (Icons.music_note_outlined, l.whaleInboxSongReady),
+      WhaleNoticeKind.songFailed => (Icons.error_outline, l.whaleInboxSongFailed),
+      WhaleNoticeKind.campCompleted => (Icons.cabin_outlined, l.whaleInboxCampCompleted),
+      WhaleNoticeKind.campReturned => (Icons.home_outlined, l.whaleActivityReturn),
+    };
+    final at = item.at.toLocal();
+    final material = MaterialLocalizations.of(context);
+    final time = '${material.formatShortDate(at)} ${material.formatTimeOfDay(TimeOfDay.fromDateTime(at))}';
+    return ListTile(
+      key: ValueKey(item.id),
+      leading: Icon(icon),
+      title: Text(title, style: item.read ? null : const TextStyle(fontWeight: FontWeight.w700)),
+      subtitle: Text(item.read ? time : l.whaleInboxUnreadAt(time)),
+      trailing: const Icon(Icons.chevron_right),
+      onTap: _blocked ? null : () => unawaited(_open(item)),
+    );
+  }
+}
