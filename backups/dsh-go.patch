+    expect(find.text('Gathered a Minecraft log'), findsOneWidget);
+    expect(find.text('Little Whale replied to a post'), findsNothing);
+    await tester.tap(find.widgetWithText(ChoiceChip, 'Feed'));
+    await tester.pumpAndSettle();
+    await tester.tap(find.text('Little Whale replied to a post'));
