+  Future<void> _openAttachment(String messageId, ChatAttachment attachment) async {
+    if (!_voiceForeground || _attachmentDownload != null || _pickingAttachments || _conversation != null) return;
+    final abort = Completer<void>();
+    setState(() {
+      _attachmentDownload = abort;
+      _openingAttachment = (messageId, attachment.id);
+    });
