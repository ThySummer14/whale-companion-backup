+class _PostEditor extends StatefulWidget {
+  const _PostEditor(this.host, this.parent, this.photos, this.imageOnly, {this.publishPhotoLimit, this.onRevoked});
+  final CompanionHost host;
+  final String? parent;
+  final bool photos;
