+    final request = _authenticatedRequest(
+      method ?? (data == null && recording == null ? 'GET' : 'POST'),
+      path,
+      query,
+      abort,
+    );
+    if (recording != null) {
+      request.headers['Content-Type'] = 'audio/wav';
+      request.bodyBytes = recording;
+    } else if (data != null) {
+      request.headers['Content-Type'] = 'application/json';
+      request.body = jsonEncode(data);
+    }
+    try {
+      return await (() async {
+        final response = await _client.send(request);
+        final responseLimit = response.statusCode >= 200 && response.statusCode < 300 ? maxBytes : 64 * 1024;
+        final bytes = BytesBuilder(copy: false);
+        await for (final part in response.stream) {
+          if (bytes.length + part.length > responseLimit) throw const HostError(0, 'response-too-large');
+          bytes.add(part);
+        }
+        final result = http.Response.bytes(bytes.takeBytes(), response.statusCode, headers: response.headers);
+        if (result.statusCode < 200 || result.statusCode >= 300) {
+          String code = 'http-error';
+          try {
+            final parsed = jsonDecode(result.body) as Json;
+            code = parsed['code'] as String? ?? parsed['error'] as String? ?? code;
+          } catch (_) {}
+          throw HostError(result.statusCode, code);
+        }
+        return result;
+      })().timeout(timeout);
+    } on HostError {
+      rethrow;
+    } on Exception {
+      throw const HostError(0, 'offline');
+    }
+  }
