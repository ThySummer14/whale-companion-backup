+    await tester.tap(find.text('歌词'));
+    await tester.pumpAndSettle();
+    expect(find.text('暂无歌词，先听她唱。'), findsOneWidget);
+
+    await tester.tap(find.text('播放队列'));
+    await tester.pumpAndSettle();
+    await tester.tap(find.text('窗边的小夜曲').last);
+    await tester.pumpAndSettle();
