+      final user = payload['userMessageId'];
+      final assistant = payload['assistantMessageId'];
+      if (event.containsKey('cursor') &&
+          event['cursor'] == null &&
+          session is String &&
+          session.isNotEmpty &&
+          user is String &&
+          user.isNotEmpty &&
