+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  final now = DateTime(2026, 11, 9, 12);
+
+  test('older or incomplete host responses preserve unknown fields', () {
+    final state = WhaleStatusSnapshot.fromState({
+      'presence': 'unexpected',
+      'stats': {'inputTokens': 0, 'outputTokens': -1},
+      'capabilities': [
+        null,
+        {'id': 'media.tts', 'status': 'ready'},
+      ],
+    }, now);
+    expect(state.presence, WhalePresence.unknown);
+    expect(state.inputTokens, 0);
+    expect(state.outputTokens, isNull);
+    expect(state.capability('media.tts'), WhaleCapability.ready);
+    expect(state.capability('game.minecraft'), WhaleCapability.unknown);
+    expect(state.worlds, isEmpty);
+  });
+
+  test('world snapshot accepts version one, bounded valid rows, and distinct connector IDs', () {
+    final state = WhaleStatusSnapshot.fromState({
+      'worlds': {
+        'version': 1,
+        'items': [
+          {'id': 'minecraft', 'label': 'Minecraft', 'status': 'busy'},
+          {'id': 'minecraft', 'label': 'Duplicate', 'status': 'paused'},
+          {'id': 'bilibili', 'label': ' Bilibili ', 'status': 'standby'},
+          {'id': 'singing', 'label': 'Singing', 'status': 'future'},
+          {'id': 'Upper', 'label': 'World', 'status': 'ready'},
+          {'id': 'empty', 'label': ' ', 'status': 'ready'},
+          null,
+        ],
+      },
+    }, now);
+    expect(state.worlds.map((world) => world.id), ['minecraft', 'bilibili']);
+    expect(state.worlds.first.status, WhaleWorldHealth.busy);
+    expect(state.worlds.last.label, 'Bilibili');
+    expect(WhaleStatusSnapshot.fromState({
+      'worlds': {'version': 2, 'items': state.worlds},
+    }, now).worlds, isEmpty);
+  });
+
+  testWidgets('world status renders current connector states without duplicating the legacy Minecraft tile', (tester) async {
+    tester.view.physicalSize = const Size(400, 950);
+    tester.view.devicePixelRatio = 1;
+    addTearDown(tester.view.resetPhysicalSize);
+    addTearDown(tester.view.resetDevicePixelRatio);
+    final state = WhaleStatusSnapshot.fromState({
+      'capabilities': [
+        {'id': 'game.minecraft', 'status': 'ready'},
+      ],
+      'worlds': {
+        'version': 1,
+        'items': [
+          {'id': 'minecraft', 'label': 'Minecraft', 'status': 'paused'},
+          {'id': 'bilibili', 'label': 'Bilibili', 'status': 'busy'},
+          {'id': 'singing', 'label': 'Singing', 'status': 'unconfigured'},
+          {'id': 'future-world', 'label': 'Future world', 'status': 'standby'},
+        ],
+      },
+    }, now);
+    await tester.pumpWidget(MaterialApp(
+      locale: const Locale('en'),
+      localizationsDelegates: L10n.localizationsDelegates,
+      supportedLocales: AppLocale.supported,
+      home: Scaffold(body: WhaleStatusPage(
+        snapshot: state,
+        connection: WhaleStatusConnection.reachable,
+        refreshing: false,
+        onRefresh: () async {},
+      )),
+    ));
+    await tester.pumpAndSettle();
+    expect(find.text('Connected worlds'), findsOneWidget);
+    expect(find.text('Minecraft'), findsOneWidget);
+    expect(find.text('Paused'), findsOneWidget);
+    expect(find.text('In use'), findsOneWidget);
+    expect(find.text('Setup required'), findsOneWidget);
+    expect(find.text('Future world'), findsOneWidget);
+    expect(find.text('Standing by'), findsOneWidget);
+  });
+
+  testWidgets('shows recorded counters and distinguishes a lost connection from a running role', (tester) async {
+    final state = WhaleStatusSnapshot.fromState({
+      'persona': {'name': 'Little Whale QA'},
+      'presence': 'running',
+      'stats': {'inputTokens': 12500, 'outputTokens': 417},
+      'capabilities': [
+        {'id': 'media.tts', 'status': 'ready'},
+      ],
+    }, now);
+    var refreshes = 0;
+
+    Future<void> show(
+      WhaleStatusSnapshot snapshot,
+      WhaleStatusConnection connection, {
+      VoicePlaybackTiming? timing,
+      VoiceReplyTiming? reply,
+      int? transcriptionMs,
+    }) async {
+      await tester.pumpWidget(
+        MaterialApp(
+          locale: const Locale('en'),
+          localizationsDelegates: L10n.localizationsDelegates,
+          supportedLocales: AppLocale.supported,
+          home: Scaffold(
+            body: WhaleStatusPage(
+              snapshot: snapshot,
+              connection: connection,
+              refreshing: false,
+              voiceTiming: timing,
+              voiceReplyTiming: reply,
+              voiceTranscriptionMs: transcriptionMs,
+              onRefresh: () async {
+                refreshes++;
+              },
+            ),
+          ),
+        ),
+      );
+      await tester.pumpAndSettle();
+    }
+
+    await show(state, WhaleStatusConnection.reachable);
+    expect(find.text('Online · Busy'), findsOneWidget);
+    expect(find.text('12,500'), findsOneWidget);
+    expect(find.text('417'), findsOneWidget);
+    expect(find.textContaining('Latest PCM'), findsNothing);
+    await tester.tap(find.byTooltip('Refresh'));
+    expect(refreshes, 1);
+
+    await show(
+      state,
+      WhaleStatusConnection.unreachable,
+      timing: (firstByteMs: 82, nativeStartMs: 117, source: VoiceStreamSource.prefetchLive),
+      reply: (readyMs: 730, nativeStartMs: 932),
+      transcriptionMs: 412,
+    );
+    expect(find.text('Mac mini is unreachable'), findsOneWidget);
+    expect(find.text('Online · Busy'), findsNothing);
+    expect(find.text('12,500'), findsOneWidget);
