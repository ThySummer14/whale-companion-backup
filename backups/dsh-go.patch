+      unawaited(_dictation.cancel());
+    }
+    unawaited(_voice.stop());
+  }
+
+  void _observeConversationDictation() {
+    if (_conversation == _ConversationPhase.listening &&
+        !_dictation.active &&
+        _dictation.notice != DictationNotice.ready) {
+      _endConversation();
+    }
+  }
+
+  void _observeConversationPlayback() {
+    if (_conversation != _ConversationPhase.speaking) return;
+    switch (_voice.phase) {
+      case WhaleVoicePhase.playing:
+        _conversationStartedAudio = true;
+      case WhaleVoicePhase.finished when _conversationStartedAudio:
+        setState(() => _conversation = _ConversationPhase.resuming);
+        _queueConversationMic();
+      case WhaleVoicePhase.failed || WhaleVoicePhase.finished:
+        _endConversation();
+      default:
+        break;
+    }
+  }
+
+  void _trackDictatedDraft() {
+    final dictated = _dictatedText;
+    if (dictated == null || _input.text.contains(dictated)) return;
+    setState(() {
+      _dictatedText = null;
+      _readNextReply = true;
+    });
+  }
+
+  void _discardVoiceReply({bool stopPlayback = true}) {
+    final hadPending = _replyTimeout != null;
+    _replyTimeout?.cancel();
+    _replyTimeout = null;
+    _voiceReply.clear();
+    if (stopPlayback) _voice.stopAutomatic();
+    if (hadPending && mounted) setState(() {});
+  }
+
+  void _playVoiceReply(VoiceReplyMatch? reply) {
+    if (reply == null) return;
