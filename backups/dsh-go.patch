+import 'package:flutter/foundation.dart';
+import 'package:flutter/material.dart';
+import 'package:webview_flutter/webview_flutter.dart';
+import 'package:webview_flutter_android/webview_flutter_android.dart';
+
+import '../l10n/l10n.dart';
+import '../ui/web/web_view_guard.dart';
+import 'host.dart';
+
+enum WhaleAvatarViewerIssue { unavailable, expired, failed }
+
+typedef WhaleAvatarViewerBuilder = Widget Function(
+  WhaleAvatarLaunch launch,
+  Future<void> closed,
+  VoidCallback onReady,
+  ValueChanged<WhaleAvatarViewerIssue> onIssue,
+);
+
+class WhaleAvatarViewerPage extends StatefulWidget {
+  const WhaleAvatarViewerPage({
+    required this.host,
+    required this.revoked,
+    required this.onRevoked,
+    @visibleForTesting this.viewerBuilder,
+    super.key,
+  });
+
+  final CompanionHost host;
+  final ValueListenable<bool> revoked;
+  final VoidCallback onRevoked;
+  final WhaleAvatarViewerBuilder? viewerBuilder;
+
+  @override
+  State<WhaleAvatarViewerPage> createState() => _WhaleAvatarViewerPageState();
+}
+
+class _WhaleAvatarViewerPageState extends State<WhaleAvatarViewerPage> with WidgetsBindingObserver {
+  Completer<void>? _session;
+  WhaleAvatarLaunch? _launch;
+  WhaleAvatarViewerIssue? _issue;
+  Timer? _readyTimeout;
+  bool _ready = false;
+  bool _foreground = true;
+
+  @override
+  void initState() {
+    super.initState();
+    final lifecycle = WidgetsBinding.instance.lifecycleState;
+    _foreground =
+        lifecycle == null || lifecycle == AppLifecycleState.resumed || lifecycle == AppLifecycleState.inactive;
+    WidgetsBinding.instance.addObserver(this);
+    widget.revoked.addListener(_revocationChanged);
+    unawaited(_open());
+  }
+
+  void _release() {
+    _session?.complete();
+    _session = null;
+    _readyTimeout?.cancel();
+    _readyTimeout = null;
+    _launch = null;
+    _ready = false;
+  }
+
+  void _revocationChanged() {
+    if (widget.revoked.value) setState(_release);
+  }
+
+  @override
+  void didChangeAppLifecycleState(AppLifecycleState state) {
+    switch (state) {
+      case AppLifecycleState.hidden || AppLifecycleState.paused || AppLifecycleState.detached:
+        if (!_foreground) return;
+        setState(() {
+          _foreground = false;
+          _release();
+        });
+      case AppLifecycleState.resumed:
+        if (_foreground) return;
+        _foreground = true;
+        unawaited(_open());
+      case AppLifecycleState.inactive:
+        break;
+    }
+  }
+
+  @override
+  void dispose() {
+    widget.revoked.removeListener(_revocationChanged);
+    WidgetsBinding.instance.removeObserver(this);
+    _release();
+    super.dispose();
+  }
+
+  Future<void> _open() async {
+    if (!_foreground || widget.revoked.value || _session != null) return;
+    final session = Completer<void>();
+    setState(() {
+      _session = session;
+      _issue = null;
+    });
+    try {
+      final launch = await widget.host.openAvatarViewer(session.future);
+      if (!mounted || !identical(_session, session)) return;
+      setState(() => _launch = launch);
+      _readyTimeout = Timer(const Duration(seconds: 35), () => _fail(launch, WhaleAvatarViewerIssue.failed));
+    } on Object catch (error) {
+      if (!mounted || !identical(_session, session)) return;
+      if (error is HostError && error.status == 401) {
+        widget.onRevoked();
+      } else {
+        setState(() {
+          _release();
+          _issue = error is HostError && error.status == 404
+              ? WhaleAvatarViewerIssue.unavailable
+              : WhaleAvatarViewerIssue.failed;
+        });
+      }
+    }
+  }
+
+  void _frameReady(WhaleAvatarLaunch launch) {
+    if (!mounted || !identical(_launch, launch) || _ready) return;
+    _readyTimeout?.cancel();
+    _readyTimeout = null;
+    setState(() => _ready = true);
+  }
+
+  void _fail(WhaleAvatarLaunch launch, WhaleAvatarViewerIssue issue) {
+    if (!mounted || !identical(_launch, launch)) return;
+    setState(() {
+      _release();
+      _issue = issue;
+    });
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final l = context.l10n;
+    final launch = _launch;
+    final revoked = widget.revoked.value;
+    final message = revoked
+        ? l.whaleRevoked
+        : !_foreground
+        ? l.whaleAvatarViewerPaused
+        : switch (_issue) {
+            WhaleAvatarViewerIssue.unavailable => l.whaleAvatarViewerUnavailable,
+            WhaleAvatarViewerIssue.expired => l.whaleAvatarViewerExpired,
+            WhaleAvatarViewerIssue.failed => l.whaleAvatarViewerFailed,
+            null => l.whaleAvatarViewerLoading,
+          };
+    return Scaffold(
+      appBar: AppBar(title: Text(l.whaleAvatarViewerTitle)),
+      body: SafeArea(
+        top: false,
+        child: Stack(
+          fit: StackFit.expand,
+          children: [
+            if (launch != null)
+              KeyedSubtree(
+                key: ObjectKey(launch),
+                child: (widget.viewerBuilder ?? _webViewer)(
+                  launch,
+                  _session!.future,
+                  () => _frameReady(launch),
+                  (issue) => _fail(launch, issue),
+                ),
+              ),
+            if (!_ready)
+              ColoredBox(
+                color: Theme.of(context).colorScheme.surface,
+                child: Center(
+                  child: Padding(
+                    padding: const EdgeInsets.all(24),
+                    child: Column(
+                      mainAxisSize: MainAxisSize.min,
+                      children: [
+                        if (!revoked && _foreground && _issue == null) ...[
+                          const SizedBox.square(dimension: 24, child: CircularProgressIndicator(strokeWidth: 2)),
+                          const SizedBox(height: 16),
+                        ],
+                        Semantics(liveRegion: true, child: Text(message, textAlign: TextAlign.center)),
+                        if (!revoked && _foreground && _issue != null) ...[
+                          const SizedBox(height: 12),
+                          OutlinedButton(onPressed: _open, child: Text(l.whaleAvatarViewerRetry)),
+                        ],
+                      ],
+                    ),
+                  ),
+                ),
+              ),
+          ],
+        ),
+      ),
+    );
+  }
+}
+
+Widget _webViewer(
+  WhaleAvatarLaunch launch,
+  Future<void> closed,
+  VoidCallback onReady,
+  ValueChanged<WhaleAvatarViewerIssue> onIssue,
+) => _PrivateAvatarWebView(launch: launch, closed: closed, onReady: onReady, onIssue: onIssue);
+
+class _PrivateAvatarWebView extends StatefulWidget {
+  const _PrivateAvatarWebView({
+    required this.launch,
+    required this.closed,
+    required this.onReady,
+    required this.onIssue,
+  });
+
+  final WhaleAvatarLaunch launch;
+  final Future<void> closed;
+  final VoidCallback onReady;
+  final ValueChanged<WhaleAvatarViewerIssue> onIssue;
+
+  @override
+  State<_PrivateAvatarWebView> createState() => _PrivateAvatarWebViewState();
+}
+
+class _PrivateAvatarWebViewState extends State<_PrivateAvatarWebView> {
+  WebViewController? _web;
+  bool _rendererGone = false;
+  bool _closed = false;
+  late final _guard = WebViewGuard(
+    onGone: (_) {
+      _rendererGone = true;
+      _report(WhaleAvatarViewerIssue.failed);
+    },
+  );
+
+  @override
+  void initState() {
+    super.initState();
+    unawaited(widget.closed.then((_) => _stop()));
+    unawaited(_start());
+  }
+
+  Future<void> _start() async {
+    try {
+      final web = WebViewController(onPermissionRequest: (request) => unawaited(request.deny()));
+      if (web.platform case final AndroidWebViewController android) {
+        await android.setAllowFileAccess(false);
+        await android.setAllowContentAccess(false);
+        await android.setMixedContentMode(MixedContentMode.neverAllow);
+      }
+      await web.setJavaScriptMode(JavaScriptMode.unrestricted);
+      await web.setBackgroundColor(Colors.transparent);
+      await web.setNavigationDelegate(
+        NavigationDelegate(
+          onNavigationRequest: (request) => request.isMainFrame && widget.launch.allowsNavigation(request.url)
+              ? NavigationDecision.navigate
+              : NavigationDecision.prevent,
+          onPageStarted: (url) {
+            if (!widget.launch.allowsNavigation(url)) _report(WhaleAvatarViewerIssue.failed);
+          },
+          onWebResourceError: (error) {
+            if (error.isForMainFrame == true) _report(WhaleAvatarViewerIssue.failed);
+          },
+          onHttpError: (error) {
+            if (error.request?.uri != widget.launch.uri) return;
+            _report(switch (error.response?.statusCode) {
+              401 || 403 => WhaleAvatarViewerIssue.expired,
+              404 => WhaleAvatarViewerIssue.unavailable,
+              _ => WhaleAvatarViewerIssue.failed,
+            });
+          },
+          onHttpAuthRequest: (request) => request.onCancel(),
+          onSslAuthError: (error) {
+            unawaited(error.cancel());
+            _report(WhaleAvatarViewerIssue.failed);
+          },
+        ),
+      );
+      await web.addJavaScriptChannel(
+        'WhaleAvatarViewer',
+        onMessageReceived: (message) {
+          if (!mounted || _closed) return;
+          switch (message.message) {
+            case 'ready':
+              widget.onReady();
+            case 'expired':
+              _report(WhaleAvatarViewerIssue.expired);
+            case 'unavailable':
+              _report(WhaleAvatarViewerIssue.unavailable);
+          }
+        },
+      );
+      if (!mounted || _closed) return;
+      await _guard.attach(web, dark: Theme.of(context).brightness == Brightness.dark, textZoom: 100);
+      if (!mounted || _closed) return;
+      setState(() => _web = web);
+      await web.loadRequest(widget.launch.uri, headers: widget.launch.headers);
+    } on Object {
+      _report(WhaleAvatarViewerIssue.failed);
+    }
+  }
+
+  void _report(WhaleAvatarViewerIssue issue) {
+    if (mounted && !_closed) widget.onIssue(issue);
+  }
+
+  void _stop() {
+    if (_closed) return;
+    _closed = true;
+    if (_web case final web? when !_rendererGone) {
+      // Native polling must end even when Flutter suspends background frames.
+      unawaited(web.loadHtmlString('').catchError((Object _) {}));
+    }
+  }
+
+  @override
+  void dispose() {
+    _stop();
+    _guard.dispose();
+    WidgetsBinding.instance.addPostFrameCallback((_) => unawaited(_guard.destroy()));
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) => switch (_web) {
+    final web? => WebViewWidget(controller: web),
+    null => const SizedBox.expand(),
+  };
+}
