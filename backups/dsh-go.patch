+    host.pcmSource = VoiceStreamSource.prefetchLive;
+    nativeWrite = Completer<bool>();
+    final pending = voice.toggle('live');
+    pcm.add(Uint8List.fromList([1, 2]));
+    pcm.add(Uint8List.fromList([3, 4]));
+    await waitForCall('writePcm');
+    final begin = calls.singleWhere((call) => call.method == 'beginPcm');
+    expect((begin.arguments as Map)['sampleRate'], 48000);
+    expect(voice.phase, WhaleVoicePhase.loading);
+    expect(calls.where((call) => call.method == 'writePcm').length, 1);
+    expect(calls.any((call) => call.method == 'endPcm'), isFalse);
+    expect(host.lastVoicePlaybackTiming, isNull);
+    await event('start', id: 'older-clip');
