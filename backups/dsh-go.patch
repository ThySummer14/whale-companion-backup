+import 'package:dsh_app/whale/bilibili_state.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  const bvid = 'BV1dLx46TEhw';
+  const full = 'https://www.bilibili.com/video/$bvid/';
+
+  test('capability version and duration fail closed, with a bounded forward limit', () {
+    BilibiliConversation? parse(Map value) => BilibiliConversation.fromState({'bilibiliConversation': value});
+    const valid = {'version': 1, 'contextId': bilibiliContext, 'maxClipSeconds': 8};
+    expect(parse(valid)?.maxClipSeconds, 8);
+    expect(parse({...valid, 'maxClipSeconds': 60})?.maxClipSeconds, 12);
+    for (final invalid in [
+      {'version': 2},
+      {'version': 1.0},
+      {'contextId': 'chat.mobile'},
+      {'maxClipSeconds': 0},
+      {'maxClipSeconds': 7.5},
+      {'maxClipSeconds': '12'},
+      {'maxClipSeconds': null},
+    ]) {
+      expect(parse({...valid, ...invalid}), isNull, reason: '$invalid');
+    }
+    expect(BilibiliConversation.fromState({}), isNull);
+  });
+
+  test('link parameters produce a canonical clip command for each modality', () {
+    final source = WhaleBilibiliSource.fromInput(' $full?p=3&t=71&from=tracking ')!;
+    expect(source.time, '1:11');
+    expect(source.uri.toString(), '${full}?p=3&t=71');
+    expect(whaleBilibiliClipDraft(source, 71, 6, WhaleBilibiliMode.both), '看这段 ${full}?p=3 71 6秒 画面和声音');
+    expect(whaleBilibiliClipDraft(source, 10, 3, WhaleBilibiliMode.audio), '看这段 ${full}?p=3 10 3秒 声音');
+    expect(
+      whaleBilibiliClipDraft(WhaleBilibiliSource.fromInput(bvid)!, 0, 1, WhaleBilibiliMode.visual),
+      '看这段 $bvid 0 1秒 画面',
+    );
+  });
+
+  for (final bad in [
+    'https://b23.tv/short',
+    'http://www.bilibili.com/video/$bvid/',
+    'https://www.bilibili.com.evil.test/video/$bvid/',
+    'https://www.bilibili.com@evil.test/video/$bvid/',
+    '${full}extra',
+    '${full}?p=1&p=2',
+    '${full}?p=0',
+    '${full}?p=1001',
+    '${full}?t=5&t=6',
+    '${full}?t=-1',
+    '${full}?t=604801',
+    '$full\\evil',
+    '$full\nother text',
+    '${full}?p=%FF',
+  ]) {
+    test('rejects unsafe or ambiguous target $bad', () => expect(WhaleBilibiliSource.fromInput(bad), isNull));
+  }
+
+  test('start time matches supported seconds, minute and hour forms', () {
+    expect(parseWhaleBilibiliStart(' 0 '), 0);
+    expect(parseWhaleBilibiliStart('00:12'), 12);
+    expect(parseWhaleBilibiliStart('1:04:09'), 3849);
+    expect(parseWhaleBilibiliStart('604800'), 604800);
+    for (final bad in ['-1', '604801', '00:60', '00:1', '1:00:60', '1.5', '']) {
+      expect(parseWhaleBilibiliStart(bad), isNull);
+    }
+  });
+
+  test('receipt links are reconstructed and incomplete or private materials cannot open a source', () {
+    const source = {'bvid': bvid, 'part': 3, 'startSeconds': 12, 'seconds': 6, 'visual': true, 'audio': false};
+    final visual = WhaleBilibiliReceipt.fromWire({'mode': 'clip', 'source': source})!;
+    expect(visual.source?.uri.toString(), '${full}?p=3&t=12');
+    expect(visual.material, WhaleBilibiliMode.visual);
+    expect(visual.seconds, 6);
+    final audio = WhaleBilibiliReceipt.fromWire({
+      'mode': 'clip',
+      'source': {...source, 'visual': false, 'audio': true},
+    });
+    expect(audio?.material, WhaleBilibiliMode.audio);
+    final subtitle = WhaleBilibiliReceipt.fromWire({
+      'mode': 'subtitle',
+      'source': {'bvid': bvid, 'part': 3},
+    });
+    expect(subtitle?.source?.uri.toString(), '${full}?p=3');
+    expect(WhaleBilibiliReceipt.fromWire({'mode': 'clip'})?.source, isNull);
+    for (final changes in [
+      {'bvid': 'https://example.test'},
+      {'startSeconds': null},
+      {'seconds': 13},
+      {'visual': false, 'audio': false},
+      {'part': '3'},
+      {'audio': 'false'},
+    ]) {
+      expect(
+        WhaleBilibiliReceipt.fromWire({
+          'mode': 'clip',
+          'source': {...source, ...changes},
+        })?.source,
+        isNull,
+      );
+    }
+    expect(WhaleBilibiliReceipt.fromWire({'mode': 'future', 'source': source}), isNull);
+  });
+}
